                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="3" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Self}}"/>
                      <TranslateTransform X="-20" Y="0"/>
                    </TransformGroup>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Cicle6" Width="6" Height="6" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="3" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Self}}"/>
                      <TranslateTransform X="-33" Y="0"/>
                    </TransformGroup>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </UniformGrid>
            </c:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="SineWaveProgressRingStyle" TargetType="c:ModernProgressRing">
    <ControlTheme.Resources>
            <ResourceDictionary><SineEase x:Key="Ease" EasingMode="EaseInOut"/>
          </ResourceDictionary></ControlTheme.Resources>
          <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Height" Value="80"/>
    <Setter Property="Width" Value="80"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="DensityMultiplier" Value="0.8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernProgressRing">
          <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Margin="2 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="10" Height="10" Margin="1 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="10" Height="10" Margin="1 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="10" Height="10" Margin="1 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="10" Height="10" Margin="1 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="10" Height="10" Margin="1 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="10" Height="10" Margin="1 0 0 0" Fill="{TemplateBinding Foreground}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="SmallBoxToBigProgressRingStyle" TargetType="c:ModernProgressRing">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernProgressRing">
          <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <Border.Styles><Style Selector="Ellipse.ProgressRingEllipseStyle">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
              </Style>
            </Border.Styles><!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <Border x:Name="Ring" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" Width="54" Height="54" IsHitTestVisible="False" IsVisible="False">
              <Border.RenderTransform>
                <RotateTransform Angle="45"/>
              </Border.RenderTransform>
              <c:SpacingUniformGrid Columns="2" Rows="2" RenderTransformOrigin="0,1" Width="54" Height="54">
                <c:SpacingUniformGrid.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Self}}"/>
                </c:SpacingUniformGrid.RenderTransform>
                <Rectangle x:Name="ProgressElement2" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0" Margin="-0.25">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform/>
                      <ScaleTransform ScaleY="0"/>
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="ProgressElement3" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0" Margin="-0.25">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform/>
                      <ScaleTransform ScaleY="0"/>
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="ProgressElement1" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0" Margin="-0.25">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <RotateTransform/>
                      <ScaleTransform ScaleY="1"/>
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="ProgressElement4" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0" Margin="-0.25">
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <TranslateTransform/>
                      <RotateTransform/>
                      <ScaleTransform ScaleY="0"/>
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
              </c:SpacingUniformGrid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="SnakeProgressRingStyle" TargetType="c:ModernProgressRing">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="80"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="MaxHeight" Value="80"/>
    <Setter Property="MaxWidth" Value="80"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="DensityMultiplier" Value="0.8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernProgressRing">
          <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <c:Cell x:Name="Ring" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" IsVisible="False">
              <c:Cell.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                  <TranslateTransform X="10"/>
                </TransformGroup>
              </c:Cell.RenderTransform>
              <Path x:Name="PART_Stroke" Width="68" Height="68" StrokeDashOffset="0" StrokeThickness="6" Data="F1 M -10,-10 a 10,10 90 0 1 10,10 V 60 a 10,10 180 1 0 20,0 V 0 a 10,10 180 1 1 20,0 V 60 a 10,10 180 1 0 20,0 V 0 a 10,10 180 1 1 20,0 V 60 a 10,10 180 1 0 20,0 V0" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeDashArray="33,1000"><!-- PORT: removed StrokeDashCap (not in Avalonia) --><!-- PORT: removed StrokeEndLineCap (not in Avalonia) --><!-- PORT: removed StrokeStartLineCap (not in Avalonia) --></Path>
            </c:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="SplashProgressRingStyle" TargetType="c:ModernProgressRing">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
