  <ControlTheme x:Key="WalkProgressRingStyle" TargetType="c:ModernProgressRing">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
    <Setter Property="ToolTip.Tip" Value="Original idea: Pascal Gault"/>
    <Setter Property="DensityMultiplier" Value="0.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernProgressRing">
          <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <Border.Styles><Style Selector="Ellipse.ProgressRingEllipseStyle">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
              </Style>
            </Border.Styles><!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <c:Cell x:Name="Ring" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" IsVisible="False">
              <c:Cell.RenderTransform>
                <TranslateTransform/>
              </c:Cell.RenderTransform>
              <UniformGrid Columns="5" Rows="1">
                <Ellipse Width="12" Height="12" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="1" ScaleY="1"/>
                      <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="12" Height="12" Fill="{TemplateBinding Foreground}"/>
                <Ellipse Width="12" Height="12" Fill="{TemplateBinding Foreground}"/>
                <Ellipse Width="12" Height="12" Fill="{TemplateBinding Foreground}"/>
                <Ellipse Width="12" Height="12" Fill="{TemplateBinding Foreground}"/>
              </UniformGrid>
            </c:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
