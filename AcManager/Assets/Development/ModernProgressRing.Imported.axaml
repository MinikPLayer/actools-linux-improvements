        <ControlTemplate TargetType="c:ModernProgressRing">
          <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <Border.Styles><Style Selector="Ellipse.ProgressRingEllipseStyle">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
              </Style>
            </Border.Styles><!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <c:Cell x:Name="Ring" Margin="{TemplateBinding Padding}" IsVisible="False">
              <UniformGrid Columns="6" Rows="1">
                <Ellipse x:Name="Cicle1" Width="6" Height="6" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="3" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Self}}"/>
                      <TranslateTransform X="33" Y="0"/>
                    </TransformGroup>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Cicle2" Width="8" Height="8" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="3" ScaleY="{Binding ScaleX, RelativeSource={RelativeSource Self}}"/>
                      <TranslateTransform X="20" Y="0"/>
                    </TransformGroup>
