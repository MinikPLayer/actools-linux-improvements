            </Border.Styles><!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <c:Cell x:Name="Ring" Margin="{TemplateBinding Padding}" RenderTransformOrigin="0.49,0.49" Width="80" Height="80" IsHitTestVisible="False" IsVisible="False">
              <c:Cell.RenderTransform>
                <RotateTransform Angle="90"/>
              </c:Cell.RenderTransform>
              <Path x:Name="Path1" Data="F1 M 0,0 H 52 V 52 H 0 Z" StrokeDashOffset="6.5031" Stroke="{TemplateBinding Foreground}" StrokeThickness="4" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeDashArray="13.0062,39.0188"/>
              <Path x:Name="Path2" Data="F1 M 0,0 H 52 V 52 H 0 Z" StrokeDashOffset="32.5155" Stroke="{TemplateBinding Foreground}" StrokeThickness="4" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeDashArray="13.0062,39.0188"/>
              <Path x:Name="Path3" Data="F1 M 0,0 H 36 V 36 H 0 Z" StrokeDashOffset="13.5093" Stroke="{TemplateBinding Foreground}" StrokeThickness="4" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeDashArray="9.0062,27.0188"/>
              <Path x:Name="Path4" Data="F1 M 0,0 H 36 V 36 H 0 Z" StrokeDashOffset="31.5218" Stroke="{TemplateBinding Foreground}" StrokeThickness="4" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeDashArray="9.0062,27.0188"/>
            </c:Cell>
