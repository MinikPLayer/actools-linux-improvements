                <Setter Property="Opacity" Value="0.3"/>
              </Style>
              <Style Selector="Path">
                <Setter Property="StrokeThickness" Value="20"/>
              </Style>
            </Border.Styles><!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <c:Cell Background="Transparent" Width="80" Height="80" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <c:Cell.RenderTransform>
                <TransformGroup>
                  <TranslateTransform X="40" Y="40"/>
                  <ScaleTransform ScaleX="0.45" ScaleY="0.45"/>
                </TransformGroup>
              </c:Cell.RenderTransform>
              <Canvas x:Name="PART_Canvas0">
                <Path Stroke="{TemplateBinding Foreground}" Data="M -36,70 A 80,80 0 0 1 -70,36"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas1">
                <Path Stroke="{TemplateBinding Foreground}" Data="M -76,24 A 80,80 0 0 1 -76,-24"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas2">
                <Path Stroke="{TemplateBinding Foreground}" Data="M -70,-36 A 80,80 0 0 1 -36,-70"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas3">
                <Path Stroke="{TemplateBinding Foreground}" Data="M -24,-76 A 80,80 0 0 1 24,-76"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas4">
                <Path Stroke="{TemplateBinding Foreground}" Data="M 36,-70 A 80,80 0 0 1 70,-36"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas5">
                <Path Stroke="{TemplateBinding Foreground}" Data="M 76,-24 A 80,80 0 0 1 76,24"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas6">
                <Path Stroke="{TemplateBinding Foreground}" Data="M 70,36 A 80,80 0 0 1 36,70"/>
              </Canvas>
              <Canvas x:Name="PART_Canvas7">
                <Path Stroke="{TemplateBinding Foreground}" Data="M 24,76 A 80,80 0 0 1 -24,76"/>
              </Canvas>
            </c:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="OctahedronProgressRingStyle" TargetType="c:ModernProgressRing">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="MinWidth" Value="20"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
    <Setter Property="ToolTip.Tip" Value="Original idea: /u/blueconcepts"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernProgressRing">
          <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <!-- PORT: removed VisualStateManager.VisualStateGroups -->
            <Viewport3D x:Name="Ring" IsHitTestVisible="False">
              <Viewport3D.Camera>
                <PerspectiveCamera Position="-160 0 0" LookDirection="40 0 0" FieldOfView="15" UpDirection="0,1,1"/>
              </Viewport3D.Camera>
              <ModelVisual3D>
                <ModelVisual3D.Content>
                  <Model3DGroup>
                    <AmbientLight Color="White"/>
                    <GeometryModel3D>
                      <GeometryModel3D.Geometry>
                        <MeshGeometry3D Positions=" 10,0,10 0,10,10 -10,0,10 0,-10,10 0,0,20 10,10,0 0,10,10 -10,10,0 0,10,-10 0,20,0 10,-10,0 0,-10,10 -10,-10,0 0,-10,-10 0,-20,0 10,10,0 10,0,10 10,-10,0 10,0,-10 20,0,0 -10,10,0 -10,0,10 -10,-10,0 -10,0,-10 -20,0,0 10,0,-10 0,10,-10 -10,0,-10 0,-10,-10 0,0,-20" TriangleIndices=" 0 1 4 1 2 4 2 3 4 3 0 4 5 9 6 6 9 7 7 9 8 8 9 5 10 11 14 11 12 14 12 13 14 13 10 14 15 16 19 16 17 19 17 18 19 18 15 19 20 24 21 21 24 22 22 24 23 23 24 20 25 29 26 26 29 27 27 29 28 28 29 25"/>
                      </GeometryModel3D.Geometry>
                      <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                      </GeometryModel3D.Material>
                      <GeometryModel3D.Transform>
                        <Transform3DGroup>
                          <Transform3DGroup.Children>
                            <RotateTransform3D>
                              <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="Rotate1" Axis="1 0 0"/>
                              </RotateTransform3D.Rotation>
                            </RotateTransform3D>
                            <RotateTransform3D>
                              <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="Rotate2" Axis="0 -1 0"/>
                              </RotateTransform3D.Rotation>
                            </RotateTransform3D>
                          </Transform3DGroup.Children>
                        </Transform3DGroup>
                      </GeometryModel3D.Transform>
                    </GeometryModel3D>
                  </Model3DGroup>
                </ModelVisual3D.Content>
              </ModelVisual3D>
            </Viewport3D>
          </Border>
        </ControlTemplate>
      </Setter.Value>
