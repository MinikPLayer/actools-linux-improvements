<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app, on top of Avalonia (it used to be a WPF project with explicit item lists, see git history). Uses glob patterns for sources
    (see FirstFloor.ModernUI.csproj); sources which are not ported yet are listed in Deferred.props.
  -->
  <PropertyGroup>
    <!-- There is also a custom packer made for this app, that’s why there is an option. -->
    <UseCosturaToPack>false</UseCosturaToPack>
    <IncludeWorkshop>false</IncludeWorkshop>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AcManager</RootNamespace>
    <AssemblyName>AssettoCorsa</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>4</WarningLevel>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Icons\Icon.ico</ApplicationIcon>
    <StartupObject>AcManager.EntryPoint</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\Output\$(Platform)\Debug\</OutputPath>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\$(Platform)\Release\</OutputPath>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseCosturaToPack)' == 'true'">
    <DefineConstants>$(DefineConstants);COSTURA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludeWorkshop)' == 'true'">
    <DefineConstants>$(DefineConstants);INCLUDE_WORKSHOP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="..\Build\AvaloniaCompat.props" />
  <ItemGroup>
    <Using Include="AcTools.Render.Base.Utils.MathF" Alias="MathF" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.3.0.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="OxyPlot.Avalonia" Version="2.1.0-Avalonia11" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.0" />
    <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
    <ProjectReference Include="..\AcManager.Internal.Stub\AcManager.Internal.Stub.csproj" />
    <Reference Include="AcTools.AcdEncryption, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\Libraries\AcTools\AcTools.AcdEncryption.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="AcTools.Kn5Tools, Culture=neutral">
      <HintPath>..\Libraries\AcTools\AcTools.Kn5Tools.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="MegaApiClient, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>..\Libraries\MegaApiClient\MegaApiClient.dll</HintPath>
    </Reference>
    <Reference Include="NAudio, Version=1.8.4.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>..\Libraries\NAudio\NAudio.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\Libraries\Newtonsoft.Json\Newtonsoft.Json.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="SharpCompress, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\Libraries\SharpCompress\SharpCompress.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="xxHashSharp, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>..\packages\xxHashSharp.1.0.0\lib\net45\xxHashSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="MoonSharp.Interpreter, Version=2.0.0.0, Culture=neutral, PublicKeyToken=921e73ce94aa17f8, processorArchitecture=MSIL">
      <HintPath>..\packages\MoonSharp.2.0.0.0\lib\net40-client\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AcManager.AcSound\AcManager.AcSound.csproj" />
    <ProjectReference Include="..\AcManager.ContentRepair\AcManager.ContentRepair.csproj" />
    <ProjectReference Include="..\AcManager.DiscordRpc\AcManager.DiscordRpc.csproj" />
    <ProjectReference Include="..\AcManager.LargeFilesSharing\AcManager.LargeFilesSharing.csproj" />
    <ProjectReference Include="..\AcManager.Tools\AcManager.Tools.csproj" />
    <ProjectReference Include="..\AcManager.Controls\AcManager.Controls.csproj" />
    <ProjectReference Include="..\AcTools.ExtraKn5Utils\AcTools.ExtraKn5Utils.csproj" />
    <ProjectReference Include="..\AcTools.GenericMods\AcTools.GenericMods.csproj" />
    <ProjectReference Include="..\AcTools.LapTimes\AcTools.LapTimes.csproj" />
    <ProjectReference Include="..\AcTools.NeuralTyres\AcTools.NeuralTyres.csproj" />
    <ProjectReference Include="..\AcTools.Render\AcTools.Render.csproj" />
    <ProjectReference Include="..\AcTools.WheelAngles\AcTools.WheelAngles.csproj" />
    <ProjectReference Include="..\AcTools\AcTools.csproj" />
    <ProjectReference Include="..\FirstFloor.ModernUI\FirstFloor.ModernUI.csproj" />
    <ProjectReference Include="..\LicensePlates\LicensePlates.csproj" />
    <ProjectReference Include="..\StringBasedFilter\StringBasedFilter.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeWorkshop)' == 'true'">
    <ProjectReference Include="..\AcManager.Workshop\AcManager.Workshop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <EmbeddedResource Include="**\*.resx" Exclude="obj\**;bin\**" />
    <EmbeddedResource Include="app.config" />
    <AvaloniaXaml Include="**\*.axaml" Exclude="obj\**;bin\**" />
    <AvaloniaResource Include="Assets\Img\**;Assets\Icons\*.ico;Assets\Data\*.css" />
    <None Include="Assets\Data\**;Assets\Presets\**;About\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeWorkshop)' != 'true'">
    <Compile Remove="Pages\Workshop\**;Tools\WorkshopPublishTools\**" />
    <AvaloniaXaml Remove="Pages\Workshop\**" />
  </ItemGroup>
  <Import Project="Deferred.props" />
</Project>
