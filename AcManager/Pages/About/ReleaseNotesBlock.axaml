<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.About.ReleaseNotesBlock">
  <DockPanel x:Name="Root" MinWidth="200">
    <DockPanel Margin="0 0 0 8" DockPanel.Dock="Top">
      <Ellipse DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4" Fill="{DynamicResource Go}" Width="8" Height="8" ToolTip.Tip="{x:Static g:AppStrings.About_NewTooltip}" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <TextBlock Text="{Binding Version, StringFormat={x:Static g:AppStrings.About_VersionFormat}}" Classes="Heading1"/>
    </DockPanel>
    <TextBlock Margin="0 0 0 16" Text="{Binding DisplayName}" DockPanel.Dock="Top" Classes="Label"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0 0 0 20">
      <mui:SelectableBbCodeBlock Text="{Binding Content}" LineHeight="20"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>