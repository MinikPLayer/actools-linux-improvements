<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:workshop="clr-namespace:AcManager.Pages.Workshop" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Workshop.WorkshopContentCars">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/WorkshopResources.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ListBox x:Name="List" ItemsSource="{Binding List}" ItemTemplate="{StaticResource WorkshopResources.ContentItem.Tile}" PointerReleased="OnItemMouseDown" Theme="{StaticResource VirtualizingListBox}">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <mui:VirtualizingTilePanel HorizontalAlignment="Left" ItemWidth="240" ItemHeight="140"/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
  </ListBox>
</UserControl>