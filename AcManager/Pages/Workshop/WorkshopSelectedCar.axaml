<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:AcManager.Pages.Workshop" xmlns:c="http://acstuff.club/app/controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:g="clr-namespace:AcManager" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Workshop.WorkshopSelectedCar">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSelectedSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Themes/GraphDataViewer.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <ItemsPanelTemplate x:Key="CompactSkinsPanel">
        <VirtualizingStackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Background="Transparent" Margin="16 0 16 0">
    <!--<c:AcToolBar x:Name="ToolBar" IsActive="True" DockPanel.Dock="Bottom" Panel.ZIndex="1">
      <ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="Install" Style="{StaticResource Go.ToolBarButton}" />
      </ToolBar>
    </c:AcToolBar>-->

    <ScrollViewer HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" Margin="-8 8 -14 0" Padding="0 0 8 0">
      <StackPanel MinWidth="500" Margin="0 0 0 40">

        <DockPanel>
          <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0 0 4 0">
            <mui:BetterImage Filename="{Binding SelectedObject.BrandBadge}"/>
          </Border>
          <!--<c:FavouriteButton IsChecked="{Binding AcObject.IsFavourite, RelativeSource={RelativeSource TemplatedParent}}" DockPanel.Dock="Right"
              Margin="8 0 0 0" />-->
          <mui:BbCodeBlock Mode="WithoutBbCodes" Text="{Binding SelectedObject.DisplayName}" Placeholder="{x:Static c:ControlsStrings.TableHeader_Name}" Classes="Heading2"/>
        </DockPanel>

        <Grid Margin="0 0 0 12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MaxWidth="800"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>

          <mui:Cell MaxWidth="800">
            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
            <mui:BetterImage x:Name="SelectedSkinPreviewImage" Filename="{Binding SelectedItem.PreviewImage, ElementName=SkinsList}" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5626223}" MaxWidth="800" PointerReleased="OnPreviewRightClick"/>
            <Border x:Name="SkinsListCompactModeParent" Margin="4" Height="36" VerticalAlignment="Top">
              <ListBox x:Name="SkinsList" ItemsSource="{Binding SelectedObject.Skins}" ScrollViewer.VerticalScrollBarVisibility="Disabled" mui:FancyScroll.InvertLocation="True" ItemsPanel="{StaticResource CompactSkinsPanel}">
                <i:Interaction.Behaviors>
                  <mui:HorizontalScrollBehavior x:Name="HorizontalScrollBehavior"/>
                </i:Interaction.Behaviors>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <mui:BetterImage Filename="{Binding LiveryImage}" Width="32" Height="32" ClearOnChange="True" ToolTip.Tip="{Binding DisplayName}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <mui:BetterImage Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="64" Height="64" Filename="{Binding SelectedObject.UpgradeIcon}" CollapseIfNull="True" Background="{DynamicResource CarIconBackground}" Effect="{DynamicResource CarIconEffect}" PointerReleased="OnUpgradeIconClick"/>
          </mui:Cell>

          <!-- Description -->
          <DockPanel Grid.Column="1" Margin="20 0 0 0" Height="{Binding ActualHeight, ElementName=SelectedSkinPreviewImage}">
            <!--<c:RatingBar Rating="{Binding SelectedObject.Rating}" DockPanel.Dock="Bottom" Margin="0 12 0 0" HorizontalAlignment="Center" />-->
            <Border DockPanel.Dock="Top" x:Name="SkinsListExtendedModeParent" Margin="0 0 0 12" MaxHeight="180" IsVisible="False"/>
            <mui:BbCodeBlock Text="{Binding SelectedObject.Description}" Mode="WithoutBbCodes" TextWrapping="Wrap" Placeholder="{x:Static t:ToolsStrings.Common_None}"/>
          </DockPanel>
        </Grid>

        <!-- Data section -->
        <StackPanel>
          <!-- Tags -->
          <mui:TagsList ItemsSource="{Binding SelectedObject.Tags}" IsReadOnly="True" Margin="0 0 0 12">
            <mui:TagsList.ItemContextMenu>
              <mui:InheritingContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByTag}" CommandParameter="{Binding}"/>
              </mui:InheritingContextMenu>
            </mui:TagsList.ItemContextMenu>
          </mui:TagsList>
        </StackPanel>

        <mui:AsyncButton>
          <mui:AsyncButton.Content>
            <DockPanel>
              <Path Width="20" Height="20" Margin="0 0 8 0" Stretch="Uniform" Data="{StaticResource DownloadIconData}" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding Path=(Control.Foreground), RelativeSource={RelativeSource Self}}"/>
              <TextBlock Text="Install" DockPanel.Dock="Top" Classes="Heading2"/>
              <TextBlock Text="{Binding SelectedObject.SizeToInstall, Converter={StaticResource FileSizeConverter}}" Classes="Small"/>
            </DockPanel>
          </mui:AsyncButton.Content>
        </mui:AsyncButton>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</UserControl>