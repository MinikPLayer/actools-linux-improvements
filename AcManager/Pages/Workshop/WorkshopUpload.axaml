<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:w="clr-namespace:AcManager.Pages.Workshop" xmlns:ws="http://acstuff.club/app/workshop" xmlns:workshop="clr-namespace:AcManager.Controls.UserControls.Workshop;assembly=AcManager.Controls" xmlns:validators="clr-namespace:AcManager.Tools.WorkshopPublishTools.Validators" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Workshop.WorkshopUpload" MinWidth="600" Width="800" Height="720" MaxWidth="{x:Static mui:DpiAwareWindow.UnlimitedSize}" MaxHeight="{x:Static mui:DpiAwareWindow.UnlimitedSize}" SizeToContent="Manual" LocationAndSizeKey="WorkshopUpload.LS" Title="Upload to CM Workshop" CanResize="True">
  <mui:ModernDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/WorkshopResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="WorkshopValidationItem" DataType="validators:WorkshopValidatedItem">
        <TextBlock Text="{Binding DisplayMessage, StringFormat='{}• {0}'}" Classes="Small"/>
      </DataTemplate>

      <mui:SpacingStackPanel x:Key="WorkshopValidationPanel" Orientation="Horizontal" Spacing="8">
        <DockPanel Background="Transparent" IsVisible="{Binding ValidationFailed.Count, Converter={StaticResource MoreToVisibilityConverter}}">
          <ToolTip.Tip>
            <StackPanel>
              <TextBlock Text="Errors requiring fixing:" Margin="0 0 0 4" Classes="Label"/>
              <ItemsControl ItemsSource="{Binding ValidationFailed}" ItemTemplate="{StaticResource WorkshopValidationItem}"/>
            </StackPanel>
          </ToolTip.Tip>
          <Path Data="{StaticResource CloseIconData}" Width="12" Height="12" Fill="Red" Stretch="Uniform"/>
          <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ValidationFailed.Count}" VerticalAlignment="Center" Classes="Small"/>
        </DockPanel>
        <DockPanel Background="Transparent" IsVisible="{Binding ValidationWarning.Count, Converter={StaticResource MoreToVisibilityConverter}}">
          <ToolTip.Tip>
            <StackPanel>
              <TextBlock Text="Possible issues:" Margin="0 0 0 4" Classes="Label"/>
              <ItemsControl ItemsSource="{Binding ValidationWarning}" ItemTemplate="{StaticResource WorkshopValidationItem}"/>
            </StackPanel>
          </ToolTip.Tip>
          <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" Fill="{DynamicResource Error}" Stretch="Uniform"/>
          <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ValidationWarning.Count}" VerticalAlignment="Center" Classes="Small"/>
        </DockPanel>
        <DockPanel Background="Transparent" IsVisible="{Binding ValidationFixable.Count, Converter={StaticResource MoreToVisibilityConverter}}">
          <ToolTip.Tip>
            <StackPanel>
              <TextBlock Text="Issues that will be fixed automatically:" Margin="0 0 0 4" Classes="Label"/>
              <ItemsControl ItemsSource="{Binding ValidationFixable}" ItemTemplate="{StaticResource WorkshopValidationItem}"/>
            </StackPanel>
          </ToolTip.Tip>
          <Path Data="{StaticResource GearIconData}" Width="12" Height="12" Fill="{DynamicResource WindowText}" Stretch="Uniform"/>
          <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ValidationFixable.Count}" VerticalAlignment="Center" Classes="Small"/>
        </DockPanel>
        <DockPanel Background="Transparent" IsVisible="{Binding ValidationPassed.Count, Converter={StaticResource MoreToVisibilityConverter}}">
          <ToolTip.Tip>
            <StackPanel>
              <TextBlock Text="Passed checks:" Margin="0 0 0 4" Classes="Label"/>
              <ItemsControl ItemsSource="{Binding ValidationPassed}" ItemTemplate="{StaticResource WorkshopValidationItem}"/>
            </StackPanel>
          </ToolTip.Tip>
          <Path Data="{StaticResource CheckIconData}" Width="12" Height="12" Fill="{DynamicResource Go}" Stretch="Uniform"/>
          <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ValidationPassed.Count}" VerticalAlignment="Center" Classes="Small"/>
        </DockPanel>
      </mui:SpacingStackPanel>

      <DockPanel x:Key="PieceReady">
        <DockPanel Margin="0 0 0 20" Dock="Top">

          <workshop:WorkshopCurrentUserBlock DockPanel.Dock="Right" Width="160"/>

          <StackPanel>
            <TextBlock Text="{Binding Phase, StringFormat='{}Step {0:d}'}" Classes="Heading2"/>
            <TextBlock Text="{Binding PhaseName}" Classes="Small"/>
          </StackPanel>

        </DockPanel>

        <mui:Switch Value="{Binding Phase}" Margin="0 20 0 20">

          <DockPanel mui:Switch.When="{x:Static w:WorkshopUpload+UploadPhase.Preparation}" VerticalAlignment="Top">
            <mui:ModernProgressRing Width="80" Height="80" VerticalAlignment="Center" HorizontalAlignment="Center" IsActive="True"/>
          </DockPanel>

          <DockPanel mui:Switch.When="{x:Static w:WorkshopUpload+UploadPhase.Failed}" VerticalAlignment="Top">
            <mui:AsyncButton Command="{Binding RetryCommand}" Content="Try again" DockPanel.Dock="Bottom" Margin="0 8 0 0"/>
            <Path Data="{StaticResource AlertIconData}" Width="16" Height="16" Fill="{DynamicResource Error}" Stretch="Uniform" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0 4 8 0"/>
            <TextBlock Margin="0 0 0 4" Text="Error:" DockPanel.Dock="Top" Classes="Heading2"/>
            <TextBlock Text="{Binding CurrentError}" Classes="Small"/>
          </DockPanel>

          <DockPanel mui:Switch.When="{x:Static w:WorkshopUpload+UploadPhase.Setup}" VerticalAlignment="Top">
            <mui:SpacingStackPanel Spacing="8" DockPanel.Dock="Bottom" Margin="0 20 0 0">

              <DockPanel>
                <TextBlock Text="Authors:" DockPanel.Dock="Top" Margin="0 0 0 4" Classes="Label"/>
                <ContentControl ContentTemplate="{StaticResource WorkshopCollabsEditor}" Content="{Binding CollabModel}"/>
              </DockPanel>

              <CheckBox IsChecked="{Binding IsOriginalWork}" Background="Transparent">
                <ToolTip.Tip>
                  <TextBlock MaxWidth="400" TextWrapping="Wrap" Text="Keep it checked if either whole thing was made by you, or you have permission to use it (for example, if it uses assets you bought online, or assets with permissive license)"/>
                </ToolTip.Tip>
                <Label Content="This is a scratch made work"/>
              </CheckBox>

              <mui:AsyncButton Command="{Binding UploadCommand}" Content="Upload"/>
              <!--<DockPanel Visibility="{Binding CurrentError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='inverse|hidden'}">
                <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" Fill="{DynamicResource Error}" Stretch="Uniform" DockPanel.Dock="Left" />
                <TextBlock Margin="8 0 0 0" Foreground="{DynamicResource Error}" Text="{Binding CurrentError}" />
              </DockPanel>-->
            </mui:SpacingStackPanel>

            <ItemsControl ItemsSource="{Binding PlannedActions}" Theme="{StaticResource VirtualizingItemsControl}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel IsEnabled="{Binding IsAvailable}" Margin="0 0 0 8">
                    <DockPanel DockPanel.Dock="Top">
                      <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center" IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='inverse|hidden'}"/>
                      <DockPanel>
                        <ContentControl Content="{StaticResource WorkshopValidationPanel}" DockPanel.Dock="Right" Margin="8 0 0 0"/>
                        <mui:BetterImage Width="24" Height="24" Margin="8 0 4 0" Filename="{Binding IconFilename}" CollapseIfMissing="True" CollapseIfNull="True"/>
                        <TextBlock Text="{Binding Target.DisplayName}" DockPanel.Dock="Top"/>
                        <TextBlock Text="{Binding DisplayStatus}" DockPanel.Dock="Top" Classes="Small"/>
                      </DockPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ChildrenGroups}" Margin="16 8 0 0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Expander Theme="{StaticResource SimpleExpander}">
                            <Expander.Header>
                              <DockPanel>
                                <mui:SpacingStackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8 -2 0 2" Spacing="8">
                                  <DockPanel IsVisible="{Binding ChildrenValidationFailed, Converter={StaticResource MoreToVisibilityConverter}}">
                                    <Path Data="{StaticResource CloseIconData}" Width="12" Height="12" Fill="Red" Stretch="Uniform"/>
                                    <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ChildrenValidationFailed}" VerticalAlignment="Center" Classes="Small"/>
                                  </DockPanel>
                                  <DockPanel IsVisible="{Binding ChildrenValidationWarning, Converter={StaticResource MoreToVisibilityConverter}}">
                                    <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" Fill="{DynamicResource Error}" Stretch="Uniform"/>
                                    <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ChildrenValidationWarning}" VerticalAlignment="Center" Classes="Small"/>
                                  </DockPanel>
                                  <DockPanel IsVisible="{Binding ChildrenValidationFixable, Converter={StaticResource MoreToVisibilityConverter}}">
                                    <Path Data="{StaticResource GearIconData}" Width="12" Height="12" Fill="{DynamicResource WindowText}" Stretch="Uniform"/>
                                    <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ChildrenValidationFixable}" VerticalAlignment="Center" Classes="Small"/>
                                  </DockPanel>
                                  <DockPanel IsVisible="{Binding ChildrenValidationPassed, Converter={StaticResource MoreToVisibilityConverter}}">
                                    <Path Data="{StaticResource CheckIconData}" Width="12" Height="12" Fill="{DynamicResource Go}" Stretch="Uniform"/>
                                    <TextBlock Margin="4 0 0 0" FontWeight="Bold" Text="{Binding ChildrenValidationPassed}" VerticalAlignment="Center" Classes="Small"/>
                                  </DockPanel>
                                </mui:SpacingStackPanel>
                                <TextBlock Text="{Binding DisplayTitle}" Background="Transparent" Classes="Label"/>
                              </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="16 0 0 0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <DockPanel>
                                    <ContentControl Content="{StaticResource WorkshopValidationPanel}" DockPanel.Dock="Right" Margin="8 0 0 0"/>
                                    <CheckBox IsChecked="{Binding IsActive}" DockPanel.Dock="Top" Margin="0 4 0 0">
                                      <DockPanel>
                                        <mui:BetterImage Width="14" Height="14" Margin="4 0 4 0" Filename="{Binding IconFilename}" CollapseIfMissing="True" CollapseIfNull="True" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Target.DisplayName}" VerticalAlignment="Center" Classes="Small"/>
                                      </DockPanel>
                                    </CheckBox>
                                  </DockPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Expander>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>

          <ItemsControl ItemsSource="{Binding UploadLog}" TextElement.FontSize="10" Theme="{StaticResource VirtualizingItemsControl}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <mui:BbCodeBlock Text="{Binding Mode=OneWay}" FontWeight="Normal" FontFamily="{StaticResource MonospaceFont}" TextWrapping="NoWrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </mui:Switch>
      </DockPanel>
    </ResourceDictionary>
  </mui:ModernDialog.Resources>

  <mui:BooleanLazySwitch Value="{Binding IsAbleToUploadContent, Source={x:Static ws:WorkshopHolder.Model}}" TrueResourceKey="PieceReady" FalseResourceKey="WorkshopResources.AuthorizationPiece"/>
</mui:ModernDialog>