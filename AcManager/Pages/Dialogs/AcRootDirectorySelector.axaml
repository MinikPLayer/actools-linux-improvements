<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.AcRootDirectorySelector" Title="{x:Static g:AppStrings.Main_ContentManager}" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" LocationAndSizeKey="__AcRootDirectorySelector_LS" MaxHeight="1200" ButtonsRowContentAlignment="Left">
  <mui:ModernDialog.ButtonsRowContent>
    <Button Content="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_InstallRecommendedPlugins}" Command="{Binding Recommended.InstallAllCommand, Source={x:Static t:PluginsManager.Instance}}"/>
  </mui:ModernDialog.ButtonsRowContent>
  <mui:ModernDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/Plugins.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </mui:ModernDialog.Resources>
  <StackPanel Width="500">
    <mui:BbCodeBlock Text="{x:Static g:AppStrings.AcRoot_Welcome}" Margin="0 0 0 20" IsVisible="{Binding FirstRun, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <mui:BbCodeBlock Text="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_AppJustHasBeenUpdatedPleaseReview}" Margin="0 0 0 20" IsVisible="{Binding ReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

    <!-- AC root -->
    <StackPanel IsVisible="{Binding ChangeAcRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{x:Static g:AppStrings.AcRoot_Prompt}" Classes="Heading2"/>
      <DockPanel Margin="20 8 0 0">
        <Button Content="{x:Static c:ControlsStrings.Common_Change}" Command="{Binding ChangeAcRootCommand}" DockPanel.Dock="Right" Margin="4 0 0 0"/>
        <mui:BetterTextBox Placeholder="?" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
      </DockPanel>
    </StackPanel>

    <!-- Steam ID -->
    <StackPanel IsVisible="{Binding ChangeSteamId, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{x:Static g:AppStrings.AcRoot_SteamId_Prompt}" Margin="0 20 0 0" Classes="Heading2"/>
      <DockPanel Margin="20 8 0 0">
        <mui:AsyncButton Content="{x:Static c:ControlsStrings.Common_Change}" Command="{Binding GetSteamIdCommand}" DockPanel.Dock="Right" Margin="4 0 0 0"/>
        <mui:BetterComboBox ItemsSource="{Binding SteamProfiles}" SelectedItem="{Binding SteamProfile}" Placeholder="?" Foreground="{DynamicResource InputText}" IsEditable="False" DisplayMemberBinding="{Binding DisplayName}"/>
      </DockPanel>
    </StackPanel>

    <!-- Player name -->
    <StackPanel IsVisible="{Binding SettingsRun, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
      <TextBlock Text="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_WhatsYourName}" Margin="0 20 0 0" Classes="Heading2"/>
      <DockPanel Margin="20 8 0 0">
        <mui:BetterTextBox Text="{Binding PlayerName, Source={x:Static t:SettingsHolder.Drive}}" Placeholder="?"/>
      </DockPanel>
    </StackPanel>

    <!-- Shortcut -->
    <StackPanel IsVisible="{Binding SettingsRun, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
      <TextBlock Text="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_AddAShortcutToStartMenu}" Margin="0 20 0 0" Classes="Heading2"/>
      <TextBlock Margin="20 8 0 0" Text="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_AddAShortcutToStartMenu_Tooltip}" Classes="Small"/>
      <StackPanel Margin="20 8 0 0" Orientation="Horizontal">
        <Button Content="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_Create}" Command="{x:Static mui:AppShortcut.CreateShortcutCommand}" Margin="0 0 4 0"/>
        <Button Content="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_Delete}" Command="{x:Static mui:AppShortcut.DeleteShortcutCommand}" Margin="0 0 4 0"/>
      </StackPanel>
    </StackPanel>

    <!-- Plugins -->
    <StackPanel IsVisible="{Binding SettingsRun, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
      <TextBlock Text="{x:Static g:AppStrings.Dialogs_AcRootDirectorySelector_InstallSomePlugins}" Margin="0 20 0 0" IsVisible="{Binding Recommended.ListView.Count, Source={x:Static t:PluginsManager.Instance}, Converter={StaticResource MoreToVisibilityConverter}, ConverterParameter=0}" Classes="Heading2"/>
      <ItemsControl Margin="20 8 0 0" ItemsSource="{Binding Recommended.ListView, Source={x:Static t:PluginsManager.Instance}}" mui:FancyScroll.Outside="True" ItemTemplate="{StaticResource PluginItemTemplate.NoOptions}" Height="440" Padding="0 0 8 0" Theme="{StaticResource VirtualizingItemsControl}"/>
    </StackPanel>
  </StackPanel>
</mui:ModernDialog>