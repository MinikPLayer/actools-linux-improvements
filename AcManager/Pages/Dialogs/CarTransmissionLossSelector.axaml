<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.CarTransmissionLossSelector" Title="{Binding Car.DisplayName, StringFormat={x:Static g:AppStrings.CarSpecs_TransmissionLossTitle}}">
  <StackPanel>
    <mui:ValueLabel Value="{Binding Value, Converter={StaticResource PercentageConverter}}" Content="{x:Static g:AppStrings.CarSpecs_TransmissionLoss}" Postfix="%" Margin="0 0 0 4"/>
    <Slider Value="{Binding Value, Converter={StaticResource PercentageConverter}, ConverterParameter=0.1}" Minimum="0" Maximum="50" TickFrequency="5" TickPlacement="BottomRight"/>

    <c:PropertiesGrid Margin="0 20 0 0" LabelWidth="160" Width="480">
      <TextBlock c:PropertiesGrid.Label="Power at wheels (data):">
        <Run Text="{Binding DataPower, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
        <Run Text="{x:Static t:ToolsStrings.Units_WHP}"/>
      </TextBlock>
      <TextBlock c:PropertiesGrid.Label="Power at crankshaft (UI):">
        <Run Text="{Binding UiPower, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
        <Run Text="{x:Static t:ToolsStrings.Units_BHP}"/>
      </TextBlock>
      <TextBlock c:PropertiesGrid.Label="Torque at wheels (data):">
        <Run Text="{Binding DataTorque, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
        <Run Text="{x:Static t:ToolsStrings.Units_Nm}"/>
      </TextBlock>
      <TextBlock c:PropertiesGrid.Label="Torque at crankshaft (UI):">
        <Run Text="{Binding UiTorque, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
        <Run Text="{x:Static t:ToolsStrings.Units_Nm}"/>
      </TextBlock>
    </c:PropertiesGrid>

    <c:MessageBlock Margin="0 20 0 0" IsVisible="{Binding Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=0}">
      <mui:BbCodeBlock Text="Asterisk (“*”) will be added to mark values as wheels’ power and torque."/>
    </c:MessageBlock>
  </StackPanel>
</mui:ModernDialog>