<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.FindInformationDialog" Title="{Binding SelectedObject.DisplayName, Mode=OneTime}" Width="1080" Height="800" MaxWidth="{x:Static mui:DpiAwareWindow.UnlimitedSize}" MaxHeight="{x:Static mui:DpiAwareWindow.UnlimitedSize}" SizeToContent="Manual" LocationAndSizeKey="__findInformationDialog.ls" ButtonsRowContentAlignment="Stretch" MinWidth="400" MinHeight="600" CanResize="True" KeyDown="OnPreviewKeyDown">
  <mui:ModernDialog.ButtonsRowContent>
    <DockPanel>
      <Button Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" DockPanel.Dock="Right" Margin="12 0 0 0" IsVisible="{Binding SaveCommand.IsAbleToExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      <TextBlock Text="{x:Static c:ControlsStrings.FindInformation_Description}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="Small"/>
    </DockPanel>
  </mui:ModernDialog.ButtonsRowContent>
  <c:WebBlock x:Name="WebBrowser" StartPage="{Binding StartPage}" PageLoaded="OnPageLoaded" NewWindowsBehavior="MultiTab"/>
</mui:ModernDialog>