<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.TrackGeoTagsDialog" Title="{Binding Track.Name}" MaxWidth="1200" MaxHeight="900">
  <StackPanel>
    <Grid Margin="0 8 8 8" Background="Transparent">
      <Grid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Show dev tools" Click="OnShowDevToolsClick"/>
        </ContextMenu>
      </Grid.ContextMenu>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="{x:Static t:ToolsStrings.TrackGeoTags_LatitudeLabel}" Grid.Column="0" Grid.Row="0" ToolTip.Tip="{x:Static t:ToolsStrings.TrackGeoTags_LatitudeLabel_Tooltip}" Classes="Label Label.Padding"/>
      <TextBlock Text="{x:Static t:ToolsStrings.TrackGeoTags_LongitudeLabel}" Grid.Column="2" Grid.Row="0" ToolTip.Tip="{x:Static t:ToolsStrings.TrackGeoTags_LongitudeLabel_Tooltip}" Classes="Label Label.Padding"/>

      <mui:BetterTextBox Text="{Binding Latitude}" Grid.Column="1" Grid.Row="0" Mode="Number" Minimum="-90" Maximum="90" Placeholder="?" Classes="TextBoxAsTextBlock"/>
      <mui:BetterTextBox Text="{Binding Longitude}" Grid.Column="3" Grid.Row="0" Mode="Number" Minimum="-180" Maximum="180" Placeholder="?" Classes="TextBoxAsTextBlock"/>
    </Grid>

    <c:WebBlock x:Name="MapWebBrowser" Width="1080" Height="640" IsAddressBarVisible="False" NewWindowsBehavior="OpenInBrowser"/>
  </StackPanel>
</mui:ModernDialog>