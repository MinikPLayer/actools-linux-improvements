<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:sys="using:System" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.CarCreateTyresMachineDialog" Title="Tyres machine editor" SizeToContent="Manual" Width="1400" Height="800" MinWidth="1200" MinHeight="600" MaxWidth="{x:Static mui:DpiAwareWindow.UnlimitedSize}" MaxHeight="{x:Static mui:DpiAwareWindow.UnlimitedSize}" LocationAndSizeKey=".CarCreateTyresMachineDialog" x:Name="This" DoNotAttachToWaitingDialogs="True" ContentMargin="0 0 0 -42" CanResize="True">
  <mui:ModernDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/UserPresets.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/TextEditor.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <ControlTheme x:Key="OneSymbolButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="DockPanel.Dock" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter x:Name="Presenter" RecognizesAccessKey="True" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 -4 -4 0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.FontSize="{DynamicResource SmallFontSize}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>

      <c:PropertiesGrid x:Key="ResultParams" Columns="2" Rows="1">
        <mui:BetterComboBox c:PropertiesGrid.Label="Tyres name:" Text="{Binding ExampleCarsModel.TyresName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ExampleCarsModel.TyresNames}" Placeholder="{Binding ExampleCarsModel.TyresNames[0]}"/>
        <mui:BetterComboBox c:PropertiesGrid.Label="Short name:" Text="{Binding ExampleCarsModel.TyresShortName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ExampleCarsModel.TyresShortNames}" Placeholder="{Binding ExampleCarsModel.TyresShortNames[0]}"/>
      </c:PropertiesGrid>
    </ResourceDictionary>
  </mui:ModernDialog.Resources>
  <mui:ModernDialog.ButtonsRowContent>
    <ContentPresenter Content="{StaticResource ResultParams}" Width="400"/>
  </mui:ModernDialog.ButtonsRowContent>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition MinWidth="200" Width="300"/>
      <ColumnDefinition Width="9"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <DockPanel Margin="0 0 8 0">
      <c:UserPresetsControl UserPresetable="{Binding ExampleCarsModel}" ShowSaveButton="True" Margin="0 8 0 0" DockPanel.Dock="Bottom"/>

      <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8">
        <TextBlock Text="Cars display filter:" Width="120" Classes="Label"/>
        <mui:HistoricalTextBox Placeholder="*" Text="{Binding ExampleCarsModel.CarsFilter, UpdateSourceTrigger=PropertyChanged}" SaveKey="CreateTyres.CarsFilter.History" Theme="{StaticResource BetterComboBox.Borderless}">
          <mui:HistoricalTextBox.DefaultItems>
            <sys:String>kunos+</sys:String>
          </mui:HistoricalTextBox.DefaultItems>
        </mui:HistoricalTextBox>
      </DockPanel>

      <ItemsControl x:Name="TyresListBox" ItemsSource="{Binding ExampleCarsModel.CommonTyresList}" mui:FancyScroll.Outside="True" DockPanel.Dock="Top" Height="200" Margin="0 0 0 8" Theme="{StaticResource VirtualizingItemsControl}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type di:CarCreateTyresMachineDialog+CommonTyres}">
            <DockPanel Margin="2" Background="Transparent" x:Name="__Dt0">
              <DockPanel.Styles><Style Selector="DockPanel#__Dt0"><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding IncludedCount, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/></Style><Style Selector="^[(pa|T.S1)=True] TextBlock#PART_Name"><!-- PORT: removed setter of Foreground (not in Avalonia) -->
              </Style></Style></DockPanel.Styles><ToolTip.Tip>
                <TextBlock Text="{Binding DisplaySource.Value}" TextWrapping="Wrap" FontSize="{StaticResource SmallFontSize}" MaxWidth="400" DockPanel.Dock="Bottom"/>
              </ToolTip.Tip>
              <Button Content="−" Margin="4 0 8 0" Command="{Binding ExcludeAllCommand}" ToolTip.Tip="Exclude all" Theme="{StaticResource OneSymbolButton}"/>
              <Button Content="+" Margin="4 0 0 0" Command="{Binding IncludeAllCommand}" ToolTip.Tip="Include all" Theme="{StaticResource OneSymbolButton}"/>
              <TextBlock x:Name="PART_Name" TextTrimming="CharacterEllipsis" Classes="Small">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} ({1} out of {2} visible)">
                    <Binding Path="DisplayName"/>
                    <Binding Path="IncludedCount"/>
                    <Binding Path="Count"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ListBox x:Name="CarsListBox" ItemsSource="{Binding ExampleCarsModel.CarsView}" mui:ListBoxHelper.ProperMultiSelectionMode="True" mui:FancyScroll.Outside="True" Theme="{StaticResource VirtualizingListBox}">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource CheckBoxListBoxItem}">
            <Setter Property="IsSelected" Value="{Binding IsChecked, Mode=TwoWay}"/>
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type di:CarCreateTyresMachineDialog+CarWithTyres}">
            <Expander IsExpanded="{Binding IsExpanded}" Theme="{StaticResource Expander.Animated}">
              <!--<Expander.CacheMode>
                <BitmapCache RenderAtScale="{Binding BitmapCacheScale, Source={x:Static mui:AppearanceManager.Current}, Mode=OneTime}"
                    EnableClearType="{Binding BitmapCacheClearType, Source={x:Static mui:AppearanceManager.Current}, Mode=OneTime}" />
              </Expander.CacheMode>-->
              <Expander.Header>
                <DockPanel>
                  <c:CarIcon DecodeWidth="16" Car="{Binding Car}" Margin="0 0 8 0" Width="16" Height="16" ClearOnChange="True"/>
                  <TextBlock Text="{Binding CheckedCount}" DockPanel.Dock="Right" Margin="4 0" ToolTip.Tip="{Binding DisplayChecked}" IsVisible="{Binding CheckedCount, Converter={StaticResource MoreToVisibilityConverter}}"/>
                  <TextBlock Text="{Binding Car.DisplayName}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Tyres}" DockPanel.Dock="Bottom" Margin="0 4 0 0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type di:CarCreateTyresMachineDialog+CarTyres}">
                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0 0 8 4">
                      <TextBlock Text="{Binding Entry.DisplayName}" Classes="Label"/>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <mui:ModernTabSplitter Grid.Column="1" InitialWidth="300" SaveKey="CarCreateTyresMachineDialog"/>

    <DockPanel Grid.Column="2" Margin="8 0 0 42">
      <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="20" DockPanel.Dock="Top">
        <mui:SpacingStackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="Total tyres selected:" Width="180" Classes="Label"/>
            <mui:BetterTextBox Text="{Binding ExampleCarsModel.TotalTyresCount, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <TextBlock Text="Unique tyres selected:" Width="180" Classes="Label"/>
            <mui:BetterTextBox Text="{Binding ExampleCarsModel.UniqueTyresCount, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <mui:ValueLabel Value="{Binding ExampleCarsModel.ValuePadding, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="Padding" Width="180" Padding="0"/>
            <Slider Minimum="0" Maximum="0.5" Value="{Binding ExampleCarsModel.ValuePadding, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}" TickFrequency="0.1" LargeChange="0.1" SmallChange="0.1" TickPlacement="None"/>
          </DockPanel>

          <DockPanel IsVisible="{Binding ExampleCarsModel.UniqueTyresCount, Converter={StaticResource MoreToVisibilityConverter}}">
            <TextBlock Text="Radius:" Width="180" Classes="Label"/>
            <mui:BetterTextBox Text="{Binding ExampleCarsModel.Radius.DisplayValue, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel IsVisible="{Binding ExampleCarsModel.UniqueTyresCount, Converter={StaticResource MoreToVisibilityConverter}}">
            <TextBlock Text="Rim radius:" Width="180" Classes="Label"/>
            <mui:BetterTextBox Text="{Binding ExampleCarsModel.RimRadius.DisplayValue, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel IsVisible="{Binding ExampleCarsModel.UniqueTyresCount, Converter={StaticResource MoreToVisibilityConverter}}">
            <TextBlock Text="Width:" Width="180" Classes="Label"/>
            <mui:BetterTextBox Text="{Binding ExampleCarsModel.Width.DisplayValue, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>
          </DockPanel>
        </mui:SpacingStackPanel>

        <mui:SpacingStackPanel Spacing="8">
          <CheckBox IsChecked="{Binding TrainingModel.SeparateNetworks}">
            <Label Content="Use a separate network for each value"/>
          </CheckBox>

          <DockPanel>
            <TextBlock Text="Neurons in hidden layers:" Width="180" Classes="Label"/>
            <mui:BetterTextBox Text="{Binding TrainingModel.Layers}" Placeholder="{x:Static di:CarCreateTyresMachineDialog.DefaultNeuralLayers}"/>
          </DockPanel>

          <DockPanel IsVisible="{Binding TrainingModel.FannAlgorithm.IntValue, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='≠2'}">
            <mui:ValueLabel Value="{Binding TrainingModel.LearningRate, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="Learning rate" Width="180" Padding="0"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding TrainingModel.LearningRate, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}" TickFrequency="0.1" LargeChange="0.1" SmallChange="0.1" TickPlacement="None"/>
          </DockPanel>

          <DockPanel>
            <mui:ValueLabel Value="{Binding TrainingModel.TrainingRuns}" mui:BetterTextBox.Mode="Integer" Content="Training runs" Width="180" Padding="0" Postfix="{Binding TrainingModel.TrainingRuns, Converter={StaticResource PluralizingConverter}, ConverterParameter=' run'}"/>
            <Slider Minimum="0" Maximum="1" TickFrequency="0.2" LargeChange="0.2" SmallChange="0.2" TickPlacement="None">
              <Slider.Value>
                <Binding Path="TrainingModel.TrainingRuns">
                  <Binding.Converter>
                    <mui:LogarithmicScale Minimum="10000" Middle="300000" Maximum="1000000" RoundTo="10000"/>
                  </Binding.Converter>
                </Binding>
              </Slider.Value>
            </Slider>
          </DockPanel>

          <DockPanel>
            <mui:ValueLabel Value="{Binding TrainingModel.AverageAmount}" mui:BetterTextBox.Mode="Integer" Content="Average between" Width="180" Padding="0" Postfix="{Binding TrainingModel.AverageAmount, Converter={StaticResource PluralizingConverter}, ConverterParameter=' network'}"/>
            <Slider Minimum="1" Maximum="5" Value="{Binding TrainingModel.AverageAmount}" TickFrequency="1" LargeChange="1" SmallChange="1" TickPlacement="None"/>
          </DockPanel>

          <!--<c:UserPresetsControl UserPresetable="{Binding}" ShowSaveButton="True" Style="{StaticResource UserPresetsControl.Compact.Share}"
              Width="{x:Static sys:Double.NaN}" Tag="{Binding ShareCommand}" />-->
          <c:UserPresetsControl UserPresetable="{Binding TrainingModel}" ShowSaveButton="True"/>
        </mui:SpacingStackPanel>

        <mui:SpacingStackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="FANN algorithm:" Classes="Label"/>
            <mui:BetterComboBox ItemsSource="{Binding Source={x:Static di:CarCreateTyresMachineDialog.FannAlgorithms}}" SelectedItem="{Binding TrainingModel.FannAlgorithm}" Width="120" IsEditable="False">
              <mui:BetterComboBox.ItemTemplate>
                <DataTemplate DataType="t:SettingEntry">
                  <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Tag}"/>
                </DataTemplate>
              </mui:BetterComboBox.ItemTemplate>
            </mui:BetterComboBox>
          </DockPanel>

          <CheckBox IsChecked="{Binding TrainingModel.HighPrecision}">
            <Label Content="High precision"/>
          </CheckBox>

          <DockPanel IsVisible="{Binding TrainingModel.FannAlgorithm.Value, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='0'}">
            <mui:ValueLabel Value="{Binding TrainingModel.LearningMomentum, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="Learning momentum" Width="180" Padding="0"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding TrainingModel.LearningMomentum, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}" TickFrequency="0.1" LargeChange="0.1" SmallChange="0.1" TickPlacement="None"/>
          </DockPanel>

          <DockPanel>
            <mui:ValueLabel Value="{Binding TrainingModel.RandomBounds, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="Random bounds" Width="180" Padding="0"/>
            <Slider Minimum="0.1" Maximum="1" Value="{Binding TrainingModel.RandomBounds, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}" TickFrequency="0.1" LargeChange="0.1" SmallChange="0.1" TickPlacement="None"/>
          </DockPanel>
        </mui:SpacingStackPanel>
      </mui:SpacingUniformGrid>

      <DockPanel DockPanel.Dock="Top" Margin="0 20">
        <CheckBox IsChecked="{Binding ExampleCarsModel.TestSingleKey}" IsVisible="{Binding TrainingModel.SeparateNetworks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Label Content="Train only:"/>
        </CheckBox>

        <mui:BetterComboBox ItemsSource="{Binding ExampleCarsModel.TestKeysView}" SelectedItem="{Binding ExampleCarsModel.SelectedTestKey}" Width="120" IsEditable="False" Margin="8 0" IsEnabled="{Binding ExampleCarsModel.TestSingleKey}" IsVisible="{Binding TrainingModel.SeparateNetworks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <mui:BetterComboBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate DataType="GroupItem">
                  <TextBlock x:Name="PART_Name" Text="{Binding Name}" Foreground="{DynamicResource WindowText}" Margin="0 4" Classes="Label"><TextBlock.Styles><Style Selector="TextBlock#PART_Name"><Style Selector="^"><Setter Property="pa:T.S2" Value="{Binding Name, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S2)=True] TextBlock#PART_Name"><Setter Property="IsVisible" Value="False"/>
                    </Style></Style></TextBlock.Styles></TextBlock>
                  </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </mui:BetterComboBox.GroupStyle>
          <mui:BetterComboBox.ItemTemplate>
            <DataTemplate DataType="t:SettingEntry">
              <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Value}"/>
            </DataTemplate>
          </mui:BetterComboBox.ItemTemplate>
        </mui:BetterComboBox>

        <mui:AsyncButton Command="{Binding CreateTyresMachineCommand}">
          <DockPanel>
            <Path Stretch="Uniform" Margin="0 0 6 -1" VerticalAlignment="Center" Width="12" Height="12" Fill="{Binding Path=(TextBlock.Foreground), RelativeSource={RelativeSource Self}}" Data="M413.696,182.272h-21.504v-68.096c-0.512-8.192-7.168-14.848-15.36-15.36H229.888V4.608h-30.72v94.208H52.224    c-8.192,0.512-14.848,7.168-15.36,15.36v68.096H15.36c-8.704,0-15.36,6.656-15.36,15.36v101.376c0,8.704,6.656,15.36,15.36,15.36    h21.504v94.72c0.512,8.192,7.168,14.848,15.36,15.36h324.608c8.192-0.512,14.848-7.168,15.36-15.36v-94.72h21.504    c8.704,0,15.36-6.656,15.36-15.36V197.632C429.056,188.928,422.4,182.272,413.696,182.272z M100.352,218.624    c0-24.576,19.968-44.544,44.544-44.544s44.544,19.968,44.544,44.544s-19.968,44.544-44.544,44.544S100.352,243.2,100.352,218.624z     M282.112,352.256H146.944v-30.72h135.168V352.256z M328.704,218.624c0,24.576-19.968,44.544-44.544,44.544    c-25.088,0-45.056-19.968-45.568-44.544c0-25.088,19.968-45.056,44.544-45.568c24.576-0.512,45.056,19.968,45.568,44.544    C328.704,218.112,328.704,218.112,328.704,218.624z"/>
            <TextBlock Text="Create new Tyres Machine"/>
          </DockPanel>
        </mui:AsyncButton>
      </DockPanel>

      <mui:ReferenceSwitch Value="{Binding GeneratedMachine}" IsVisible="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
        <DockPanel>
          <ae:TextEditor c:AvalonExtension.Text="{Binding GeneratedTyresData}" c:AvalonExtension.Mode="Ini" DockPanel.Dock="Right" Margin="20 0 0 0" Width="250" IsReadOnly="True" FontSize="{DynamicResource SmallFontSize}" WordWrap="False"/>

          <ListBox ItemsSource="{Binding OutputKeysView}" Width="200" SelectedItem="{Binding SelectedOutputKey}" DockPanel.Dock="Left" Margin="0 0 20 0" Theme="{StaticResource VirtualizingListBox}">
            <!-- PORT: removed ListBox.GroupStyle (no grouping in Avalonia lists) -->
            <ListBox.ItemTemplate>
              <DataTemplate DataType="t:SettingEntry">
                <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Value}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <mui:SpacingStackPanel Spacing="4" Margin="0 20 0 0" DockPanel.Dock="Bottom">
            <DockPanel>
              <RadioButton Width="20" Margin="0 -2 0 2" IsChecked="{Binding GraphWidth, Converter={StaticResource InvertBooleanConverter}}"/>
              <mui:ValueLabel Value="{Binding DisplayTestWidth}" mui:BetterTextBox.Mode="Number" Postfix=" cm" Content="Width" Width="200" Padding="0"/>
              <Slider Minimum="0" Maximum="1" Value="{Binding TestWidth}" TickPlacement="None"/>
            </DockPanel>
            <DockPanel>
              <RadioButton Width="20" Margin="0 -2 0 2" IsChecked="{Binding GraphWidth}"/>
              <mui:ValueLabel Value="{Binding DisplayTestRadius}" mui:BetterTextBox.Mode="Number" Postfix=" cm" Content="Radius" Width="200" Padding="0"/>
              <Slider Minimum="0" Maximum="1" Value="{Binding TestRadius}" TickPlacement="None"/>
            </DockPanel>
            <DockPanel Margin="20 0 0 0">
              <mui:ValueLabel Value="{Binding DisplayTestProfile}" mui:BetterTextBox.Mode="Number" Postfix=" cm" Content="Profile" Width="200" Padding="0"/>
              <Slider Minimum="0" Maximum="1" Value="{Binding TestProfile}" TickPlacement="None"/>
            </DockPanel>
          </mui:SpacingStackPanel>

          <di:TyresMachineGraphViewer Data="{Binding SelectedOutputData}" GraphWidth="{Binding GraphWidth}" ValueTitle="{Binding SelectedOutputKey.DisplayName}" ValueUnits="{Binding SelectedOutputUnits}" ValueTitleDigits="{Binding SelectedOutputTitleDigits}" ValueTrackerDigits="{Binding SelectedOutputTrackerDigits}"/>
        </DockPanel>
      </mui:ReferenceSwitch>
    </DockPanel>
  </Grid>
</mui:ModernDialog>