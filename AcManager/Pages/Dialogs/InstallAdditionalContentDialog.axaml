<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:g="clr-namespace:AcManager" xmlns:uc="clr-namespace:AcManager.UserControls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.InstallAdditionalContentDialog" Title="{x:Static g:AppStrings.AdditionalContent_Title}" MinWidth="200" MinHeight="320" Width="540" Height="480" MaxWidth="{x:Static mui:DpiAwareWindow.UnlimitedSize}" MaxHeight="{x:Static mui:DpiAwareWindow.UnlimitedSize}" SizeToContent="Manual" LocationAndSizeKey="installAdditionalContent" ShowInTaskbar="True" ButtonsRowContentAlignment="Stretch" Closed="OnClosed" KeyDown="OnKeyDown" x:Name="This" Padding="0 20" CanResize="True" DragDrop.AllowDrop="True" DragDrop.Drop="OnDrop" DragDrop.DragEnter="OnDragEnter">
  <mui:ModernDialog.ButtonsRowContent>
    <TextBlock Text="{x:Static g:AppStrings.Dialogs_InstallAdditionalContentDialog_Hint}" TextWrapping="Wrap" MaxWidth="200" HorizontalAlignment="Left" Classes="Small"/>
  </mui:ModernDialog.ButtonsRowContent>
  <uc:InstallAdditionalContentList/>
</mui:ModernDialog>