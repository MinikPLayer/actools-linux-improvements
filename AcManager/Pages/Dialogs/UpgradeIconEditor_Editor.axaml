<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:at="clr-namespace:AcTools;assembly=AcTools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.UpgradeIconEditor_Editor" x:Name="ThisControl">
  <UserControl.Resources>
    <ResourceDictionary>
      <swi:RoutedCommand x:Key="ToggleBold"/>
      <swi:RoutedCommand x:Key="ToggleItalic"/>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- PORT: removed UserControl.CommandBindings -->
  <!-- PORT: removed UserControl.InputBindings -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50*"/>
      <ColumnDefinition Width="50*"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{x:Static g:AppStrings.UpgradeIcon_Current}" Grid.Row="0" Grid.Column="0" Classes="Heading2"/>
    <TextBlock Text="{x:Static g:AppStrings.UpgradeIcon_New}" Grid.Row="0" Grid.Column="1" Classes="Heading2"/>
    <mui:BetterImage Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Filename="{Binding Car.UpgradeIcon}" Width="{Binding Source={x:Static at:CommonAcConsts.UpgradeIconWidth}}" Height="{Binding Source={x:Static at:CommonAcConsts.UpgradeIconHeight}}" Grid.Row="1" Grid.Column="0" Background="{DynamicResource CarIconBackground}" Effect="{DynamicResource CarIconEffect}"/>
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid Width="{Binding Source={x:Static at:CommonAcConsts.UpgradeIconWidth}}" Height="{Binding Source={x:Static at:CommonAcConsts.UpgradeIconHeight}}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="{DynamicResource CarIconBackground}" Effect="{DynamicResource CarIconEffect}">
        <Grid x:Name="NewIcon">
          <Image Source="/Assets/Img/Upgrade.png" Width="{Binding Source={x:Static at:CommonAcConsts.UpgradeIconWidth}}" Height="{Binding Source={x:Static at:CommonAcConsts.UpgradeIconHeight}}" RenderOptions.BitmapInterpolationMode="LowQuality"/>
          <TextBox x:Name="NewIconLabel" Foreground="White" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" TextAlignment="Center" FontSize="15" FontFamily="Consolas" FontWeight="Bold" Margin="7 33 8 0" TextChanged="NewIconLabel_OnTextChanged"/>
        </Grid>
      </Grid>
    </Grid>
    <TextBlock Text="{x:Static g:AppStrings.UpgradeIcon_Commentary}" MinWidth="200" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0" Classes="Small"/>
  </Grid>
</UserControl>