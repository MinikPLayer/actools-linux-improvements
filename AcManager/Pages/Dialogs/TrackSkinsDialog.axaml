<mui:ModernWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.TrackSkinsDialog" MinWidth="600" Width="800" Height="720" DoNotAttachToWaitingDialogs="True" MaxWidth="{x:Static mui:DpiAwareWindow.UnlimitedSize}" MaxHeight="{x:Static mui:DpiAwareWindow.UnlimitedSize}" SizeToContent="Manual" IsTitleVisible="True" Initialized="OnInitialized" Closed="OnClosed" LocationAndSizeKey="TrackSkinsDialog.LS" Title="{Binding SelectedTrack.DisplayNameWithoutCount, StringFormat={x:Static g:AppStrings.Dialog_CarSkinsFormat}}" SaveKey="TrackSkinsDialog" CanResize="True"/>