<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:di="clr-namespace:AcManager.Pages.Dialogs" xmlns:c="http://acstuff.club/app/controls" xmlns:g="clr-namespace:AcManager" xmlns:sys="using:System" xmlns:t="http://acstuff.club/app/tools" xmlns:ty="clr-namespace:AcManager.Tools.Helpers.Tyres;assembly=AcManager.Tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Dialogs.CarReplaceTyresDialog" Title="Found tyres" SizeToContent="Manual" Width="920" Height="800" MinWidth="800" MinHeight="240" MaxWidth="{x:Static mui:DpiAwareWindow.UnlimitedSize}" MaxHeight="{x:Static mui:DpiAwareWindow.UnlimitedSize}" LocationAndSizeKey=".carReplaceTyresDialog" x:Name="This" DoNotAttachToWaitingDialogs="True" ContentMargin="0 -42 0 0" CanResize="True">
  <mui:ModernDialog.Styles><Style Selector="Border.TyresCell">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonText}"/>
        <Setter Property="mui:Draggable.Destination" Value="{x:Static ty:TyresEntry.DraggableFormat}"/>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderHover}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonTextHover}"/>
          </Style><Style Selector="^[(Button.IsPressed)=True]"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderPressed}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonTextPressed}"/>
          </Style></Style>

      </mui:ModernDialog.Styles><mui:ModernDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/Plugins.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="TyresSetDataTemplate" DataType="{x:Type ty:TyresSet}">
        <Border Height="120" Padding="8 4" TextElement.FontWeight="Normal">
          <Border.ContextMenu>
            <mui:InheritingContextMenu>
              <!--<MenuItem Header="{x:Static g:AppStrings.Toolbar_Clone}" Command="{Binding CloneCommand}" />-->
              <MenuItem Header="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding DeleteCommand}"/>
            </mui:InheritingContextMenu>
          </Border.ContextMenu>

          <mui:Cell>
            <mui:BooleanSwitch HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" ZIndex="10">
              <mui:BooleanSwitch.Value>
                <MultiBinding Converter="{StaticResource OrConverter}">
                  <Binding Path="DifferentTyres"/>
                  <Binding Path="Dublicate"/>
                </MultiBinding>
              </mui:BooleanSwitch.Value>
              <mui:SpacingStackPanel Background="{DynamicResource DarkStripeBackground}" TextElement.Foreground="{DynamicResource DarkStripeText}">
                <DockPanel Background="Transparent" Margin="4 2" IsVisible="{Binding DifferentTyres, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ToolTip.Tip>Different tyres might cause car to drive badly and unexpectedly</ToolTip.Tip>
                  <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Error}" Stretch="Uniform" Margin="2 2 4 0" VerticalAlignment="Center"/>
                  <TextBlock Text="Different tyres" FontSize="10"/>
                </DockPanel>
                <DockPanel Background="Transparent" Margin="4 2" IsVisible="{Binding Dublicate, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ToolTip.Tip>This set is exact copy of some previous one, it won’t be saved</ToolTip.Tip>
                  <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Error}" Stretch="Uniform" Margin="2 2 4 0" VerticalAlignment="Center"/>
                  <TextBlock Text="Dublicate" FontSize="10"/>
                </DockPanel>
              </mui:SpacingStackPanel>
            </mui:BooleanSwitch>

            <DockPanel VerticalAlignment="Center">
              <!-- Position (draggable set) -->
              <DockPanel DockPanel.Dock="Left" Margin="0 0 8 0" Background="Transparent">
                <RadioButton DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0 0 4 0" IsChecked="{Binding DefaultSet}" ToolTip.Tip="Default set"/>
                <!-- <Path VerticalAlignment="Center" DockPanel.Dock="Left" Height="8" Width="6" Margin="0 0 4 0" Stretch="Uniform"
                       Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}"
                       Data="F1 M 28.5,23L 36.5,23L 36.5,31L 28.5,31L 28.5,23 Z M 28.5,34L 36.5,34L 36.5,42L 28.5,42L 28.5,34 Z M 39.5,23L 47.5,23L 47.5,31L 39.5,31L 39.5,23 Z M 28.5,45L 36.5,45L 36.5,53L 28.5,53L 28.5,45 Z M 39.5,34L 47.5,34L 47.5,42L 39.5,42L 39.5,34 Z M 39.5,45L 47.5,45L 47.5,53L 39.5,53L 39.5,45 Z" /> -->
                <TextBlock Text="{Binding Position, StringFormat='{}#{0}'}" VerticalAlignment="Center" Classes="Heading2"/>
              </DockPanel>

              <Button DockPanel.Dock="Right" Width="13" Height="13" Margin="4 0 4 0" VerticalAlignment="Center" Padding="2" Command="{Binding DeleteCommand}" IsVisible="{Binding DeleteCommand.IsAbleToExecute, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Path Data="M0,0 L7,7 M7,0 L0,7 Z" Width="8" Height="8" HorizontalAlignment="Center" StrokeThickness="1" Stroke="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/>
              </Button>
              <!-- Tyres per place (draggable tyres) -->
              <c:PropertiesGrid Columns="1" LabelWidth="60" VerticalSpacing="4">
                <Border c:PropertiesGrid.Label="Front:" mui:Draggable.Data="{Binding Front}" DragDrop.AllowDrop="True" DragDrop.Drop="OnFrontSlotDrop" PointerPressed="OnFrontSlotMouseDown" Classes="TyresCell">
                  <mui:Cell>
                    <DockPanel Margin="8 4">
                      <Path VerticalAlignment="Center" DockPanel.Dock="Left" Height="8" Width="6" Margin="0 2 4 -2" Stretch="Uniform" Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M 28.5,23L 36.5,23L 36.5,31L 28.5,31L 28.5,23 Z M 28.5,34L 36.5,34L 36.5,42L 28.5,42L 28.5,34 Z M 39.5,23L 47.5,23L 47.5,31L 39.5,31L 39.5,23 Z M 28.5,45L 36.5,45L 36.5,53L 28.5,53L 28.5,45 Z M 39.5,34L 47.5,34L 47.5,42L 39.5,42L 39.5,34 Z M 39.5,45L 47.5,45L 47.5,53L 39.5,53L 39.5,45 Z"/>
                      <TextBlock Text="{Binding Front.DisplayName}" DockPanel.Dock="Top" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Front.DisplaySource}" TextTrimming="CharacterEllipsis" Classes="Small"/>
                    </DockPanel>
                    <Border Margin="-1" BorderThickness="1" BorderBrush="Transparent" ToolTip.Tip="{Binding Front.DisplayOffsetFrontDescription}">
                      <TextBlock DataContext="{Binding Front.AppropriateLevelFront}" Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 0" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label"/>
                    </Border>
                    <Border Margin="-1" BorderThickness="1" DataContext="{Binding DataContext.MovingTyres.AppropriateLevelFront, ElementName=This}" BorderBrush="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" IsVisible="{Binding (mui:Draggable.IsDestinationHighlighted), RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 -2 6 2" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label">
                        <TextBlock.Effect>
                          <DropShadowEffect Opacity="0.4" Color="Black" BlurRadius="4" OffsetX="0" OffsetY="2"/>
                        </TextBlock.Effect>
                      </TextBlock>
                    </Border>
                  </mui:Cell>
                </Border>
                <Border c:PropertiesGrid.Label="Rear:" mui:Draggable.Data="{Binding Rear}" DragDrop.AllowDrop="True" DragDrop.Drop="OnRearSlotDrop" PointerPressed="OnRearSlotMouseDown" Classes="TyresCell">
                  <mui:Cell>
                    <DockPanel Margin="8 4">
                      <Path VerticalAlignment="Center" DockPanel.Dock="Left" Height="8" Width="6" Margin="0 2 4 -2" Stretch="Uniform" Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M 28.5,23L 36.5,23L 36.5,31L 28.5,31L 28.5,23 Z M 28.5,34L 36.5,34L 36.5,42L 28.5,42L 28.5,34 Z M 39.5,23L 47.5,23L 47.5,31L 39.5,31L 39.5,23 Z M 28.5,45L 36.5,45L 36.5,53L 28.5,53L 28.5,45 Z M 39.5,34L 47.5,34L 47.5,42L 39.5,42L 39.5,34 Z M 39.5,45L 47.5,45L 47.5,53L 39.5,53L 39.5,45 Z"/>
                      <TextBlock Text="{Binding Rear.DisplayName}" DockPanel.Dock="Top" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Rear.DisplaySource}" TextTrimming="CharacterEllipsis" Classes="Small"/>
                    </DockPanel>
                    <Border Margin="-1" BorderThickness="1" BorderBrush="Transparent" ToolTip.Tip="{Binding Rear.DisplayOffsetRearDescription}">
                      <TextBlock DataContext="{Binding Rear.AppropriateLevelRear}" Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 0" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label"/>
                    </Border>
                    <Border Margin="-1" BorderThickness="1" DataContext="{Binding DataContext.MovingTyres.AppropriateLevelRear, ElementName=This}" BorderBrush="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" IsVisible="{Binding (mui:Draggable.IsDestinationHighlighted), RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 -2 6 2" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label">
                        <TextBlock.Effect>
                          <DropShadowEffect Opacity="0.4" Color="Black" BlurRadius="4" OffsetX="0" OffsetY="2"/>
                        </TextBlock.Effect>
                      </TextBlock>
                    </Border>
                  </mui:Cell>
                </Border>
              </c:PropertiesGrid>
            </DockPanel>
          </mui:Cell>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="TyresSetGeneratedDataTemplate" DataType="{x:Type ty:TyresSet}">
        <Border Height="120" Padding="8 4" TextElement.FontWeight="Normal">

          <!-- Tyres per place (draggable tyres) -->
          <c:PropertiesGrid Columns="1" LabelWidth="60" VerticalSpacing="4" VerticalAlignment="Center">
            <Border c:PropertiesGrid.Label="Front:" mui:Draggable.Data="{Binding Front}" PointerPressed="OnFrontSlotMouseDown" Classes="TyresCell">
              <mui:Cell>
                <DockPanel Margin="8 4">
                  <Path VerticalAlignment="Center" DockPanel.Dock="Left" Height="8" Width="6" Margin="0 2 4 -2" Stretch="Uniform" Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M 28.5,23L 36.5,23L 36.5,31L 28.5,31L 28.5,23 Z M 28.5,34L 36.5,34L 36.5,42L 28.5,42L 28.5,34 Z M 39.5,23L 47.5,23L 47.5,31L 39.5,31L 39.5,23 Z M 28.5,45L 36.5,45L 36.5,53L 28.5,53L 28.5,45 Z M 39.5,34L 47.5,34L 47.5,42L 39.5,42L 39.5,34 Z M 39.5,45L 47.5,45L 47.5,53L 39.5,53L 39.5,45 Z"/>
                  <TextBlock Text="{Binding Front.DisplayName}" DockPanel.Dock="Top" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Front.DisplaySource}" TextTrimming="CharacterEllipsis" Classes="Small"/>
                </DockPanel>
                <Border Margin="-1" BorderThickness="1" BorderBrush="Transparent" ToolTip.Tip="{Binding Front.DisplayOffsetFrontDescription}">
                  <TextBlock DataContext="{Binding Front.AppropriateLevelFront}" Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 0" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label"/>
                </Border>
                <Border Margin="-1" BorderThickness="1" DataContext="{Binding DataContext.MovingTyres.AppropriateLevelFront, ElementName=This}" BorderBrush="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" IsVisible="{Binding (mui:Draggable.IsDestinationHighlighted), RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 -2 6 2" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label">
                    <TextBlock.Effect>
                      <DropShadowEffect Opacity="0.4" Color="Black" BlurRadius="4" OffsetX="0" OffsetY="2"/>
                    </TextBlock.Effect>
                  </TextBlock>
                </Border>
              </mui:Cell>
            </Border>
            <Border c:PropertiesGrid.Label="Rear:" mui:Draggable.Data="{Binding Rear}" PointerPressed="OnRearSlotMouseDown" Classes="TyresCell">
              <mui:Cell>
                <DockPanel Margin="8 4">
                  <Path VerticalAlignment="Center" DockPanel.Dock="Left" Height="8" Width="6" Margin="0 2 4 -2" Stretch="Uniform" Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M 28.5,23L 36.5,23L 36.5,31L 28.5,31L 28.5,23 Z M 28.5,34L 36.5,34L 36.5,42L 28.5,42L 28.5,34 Z M 39.5,23L 47.5,23L 47.5,31L 39.5,31L 39.5,23 Z M 28.5,45L 36.5,45L 36.5,53L 28.5,53L 28.5,45 Z M 39.5,34L 47.5,34L 47.5,42L 39.5,42L 39.5,34 Z M 39.5,45L 47.5,45L 47.5,53L 39.5,53L 39.5,45 Z"/>
                  <TextBlock Text="{Binding Rear.DisplayName}" DockPanel.Dock="Top" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Rear.DisplaySource}" TextTrimming="CharacterEllipsis" Classes="Small"/>
                </DockPanel>
                <Border Margin="-1" BorderThickness="1" BorderBrush="Transparent" ToolTip.Tip="{Binding Rear.DisplayOffsetRearDescription}">
                  <TextBlock DataContext="{Binding Rear.AppropriateLevelRear}" Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 0" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label"/>
                </Border>
                <Border Margin="-1" BorderThickness="1" DataContext="{Binding DataContext.MovingTyres.AppropriateLevelRear, ElementName=This}" BorderBrush="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" IsVisible="{Binding (mui:Draggable.IsDestinationHighlighted), RelativeSource={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="{Binding}" Padding="4 2" Width="20" TextAlignment="Center" HorizontalAlignment="Right" Margin="4 -2 6 2" Foreground="Black" Background="{Binding Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" Classes="Label">
                    <TextBlock.Effect>
                      <DropShadowEffect Opacity="0.4" Color="Black" BlurRadius="4" OffsetX="0" OffsetY="2"/>
                    </TextBlock.Effect>
                  </TextBlock>
                </Border>
              </mui:Cell>
            </Border>
          </c:PropertiesGrid>

        </Border>
      </DataTemplate>

      <DataTemplate x:Key="TyresEntryDataTemplate" DataType="{x:Type ty:TyresEntry}">
        <Border Height="60" TextElement.FontWeight="Normal">
          <DockPanel VerticalAlignment="Center">
            <mui:SpacingStackPanel Spacing="2" VerticalAlignment="Center" DockPanel.Dock="Left" Width="32" Margin="0 0 8 0">
              <Border Padding="4 2" Background="{Binding AppropriateLevelFront, Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" ToolTip.Tip="{Binding DisplayOffsetFrontDescription}">
                <TextBlock Text="{Binding AppropriateLevelFront, StringFormat='{}F.: {0}'}" Foreground="Black" TextAlignment="Center" Classes="Label"/>
              </Border>
              <Border Padding="4 2" Background="{Binding AppropriateLevelRear, Converter={x:Static di:CarReplaceTyresDialog.AppropriateLevelToColorConverter}}" ToolTip.Tip="{Binding DisplayOffsetRearDescription}">
                <TextBlock Text="{Binding AppropriateLevelRear, StringFormat='{}R.: {0}'}" Foreground="Black" TextAlignment="Center" Classes="Label"/>
              </Border>
            </mui:SpacingStackPanel>

            <TextBlock DockPanel.Dock="Top" TextTrimming="CharacterEllipsis" Margin="0 3 0 0">
              <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold"/>
              <Run FontSize="11">from</Run>
              <Run Text="{Binding Source.DisplayName, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>

            <mui:SpacingUniformGrid HorizontalSpacing="20" Margin="20 0" Rows="1">
              <TextBlock DockPanel.Dock="Left" IsVisible="{Binding Source.Author, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small">
                <Run>Version:</Run>
                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource Error}" Background="Transparent" ToolTip.Tip="Not compatible with current version, existing entries have to be removed if used" Classes="inline1">
                  <Run.Styles>
                    <Style Selector="Run.inline1">
                      <!-- PORT: DataTrigger with element binding not converted --></Style>
                  </Run.Styles>
                </Run>
              </TextBlock>
              <TextBlock Text="{Binding DisplayPosition}" Classes="Small"/>
              <TextBlock Text="{Binding Source.Author, StringFormat='{}Made by {0}'}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Source.Author, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small"/>
            </mui:SpacingUniformGrid>
          </DockPanel>
        </Border>
      </DataTemplate>

      <mui:BooleanSwitch x:Key="ReplaceMode" Loaded="OnReplaceModeLoaded">
        <mui:BooleanSwitch.True>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="8 -1 0 8">
              <TextBlock Text="Source cars filter:" Width="120" DockPanel.Dock="Left" Classes="Label"/>
              <Button Command="{Binding ChangeCarsFilterCommand}" Content="Change" DockPanel.Dock="Right" Margin="0 -8" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CarReplaceTyresDonorFilter, Source={x:Static t:SettingsHolder.Content}}"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="8 0 0 8">
              <TextBlock Text="Unique tyres found:" Width="120" DockPanel.Dock="Left" Classes="Label"/>
              <TextBlock Text="{Binding TyresView.Count}"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="8 0 0 8">
              <TextBlock Text="{x:Static c:ControlsStrings.Common_FilterLabel}" Width="120" DockPanel.Dock="Left" Classes="Label"/>
              <mui:HistoricalTextBox Placeholder="*" Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" SaveKey="carreplacetyresdialog.filter" Theme="{StaticResource BetterComboBox.Borderless}">
                <mui:HistoricalTextBox.DefaultItems>
                  <sys:String>street</sys:String>
                  <sys:String>slicks</sys:String>
                  <sys:String>!grade:F &amp; !grade:E</sys:String>
                  <sys:String>version:7</sys:String>
                  <sys:String>slicks &amp; v:7</sys:String>
                  <sys:String>car(#race)</sys:String>
                </mui:HistoricalTextBox.DefaultItems>
              </mui:HistoricalTextBox>
            </DockPanel>
            <ListBox ItemsSource="{Binding TyresView}" mui:Draggable.Enabled="True" ItemTemplate="{StaticResource TyresEntryDataTemplate}" Theme="{StaticResource VirtualizingListBox}"/>
          </DockPanel>
        </mui:BooleanSwitch.True>
        <mui:BooleanSwitch.False>
          <mui:SpacingStackPanel Spacing="8" VerticalAlignment="Center" Margin="20 0">
            <ProgressBar Maximum="1" Value="{Binding TyresLoadingProgress.Progress, Mode=OneWay}" IsIndeterminate="{Binding TyresLoadingProgress.IsIndeterminate}" Height="4"/>
            <TextBlock Text="{Binding TyresLoadingProgress.Message}" HorizontalAlignment="Center"/>
          </mui:SpacingStackPanel>
        </mui:BooleanSwitch.False>
      </mui:BooleanSwitch>

      <DockPanel x:Key="GenerateMode" Loaded="OnGenerateModeLoaded">
        <Canvas x:Name="TestElement" DockPanel.Dock="Top" Margin="0 0 0 20" Height="240" Width="400" HorizontalAlignment="Center">
          <mui:Cell Width="400" Height="240" x:Name="RoomAnimationPiece">
            <mui:Cell.OpacityMask>
              <VisualBrush Stretch="None" TileMode="None">
                <VisualBrush.Visual>
                  <Canvas Height="240" Width="400">
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="50"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="100"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="150"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="200"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="250"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="300"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="42" Height="100" Margin="4 10" Fill="#aa000000" Canvas.Left="350"/>
                    <Rectangle RadiusX="4" RadiusY="4" Width="400" Height="120" Fill="Black" Canvas.Top="120"/>
                  </Canvas>
                </VisualBrush.Visual>
              </VisualBrush>
            </mui:Cell.OpacityMask>
            <Border Background="Black" Opacity="0.1"/>
            <Border Height="240" Width="400" ClipToBounds="True" IsHitTestVisible="False">
              <mui:Cell x:Name="BurningSet" Width="320" RenderTransformOrigin="0.5 0.5" VerticalAlignment="Top" Height="110" Margin="0" Opacity="0">
                <Border Background="Black" Margin="1"/>
                <Border Background="{DynamicResource ButtonBackground}" Opacity="0.85" Margin="1"/>
                <ContentPresenter x:Name="BurningPresenter" Content="{Binding}" ContentTemplate="{StaticResource TyresSetGeneratedDataTemplate}" mui:Draggable.Enabled="True" mui:Draggable.Data="{Binding}" Margin="0 -5"/>
                <Path x:Name="BurningFresh1" Data="M90,0 L0,90 L0,105 L105,0 z" Fill="White" Opacity="0"/>
                <Path x:Name="BurningFresh2" Data="M115,0 l-110,110 h30 l110,-110 z" Fill="White" Opacity="0"/>
                <Border x:Name="BurningBlack" Background="Black" Opacity="0" Margin="1" IsHitTestVisible="False"/>
              </mui:Cell>
            </Border>
            <Border x:Name="GeneratedMaskBorder" Height="240" Width="400">
              <Border.OpacityMask>
                <VisualBrush Stretch="None">
                  <VisualBrush.Visual>
                    <Border Width="400" Background="Transparent">
                      <Border x:Name="GeneratedMask" Width="0" Height="120" Background="Black" HorizontalAlignment="Left"/>
                    </Border>
                  </VisualBrush.Visual>
                </VisualBrush>
              </Border.OpacityMask>
              <Border Height="240" Width="400" ClipToBounds="True">
                <mui:Cell x:Name="GeneratedSet" Width="320" RenderTransformOrigin="0.5 0.5" VerticalAlignment="Top" Height="110" Margin="0">
                  <Border Background="Black" Margin="1"/>
                  <Border Background="{DynamicResource ButtonBackground}" Opacity="0.85" Margin="1"/>
                  <ContentPresenter x:Name="GeneratedPresenter" Content="{Binding}" ContentTemplate="{StaticResource TyresSetGeneratedDataTemplate}" mui:Draggable.Enabled="True" mui:Draggable.Data="{Binding}" Margin="0 -5"/>
                  <Path x:Name="GeneratedFresh1" Data="M90,0 L0,90 L0,105 L105,0 z" Fill="White" Opacity="0"/>
                  <Path x:Name="GeneratedFresh2" Data="M115,0 l-110,110 h30 l110,-110 z" Fill="White" Opacity="0"/>
                </mui:Cell>
              </Border>
            </Border>
            <Border Height="240" Width="400" IsHitTestVisible="False" ClipToBounds="True">
              <!-- PORT: removed Border.CacheMode -->
              <Canvas Height="240" Width="400" Opacity="0.2">
                <Canvas.Effect>
                  <BlurEffect Radius="4"><!-- PORT: removed KernelType (not in Avalonia) --><!-- PORT: removed RenderingBias (not in Avalonia) --></BlurEffect>
                </Canvas.Effect>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="50"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="100"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="150"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="200"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="250"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="300"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="50" Height="110" Margin="0 4" StrokeThickness="4" Stroke="Black" Canvas.Left="350"/>
                <Rectangle RadiusX="6" RadiusY="6" Width="408" Height="130" Margin="-4 0" StrokeThickness="4" Stroke="Black" Canvas.Top="114"/>
              </Canvas>
            </Border>
            <Canvas x:Name="FlamesAnimationParent" Height="240" Width="400" ClipToBounds="True" IsHitTestVisible="False"/>
          </mui:Cell>
          <mui:Cell Width="400" Height="120" x:Name="RoomGlowAnimationPiece" Margin="0 -5 0 5" IsHitTestVisible="False">
            <mui:Cell.Effect>
              <DropShadowEffect BlurRadius="50" Opacity="1" OffsetX="0" OffsetY="-0"/>
            </mui:Cell.Effect>
            <mui:Cell.OpacityMask>
              <VisualBrush Stretch="None" TileMode="Tile">
                <!-- PORT: removed Viewport (not in Avalonia) --><!-- PORT: removed ViewportUnits (not in Avalonia) --><VisualBrush.Visual>
                  <Border CornerRadius="4" Width="42" Height="100" Margin="4 10" Background="Black"/>
                </VisualBrush.Visual>
              </VisualBrush>
            </mui:Cell.OpacityMask>
            <Border x:Name="ScanAnimationPiece" HorizontalAlignment="Left" Margin="-4 0" Width="8"/>
          </mui:Cell>
        </Canvas>

        <TextBlock Text="Trained machines:" DockPanel.Dock="Top" Margin="0 0 0 4" Classes="Label Label.Padding"/>
        <ListBox mui:Draggable.Enabled="True" SelectionChanged="SelectedMachineChanged" Theme="{StaticResource VirtualizingListBox}">
          <ListBox.ItemTemplate>
            <c:FlexibleDataTemplateSelector>
              <c:FlexibleDataTemplateSelector.DataTemplate>
                <DataTemplate DataType="{x:Type di:CarReplaceTyresDialog+TyresMachinePresetInfo}">
                  <Border Padding="8 4" x:Name="PART_Panel">
                    <Border.Styles><Style Selector="Border#PART_Panel"><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding IsAppropriate, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S1" Value="{Binding IsWidthAppropriate, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S2" Value="{Binding IsProfileAppropriate, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S3" Value="{Binding IsRadiusAppropriate, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S0)=True] Border#PART_Panel"><Setter Property="TextElement.Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
                    </Style><Style Selector="^[(pa|T.S1)=True] mui|BbCodeBlock#PART_Width"><Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                    </Style><Style Selector="^[(pa|T.S2)=True] mui|BbCodeBlock#PART_Profile"><Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                    </Style><Style Selector="^[(pa|T.S3)=True] mui|BbCodeBlock#PART_Radius"><Setter Property="TextBlock.TextDecorations" Value="Strikethrough"/>
                    </Style></Style></Border.Styles><DockPanel>
                      <ContentPresenter Width="32" Height="32" Margin="0 0 20 0" Content="{Binding Icon}"/>
                      <mui:SpacingUniformGrid Rows="1" Margin="0 4 0 0" DockPanel.Dock="Bottom" IsVisible="{Binding Description.Value, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='inverse hidden'}">
                        <mui:BbCodeBlock x:Name="PART_Width" Text="{Binding WidthRange, StringFormat='Width: {0}'}" Classes="Small"/>
                        <!--<mui:BbCodeBlock x:Name="PART_RimRadius" BbCode="{Binding RimRadiusRange, StringFormat='Rims: {0}'}" Style="{StaticResource Small}" />-->
                        <mui:BbCodeBlock x:Name="PART_Profile" Text="{Binding ProfileRange, StringFormat='Profile: {0}'}" Classes="Small"/>
                        <mui:BbCodeBlock x:Name="PART_Radius" Text="{Binding RadiusRange, StringFormat='Radius: {0}'}" Classes="Small"/>
                      </mui:SpacingUniformGrid>
                      <mui:PlaceholderTextBlock Text="{Binding Description.Value}" Margin="8 1 4 -1" Placeholder="Loading details…" DockPanel.Dock="Right" Classes="Label"/>
                      <TextBlock Text="{Binding Preset.DisplayName}" DockPanel.Dock="Top" Classes="Heading2"/>
                    </DockPanel>
                  </Border>
                  </DataTemplate>
              </c:FlexibleDataTemplateSelector.DataTemplate>
            </c:FlexibleDataTemplateSelector>
          </ListBox.ItemTemplate>
          <!--<ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel ScrollUnit="Pixel" IsVirtualizing="True" VirtualizationMode="Recycling" Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>-->
          <ItemsControl.Resources>
            <!-- PORT: removed CollectionViewSource -->
          </ItemsControl.Resources>
          <ItemsControl.Items>
            <!-- PORT: removed CollectionContainer -->

              <mui:SpacingStackPanel Spacing="4" Margin="0 20 0 0" DataContext="{x:Static di:CarReplaceTyresDialog.Plugins}">
                <StackPanel IsVisible="{Binding IsReady, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                  <mui:Switch Value="{Binding ListView.Count}">
                    <TextBlock mui:Switch.When="0" Text="FANN plugin is required to generate tyres." Foreground="{DynamicResource Error}" TextWrapping="Wrap" Classes="Label"/>
                    <mui:SpacingStackPanel Spacing="4">
                      <TextBlock Text="Plugin is required to generate tyres:" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Classes="Label"/>
                      <ItemsControl ItemsSource="{Binding .ListView}" ItemTemplate="{StaticResource PluginItemTemplate.NoOptions}" Margin="0 0 0 -12"/>
                    </mui:SpacingStackPanel>
                  </mui:Switch>
                </StackPanel>
                <Button Click="OnNewTyresMachineButtonClick" IsEnabled="{Binding IsReady}">
                  <DockPanel>
                    <Path Data="{StaticResource AddIconData}" Stretch="Fill" Width="10" Height="10" HorizontalAlignment="Center" Margin="0 1 4 -1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    <TextBlock Text="Create new" VerticalAlignment="Center"/>
                  </DockPanel>
                </Button>
              </mui:SpacingStackPanel>

            </ItemsControl.Items>
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource FlatListBoxItem}">
              <Style Selector="^"><Setter Property="pa:T.S4" Value="{Binding Preset.DisplayName, FallbackValue=-1, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=-1}"/></Style><Style Selector="^[(pa|T.S4)=True]"><Setter Property="Background" Value="Transparent"/>
                  <Setter Property="FontWeight" Value="Normal"/>
                </Style></ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>

        <!--<ListBox ItemsSource="{Binding TyresView}" Style="{StaticResource VirtualizingListBox}" mui:Draggable.Enabled="True"
          ItemTemplate="{StaticResource TyresEntryDataTemplate}" />-->
      </DockPanel>
    </ResourceDictionary>
  </mui:ModernDialog.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition MinWidth="200" Width="400"/>
      <ColumnDefinition Width="9"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <DockPanel Margin="0 42 8 0">
      <DockPanel DockPanel.Dock="Top" Margin="0 0 0 20">
        <mui:BetterImage Width="24" Height="24" DockPanel.Dock="Left" Margin="0 0 8 0" Filename="{Binding Car.BrandBadge}"/>
        <TextBlock Text="{Binding Car.DisplayName}" VerticalAlignment="Center" Classes="Heading2"/>
      </DockPanel>

      <c:PropertiesGrid Columns="1" LabelWidth="120" VerticalSpacing="4" LabelPadding="8 0 0 0" DockPanel.Dock="Top">
        <TextBlock c:PropertiesGrid.Label="Current version:" Text="{Binding SetsVersion}" TextTrimming="CharacterEllipsis"/>
        <TextBlock c:PropertiesGrid.Label="Front tyres:" Text="{Binding OriginalTyresFront.DisplayParams}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OriginalTyresFront.DisplayParamsExtra}"/>
        <TextBlock c:PropertiesGrid.Label="Rear tyres:" Text="{Binding OriginalTyresRear.DisplayParams}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OriginalTyresRear.DisplayParamsExtra}"/>
      </c:PropertiesGrid>

      <TextBlock Text="Existing sets:" DockPanel.Dock="Top" Margin="0 4 0 4" Classes="Label Label.Padding"/>

      <ListBox ItemsSource="{Binding Sets}" mui:Draggable.Enabled="True" mui:Draggable.DestinationConverter="{Binding}" ItemTemplate="{StaticResource TyresSetDataTemplate}" ItemContainerTheme="{StaticResource RibbonListBoxItem.Left}" Theme="{StaticResource VirtualizingListBox}"/>
    </DockPanel>

    <Border Grid.Column="0" Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom" Padding="20 8" Margin="20" HorizontalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{DynamicResource DarkStripeText}" IsVisible="{Binding MovingTyres, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
      <TextBlock Text="Hold Shift to swap tyres" TextAlignment="Center" Classes="Small"/>
    </Border>

    <mui:ModernTabSplitter Grid.Column="1" Margin="0 42 0 0" InitialWidth="400" SaveKey="CarReplaceTyresDialog"/>

    <mui:ModernTab mui:ModernFrame.KeepContentAlive="True" SaveKey=".CarReplayTyres.Mode" LinksMargin="8 0 0 20" LinksHorizontalAlignment="Stretch" Grid.Column="2" Margin="8 0 0 0">
      <mui:ModernTab.LinksListBoxTemplate>
        <ControlTemplate>
          <ItemsPresenter HorizontalAlignment="Left"/>
        </ControlTemplate>
      </mui:ModernTab.LinksListBoxTemplate>
      <mui:ModernTab.Links>
        <mui:Link DisplayName="Find fitting tyres" Key="ReplaceMode"/>
        <mui:Link DisplayName="Generate new ones" Key="GenerateMode"/>
      </mui:ModernTab.Links>
      <mui:ModernTab.ContentLoader>
        <mui:DirectContentLoader>
          <mui:DirectContentLoaderEntry Key="ReplaceMode" Content="{StaticResource ReplaceMode}"/>
          <mui:DirectContentLoaderEntry Key="GenerateMode" Content="{StaticResource GenerateMode}"/>
        </mui:DirectContentLoader>
      </mui:ModernTab.ContentLoader>
    </mui:ModernTab>
  </Grid>
</mui:ModernDialog>