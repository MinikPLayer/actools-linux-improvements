<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:miscellaneous="clr-namespace:AcManager.Pages.Miscellaneous" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Miscellaneous.LapTimes_Sources" Margin="{StaticResource ContentMarginWithPadding}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>

  <ItemsControl Margin="{StaticResource ContentMarginWithPadding}" x:Name="List">
    <ItemsControl.Template>
      <ControlTemplate TargetType="ItemsControl">
        <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </ScrollViewer>
      </ControlTemplate>
    </ItemsControl.Template>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="t:LapTimesSource">
        <Border Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Padding="20" Margin="20">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0 12 0 0">
              <ItemsControl ItemsSource="{Binding ExtraTools}" Margin="4 0 0 0" DockPanel.Dock="Right" IsVisible="{Binding ExtraTools.Count, Converter={StaticResource MoreToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="4"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding DisplayName}" Command="{Binding Command}" ToolTip.Tip="{Binding Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="{x:Static c:ControlsStrings.CustomShowroom_Export}" Command="{Binding ExportCommand}" ToolTip.Tip="Export lap times from other enabled sources"/>
            </DockPanel>

            <mui:SpacingStackPanel Spacing="4" Height="160">
              <!-- Name -->
              <mui:ReferenceSwitch Value="{Binding DetailsUrl}" Height="32">
                <mui:ReferenceSwitch.Null>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Bottom" Classes="Heading2"/>
                </mui:ReferenceSwitch.Null>
                <mui:ReferenceSwitch.NonNull>
                  <DockPanel>
                    <TextBlock Text="{Binding DisplayName}" Classes="Heading2"/>
                    <Button CommandParameter="{Binding DetailsUrl}" Theme="{StaticResource MoreDetailsSuperscript}"/>
                  </DockPanel>
                </mui:ReferenceSwitch.NonNull>
              </mui:ReferenceSwitch>

              <!-- Description -->
              <mui:BbCodeBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="Small"/>

              <CheckBox IsChecked="{Binding IsEnabled}" Margin="0 12 0 0">
                <Label>Enabled</Label>
              </CheckBox>

              <mui:SpacingStackPanel Spacing="4" IsVisible="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <CheckBox IsChecked="{Binding AutoAddEntries}" IsEnabled="{Binding ReaderBased}" IsVisible="{Binding AutoAddAllowed, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Label>Add new lap times automatically</Label>
                </CheckBox>

                <!-- Loading -->
                <Border Height="12" Margin="0 12 0 0" IsVisible="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Center" Width="200"/>
                </Border>

                <!-- Amount of entries -->
                <TextBlock TextWrapping="Wrap" Height="12" Margin="0 12 0 0" Text="{Binding EntriesCount, Converter={StaticResource PluralizingConverter}, ConverterParameter='{}{0} entry', TargetNullValue='Loading…'}" IsVisible="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small"/>

                <!-- Last modified -->
                <TextBlock TextWrapping="Wrap" Height="12" Text="{Binding LastModified, StringFormat='Last modified: {0}', TargetNullValue=''}" IsVisible="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small"/>
              </mui:SpacingStackPanel>
            </mui:SpacingStackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel ItemWidth="320" ItemHeight="300"/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</UserControl>