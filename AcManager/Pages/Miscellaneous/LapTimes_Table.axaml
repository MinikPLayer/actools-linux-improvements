<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mi="clr-namespace:AcManager.Pages.Miscellaneous" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Miscellaneous.LapTimes_Table">
  <UserControl.Styles><Style Selector="DataGridCell.NumberCellStyle">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <Style Selector="DataGridCell.SmallNumberCellStyle">
        <Setter Property="TextElement.FontSize" Value="{DynamicResource SmallFontSize}"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <Style Selector="DataGridCell.SmallCellStyle">
        <Setter Property="TextElement.FontSize" Value="{DynamicResource SmallFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <Style Selector="DataGridRow.RowStyle">
        <Setter Property="ContextMenu" Value="{StaticResource BestLapWrappedContextMenu}"/>
      </Style>
    </UserControl.Styles><UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/LapTimesSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      </ResourceDictionary>
  </UserControl.Resources>

  <!-- Not very good, but at least LapTimeWrapped are known -->
  <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
  <DataGrid x:Name="Grid" Margin="{StaticResource ContentMarginWithPadding}" ItemsSource="{Binding View}" IsReadOnly="True" Sorting="OnGridSorting" Theme="{StaticResource DataGrid.Lite}">
    <!-- PORT: removed RowStyle (not in Avalonia) --><DataGrid.Columns>
      <DataGridTemplateColumn Width="1.5*" Header="{x:Static c:ControlsStrings.TableHeader_Car}" SortMemberPath="Car.DisplayName">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate DataType="{x:Type t:LapTimeWrapped}">
            <StackPanel Orientation="Horizontal" x:Name="__Dt0">
              <StackPanel.Styles><Style Selector="StackPanel#__Dt0"><Style Selector="^ TextBlock#Text"><!-- PORT: removed setter of Text (not in Avalonia) --></Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding Car, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S1)=True] mui|BetterImage#BrandBadge"><Setter Property="IsVisible" Value="False"/>
                </Style><Style Selector="^[(pa|T.S1)=True] TextBlock#Text"><!-- PORT: removed setter of Text (not in Avalonia) -->
              </Style></Style></StackPanel.Styles><mui:BetterImage x:Name="BrandBadge" Filename="{Binding Car.BrandBadge}" Width="24" Height="24" Margin="0 0 12 0" ClearOnChange="True"/>
              <TextBlock x:Name="Text" VerticalAlignment="Center"/>
            </StackPanel>
            </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <DataGridTemplateColumn Width="1.5*" Header="{x:Static c:ControlsStrings.TableHeader_Track}" SortMemberPath="Track.DisplayName">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate DataType="{x:Type t:LapTimeWrapped}">
            <StackPanel Orientation="Horizontal" x:Name="__Dt2">
              <StackPanel.Styles><Style Selector="StackPanel#__Dt2"><Style Selector="^ TextBlock#Text"><!-- PORT: removed setter of Text (not in Avalonia) --></Style><Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding Track, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S3)=True] mui|BetterImage#Outline"><Setter Property="IsVisible" Value="False"/>
                </Style><Style Selector="^[(pa|T.S3)=True] TextBlock#Text"><!-- PORT: removed setter of Text (not in Avalonia) -->
              </Style></Style></StackPanel.Styles><mui:BetterImage x:Name="Outline" Filename="{Binding Track.OutlineImage}" Width="24" Height="24" Margin="0 0 12 0" ClearOnChange="True"/>
              <TextBlock x:Name="Text" VerticalAlignment="Center"/>
            </StackPanel>
            </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <DataGridTextColumn Width="120" Header="{x:Static c:ControlsStrings.TableHeader_BestLap}" SortMemberPath="Entry.LapTime" Binding="{Binding Entry.LapTime, Converter={StaticResource MillisecondsTimeSpanConverter}}" pa:ColumnNames.Name="DefaultColumn"><!-- PORT: removed HeaderStyle (not in Avalonia) --><!-- PORT: removed CellStyle (not in Avalonia) --></DataGridTextColumn>
      <DataGridTextColumn Width="180" Header="{x:Static c:ControlsStrings.TableHeader_Date}" SortMemberPath="Entry.EntryDate" Binding="{Binding Entry.EntryDate}"><!-- PORT: removed HeaderStyle (not in Avalonia) --><!-- PORT: removed CellStyle (not in Avalonia) --></DataGridTextColumn>
      <DataGridTextColumn Width="140" Header="Source" SortMemberPath="Entry.Source" Binding="{Binding Entry.Source}"><!-- PORT: removed CellStyle (not in Avalonia) --></DataGridTextColumn>
    </DataGrid.Columns>
  </DataGrid>
</UserControl>