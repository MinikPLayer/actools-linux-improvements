<mi:MostSomethingBase xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:mi="clr-namespace:AcManager.Pages.Miscellaneous" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Miscellaneous.MostUsed">
  <mi:MostSomethingBase.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="MostSomethingBase.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></mi:MostSomethingBase.Resources>
  <mui:SpacingUniformGrid Classes="MostPageStyle">
    <ItemsControl ItemsSource="{Binding CarEntries}" ItemTemplate="{StaticResource MostCarTemplate}" Theme="{StaticResource VirtualizingItemsControl}"/>
    <ItemsControl ItemsSource="{Binding TrackEntries}" ItemTemplate="{StaticResource MostTrackTemplate}" Theme="{StaticResource VirtualizingItemsControl}"/>
  </mui:SpacingUniformGrid>
</mi:MostSomethingBase>