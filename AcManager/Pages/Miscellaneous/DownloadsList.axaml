<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:uc="clr-namespace:AcManager.UserControls" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Miscellaneous.DownloadsList">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <DockPanel Classes="ContentRoot">
    <mui:SpacingUniformGrid Rows="1" HorizontalAlignment="Right" DockPanel.Dock="Bottom" DataContext="{x:Static t:ContentInstallationManager.Instance}" Margin="20 12 20 20">
      <Button Command="{Binding InstallAllCommand}" Margin="0 8 4 8" IsVisible="{Binding HasMoreThanOneWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel>
          <Path Width="12" Height="12" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource AddMultipleIconData}"/>
          <TextBlock Text="{x:Static g:AppStrings.MainWindow_Downloads_InstallAll}"/>
        </DockPanel>
      </Button>
      <Button Command="{Binding RemoveCompletedCommand}" Margin="0 8 4 8" IsVisible="{Binding RemoveCompletedCommand.IsAbleToExecute, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel>
          <Path Width="12" Height="12" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource CleanUpIconData}"/>
          <TextBlock Text="{x:Static g:AppStrings.MainWindow_Downloads_RemoveCompleted}"/>
        </DockPanel>
      </Button>
    </mui:SpacingUniformGrid>
    <uc:InstallAdditionalContentList VerticalContentAlignment="Top"/>
  </DockPanel>
</UserControl>