<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Pages.AcSettings" xmlns:c="clr-namespace:AcManager.Controls;assembly=AcManager.Controls" xmlns:o="clr-namespace:AcManager.Tools.Objects;assembly=AcManager.Tools" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsPython" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/FavouritesSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <ControlTheme x:Key="DesktopsGridColumn.LeftAlignment" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        <Setter Property="Padding" Value="8 4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
              <mui:Cell>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                  <DockPanel x:Name="containerGrid">
                    <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="2" DockPanel.Dock="Bottom" Margin="0 2 -4 0">
                      <TextBlock Text="1" ToolTip.Tip="First desktop" Classes="Small"/>
                      <TextBlock Text="2" ToolTip.Tip="Second desktop" Classes="Small"/>
                      <TextBlock Text="3" ToolTip.Tip="Third desktop" Classes="Small"/>
                      <TextBlock Text="4" ToolTip.Tip="Fourth desktop" Classes="Small"/>
                    </mui:SpacingUniformGrid>
                    <Path x:Name="SortArrow" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="6" Margin="4 0" Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.4" Data="M0,0 L1,0 0.5,1 z"/>
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                  </DockPanel>
                </Border>
                <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
              </mui:Cell>
              </ControlTemplate>
          </Setter.Value>
        </Setter>

        <Style Selector="^ /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/><Setter Property="DockPanel.Dock" Value="Right"/></Style><Style Selector="^:pointerover"><Style Selector="^[CanUserSort=True]"><Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForegroundHover}"/>
          </Style></Style><Style Selector="^:pressed"><Style Selector="^[CanUserSort=True]"><Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForegroundPressed}"/>
          </Style></Style><Style Selector="^[SortDirection=Ascending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <RotateTransform Angle="180"/>
                    </Setter.Value>
                  </Setter>
                </Style><Style Selector="^[SortDirection=Descending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                </Style><Style Selector="^[CanUserSort=False] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/>
                </Style><Style Selector="^[HorizontalContentAlignment=Right] /template/ Path#SortArrow"><Setter Property="DockPanel.Dock" Value="Left"/>
                </Style></ControlTheme>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Column="0" Classes="SettingsPanel">
      <CheckBox IsChecked="{Binding EnablePythonApps, Source={x:Static t:AcSettingsHolder.Gameplay}}">
        <Label Content="{x:Static g:AppStrings.AcSettings_Python_EnablePythonApps}"/>
      </CheckBox>

      <CheckBox IsChecked="{Binding DeveloperApps, Source={x:Static t:AcSettingsHolder.System}}" IsEnabled="{Binding EnablePythonApps, Source={x:Static t:AcSettingsHolder.Gameplay}}">
        <Label Content="{x:Static g:AppStrings.AcSettings_System_DeveloperApps}"/>
      </CheckBox>

      <CheckBox IsChecked="{Binding SaveDevAppsInAppsPresets, Source={x:Static t:SettingsHolder.Drive}}" IsEnabled="{Binding EnablePythonApps, Source={x:Static t:AcSettingsHolder.Gameplay}}">
        <Label Content="{x:Static g:AppStrings.AcSettings_Python_KeepDeveloperAppsFlagWithAppsPresets}"/>
      </CheckBox>
    </StackPanel>

    <DockPanel Grid.Column="0" Grid.Row="1" IsEnabled="{Binding EnablePythonApps, Source={x:Static t:AcSettingsHolder.Gameplay}}">
      <Label DockPanel.Dock="Top" Margin="0 0 0 8" Content="{x:Static g:AppStrings.AcSettings_Apps_ActivatedLabel}"/>
      <ListBox x:Name="EnabledAppsListBox" ItemsSource="{Binding Apps}" SelectionMode="Multiple" SelectionChanged="OnEnabledAppsListSelectionChanged" Margin="0 0 20 0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <mui:SpacingUniformGrid x:Name="EnabledAppsListPanel" Columns="4" HorizontalSpacing="20" VerticalSpacing="4" VerticalAlignment="Top"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource CheckBoxListBoxItem}">
            <Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S0)=True]"><Setter Property="IsEnabled" Value="False"/>
              </Style></ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="o:PythonAppObject">
            <DockPanel IsEnabled="{Binding Enabled}" Background="Transparent" mui:Draggable.Data="{Binding}" x:Name="__Dt1">
              <DockPanel.Styles><Style Selector="DockPanel#__Dt1"><Style Selector="^ Path#FavouriteIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S2" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S2)=True] Path#FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
              </Style></Style></DockPanel.Styles><ToolTip.Tip>
                <ToolTip IsVisible="{Binding Description, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
                  <mui:BbCodeBlock Mode="SafeBbCodes" Text="{Binding Description}" MaxWidth="400" TextWrapping="Wrap"/>
                </ToolTip>
              </ToolTip.Tip>
              <c:OriginIcon Author="{Binding Author}" MaxWidth="12" MaxHeight="12" DockPanel.Dock="Right" x:Name="PART_OriginIcon"/>
              <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource FavouriteBrush}" Stretch="Uniform" x:Name="FavouriteIcon" VerticalAlignment="Center" Margin="2 0 4 0"/>
              <mui:BetterImage Width="14" Height="14" CollapseIfNull="True" CollapseIfMissing="True" Filename="{Binding AppIcon.Value, FallbackValue={x:Null}}" Margin="0 0 4 0" ClearOnChange="True" ToolTip.Tip="{Binding AppIcon.Value}"/>
              <TextBlock Text="{Binding DisplayName}"/>
            </DockPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <mui:SpacingStackPanel Spacing="4" Grid.Column="0" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 20 20">
      <c:UserPresetsControl x:Name="UserPresetsControl" UserPresetable="{Binding Presets}"/>
      <Button Content="Combine presets to multi-desktop preset" Command="{Binding CombinePresetsCommand}" ToolTip.Tip="Use it if you want to switch between several presets during the race. But keep in mind that all used apps will be enabled and loaded."/>
    </mui:SpacingStackPanel>
  </Grid>
</UserControl>