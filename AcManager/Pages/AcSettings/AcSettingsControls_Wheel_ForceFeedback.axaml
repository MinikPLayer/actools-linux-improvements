<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Pages.AcSettings" xmlns:g="clr-namespace:AcManager" xmlns:с="http://acstuff.club/app/controls" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:w="clr-namespace:AcTools.WheelAngles.Implementations.Options;assembly=AcTools.WheelAngles" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsControls_Wheel_ForceFeedback">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="AcSettingsControls_Wheel_ForceFeedback">
    <mui:SpacingUniformGrid x:Name="Grid" Columns="1" HorizontalSpacing="20" VerticalStackMode="True">

      <StackPanel set:Search.Category="{x:Static g:AppStrings.AcSettings_Controls}" Classes="SettingsPanel">
        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbGain}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_Gain}"/>
          <Slider Minimum="0" Maximum="200" Value="{Binding Controls.WheelFfbGain}" TickFrequency="20" TickPlacement="BottomRight"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Controls.WheelFfbInvert}">
          <Label Content="{x:Static g:AppStrings.Controls_InvertFfb}"/>
        </CheckBox>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbFilter}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_FilterAxis}"/>
          <Slider Minimum="0" Maximum="99" Value="{Binding Controls.WheelFfbFilter}" TickFrequency="11" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbMinForce, StringFormat='{}{0:F1}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_MinimumForce}"/>
          <Slider Minimum="0" Maximum="30" Value="{Binding Controls.WheelFfbMinForce}" TickFrequency="3" TickPlacement="BottomRight"/>
        </DockPanel>

        <!-- Effects -->
        <TextBlock Text="{x:Static с:ControlsStrings.Controls_EffectsHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbKerbEffect}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_KerbEffect}"/>
          <Slider Minimum="0" Maximum="150" Value="{Binding Controls.WheelFfbKerbEffect}" TickFrequency="15" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbRoadEffect}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_RoadEffect}"/>
          <Slider Minimum="0" Maximum="150" Value="{Binding Controls.WheelFfbRoadEffect}" TickFrequency="15" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbSlipEffect}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_SlipEffect}"/>
          <Slider Minimum="0" Maximum="150" Value="{Binding Controls.WheelFfbSlipEffect}" TickFrequency="15" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.WheelFfbAbsEffect}" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_ABSEffect}"/>
          <Slider Minimum="0" Maximum="150" Value="{Binding Controls.WheelFfbAbsEffect}" TickFrequency="15" TickPlacement="BottomRight"/>
        </DockPanel>

        <!-- Miscellaneous -->
        <TextBlock Text="{x:Static с:ControlsStrings.Controls_MiscellaneousHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Controls.WheelFfbEnhancedUndersteer}">
          <Label Content="{x:Static с:ControlsStrings.Controls_EnhancedUndersteer}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding System.SoftLock}">
          <Label Content="{x:Static с:ControlsStrings.Controls_SoftLock}"/>
        </CheckBox>

        <DockPanel ToolTip.Tip="{x:Static с:ControlsStrings.Controls_SkipFfbSteps_Tooltip}">
          <mui:ValueLabel Value="{Binding Controls.WheelFfbSkipSteps}" Content="{x:Static с:ControlsStrings.Controls_SkipFfbSteps}"/>
          <Slider Minimum="0" Maximum="5" Value="{Binding Controls.WheelFfbSkipSteps}" TickFrequency="1" TickPlacement="BottomRight"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Controls.HardwareLock}" IsEnabled="{Binding Controls.IsHardwareLockSupported}">
          <ToolTip.Tip>
            <mui:BbCodeBlock MaxWidth="480" Text="CM will try to adjust device’s steering lock, [b]experimental[/b].[br][br]If you adjusted [mono][b]STEER/SCALE[/b][/mono] in [mono][b]config.ini[/mono][/b], you might want to change it back, especially now when CM can sync virtual and real steering wheels automatically. Be ready to fix steering lock in device’s settings in case CM will fail to revert it back.[br][br]If you want to see your device added here and ready to do some testing of various pre-release builds, please, contact me, maybe there is a way."/>
          </ToolTip.Tip>
          <DockPanel>
            <TextBlock Text="{Binding Controls.DisplayHardwareLockSupported, StringFormat='{}Supported controllers: {0}'}" TextWrapping="Wrap" DockPanel.Dock="Bottom" Margin="0 2 0 0" Classes="Small"/>
            <Label Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_HardwareLock}"/>
          </DockPanel>
        </CheckBox>

        <mui:BooleanSwitch Value="{Binding Controls.HardwareLock}">
          <ContentControl DataContext="{Binding Controls}" Content="{Binding HardwareLockOptions}" IsVisible="{Binding HardwareLockOptions, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
            <ContentControl.DataTemplates><DataTemplate DataType="{x:Type w:LogitechOptions}">
                <StackPanel Classes="SettingsPanel">
                  <TextBlock Text="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_LogitechHardwareLockOptions}" Classes="Heading2 SettingsPanel.Heading2"/>

                  <TextBlock Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0 0 0 8" Text="Although CM uses official Logitech SDK and calls a couple of some well-documented functions, there is a small chance it might mess your steering wheel up, and you would need to spend some time fixing it back. Please, be careful." Classes="Small"/>

                  <CheckBox IsChecked="{Binding UseOwnHandle}" IsEnabled="{Binding SpecifyHandle}">
                    <Label Content="Use CM’s handle instead of the one of AC"/>
                  </CheckBox>

                  <CheckBox IsChecked="{Binding DetectSettingsAutomatically}">
                    <Label Content="Detect Logitech settings automatically"/>
                  </CheckBox>

                  <TextBlock TextWrapping="Wrap" Margin="0 20 0 8" Text="CM should try to detect steering wheel’s settings automatically, but if it fails, you can specify them manually:" IsVisible="{Binding DetectSettingsAutomatically, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small"/>

                  <DockPanel IsVisible="{Binding DetectSettingsAutomatically, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <mui:ValueLabel Value="{Binding OverallGainPercentage}" Content="Logitech: overall gain" Postfix="%"/>
                    <Slider Minimum="0" Maximum="150" Value="{Binding OverallGainPercentage}" TickFrequency="10" TickPlacement="BottomRight"/>
                  </DockPanel>

                  <DockPanel IsVisible="{Binding DetectSettingsAutomatically, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <mui:ValueLabel Value="{Binding SpringGainPercentage}" Content="Logitech: spring gain" Postfix="%"/>
                    <Slider Minimum="0" Maximum="150" Value="{Binding SpringGainPercentage}" TickFrequency="10" TickPlacement="BottomRight"/>
                  </DockPanel>

                  <DockPanel IsVisible="{Binding DetectSettingsAutomatically, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <mui:ValueLabel Value="{Binding DamperGainPercentage}" Content="Logitech: damper gain" Postfix="%"/>
                    <Slider Minimum="0" Maximum="150" Value="{Binding DamperGainPercentage}" TickFrequency="10" TickPlacement="BottomRight"/>
                  </DockPanel>

                  <CheckBox IsChecked="{Binding PersistentSpringEnable}" IsEnabled="{Binding SpecifyHandle}" IsVisible="{Binding DetectSettingsAutomatically, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <Label Content="Logitech: center spring"/>
                  </CheckBox>

                  <DockPanel IsVisible="{Binding DetectSettingsAutomatically, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <mui:ValueLabel Value="{Binding DefaultSpringGainPercentage}" Content="Logitech: center spring gain" Postfix="%"/>
                    <Slider Minimum="0" Maximum="150" Value="{Binding DefaultSpringGainPercentage}" TickFrequency="10" TickPlacement="BottomRight"/>
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="{x:Type w:LogitechG29Options}">
                <StackPanel Classes="SettingsPanel">
                  <TextBlock Text="Logitech G29 hardware lock options:" Classes="Heading2 SettingsPanel.Heading2"/>

                  <TextBlock Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0 0 0 8" Text="Although CM uses official Logitech SDK and calls a couple of some well-documented functions, there is a small chance it might mess your steering wheel up, and you would need to spend some time fixing it back. Please, be careful." Classes="Small"/>

                  <DockPanel>
                    <Label Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_HandleMode}" Width="80"/>
                    <ComboBox ItemsSource="{Binding HandleOptions}" SelectedItem="{Binding Handle}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DockPanel>

                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates></ContentControl>
        </mui:BooleanSwitch>

      </StackPanel>
      <StackPanel set:Search.Category="{x:Static g:AppStrings.AcSettings_Controls}" Classes="SettingsPanel">

        <!-- Post-Processing -->
        <TextBlock Text="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_PostProcessing}" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <DockPanel ToolTip.Tip="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_CenterBoostGain_Tooltip}">
          <mui:ValueLabel Value="{Binding Controls.WheelFfbWheelCenterBoostGain}" Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_CenterBoostGain}" Postfix="%"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Controls.WheelFfbWheelCenterBoostGain}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel ToolTip.Tip="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_CenterBoostGain_Tooltip}">
          <mui:ValueLabel Value="{Binding Controls.WheelFfbWheelCenterBoostRange}" Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_CenterBoostRange}" Postfix="%"/>
          <Slider Minimum="0" Maximum="20" Value="{Binding Controls.WheelFfbWheelCenterBoostRange}" TickFrequency="2" TickPlacement="BottomRight"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding FfPostProcess.Enabled}">
          <Label Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_EnableFFBPostProcessing}"/>
        </CheckBox>

        <DockPanel IsVisible="{Binding FfPostProcess.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Label Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_PostProcessingMode}" Width="80"/>
          <ComboBox ItemsSource="{Binding FfPostProcess.Types}" SelectedItem="{Binding FfPostProcess.Type, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <mui:Switch Value="{Binding FfPostProcess.Type.Id}" IsVisible="{Binding FfPostProcess.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel mui:Switch.When="GAMMA" Margin="0" Classes="SettingsPanel">
            <DockPanel>
              <mui:ValueLabel Value="{Binding FfPostProcess.Gamma, Converter={StaticResource PercentageConverter}}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_GammaAxis}" Width="80"/>
              <Slider Minimum="0" Maximum="2" Value="{Binding FfPostProcess.Gamma, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}" TickFrequency="0.2" TickPlacement="BottomRight"/>
            </DockPanel>
          </StackPanel>
          <StackPanel mui:Switch.When="LUT" Margin="0" Classes="SettingsPanel">
            <DockPanel>
              <Label Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_LUT}" Width="80"/>
              <Button x:Name="ImportCsvButton" Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_ImportCSV}" Command="{Binding ImportCsvCommand}" ToolTip.Tip="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_ImportCSV_Tooltip}"/>
              <Button Content="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_ImportLUT}" Command="{Binding ImportLutCommand}" ToolTip.Tip="{x:Static g:AppStrings.AcSettings_Controls_Wheel_ForceFeedback_Import_Tooltip}"/>
              <mui:BetterComboBox ItemsSource="{Binding FfPostProcess.LutNames}" SelectedItem="{Binding FfPostProcess.LutName, Mode=TwoWay}"/>
            </DockPanel>

            <с:CustomGraphViewer Source="{Binding FfPostProcess.LutGraphData}" XAxisTitle="Input" YAxisTitle="Output" ValueBrush="{DynamicResource Accent}" TrackerFormatString="{}[b]{4:F1}%[/b] at [b]{2:F1}%[/b]" Margin="0 0 0 8" Height="200"/>

            <с:MessageBlock x:Name="LutLibraryMessage" CloseKey="lutlibrary-dll" Margin="0 0 0 8">
              <mui:BbCodeBlock>
                <mui:BbCodeBlock.Text>
                  Put [mono]LUTLibrary.dll[/mono] from [url="http://www.racedepartment.com/downloads/lut-generator-for-ac.9740/"]LUT
                  Generator[/url] next to CM’s executable or to “…\AppData\Local\AcTools Content Manager\Plugins” (or just drag’n’drop it here), restart CM and
                  it’ll be able to convert CSV-files from [url="http://racingcentral.org/wheelcheck/"]WheelCheck[/url] to LUT-files.
                </mui:BbCodeBlock.Text>
              </mui:BbCodeBlock>
            </с:MessageBlock>
          </StackPanel>
        </mui:Switch>

        <!-- FFB reduction at lower speeds -->
        <TextBlock Text="Lower speeds FFB reduction" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <mui:ValueLabel Value="{Binding System.FfbLowSpeedThreshold}" Postfix=" km/h" Content="Low speed threshold"/>
          <Slider Minimum="0" Maximum="10" Value="{Binding System.FfbLowSpeedThreshold}" TickFrequency="1" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding System.FfbLowSpeedMult}" Postfix="%" Content="Low speed FFB strength"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding System.FfbLowSpeedMult}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>

        <!-- Experimental -->
        <TextBlock Text="{x:Static с:ControlsStrings.Controls_ExperimentalHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox x:Name="Experimental" IsChecked="{mui:Stored controlsExperimental}">
          <Label Foreground="{DynamicResource Error}" Content="{x:Static с:ControlsStrings.Controls_UnlockExperimental}"/>
        </CheckBox>

        <CheckBox IsEnabled="{Binding IsChecked, ElementName=Experimental}" IsChecked="{Binding System.FfbGyro}">
          <Label Content="{x:Static с:ControlsStrings.Controls_GyroscopicEffect}"/>
        </CheckBox>

        <!--ToolTip="{x:Static с:ControlsStrings.Controls_DamperGain_Tooltip}"-->
        <DockPanel IsEnabled="{Binding IsChecked, ElementName=Experimental}">
          <mui:ValueLabel Value="{Binding System.FfbDamperGain}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_DamperGain}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding System.FfbDamperGain}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel IsEnabled="{Binding IsChecked, ElementName=Experimental}">
          <mui:ValueLabel Value="{Binding System.FfbDamperMinLevel}" Postfix="%" Content="{x:Static с:ControlsStrings.Controls_MinumumDamperLevel}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding System.FfbDamperMinLevel}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
      </StackPanel>

    </mui:SpacingUniformGrid>
  </ScrollViewer>
</UserControl>