<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Tools.Helpers.AcSettings;assembly=AcManager.Tools" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsControls_Wheel_Buttons" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer DataContext="{Binding Source={x:Static acset:AcSettingsHolder.Controls}}" mui:SaveScroll.Key="AcSettingsControls_Wheel_Buttons">
    <StackPanel>
      <CheckBox IsChecked="{Binding CombineWithKeyboardInput}" Margin="0 0 0 20">
        <Label Content="{x:Static g:AppStrings.Controls_CombineWithKeyboard}"/>
      </CheckBox>

      <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_ShiftersHeader}" Classes="Heading2"/>
      <ItemsControl ItemsSource="{Binding WheelGearsButtonEntries}" Margin="0 0 20 4" ItemTemplate="{StaticResource ButtonAltEntryTemplate}"/>

      <CheckBox IsChecked="{Binding WheelUseHShifter}" Margin="0 0 0 8">
        <Label Content="{x:Static g:AppStrings.Controls_UseHShifter}"/>
      </CheckBox>

      <StackPanel Background="{DynamicResource WindowBackground}" Margin="20 0 20 20" IsEnabled="{Binding WheelUseHShifter}">
        <TextBlock HorizontalAlignment="Left" Margin="4" Text="{Binding WheelHShifterDevice.DisplayName, StringFormat={x:Static g:AppStrings.Controls_DeviceFormat}, FallbackValue=?}" FontStyle="{Binding WheelHShifterDevice.IsVirtual, Converter={StaticResource BooleanToFontStyleConverter}}" Classes="Small"/>
        <ItemsControl x:Name="HShifterButtons" ItemsSource="{Binding WheelHShifterButtonEntries}" Margin="4 0 4 4" ItemTemplate="{StaticResource HShifterButtonEntryTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <mui:UniformGridWithOrientation Orientation="Vertical" Rows="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <DockPanel Margin="0 0 0 20" ToolTip.Tip="{x:Static g:AppStrings.Controls_GearShiftDebouncing_Tooltip}">
        <mui:ValueLabel Value="{Binding DebouncingInterval}" Postfix="{x:Static c:ControlsStrings.Common_MillisecondsPostfix}" DockPanel.Dock="Left" VerticalAlignment="Center" Width="200" Content="{x:Static g:AppStrings.Controls_GearShiftDebouncing}"/>
        <Slider Minimum="0" Maximum="250" Value="{Binding DebouncingInterval}" TickFrequency="25" TickPlacement="BottomRight"/>
      </DockPanel>

      <mui:SpacingUniformGrid x:Name="MainGrid" VerticalStackMode="True">
        <StackPanel>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_BrakeBalance}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarBrakeButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_Turbo}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarTurboButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_TractionControl}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarTractionControlButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_Abs}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarAbsButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_EngineBrake}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarEngineBrakeButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <!--<TextBlock Style="{StaticResource Heading2}" Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_Gestures}" />
          <ItemsControl ItemsSource="{Binding WheelGesturesButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}" />-->

        </StackPanel>
        <StackPanel>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_MguK}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarMgukButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_Miscellaneous}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelCarButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

          <TextBlock Margin="0 0 0 4" Text="{x:Static g:AppStrings.Controls_View}" Classes="Heading2"/>
          <ItemsControl ItemsSource="{Binding WheelViewButtonEntries}" Margin="0 0 20 20" ItemTemplate="{StaticResource ButtonEntryTemplate}"/>

        </StackPanel>
      </mui:SpacingUniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>