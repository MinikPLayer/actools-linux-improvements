<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Pages.AcSettings" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsControls_Controller_Main" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="AcSettingsControls_Controller">
    <StackPanel>
      <StackPanel c:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureJoypadIndexAware}" Classes="SettingsPanel">
        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.DisplayControllerDeviceIndex}" mui:BetterTextBox.Mode="Integer" mui:BetterTextBox.Minimum="1" mui:BetterTextBox.Maximum="4" Content="Gamepad ID"/>
          <Slider Minimum="1" Maximum="4" TickFrequency="1" TickPlacement="BottomRight" Value="{Binding Controls.DisplayControllerDeviceIndex}"/>
        </DockPanel>
        <CheckBox IsChecked="{Binding Controls.ControllerUseDualShock}" c:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureDualShockSupport}" ToolTip.Tip="Requires CSP 0.1.80">
          <Label Content="Use PlayStation 4 DualShock gamepad"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Controls.ControllerUseDualSense}" c:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureDualSenseSupport}" ToolTip.Tip="Requires CSP 0.1.79">
          <Label Content="Use PlayStation 5 DualSense gamepad"/>
        </CheckBox>
        <c:MessageBlock c:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureDualSenseSupport}">
          <mui:BbCodeBlock Text="With CSP active, use built-in Controller Tweaks app to change buttons live with DualShock or DualSense gamepads (or any other gamepads)." Classes="Small"/>
        </c:MessageBlock>
      </StackPanel>

      <CheckBox IsChecked="{Binding Controls.CombineWithKeyboardInput}" Margin="0 0 0 20">
        <Label Content="{x:Static g:AppStrings.Controls_CombineWithKeyboard}"/>
      </CheckBox>

      <ItemsControl x:Name="MainGrid" ItemsSource="{Binding Controls.ControllerCarButtonEntries}" ItemTemplate="{StaticResource ControllerButtonEntryTemplate}" ItemsPanel="{StaticResource TwoColumnsPanel}"/>

      <StackPanel Classes="SettingsPanel">
        <TextBlock Text="{x:Static g:AppStrings.AcSettings_Controls_Controller_Main_SteeringAndFFB}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.AcSettings_Controls_Controller_Main_SteerThumb}"/>
          <mui:BetterComboBox ItemsSource="{Binding Source={x:Static t:ControlsSettings.ControllerSticks}}" SelectedItem="{Binding Controls.ControllerSteeringStick}" IsEditable="False" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.ControllerSpeedSensitivity, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static c:ControlsStrings.Controls_SpeedSensitivity}"/>
          <Slider Minimum="0" Maximum="1" Ticks="10" TickPlacement="BottomRight" Value="{Binding Controls.ControllerSpeedSensitivity, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.ControllerSteeringSpeed, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.Controls_SteeringSpeed}"/>
          <Slider Minimum="0.01" Maximum="1" Ticks="10" TickPlacement="BottomRight" Value="{Binding Controls.ControllerSteeringSpeed, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.ControllerSteeringGamma, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Controls_Controller_Main_SteeringGamma}"/>
          <Slider Minimum="1" Maximum="4" Ticks="10" TickPlacement="BottomRight" Value="{Binding Controls.ControllerSteeringGamma, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.ControllerSteeringFilter, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Controls_Controller_Main_SteeringFilter}"/>
          <Slider Minimum="0" Maximum="1" Ticks="10" TickPlacement="BottomRight" Value="{Binding Controls.ControllerSteeringFilter, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.ControllerSteeringDeadzone, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Controls_Controller_Main_SteeringDeadzone}"/>
          <Slider Minimum="0" Maximum="0.45" Ticks="10" TickPlacement="BottomRight" Value="{Binding Controls.ControllerSteeringDeadzone, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Controls.ControllerRumbleIntensity, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Controls_Controller_Main_RumbleEffects}"/>
          <Slider Minimum="0" Maximum="1" Ticks="10" TickPlacement="BottomRight" Value="{Binding Controls.ControllerRumbleIntensity, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.01}"/>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>