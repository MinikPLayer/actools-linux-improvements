<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Pages.AcSettings" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:t="http://acstuff.club/app/tools" xmlns:na="clr-namespace:NAudio.CoreAudioApi;assembly=NAudio" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsAudio">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer mui:SaveScroll.Key="AcSettingsAudio">
      <StackPanel set:Search.Category="{x:Static g:AppStrings.AcSettings_Audio}" Classes="SettingsPanel">
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.SkidsEntryPoint}" mui:BetterTextBox.Mode="Integer" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_TyresOffset}"/>
          <Slider Minimum="0" Maximum="200" Value="{Binding Audio.SkidsEntryPoint}" TickFrequency="20" TickPlacement="BottomRight"/>
        </DockPanel>

        <TextBlock Text="{x:Static g:AppStrings.AcSettings_Audio_OutputDevice}" x:Name="DevicesHeading" Classes="Heading2 SettingsPanel.Heading2"/>
        <DockPanel x:Name="DevicesPanel">
          <Label Content="{x:Static g:AppStrings.AcSettings_Audio_DeviceName}"/>
          <mui:BetterComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioDevice}" IsEditable="False">
            <mui:BetterComboBox.Styles>
              <Style Selector="ComboBoxItem">
                <Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding State, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=Disabled}"/><Setter Property="pa:T.S1" Value="{Binding State, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=Unplugged}"/></Style><Style Selector="^[(pa|T.S0)=True]"><Setter Property="IsEnabled" Value="False"/>
                  </Style><Style Selector="^[(pa|T.S1)=True]"><Setter Property="IsEnabled" Value="False"/>
                  </Style></Style>
            </mui:BetterComboBox.Styles>
            <mui:BetterComboBox.ItemTemplate>
              <DataTemplate>
                <DockPanel x:Name="__Dt2">
                  <DockPanel.Styles><Style Selector="DockPanel#__Dt2"><Style Selector="^ TextBlock#PART_State"><!-- PORT: removed setter of Text (not in Avalonia) --></Style><Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding State, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=NotPresent}"/></Style><Style Selector="^[(pa|T.S3)=True] TextBlock#PART_State"><!-- PORT: removed setter of Text (not in Avalonia) -->
                  </Style></Style></DockPanel.Styles><mui:Cell Margin="0 0 8 0">
                    <Image Width="32" Height="32" Source="{Binding IconPath, Converter={StaticResource IconPathToImageConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path Width="10" Height="10" Margin="2" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Go}" Data="F1 M 15,21L 22,28L 32.9999,14.0001L 35.9999,17.0001L 22,34L 12.0001,24L 15,21 Z" IsVisible="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  </mui:Cell>
                  <TextBlock Text="{Binding DisplayName}" DockPanel.Dock="Top" Margin="0 0 0 4"/>
                  <TextBlock Text="{Binding DeviceName}" Classes="Small"/>
                  <TextBlock x:Name="PART_State" IsVisible="{Binding State, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='≠Active'}" Classes="Small"/>
                </DockPanel>
                </DataTemplate>
            </mui:BetterComboBox.ItemTemplate>
          </mui:BetterComboBox>
        </DockPanel>

        <CheckBox IsChecked="{Binding Oculus.AutoselectRiftAudioDisplay}">
          <Label Content="Automatically select Oculus audio device"/>
        </CheckBox>

        <TextBlock Text="{x:Static g:AppStrings.AcSettings_Audio_LevelsHeader}" Classes="Heading2 SettingsPanel.Heading2"/>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelMaster, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Master}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelMaster}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelTyres, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Tyres}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelTyres}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelEngine, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Engine}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelEngine}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelSurfaces, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Surface}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelSurfaces}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelWind, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Wind}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelWind}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelOpponents, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Opponents}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelOpponents}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <DockPanel>
          <mui:ValueLabel Value="{Binding Audio.LevelUi, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Audio_Ui}"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding Audio.LevelUi}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding PatchItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border>
                <Border.Styles><Style Selector="DockPanel">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="0 0 0 8"/>

      <Style Selector="^ Label">
          <Setter Property="Margin" Value="0 4 8 0"/>
          <Setter Property="Width" Value="148"/>
          <Setter Property="VerticalAlignment" Value="Top"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ mui|ValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ mui|DoubleValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ controls|TemperatureValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ controls|DoubleTemperatureValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ Button">
          <Setter Property="Margin" Value="8 0 0 0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>

        <Style Selector="^ mui|AsyncButton">
          <Setter Property="Margin" Value="8 0 0 0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>

        <Style Selector="^ mui|LabeledToggleButton">
          <Setter Property="Margin" Value="8 0 0 0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>

        <Style Selector="^ TextBlock">
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="^ CheckBox"><Setter Property="VerticalAlignment" Value="Center"/>

    </Style>
      </Style>

    <Style Selector="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>

    <Setter Property="Margin" Value="0 0 0 8"/>
    </Style>

    <Style Selector="controls|MessageBlock">
      <Setter Property="Margin" Value="0 0 0 8"/>
    </Style>
  </Border.Styles><DockPanel>
                  <mui:ValueLabel Value="{Binding Value, StringFormat='{}{0:F0}'}" mui:BetterTextBox.Mode="Number" Postfix="%" Content="{Binding DisplayName}"/>
                  <Slider Minimum="0" Maximum="100" Value="{Binding Value}" TickFrequency="10" TickPlacement="BottomRight"/>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 20 20">
      <c:UserPresetsControl x:Name="UserPresetsControl" UserPresetable="{Binding Presets}" MinWidth="300" Margin="0 0 4 0"/>
      <Button Command="{Binding ShareCommand}" Content="{x:Static g:AppStrings.Common_Share}" ToolTip.Tip="{x:Static g:AppStrings.Common_Share_SettingsTooltip}"/>
    </StackPanel>
  </Grid>
</UserControl>