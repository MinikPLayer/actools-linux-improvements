<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Pages.AcSettings" xmlns:g="clr-namespace:AcManager" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsGeneral">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="AcSettingsGeneral">
    <StackPanel set:Search.Category="{x:Static g:AppStrings.AcSettings_Miscellaneous}" Classes="SettingsPanel">
      <!-- Language -->

      <TextBlock Text="{x:Static g:AppStrings.Settings_Locale_LanguageLabel}" Classes="Heading2 SettingsPanel.Heading2.First"/>

      <DockPanel DataContext="{Binding Source={x:Static t:AcSettingsHolder.Launcher}}">
        <Label Content="{x:Static g:AppStrings.Settings_Locale_LanguageLabel}"/>
        <mui:BetterComboBox IsEditable="False" ItemsSource="{Binding LanguageEntries}" SelectedItem="{Binding LanguageEntry}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </mui:BetterComboBox>
      </DockPanel>

      <!-- Exposure -->
      <TextBlock Text="{x:Static c:ControlsStrings.Common_ExposureLabel}" Classes="Heading2 SettingsPanel.Heading2"/>

      <DockPanel>
        <mui:ValueLabel Value="{Binding Exposure.Value}" Postfix="%" Content="{x:Static g:AppStrings.AcSettings_Exposure_Value}"/>
        <Slider Minimum="0" Maximum="200" Value="{Binding Exposure.Value}" TickFrequency="20" TickPlacement="BottomRight"/>
      </DockPanel>

      <!-- Pit stop -->
      <TextBlock Text="{x:Static g:AppStrings.AcSettings_General_PitStops}" Classes="Heading2 SettingsPanel.Heading2"/>

      <CheckBox IsChecked="{Binding PitStop.UseMouse}">
        <Label Content="{x:Static g:AppStrings.AcSettings_General_UseMousePitStop}"/>
      </CheckBox>

      <CheckBox IsChecked="{Binding PitStop.StayInCar}">
        <Label Content="{x:Static g:AppStrings.AcSettings_General_KeepCameraInTheCar}"/>
      </CheckBox>

      <DockPanel>
        <mui:ValueLabel Value="{Binding PitStop.PresetsCount}" mui:BetterTextBox.Minimum="1" mui:BetterTextBox.Maximum="10" Content="{x:Static g:AppStrings.AcSettings_General_PresetsCount}"/>
        <Slider Minimum="1" Maximum="5" Value="{Binding PitStop.PresetsCount}" TickFrequency="1" TickPlacement="BottomRight"/>
      </DockPanel>

      <!-- Replays -->
      <TextBlock Text="{x:Static g:AppStrings.AcSettings_ReplaysHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

      <DockPanel>
        <Label Content="{x:Static g:AppStrings.AcSettings_Replays_QualityLabel}"/>
        <ComboBox ItemsSource="{Binding Replay.Qualities}" SelectedItem="{Binding Replay.Quality}" DisplayMemberBinding="{Binding DisplayName}"/>
      </DockPanel>

      <DockPanel>
        <ToolTip.Tip>
          <ToolTip>
            <TextBlock Text="{Binding Replay.RecommendedSize, StringFormat={x:Static g:AppStrings.AcSettings_Replays_RecommendedMaximumSizeFormat}, TargetNullValue=?, FallbackValue=?}"/>
          </ToolTip>
        </ToolTip.Tip>
        <mui:ValueLabel Value="{Binding Replay.MaxSize}" mui:BetterTextBox.Minimum="1" Postfix=" MB" Content="{x:Static g:AppStrings.AcSettings_Replays_MaximumSize}"/>
        <Slider Minimum="10" Maximum="{Binding Replay.MaxSizeMaximum}" Value="{Binding Replay.MaxSize}" TickFrequency="99" TickPlacement="BottomRight"/>
      </DockPanel>

      <c:MessageBlock>
        <mui:BbCodeBlock>
          <mui:BbCodeBlock.Text>
            <MultiBinding StringFormat="{}Maximum duration: ≈{0} ±10% (estimated for {1} cars).">
              <Binding Path="Replay.EstimatedDuration" Converter="{StaticResource ReadableTimeSpanConverter}"/>
              <Binding Source="{x:Static t:ReplaySettings.CarsToEstimate}"/>
            </MultiBinding>
          </mui:BbCodeBlock.Text>
        </mui:BbCodeBlock>
      </c:MessageBlock>

      <!-- Replays autosave -->
      <TextBlock Text="{x:Static g:AppStrings.AcSettings_General_ReplaysAutosave}" Classes="Heading2 SettingsPanel.Heading2"/>

      <CheckBox IsChecked="{Binding Replay.Autosave}" ToolTip.Tip="Autosave replays using new AC mechanism added in 1.14 update">
        <Label Content="{x:Static g:AppStrings.Settings_Replays_AutosaveReplays}"/>
      </CheckBox>

      <DockPanel>
        <mui:ValueLabel Value="{Binding Replay.MinTimeSecond}" mui:BetterTextBox.Minimum="0" Postfix=" sec" Content="{x:Static g:AppStrings.AcSettings_General_MinimumTime}"/>
        <Slider Minimum="0" Maximum="120" Value="{Binding Replay.MinTimeSecond}" TickFrequency="12" TickPlacement="BottomRight"/>
      </DockPanel>

      <DockPanel>
        <mui:ValueLabel Value="{Binding Replay.RacesLimit}" mui:BetterTextBox.Minimum="0" Content="{x:Static g:AppStrings.AcSettings_General_LimitForRaces}"/>
        <Slider Minimum="0" Maximum="20" Value="{Binding Replay.RacesLimit}" TickFrequency="2" TickPlacement="BottomRight"/>
      </DockPanel>

      <DockPanel>
        <mui:ValueLabel Value="{Binding Replay.QualifyLimit}" mui:BetterTextBox.Minimum="0" Content="{x:Static g:AppStrings.AcSettings_General_LimitForQualifications}"/>
        <Slider Minimum="0" Maximum="20" Value="{Binding Replay.QualifyLimit}" TickFrequency="2" TickPlacement="BottomRight"/>
      </DockPanel>

      <DockPanel>
        <mui:ValueLabel Value="{Binding Replay.OthersLimit}" mui:BetterTextBox.Minimum="0" Content="{x:Static g:AppStrings.AcSettings_General_LimitForOtherSessions}"/>
        <Slider Minimum="0" Maximum="20" Value="{Binding Replay.OthersLimit}" TickFrequency="2" TickPlacement="BottomRight"/>
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>