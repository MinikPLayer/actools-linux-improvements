<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:acset="clr-namespace:AcManager.Pages.AcSettings" xmlns:c="clr-namespace:AcManager.Controls;assembly=AcManager.Controls" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.AcSettings.AcSettingsPython_detailed" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/FavouritesSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <ControlTheme x:Key="DesktopsGridColumn.LeftAlignment" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        <Setter Property="Padding" Value="8 4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
              <mui:Cell>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                  <DockPanel x:Name="containerGrid">
                    <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="2" DockPanel.Dock="Bottom" Margin="0 2 -4 0">
                      <TextBlock Text="1" ToolTip.Tip="First desktop" Classes="Small"/>
                      <TextBlock Text="2" ToolTip.Tip="Second desktop" Classes="Small"/>
                      <TextBlock Text="3" ToolTip.Tip="Third desktop" Classes="Small"/>
                      <TextBlock Text="4" ToolTip.Tip="Fourth desktop" Classes="Small"/>
                    </mui:SpacingUniformGrid>
                    <Path x:Name="SortArrow" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="6" Margin="4 0" Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.4" Data="M0,0 L1,0 0.5,1 z"/>
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                  </DockPanel>
                </Border>
                <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
              </mui:Cell>
              </ControlTemplate>
          </Setter.Value>
        </Setter>

        <Style Selector="^ /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/><Setter Property="DockPanel.Dock" Value="Right"/></Style><Style Selector="^:pointerover"><Style Selector="^[CanUserSort=True]"><Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForegroundHover}"/>
          </Style></Style><Style Selector="^:pressed"><Style Selector="^[CanUserSort=True]"><Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForegroundPressed}"/>
          </Style></Style><Style Selector="^[SortDirection=Ascending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <RotateTransform Angle="180"/>
                    </Setter.Value>
                  </Setter>
                </Style><Style Selector="^[SortDirection=Descending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                </Style><Style Selector="^[CanUserSort=False] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/>
                </Style><Style Selector="^[HorizontalContentAlignment=Right] /template/ Path#SortArrow"><Setter Property="DockPanel.Dock" Value="Left"/>
                </Style></ControlTheme>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Classes="SettingsPanel">
      <CheckBox IsChecked="{Binding DeveloperApps, Source={x:Static t:AcSettingsHolder.System}}">
        <Label Content="{x:Static g:AppStrings.AcSettings_System_DeveloperApps}"/>
      </CheckBox>
      <CheckBox IsChecked="{Binding SaveDevAppsInAppsPresets, Source={x:Static t:SettingsHolder.Drive}}">
        <Label Content="Keep developer apps flag with apps presets"/>
      </CheckBox>
    </StackPanel>

    <DockPanel Grid.Row="1">
      <mui:SpacingStackPanel DockPanel.Dock="Bottom" Margin="0 20 20 0">
        <Label Margin="0 0 0 8" Content="Scale apps:" DockPanel.Dock="Top"/>
        <DockPanel>
          <Button Content="Set scale" Command="{Binding SetScaleCommand}" DockPanel.Dock="Right" Margin="8 0 0 0"/>
          <Button Content="Multiply scale" Command="{Binding MultiplyScaleCommand}" DockPanel.Dock="Right" Margin="8 0 0 0"/>
          <mui:ValueLabel Value="{Binding ScaleValue, Converter={StaticResource PercentageConverter}}" mui:BetterTextBox.Mode="Integer" Postfix="%" Content="Value" DockPanel.Dock="Top" Margin="0 0 0 4"/>
          <Slider Minimum="0" Maximum="200" Value="{Binding ScaleValue, Converter={StaticResource PercentageConverter}, ConverterParameter=1}" TickFrequency="20" TickPlacement="BottomRight"/>
        </DockPanel>
        <c:MessageBlock CloseKey="only-ac-apps" Margin="0 8 0 0">
          <TextBlock>
            <TextBlock.Text>Sadly, scaling works only for Kunos apps. At least for now.</TextBlock.Text>
          </TextBlock>
        </c:MessageBlock>
      </mui:SpacingStackPanel>

      <DockPanel Margin="0 0 20 8" DockPanel.Dock="Top">
        <mui:ValueLabel Value="{Binding Forms.SelectedDesktop}" mui:BetterTextBox.Mode="Integer" Content="Selected desktop in-game" DockPanel.Dock="Left" Margin="0 0 20 0" Padding="0" Width="200"/>
        <Slider Minimum="1" Maximum="4" Value="{Binding Forms.SelectedDesktop}" TickFrequency="1" TickPlacement="BottomRight"/>
      </DockPanel>

      <Label Margin="0 0 0 8" Content="{x:Static g:AppStrings.AcSettings_Apps_FormsLabel}" DockPanel.Dock="Top"/>
      <DataGrid x:Name="FormsDataGrid" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" mui:FancyScroll.InvertLocation="True" Padding="8 0 0 0" Margin="-8 0 0 0" ItemsSource="{Binding Forms.Entries}" Theme="{StaticResource DataGrid.Lite}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="3*" Header="{x:Static c:ControlsStrings.TableHeader_Name}" SortMemberPath="DisplayName">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type t:AcFormEntry}">
                <DockPanel>
                  <mui:BetterImage Width="14" Height="14" Margin="0 0 4 0" CollapseIfMissing="True" ClearOnChange="True">
                    <mui:BetterImage.Filename>
                      <MultiBinding StringFormat="{}{1}\content\gui\icons\{0}_OFF.png">
                        <Binding Path="Id"/>
                        <Binding Path="Value" Source="{x:Static t:AcRootDirectory.Instance}"/>
                      </MultiBinding>
                    </mui:BetterImage.Filename>
                  </mui:BetterImage>
                  <TextBlock Text="{Binding DisplayName}"/>
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="504" Header="Position" SortMemberPath="First.Position" pa:ColumnNames.Name="PositionColumn">
            <!-- PORT: removed CellStyle (not in Avalonia) --><DataGridTemplateColumn.HeaderStyle>
              <ControlTheme TargetType="DataGridColumnHeader" BasedOn="{StaticResource DesktopsGridColumn.LeftAlignment}" x:Key="{x:Type DataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                      <mui:Cell>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                          <DockPanel x:Name="containerGrid">
                            <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="20" DockPanel.Dock="Bottom" Margin="0 2 -4 0">
                              <TextBlock Text="1" ToolTip.Tip="First desktop" Classes="Small"/>
                              <TextBlock Text="2" ToolTip.Tip="Second desktop" Classes="Small"/>
                              <TextBlock Text="3" ToolTip.Tip="Third desktop" Classes="Small"/>
                              <TextBlock Text="4" ToolTip.Tip="Fourth desktop" Classes="Small"/>
                            </mui:SpacingUniformGrid>
                            <Path x:Name="SortArrow" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="6" Margin="4 0" Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.4" Data="M0,0 L1,0 0.5,1 z"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                          </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
                      </mui:Cell>
                      </ControlTemplate>
                  </Setter.Value>
                </Setter>
              <Style Selector="^ /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/><Setter Property="DockPanel.Dock" Value="Right"/></Style><Style Selector="^[SortDirection=Ascending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                          <Setter Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="180"/>
                            </Setter.Value>
                          </Setter>
                        </Style><Style Selector="^[SortDirection=Descending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                        </Style><Style Selector="^[CanUserSort=False] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/>
                        </Style><Style Selector="^[HorizontalContentAlignment=Right] /template/ Path#SortArrow"><Setter Property="DockPanel.Dock" Value="Left"/>
                        </Style></ControlTheme>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type t:AcFormEntry}">
                <mui:BooleanSwitch Value="{Binding AnyVisible}" HorizontalAlignment="Right">
                  <ItemsControl ItemsSource="{Binding Desktops}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <mui:SpacingStackPanel Orientation="Horizontal" Spacing="20"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=hidden}">
                          <TextBlock Text="X:"/>
                          <mui:BetterTextBox Text="{Binding PosX}" Mode="Integer" Placeholder="?" TextAlignment="Right" Width="40" Theme="{StaticResource Borderless.White}"/>
                          <TextBlock Text=", Y:"/>
                          <mui:BetterTextBox Text="{Binding PosY}" Mode="Integer" Placeholder="?" TextAlignment="Right" Width="40" Theme="{StaticResource Borderless.White}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </mui:BooleanSwitch>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="158" Header="Scale" SortMemberPath="First.Scale" pa:ColumnNames.Name="ScaleColumn">
            <!-- PORT: removed CellStyle (not in Avalonia) --><DataGridTemplateColumn.HeaderStyle>
              <ControlTheme TargetType="DataGridColumnHeader" BasedOn="{StaticResource DesktopsGridColumn.LeftAlignment}" x:Key="{x:Type DataGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                      <mui:Cell>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                          <DockPanel x:Name="containerGrid">
                            <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="2" DockPanel.Dock="Bottom" Margin="0 2 5 0">
                              <TextBlock Text="1" ToolTip.Tip="First desktop" Classes="Small"/>
                              <TextBlock Text="2" ToolTip.Tip="Second desktop" Classes="Small"/>
                              <TextBlock Text="3" ToolTip.Tip="Third desktop" Classes="Small"/>
                              <TextBlock Text="4" ToolTip.Tip="Fourth desktop" Classes="Small"/>
                            </mui:SpacingUniformGrid>
                            <Path x:Name="SortArrow" HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="6" Margin="4 0" Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.4" Data="M0,0 L1,0 0.5,1 z"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                          </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Theme="{StaticResource ColumnHeaderGripperStyle}"/>
                      </mui:Cell>
                      </ControlTemplate>
                  </Setter.Value>
                </Setter>
              <Style Selector="^ /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/><Setter Property="DockPanel.Dock" Value="Right"/></Style><Style Selector="^[SortDirection=Ascending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                          <Setter Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="180"/>
                            </Setter.Value>
                          </Setter>
                        </Style><Style Selector="^[SortDirection=Descending] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="True"/>
                        </Style><Style Selector="^[CanUserSort=False] /template/ Path#SortArrow"><Setter Property="IsVisible" Value="False"/>
                        </Style><Style Selector="^[HorizontalContentAlignment=Right] /template/ Path#SortArrow"><Setter Property="DockPanel.Dock" Value="Left"/>
                        </Style></ControlTheme>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type t:AcFormEntry}">
                <mui:BooleanSwitch Value="{Binding AnyVisible}">
                  <DockPanel>
                    <TextBlock Text="%" DockPanel.Dock="Right" Margin="2 0 0 0"/>
                    <ItemsControl ItemsSource="{Binding Desktops}" HorizontalAlignment="Right">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <mui:SpacingStackPanel Orientation="Horizontal" Spacing="2"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <mui:BetterTextBox Text="{Binding Scale}" Mode="Integer" Placeholder="100" TextAlignment="Right" Width="32" IsVisible="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=hidden}" Theme="{StaticResource Borderless.White}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </mui:BooleanSwitch>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="94" SortMemberPath="First.IsVisible" Header="{x:Static c:ControlsStrings.TableHeader_Visible}">
            <!-- PORT: removed HeaderStyle (not in Avalonia) --><DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type t:AcFormEntry}">
                <ItemsControl ItemsSource="{Binding Desktops}" HorizontalAlignment="Right">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <mui:SpacingStackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="94" SortMemberPath="First.IsBlocked" Header="{x:Static c:ControlsStrings.TableHeader_Locked}" pa:ColumnNames.Name="BlockedColumn">
            <!-- PORT: removed HeaderStyle (not in Avalonia) --><DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type t:AcFormEntry}">
                <ItemsControl ItemsSource="{Binding Desktops}" HorizontalAlignment="Right">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <mui:SpacingStackPanel Orientation="Horizontal" Spacing="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsBlocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=hidden}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <mui:SpacingStackPanel Spacing="4" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 20 20">
      <c:UserPresetsControl x:Name="UserPresetsControl" UserPresetable="{Binding Presets}"/>
      <Button Content="Combine presets to multi-desktop preset" Command="{Binding CombinePresetsCommand}" ToolTip.Tip="Use it if you want to switch between several presets during the race. But keep in mind that all used apps will be enabled and loaded."/>
    </mui:SpacingStackPanel>
  </Grid>
</UserControl>