<c:AcListPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:li="clr-namespace:AcManager.Pages.Lists" xmlns:c="http://acstuff.club/app/controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Lists.TrackSkinsListPage" AddNewCommand="{Binding AddNewCommand}" Loaded="OnLoaded" Unloaded="OnUnloaded" Margin="{StaticResource ContentMargin}" ItemsSource="{Binding MainList}" SaveScrollKey="{Binding SelectedTrack.Id, StringFormat='{}TrackSkinsListPage.Scroll:{0}'}">
  <c:AcListPage.Resources>
    <DataTemplate x:Key="Batch.PackTrackSkins" DataType="{x:Type li:TrackSkinsListPage+BatchAction_PackSkins}">
      <mui:SpacingStackPanel Spacing="4">
        <mui:SpacingStackPanel.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Themes/AcListPage.BatchStyle.axaml"/>
      </ResourceDictionary.MergedDictionaries></ResourceDictionary></mui:SpacingStackPanel.Resources>
      <mui:SpacingUniformGrid Columns="1" VerticalSpacing="4" HorizontalSpacing="20" HorizontalAlignment="Left">
          <CheckBox IsChecked="{Binding JsgmeCompatible}">
            <Label Content="JSGME compatible" ToolTip.Tip="Allows to install track skins for users without CM"/>
          </CheckBox>
          <CheckBox IsChecked="{Binding PackSeparately}">
            <Label Content="Pack separately"/>
          </CheckBox>
        </mui:SpacingUniformGrid>

        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Clear" Margin="4 0 0 0" Command="{Binding JsgmeClearCommand}"/>
          <Button DockPanel.Dock="Right" Content="Change" Margin="4 0 0 0" Command="{Binding JsgmeChangeCommand}"/>
          <TextBlock Text="Include JSGME executable: " DockPanel.Dock="Left"/>
          <mui:PathTrimmingTextBlock Text="{Binding IncludeJsgme}" Placeholder="No"/>
        </DockPanel>
      </mui:SpacingStackPanel>
    </DataTemplate>
  </c:AcListPage.Resources>
</c:AcListPage>