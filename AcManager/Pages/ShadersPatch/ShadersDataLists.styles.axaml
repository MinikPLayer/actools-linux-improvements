<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:t="http://acstuff.club/app/tools" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:c="http://acstuff.club/app/controls" xmlns:sys="using:System" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AssettoCorsa/Pages/ShadersPatch/ShadersDataLists.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="DataGridRow.BaseRowStyle">
    <Setter Property="IsEnabled" Value="True"/>
    <Setter Property="Padding" Value="4 4 4 0"/>
    <Setter Property="ContextMenu">
      <Setter.Value>
        <ContextMenu>
          <MenuItem Header="{Binding LatestVersion, Mode=OneTime}" StaysOpenOnClick="True"/>
          <MenuItem Header="{Binding InstalledVersion}" StaysOpenOnClick="True" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <Separator/>
          <MenuItem Header="Install now" Command="{Binding InstallCommand}" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>
          <MenuItem Header="Reinstall" Command="{Binding InstallCommand}" CommandParameter="force" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </ContextMenu>
      </Setter.Value>
    </Setter>
    <Style Selector="^"><Setter Property="pa:T.S2" Value="{Binding IsAvailable, Mode=OneTime, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S2)=True]"><Setter Property="IsEnabled" Value="False"/>
      </Style></Style>

  <Style Selector="DataGridRow.CarsConfigsRowStyle">
    <Setter Property="IsEnabled" Value="True"/>
    <Setter Property="Padding" Value="4 4 4 0"/>
    <Setter Property="ContextMenu">
      <Setter.Value>
        <ContextMenu>
          <MenuItem Header="Features" StaysOpenOnClick="True">
            <MenuItem Header="Visually adjustable wings" StaysOpenOnClick="True" IsChecked="{Binding HasAdjustableWings, Mode=OneTime}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
            <MenuItem Header="Deforming mesh" StaysOpenOnClick="True" IsChecked="{Binding HasDeformingMesh, Mode=OneTime}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
            <MenuItem Header="Extra indicators" StaysOpenOnClick="True" IsChecked="{Binding HasExtraIndicators, Mode=OneTime}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
            <MenuItem Header="Odometer" StaysOpenOnClick="True" IsChecked="{Binding HasOdometer, Mode=OneTime}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
            <MenuItem Header="Turning signals" StaysOpenOnClick="True" IsChecked="{Binding HasTurnSignals, Mode=OneTime}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
            <MenuItem Header="Tyres textures" StaysOpenOnClick="True" IsChecked="{Binding HasTyresTextures, Mode=OneTime}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
            <MenuItem Header="{Binding DisplayTextures, Mode=OneTime}" StaysOpenOnClick="True" IsVisible="{Binding HasTyresTextures, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
          </MenuItem>
          <MenuItem Header="{Binding LatestVersion, Mode=OneTime}" StaysOpenOnClick="True"/>
          <MenuItem Header="{Binding InstalledVersion}" StaysOpenOnClick="True" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <Separator/>
          <MenuItem Header="Install now" Command="{Binding InstallCommand}" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>
          <MenuItem Header="Reinstall" Command="{Binding InstallCommand}" CommandParameter="force" IsVisible="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </ContextMenu>
      </Setter.Value>
    </Setter>
    <Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding IsAvailable, Mode=OneTime, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S3)=True]"><Setter Property="IsEnabled" Value="False"/>
      </Style></Style>

  </Styles>