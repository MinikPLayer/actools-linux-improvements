<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.ShadersPatch.ShadersDataCarsConfigs">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ShadersDataLists.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ContentControl DataContext="{Binding Source={x:Static t:PatchCarsDataUpdater.Instance}}" Theme="{StaticResource Section}">
    <DataGrid ItemsSource="{Binding View}" IsReadOnly="True" RowDetailsVisibilityMode="Visible" RowDetailsTemplate="{StaticResource NotesDetails}" Theme="{StaticResource DataGrid.Lite}">
      <!-- PORT: removed RowStyle (not in Avalonia) --><DataGrid.Columns>
        <DataGridTemplateColumn Width="3*" Header="For" SortMemberPath="DisplayName" CellTemplate="{StaticResource CarColumnTemplate}"><!-- PORT: removed SortDirection (not in Avalonia) --></DataGridTemplateColumn>
        <DataGridTemplateColumn Width="80" Header="Size" SortMemberPath="Size" CellTemplate="{StaticResource SizeColumnTemplate}"/>
        <DataGridTemplateColumn MinWidth="160" Width="2*" Header="Author" SortMemberPath="Author" CellTemplate="{StaticResource AuthorColumnTemplate}"/>
        <DataGridTemplateColumn Width="80" Header="Tyres" SortMemberPath="HasTyresTextures">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type t:PatchCarDataEntry}">
              <TextBlock x:Name="PART_Text"><TextBlock.Styles><Style Selector="TextBlock#PART_Text"><Style Selector="^ TextBlock#PART_Text"><Setter Property="Text" Value="No"/><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/></Style><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding HasTyresTextures, Mode=OneTime, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S0)=True] TextBlock#PART_Text"><Setter Property="Text" Value="Yes"/>
                  <Setter Property="Foreground" Value="{DynamicResource Go}"/>
                </Style></Style></TextBlock.Styles></TextBlock>
              </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="80" Header="Signals" SortMemberPath="HasTurnSignals">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type t:PatchCarDataEntry}">
              <TextBlock x:Name="PART_Text"><TextBlock.Styles><Style Selector="TextBlock#PART_Text"><Style Selector="^ TextBlock#PART_Text"><Setter Property="Text" Value="No"/><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/></Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding HasTurnSignals, Mode=OneTime, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S1)=True] TextBlock#PART_Text"><Setter Property="Text" Value="Yes"/>
                  <Setter Property="Foreground" Value="{DynamicResource Go}"/>
                </Style></Style></TextBlock.Styles></TextBlock>
              </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="60" SortMemberPath="IsInstalled" CellTemplate="{StaticResource InstalledColumnTemplate}" Header="{StaticResource HeaderInstallContent}"/>
      </DataGrid.Columns>
    </DataGrid>
  </ContentControl>
</UserControl>