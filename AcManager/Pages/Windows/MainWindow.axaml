<mui:ModernWindow xmlns:cdb="clr-namespace:FirstFloor.ModernUI.Presentation;assembly=FirstFloor.ModernUI" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:w="clr-namespace:AcManager.Pages.Windows" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:system="using:System" xmlns:dialogs="clr-namespace:AcManager.Pages.Dialogs" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Windows.MainWindow" Title="{x:Static g:AppStrings.Main_Title}" IsTitleVisible="False" MinWidth="800" MinHeight="640" Width="960" Height="800" DefaultContentSource="/Pages/Drive/QuickDrive.xaml" Loaded="OnLoaded" Unloaded="OnUnloaded" Closing="OnClosing" Closed="OnClosed" KeyDown="OnKeyDown" FrameNavigating="OnFrameNavigating" mui:ModernMenu.Initialize="OnMainMenuInitialize" mui:ModernMenu.SelectedChange="OnMainMenuSelectedChange" SaveKey="MainWindow" LocationAndSizeKey="MainWindow_LS" x:Name="Window" ShowErrorsButton="False" BackButtonVisibility="{Binding ShowMainWindowBackButton, Source={x:Static c:AppAppearanceManager.Instance}, Converter={StaticResource BooleanToVisibilityConverter}}" DragDrop.AllowDrop="True" DragDrop.Drop="OnDrop" DragDrop.DragEnter="OnDragEnter" PointerReleased="OnPreviewMouseRightButtonUp" PointerPressed="OnPreviewMouseRightButtonDown">
  <mui:ModernWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcItemWrapperSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/FancyBackgroundBrush.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://FirstFloor.ModernUI/Themes/ModernWindow.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <Border x:Key="SteamOverlayFix" Background="#FF00FF00" IsHitTestVisible="False" Classes="inline1">
        <Border.Styles>
          <Style Selector="Border.inline1">
            <!-- PORT: EventTrigger not converted --></Style>
        </Border.Styles>
      </Border>

      <system:Boolean x:Key="SystemButtonActive">True</system:Boolean>

      <ControlTheme x:Key="SystemButtonGo" TargetType="Button" BasedOn="{StaticResource SystemButtonBase}">
        <Setter Property="Width" Value="45"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    <Setter Property="Background">
      <Setter.Value>
        <SolidColorBrush Color="#24aaaaaa" Opacity="0"/>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <SolidColorBrush Color="#24aaaaaa" Opacity="0"/>
      </Setter.Value>
    </Setter>
  <Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={StaticResource SystemButtonActive}}"/></Style><Style Selector="^[(pa|T.S0)=True]"><Setter Property="TextElement.Foreground" Value="{DynamicResource GoButtonText}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <mui:Cell>
                    <ContentPresenter x:Name="Presenter" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    <mui:Cell x:Name="Chrome" Background="{DynamicResource GoButtonBackgroundPressed}" Opacity="{Binding Background.Opacity, RelativeSource={RelativeSource TemplatedParent}}">
                      <Border Opacity="{Binding BorderBrush.Opacity, RelativeSource={RelativeSource TemplatedParent}}" Background="Black">
                        <Border Background="{DynamicResource GoButtonBackgroundPressed}" Opacity="0.7"/>
                      </Border>
                      <Border Background="{DynamicResource GoButtonTextPressed}" Width="{Binding ActualWidth, ElementName=Presenter}" Height="{Binding ActualHeight, ElementName=Presenter}">
                        <Border.OpacityMask>
                          <VisualBrush Visual="{Binding ElementName=Presenter}" Stretch="None"/>
                        </Border.OpacityMask>
                      </Border>
                    </mui:Cell>
                  </mui:Cell>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style><!-- PORT: storyboard actions of trigger :pointerover not converted --><!-- PORT: storyboard actions of trigger :pressed not converted --><Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource ButtonTextDisabled}"/>
      </Style></ControlTheme>

      <ControlTheme x:Key="SystemButtonGo.ResizeTweaked" TargetType="Button" BasedOn="{StaticResource SystemButtonBase}">
        <Setter Property="Width" Value="45"/>
    <Setter Property="Height" Value="29"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    <Setter Property="Background">
      <Setter.Value>
        <SolidColorBrush Color="#24aaaaaa" Opacity="0"/>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <SolidColorBrush Color="#24aaaaaa" Opacity="0"/>
      </Setter.Value>
    </Setter>
  <Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={StaticResource SystemButtonActive}}"/></Style><Style Selector="^[(pa|T.S1)=True]"><Setter Property="TextElement.Foreground" Value="{DynamicResource GoButtonText}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <mui:Cell IsHitTestVisible="False" Opacity="0.2">
                    <ContentPresenter x:Name="Presenter" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    <mui:Cell x:Name="Chrome" Background="{DynamicResource GoButtonBackgroundPressed}" Opacity="{Binding Background.Opacity, RelativeSource={RelativeSource TemplatedParent}}">
                      <Border Opacity="{Binding BorderBrush.Opacity, RelativeSource={RelativeSource TemplatedParent}}" Background="Black">
                        <Border Background="{DynamicResource GoButtonBackgroundPressed}" Opacity="0.7"/>
                      </Border>
                      <Border Background="{DynamicResource GoButtonTextPressed}" Width="{Binding ActualWidth, ElementName=Presenter}" Height="{Binding ActualHeight, ElementName=Presenter}">
                        <Border.OpacityMask>
                          <VisualBrush Visual="{Binding ElementName=Presenter}" Stretch="None"/>
                        </Border.OpacityMask>
                      </Border>
                    </mui:Cell>
                  </mui:Cell>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style><!-- PORT: storyboard actions of trigger :pointerover not converted --><!-- PORT: storyboard actions of trigger :pressed not converted --><Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource ButtonTextDisabled}"/>
      </Style></ControlTheme>

      <DataTemplate x:Key="MenuButtonContent">
        <mui:Cell x:Name="__Dt2">
          <mui:Cell.Styles><Style Selector="mui|Cell#__Dt2"><Style Selector="^ mui|Cell#UpdateContentMark"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding ToUpdate.Count, Source={x:Static c:CupViewModel.Instance}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S4" Value="{Binding IsUpdateReady, Source={x:Static t:AppUpdater.Instance}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S3)=True] mui|Cell#UpdateContentMark"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S3)=True] Canvas#MainCanvas"><Setter Property="Clip" Value="{DynamicResource MarkClipIcon}"/>
          </Style><Style Selector="^[(pa|T.S4)=True] mui|Cell#UpdateContentMark"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S4)=True] Canvas#MainCanvas"><Setter Property="Clip" Value="{DynamicResource MarkClipIcon}"/>
            </Style><!-- PORT: storyboard actions of trigger [(mui|StoryboardHelper.ContinuousFired)=True] not converted --><!-- PORT: storyboard actions of trigger [(mui|StoryboardHelper.ContinuousFiringActive)=True] not converted --></Style></mui:Cell.Styles><mui:Cell.Resources>
          <PathGeometry x:Key="MarkClip">F1 M 0,0L 5.10002,0C 5.03443,0.323109 5,0.657536 5,1C 5,3.41896 6.71776,5.43672 9,5.89999L 9,9L 0,9L 0,0 Z</PathGeometry>
          <PathGeometry x:Key="MarkClipIcon">F1 M0,0 L5.1,0 L5.1,4 L9,4 L9,9 L0,9 L0,0 Z</PathGeometry>
          <!-- PORT: removed Storyboard -->
          <!-- PORT: removed Storyboard -->
          <!-- PORT: removed Storyboard -->
        </mui:Cell.Resources>
        <Canvas x:Name="MainCanvas" Width="9" Height="9" ClipToBounds="True" mui:StoryboardHelper.ContinuousFiring="{Binding}" mui:StoryboardHelper.ContinuousFiringInterval="0:0:1">
            <Canvas Width="9" Height="9">
              <Canvas.RenderTransform>
                <TranslateTransform Y="-8"/>
              </Canvas.RenderTransform>
              <Line Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StartPoint="4.51,0" EndPoint="4.51,8.5" StrokeThickness="{Binding IconPathThickness, RelativeSource={RelativeSource AncestorType={x:Type mui:DpiAwareWindow}}}"/>
              <Path Data="M-0.01,3.99 L4.51,7.49 M4.49,7.49 L9.01,3.99" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="{Binding IconPathThickness, RelativeSource={RelativeSource AncestorType={x:Type mui:DpiAwareWindow}}}"/>
            </Canvas>
            <Line Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StartPoint="-1,0.75" EndPoint="10,0.75" StrokeThickness="{Binding IconPathThickness, RelativeSource={RelativeSource AncestorType={x:Type mui:DpiAwareWindow}}}">
              <Line.RenderTransform>
                <TranslateTransform/>
              </Line.RenderTransform>
            </Line>
            <Line Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StartPoint="-1,4.75" EndPoint="10,4.75" StrokeThickness="{Binding IconPathThickness, RelativeSource={RelativeSource AncestorType={x:Type mui:DpiAwareWindow}}}">
              <Line.RenderTransform>
                <TranslateTransform/>
              </Line.RenderTransform>
            </Line>
            <Line Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StartPoint="-1,8.75" EndPoint="10,8.75" StrokeThickness="{Binding IconPathThickness, RelativeSource={RelativeSource AncestorType={x:Type mui:DpiAwareWindow}}}"/>
          </Canvas>
          <Ellipse x:Name="UpdateMark" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -2 -4 0" Width="6" Height="6" Fill="{DynamicResource Accent}" IsVisible="False"/>
          <mui:Cell x:Name="UpdateContentMark" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -4 -4 0" Width="6" Height="6">
            <Ellipse x:Name="UpdateMarkGlow" Width="14" Height="14" Stretch="Uniform" Margin="-4">
              <Ellipse.Effect>
                <BlurEffect Radius="4"><!-- PORT: removed KernelType (not in Avalonia) --><!-- PORT: removed RenderingBias (not in Avalonia) --></BlurEffect>
              </Ellipse.Effect>
              <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                  <RadialGradientBrush.GradientStops>
                    <GradientStop Color="{DynamicResource GoColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                  </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
              </Ellipse.Fill>
              <!-- PORT: removed Ellipse.Triggers -->
            </Ellipse>
            <Path Width="6" Height="6" Fill="{DynamicResource Go}" Data="{StaticResource UpdateIconData}" Stretch="Uniform"/>
          </mui:Cell>
        </mui:Cell>
        </DataTemplate>

      <DockPanel x:Key="DownloadsMenuSection">
        <Separator DockPanel.Dock="Top"/>
        <TextBlock DockPanel.Dock="Top" Text="{x:Static g:AppStrings.MainWindow_Downloads}" Margin="8 8 8 8" Classes="Label"/>
        <mui:SpacingUniformGrid Rows="1" HorizontalAlignment="Right" DockPanel.Dock="Bottom" DataContext="{x:Static t:ContentInstallationManager.Instance}" Margin="8 0 4 0">
          <Button Command="{Binding InstallAllCommand}" Margin="0 8 4 8" IsVisible="{Binding HasMoreThanOneWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
              <Path Width="12" Height="12" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource AddMultipleIconData}"/>
              <TextBlock Text="{x:Static g:AppStrings.MainWindow_Downloads_InstallAll}"/>
            </DockPanel>
          </Button>
          <Button Command="{Binding RemoveCompletedCommand}" Margin="0 8 4 8" IsVisible="{Binding RemoveCompletedCommand.IsAbleToExecute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
              <Path Width="12" Height="12" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource CleanUpIconData}"/>
              <TextBlock Text="{x:Static g:AppStrings.MainWindow_Downloads_RemoveCompleted}"/>
            </DockPanel>
          </Button>
        </mui:SpacingUniformGrid>
        <Border Tag="DownloadsParent" MaxHeight="400"/>
      </DockPanel>

      <DockPanel x:Key="CupNotificationBlock" DataContext="{x:Static c:CupViewModel.Instance}" IsVisible="{Binding ToUpdate.Count, Converter={StaticResource MoreToVisibilityConverter}}">
        <Separator DockPanel.Dock="Top"/>
        <TextBlock DockPanel.Dock="Top" Margin="8 8 8 0" Text="{Binding Path=ToUpdate.Count, Converter={StaticResource PluralizingConverter}, ConverterParameter={x:Static g:AppStrings.MainWindow_FoundNModUpdates}}" Classes="Label"/>
        <ItemsControl MaxHeight="320" ItemsSource="{Binding ToUpdate}" DockPanel.Dock="Top" Margin="12 6 12 6" Theme="{StaticResource VirtualizingItemsControl}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0 2">
                <Button DockPanel.Dock="Right" Margin="4 0 0 0" Padding="4 0" c:CupUi.InformationMode="True" c:CupUi.Object="{Binding}" IsVisible="False">
                  <Path Data="{StaticResource UpdateIconData}" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource GoButtonText}" StrokeThickness="0" Stretch="Uniform"/>
                </Button>
                <ContentControl Content="{Binding}" Margin="0 2 0 2">
                  <ContentControl.DataTemplates><DataTemplate DataType="{x:Type t:CarObject}">
                      <DockPanel mui:Draggable.Enabled="True" Background="Transparent" c:ToolTips.GenericObject="{Binding}" c:ContextMenus.GenericObject="{Binding}" x:Name="__Dt5">
                        <DockPanel.Styles><Style Selector="DockPanel#__Dt5"><Style Selector="^ Path#PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ Ellipse#PART_NewIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S6" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S7" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S8" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S9" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S6)=True] Path#PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
                        </Style><Style Selector="^[(pa|T.S7)=True] Path#PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
                        </Style><Style Selector="^[(pa|T.S8)=True] c|RatingBar#PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
                        </Style><Style Selector="^[(pa|T.S9)=True] Ellipse#PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
                        </Style></Style></DockPanel.Styles><c:CarIcon Car="{Binding}" Width="14" Height="14" Margin="0 0 6 0"/>
                        <c:OriginIcon Author="{Binding Author}" DockPanel.Dock="Right" x:Name="PART_OriginIcon"/>
                        <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
                        <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource FavouriteBrush}" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>
                        <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Mode="WithoutBbCodes" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"/>
                      </DockPanel>
                      </DataTemplate>
                  </ContentControl.DataTemplates></ContentControl>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--<mui:BbCodeBlock Text="{Binding CupUpdateSummary}" DockPanel.Dock="Top" Margin="8 0 8 8" Style="{StaticResource Small}" />-->
        <mui:SpacingUniformGrid Rows="1" HorizontalAlignment="Right" Margin="8 0 8 4" HorizontalSpacing="8">
          <Button IsVisible="False">
            <DockPanel>
              <Path Width="12" Height="12" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource ListCheckIconData}"/>
              <TextBlock Text="{x:Static g:AppStrings.MainWindow_ContentUpdate_ViewDetails}"/>
            </DockPanel>
          </Button>
          <Button Command="{Binding InstallAllCommand}">
            <DockPanel>
              <Path Width="12" Height="12" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource DownloadIconData}"/>
              <TextBlock Text="{x:Static g:AppStrings.MainWindow_Downloads_InstallAll}"/>
            </DockPanel>
          </Button>
        </mui:SpacingUniformGrid>
      </DockPanel>

      <mui:Cell x:Key="RunningInstances" Height="28" Width="80" Margin="0 0 20 0" VerticalAlignment="Top">
        <ToggleButton Padding="0" Height="28" Width="80" BorderThickness="0" Click="OnRunningInstancesButtonClick">
          <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Width="8" Height="8" DockPanel.Dock="Left" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center" Data="{StaticResource PlayIconData}"/>
            <TextBlock Text="Races" FontSize="{StaticResource SmallFontSize}"/>
          </DockPanel>
        </ToggleButton>
      </mui:Cell>

      <ListBox x:Key="RunningInstancesPopupContent" ItemsSource="{Binding Source={x:Static dialogs:GameDialog.HiddenInstances}}" SelectionChanged="OnRunningInstancesItemClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="200" Margin="8 4 8 4">
              <TextBlock Text="{Binding DisplayState}"/>
              <TextBlock Text="{Binding DisplayDetails}" FontSize="{StaticResource SmallFontSize}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </ResourceDictionary>
  </mui:ModernWindow.Resources>

  <mui:ModernWindow.TitleButtons>

    <mui:Cell Width="45">
      <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
      <Border mui:FancyHintsService.Hint="{Binding Id, Source={x:Static c:FancyHints.ContentUpdatesArrived}}" mui:FancyHintsService.OffsetX="22" mui:FancyHintsService.OffsetY="-14" mui:FancyHintsService.HorizontalAlignment="Left" mui:FancyHintsService.VerticalAlignment="Bottom" mui:FancyHintsService.HorizontalContentAlignment="Right" mui:FancyHintsService.VerticalContentAlignment="Top">
        <ToggleButton x:Name="DownloadsButton" Width="45" Tag="{Binding HasUnfinishedItems, Source={x:Static t:ContentInstallationManager.Instance}}" mui:FancyHintsService.Hint="{Binding Id, Source={x:Static c:FancyHints.DownloadsList}}" mui:FancyHintsService.OffsetX="22" mui:FancyHintsService.OffsetY="-14" mui:FancyHintsService.HorizontalAlignment="Left" mui:FancyHintsService.VerticalAlignment="Bottom" mui:FancyHintsService.HorizontalContentAlignment="Right" mui:FancyHintsService.VerticalContentAlignment="Top" IsHitTestVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type Panel}}, Path=Children[1].IsOpen, Mode=OneWay, Converter={StaticResource InvertBooleanConverter}}" DragDrop.Drop="OnContentTitleLinkDrop" DragDrop.AllowDrop="True" PointerReleased="OnDownloadsButtonClick" Theme="{StaticResource SystemButtonGo}">
          <ToolTip.Tip>
            <mui:Switch Value="{Binding UnfinishedItemsCount, Source={x:Static t:ContentInstallationManager.Instance}}" MaxWidth="480">
              <TextBlock mui:Switch.When="0" Text="{x:Static g:AppStrings.MainWindow_Downloads_Tooltip}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap">
                <TextBlock.Text>
                  <Binding Path="UnfinishedItemsCount" Source="{x:Static t:ContentInstallationManager.Instance}" StringFormat="{x:Static g:AppStrings.MainWindow_Downloads_TooltipFormat}"/>
                </TextBlock.Text>
              </TextBlock>
            </mui:Switch>
          </ToolTip.Tip>
          <ToggleButton.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.MainWindow_Downloads_InstallAll}" Command="{Binding InstallAllCommand, Source={x:Static t:ContentInstallationManager.Instance}}">
                <MenuItem.Icon>
                  <Path Width="10" Height="10" Margin="0 2 0 0" Stretch="Uniform" Data="{StaticResource AddMultipleIconData}" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Header="{x:Static g:AppStrings.MainWindow_Downloads_RemoveCompleted}" Command="{Binding RemoveCompletedCommand, Source={x:Static t:ContentInstallationManager.Instance}}">
                <MenuItem.Icon>
                  <Path Width="10" Height="10" Margin="0 2 0 0" Stretch="Uniform" Data="{StaticResource CleanUpIconData}" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{x:Static g:AppStrings.MainWindow_Downloads_RemoveAll}" Command="{Binding RemoveAllCommand, Source={x:Static t:ContentInstallationManager.Instance}}">
                <MenuItem.Icon>
                  <Path Width="10" Height="10" Margin="0 2 0 0" Stretch="Uniform" Data="{StaticResource TrashBinIconData}" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ToggleButton.ContextMenu>
          <ContentControl ContentTemplate="{StaticResource MenuButtonContent}" Content="{Binding HasLoadingItems, Source={x:Static t:ContentInstallationManager.Instance}}"/>
        </ToggleButton>
      </Border>
      <c:ModernPopup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=DownloadsButton, Mode=TwoWay}" Padding="0" Opened="OnDownloadsPopupOpened">
        <StackPanel Width="420">

          <StackPanel IsVisible="{Binding AppUpdater.ReadyToUpdateVersion, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
            <MenuItem Command="{Binding AppUpdater.FinishUpdateCommand}">
              <MenuItem.Resources>
                <!-- ReSharper disable once Xaml.RedundantResource -->
                <SolidColorBrush x:Key="ItemText" cdb:DynamicColorBrush.ColorKey="AccentColor"/>
              </MenuItem.Resources>
              <MenuItem.Icon>
                <Path Width="12" Height="12" Margin="4 2 -2 -2" Stretch="Uniform" Data="{StaticResource UpdateIconData}" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
              </MenuItem.Icon>
              <MenuItem.Header>
                <mui:BbCodeBlock Text="{Binding AppUpdater.ReadyToUpdateVersion, StringFormat={x:Static mui:UiStrings.UpdateAvailable}}"/>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="{x:Static g:AppStrings.MainWindow_UpdateMenu_ViewChangelog}" Command="{Binding ViewChangelogCommand}"/>
            <MenuItem Header="{x:Static g:AppStrings.MainWindow_UpdateMenu_SkipUpdate}" Command="{Binding AppUpdater.IgnoreUpdateCommand}"/>
            <MenuItem Header="{x:Static g:AppStrings.MainWindow_UpdateMenu_DisableAutoUpdates}" Command="{Binding AppUpdater.DisableAutoUpdatesCommand}"/>
            <Separator/>
          </StackPanel>

          <MenuItem Header="{x:Static g:AppStrings.MainWindow_AddDownload_MenuItem}" Click="OnDownloadSomethingItemClick">
            <!-- PORT: removed InputGestureText (not in Avalonia) --><MenuItem.Icon>
              <Path Width="12" Height="12" Margin="4 0 -2 0" Stretch="Uniform" Data="{StaticResource DownloadIconData}" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{x:Static g:AppStrings.MainWindow_InstallFromAFile_MenuItem}" Click="OnInstallFromAFileItemClick">
            <MenuItem.Icon>
              <Path Width="12" Height="12" Margin="4 0 -2 0" Stretch="Uniform" Data="{StaticResource OpenFolderIconData}" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            </MenuItem.Icon>
          </MenuItem>
          <Separator/>
          <MenuItem Header="{x:Static g:AppStrings.Main_Drive}" Click="OnNavigateItemClick" CommandParameter="/Pages/Drive/QuickDrive.xaml">
            <!-- PORT: removed InputGestureText (not in Avalonia) --><MenuItem.Icon>
              <Path Width="12" Height="12" Margin="4 0 -2 0" Stretch="Uniform" Data="{StaticResource CarsIconData}" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{x:Static g:AppStrings.Main_LapTimes}" Click="OnNavigateItemClick" CommandParameter="/Pages/Miscellaneous/LapTimes_Recent.xaml">
