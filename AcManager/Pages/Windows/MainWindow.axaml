          <ContextMenu>
            <MenuItem Header="{x:Static g:AppStrings.Main_Screenshots}" CommandParameter="/Pages/Lists/ScreenshotsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Replays}" CommandParameter="/Pages/Lists/ReplaysListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
          </ContextMenu>
        </TextBlock.ContextMenu>
      </TextBlock>
    </mui:TitleLink>
    <!-- ReSharper disable once Xaml.PathError -->
    <!--<mui:TitleLink GroupKey="workshop" Source="/Pages/Workshop/WorkshopContentCategories.xaml?Content=cars&amp;Category=car-brands&amp;SearchBy=carBrand">
