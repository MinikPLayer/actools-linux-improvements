    <mui:TitleLink GroupKey="content" Source="/Pages/Lists/CarsListPage.xaml">
      <TextBlock Text="{Binding Source={x:Static g:AppStrings.Main_Content}, Converter={StaticResource ToUpperConverter}}" Background="Transparent" Margin="0 -4" Padding="0 4" DragDrop.Drop="OnContentTitleLinkDrop" DragDrop.AllowDrop="True">
        <TextBlock.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static g:AppStrings.Main_Cars}" CommandParameter="/Pages/Lists/CarsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Tracks}" CommandParameter="/Pages/Lists/TracksListPage.xaml" mui:LimitedService.Limited="True" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <Separator/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Apps}" CommandParameter="/Pages/Lists/PythonAppsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_DriverModels}" CommandParameter="/Pages/Lists/DriverModelsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Fonts}" CommandParameter="/Pages/Lists/FontsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_PpFilters}" CommandParameter="/Pages/Lists/PpFiltersListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Showrooms}" CommandParameter="/Pages/Lists/ShowroomsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_UserChampionships}" CommandParameter="/Pages/Lists/UserChampionshipsListPage.xaml" mui:LimitedService.Limited="True" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Weather}" CommandParameter="/Pages/Lists/WeatherListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <Separator/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Mods}" CommandParameter="/Pages/Lists/GenericModsListPage.xaml" mui:LimitedService.Limited="True" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_Tools}" CommandParameter="/Pages/Lists/ToolsListPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <Separator/>
            <MenuItem Header="{x:Static g:AppStrings.Main_GetNewMods}" CommandParameter="/Pages/Miscellaneous/ModsWebBrowser.xaml" Icon="{StaticResource DownloadIconData}" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
          </ContextMenu>
        </TextBlock.ContextMenu>
      </TextBlock>
    </mui:TitleLink>
    <mui:TitleLink DisplayName="{x:Static g:AppStrings.Main_Downloads}" GroupKey="downloads" Source="/Pages/Miscellaneous/DownloadsList.xaml"/>
    <mui:TitleLink DisplayName="{x:Static g:AppStrings.Main_Server}" GroupKey="server" IsEnabled="False" Source="/Pages/Lists/ServerPresetsListPage.xaml"/>
    <mui:TitleLink GroupKey="settings" Source="/Pages/Settings/SettingsPage.xaml">
      <TextBlock Text="{Binding Source={x:Static g:AppStrings.Main_Settings}, Converter={StaticResource ToUpperConverter}}" Background="Transparent" Margin="0 -4" Padding="0 4">
        <TextBlock.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static g:AppStrings.Main_ContentManager}" CommandParameter="/Pages/Settings/SettingsPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_AssettoCorsa}" CommandParameter="/Pages/AcSettings/AcSettingsPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="Custom Shaders Patch" CommandParameter="/Pages/Settings/SettingsShadersPatch.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
          </ContextMenu>
        </TextBlock.ContextMenu>
      </TextBlock>
    </mui:TitleLink>
    <mui:TitleLink GroupKey="about" Source="/Pages/About/AboutPage.xaml">
      <TextBlock Text="{Binding Source={x:Static g:AppStrings.Main_About}, Converter={StaticResource ToUpperConverter}}" Background="Transparent" Margin="0 -4" Padding="0 4">
        <TextBlock.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static g:AppStrings.Main_About}" CommandParameter="/Pages/About/AboutPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_ReleaseNotes}" CommandParameter="/Pages/About/ReleaseNotesPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_ImportantTips}" CommandParameter="/Pages/About/ImportantTipsPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
            <MenuItem Header="{x:Static g:AppStrings.Main_EverythingAboutFiltering}" CommandParameter="/Pages/About/FiltersPage.xaml" Command="{x:Static mui:LinkCommands.NavigateLinkMainWindow}"/>
          </ContextMenu>
        </TextBlock.ContextMenu>
      </TextBlock>
    </mui:TitleLink>
    <mui:TitleLink x:Name="OriginalLauncher" Content="{x:Static g:AppStrings.Main_OriginalLauncherLink}" Source="{x:Static w:MainWindow.OriginalLauncherUrl}"/>
    <mui:TitleLink Content="{x:Static w:MainWindow.EnterKeyLabel}" Source="{x:Static w:MainWindow.EnterKeyUrl}" IsAccented="{x:Static w:MainWindow.EnterKeyAccent}"/>
    <mui:TitleLink GroupKey="settings/video" Source="/Pages/AcSettings/AcSettingsVideo.xaml">
      <mui:ReferenceSwitch Value="{Binding LastSessionPerformanceData, Source={x:Static t:AcSettingsHolder.Video}}">
        <mui:ReferenceSwitch.Null>
          <TextBlock Text="{x:Static g:AppStrings.Main_FPS_Unknown}" ToolTip.Tip="{x:Static g:AppStrings.Main_FPS_Tooltip}"/>
        </mui:ReferenceSwitch.Null>
        <mui:ReferenceSwitch.NonNull>
          <DockPanel Margin="0" DataContext="{Binding Source={x:Static t:AcSettingsHolder.Video}}">
            <ToolTip.Tip>
              <DockPanel Margin="0 0 12 0">
                <TextBlock Text="{x:Static g:AppStrings.Main_FPS_Title}" DockPanel.Dock="Top" Margin="4 0 0 4" Classes="Small"/>
                <c:PropertiesGrid Columns="1" Margin="-2 0 0 0">
                  <TextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.Main_FPS_Average}">
                    <TextBlock.Text>
                      <Binding Path="LastSessionPerformanceData.AverageFps" StringFormat="{x:Static g:AppStrings.Main_FPS_ValueFormat}"/>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.Main_FPS_Minimum}">
                    <TextBlock.Text>
                      <Binding Path="LastSessionPerformanceData.MinimumFps" StringFormat="{x:Static g:AppStrings.Main_FPS_ValueFormat}" TargetNullValue="?"/>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.Main_FPS_Taken}">
                    <TextBlock.Text>
                      <Binding Path="LastSessionPerformanceData.SamplesTaken" Converter="{StaticResource PluralizingConverter}" ConverterParameter="{x:Static g:AppStrings.Main_FPS_TakenFormat}"/>
                    </TextBlock.Text>
                  </TextBlock>
                </c:PropertiesGrid>
              </DockPanel>
            </ToolTip.Tip>
            <TextBlock>
              <TextBlock.Text>
                <Binding Path="LastSessionPerformanceData.AverageFps" StringFormat="{x:Static g:AppStrings.Main_FPS_ValueShortFormat}"/>
              </TextBlock.Text>
            </TextBlock>
          </DockPanel>
        </mui:ReferenceSwitch.NonNull>
      </mui:ReferenceSwitch>
    </mui:TitleLink>
  </mui:ModernWindow.TitleLinks>

  <mui:Cell x:Name="OverlayContentCell" ClipToBounds="True">
    <Border x:Name="Popup" HorizontalAlignment="Left" Width="330" Classes="inline2">
      <Border.Styles>
        <Style Selector="Border.inline2">
          <Setter Property="Focusable" Value="True"/>
          <Setter Property="RenderTransform">
            <Setter.Value>
              <TranslateTransform X="-340"/>
            </Setter.Value>
          </Setter>
          <!-- PORT: EventTrigger not converted --><!-- PORT: EventTrigger not converted --></Style>
      </Border.Styles>
    </Border>
    <Popup Height="80" Width="120" x:Name="QuickSwitchesNotification" Placement="BottomEdgeAlignedRight" HorizontalOffset="-20" VerticalOffset="-20">
      <!-- PORT: removed StaysOpen (not in Avalonia) --><Border Background="{DynamicResource WindowBackground}" Padding="12" CornerRadius="0" BorderBrush="{DynamicResource WindowBorderActive}" BorderThickness="1">
        <DockPanel>
          <TextBlock x:Name="QuickSwitchesNotificationText" DockPanel.Dock="Bottom" Margin="0 4 0 0" HorizontalAlignment="Center" Classes="Label"/>
          <Path x:Name="QuickSwitchesNotificationIcon" Width="24" Height="24" Fill="{Binding Foreground, ElementName=QuickSwitchesNotificationText}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Popup>
  </mui:Cell>
</mui:ModernWindow>