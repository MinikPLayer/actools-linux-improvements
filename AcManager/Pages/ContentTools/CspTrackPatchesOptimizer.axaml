<tools:ContentTool xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tools="clr-namespace:AcManager.Pages.ContentTools" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:c="http://acstuff.club/app/controls" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.ContentTools.CspTrackPatchesOptimizer">
  <tools:ContentTool.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/Plugins.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </tools:ContentTool.Resources>

  <mui:Cell mui:Switch.When="{x:Static tools:Stage.Loading}" Width="400" HorizontalAlignment="Center">
    <mui:SpacingStackPanel Spacing="8" VerticalAlignment="Center">
      <ProgressBar IsIndeterminate="{Binding ProgressValue.IsIndeterminate}" Maximum="1" Value="{Binding ProgressValue.Progress, Mode=OneWay}" Height="4"/>
      <TextBlock Text="{Binding ProgressValue.Message}"/>
    </mui:SpacingStackPanel>
  </mui:Cell>

  <DockPanel mui:Switch.When="{x:Static tools:Stage.Empty}" Margin="0 0 0 100" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{x:Static g:AppStrings.Online_NothingToDisplay}" Classes="Heading1"/>
  </DockPanel>

  <DockPanel mui:Switch.When="{x:Static tools:Stage.Error}" Margin="0 0 0 100" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{x:Static g:AppStrings.ContentTools_BatchPreviewsUpdater_SomeErrorHappened}" DockPanel.Dock="Top" Classes="Heading1"/>
    <TextBlock Text="{Binding Error}" Margin="0 20 0 0"/>
  </DockPanel>

  <mui:BooleanSwitch mui:Switch.When="{x:Static tools:Stage.Ready}" Value="{Binding IsReady, Source={x:Static tools:Bc7Encoder.Requirement}}">
    <mui:BooleanSwitch.False>
      <DockPanel Margin="40 0 40 100" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{x:Static c:ControlsStrings.Common_Error}" DockPanel.Dock="Top" Margin="0 0 0 8" Classes="Heading1"/>
        <mui:Switch Value="{Binding ListView.Count}" DataContext="{Binding Source={x:Static tools:Bc7Encoder.Requirement}}">
          <DockPanel mui:Switch.When="0">
            <Path Data="{StaticResource AlertIconData}" Fill="{DynamicResource Error}" Stretch="Uniform" Width="16" Height="16" Margin="0 0 8 0"/>
            <TextBlock Text="BC7 plugin is required for the tool to work." TextWrapping="Wrap"/>
          </DockPanel>
          <mui:SpacingStackPanel Spacing="4">
            <DockPanel mui:Switch.When="0">
              <Path Data="{StaticResource AlertIconData}" Fill="{DynamicResource Error}" Stretch="Uniform" Width="16" Height="16" Margin="0 0 8 0"/>
              <TextBlock Text="Plugin is required for the tool to work:" TextWrapping="Wrap"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding ListView}" ItemTemplate="{StaticResource PluginItemTemplate.NoOptions}" Margin="0 8 0 -12"/>
          </mui:SpacingStackPanel>
        </mui:Switch>
      </DockPanel>
    </mui:BooleanSwitch.False>
    <mui:BooleanSwitch.True>
      <DockPanel>
        <mui:SpacingStackPanel Spacing="8" Margin="0 0 0 20" DockPanel.Dock="Top">
          <TextBlock TextWrapping="Wrap" Text="When loading a new KN5 mentioned in “[MODEL_REPLACEMENT_…]” section, CSP won’t load textures if textures with the same name have already been loaded from a different KN5. Because of that, packing unedited original texture is pointless, and removing them can help to save disk space and improve loading performance. Plus, it could help to prevent possible copyright issues."/>
          <TextBlock TextWrapping="Wrap" Text="If you’re working on CSP configs and using those replacements, please consider running this tool before committing changes to the repo."/>
        </mui:SpacingStackPanel>
        <Button DockPanel.Dock="Bottom" Content="Optimize all" Command="{Binding OptimizeAllCommand}" IsVisible="{Binding Found.Count, Converter={StaticResource MoreToVisibilityConverter}, ConverterParameter=1}"/>
        <ItemsControl ItemsSource="{Binding Found}" Theme="{StaticResource VirtualizingItemsControl}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel x:Name="PART_Item" Margin="0 0 0 8" Background="Transparent">
                <DockPanel.Styles><Style Selector="DockPanel#PART_Item"><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding Optimized, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S0)=True] DockPanel#PART_Item"><Setter Property="Opacity" Value="0.6"/>
                  <Setter Property="ToolTip.Tip" Value="Already optimized"/>
                </Style></Style></DockPanel.Styles><Button Margin="8 0 0 0" DockPanel.Dock="Right" Command="{Binding OptimizeCommand}">Optimize</Button>
                <mui:PathTrimmingTextBlock Text="{Binding Kn5}" DockPanel.Dock="Top" Margin="0 0 0 4"/>
                <TextBlock Text="{Binding DisplayTexturesToRemove}" TextWrapping="Wrap" Classes="Small"/>
              </DockPanel>
              </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </mui:BooleanSwitch.True>
  </mui:BooleanSwitch>
</tools:ContentTool>