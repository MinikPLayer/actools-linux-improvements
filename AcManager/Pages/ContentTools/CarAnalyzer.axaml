<tools:ContentTool xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:tools="clr-namespace:AcManager.Pages.ContentTools" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.ContentTools.CarAnalyzer">
  <tools:ContentTool.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </tools:ContentTool.Resources>

  <mui:SpacingStackPanel mui:Switch.When="{x:Static tools:Stage.Loading}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
    <ProgressBar IsIndeterminate="{Binding ProgressValue.IsIndeterminate}" Maximum="1" Value="{Binding ProgressValue.Progress, Mode=OneWay}" Height="4"/>
    <TextBlock Text="{Binding ProgressValue.Message}"/>
  </mui:SpacingStackPanel>

  <DockPanel mui:Switch.When="{x:Static tools:Stage.Empty}" Margin="0 0 0 100" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{x:Static g:AppStrings.Online_NothingToDisplay}" Classes="Heading1"/>
  </DockPanel>

  <DockPanel mui:Switch.When="{x:Static tools:Stage.Error}" Margin="0 0 0 100" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{x:Static g:AppStrings.ContentTools_BatchPreviewsUpdater_SomeErrorHappened}" DockPanel.Dock="Top" Classes="Heading1"/>
    <TextBlock Text="{Binding Error}" Margin="0 20 0 0"/>
  </DockPanel>

  <Grid mui:Switch.When="{x:Static tools:Stage.Ready}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="9"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <ListBox ItemsSource="{Binding BrokenCars}" SelectedItem="{Binding BrokenCar}" Theme="{StaticResource VirtualizingListBox}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type tools:CarAnalyzer+BrokenDetails}">
          <DockPanel Margin="8 4">
            <TextBlock Text="{Binding LeftUnsolved}" VerticalAlignment="Center" DockPanel.Dock="Right" Classes="Small"/>
            <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Error}" Stretch="Uniform" Margin="2 2 4 0" VerticalAlignment="Center" IsVisible="{Binding Car.Author, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static t:AcCommonObject.AuthorKunos}}"/>
            <TextBlock Text="{Binding Car.DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0 0 4 0"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <mui:ModernTabSplitter Grid.Column="1" SaveKey="MigrationHelper"/>

    <ScrollViewer Grid.Column="2" DataContext="{Binding BrokenCar}" Margin="20 0 20 0" mui:FancyScroll.Outside="True">
      <mui:SpacingStackPanel Spacing="20">
        <DockPanel>
          <mui:BetterImage Width="24" Height="24" DockPanel.Dock="Left" Margin="0 0 8 0" Filename="{Binding Car.BrandBadge}"/>
          <TextBlock Text="{Binding Car.DisplayName}" VerticalAlignment="Center" Classes="Heading2"/>
        </DockPanel>

        <DockPanel IsVisible="{Binding Car.Author, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static t:AcCommonObject.AuthorKunos}}">
          <Path Data="{StaticResource AlertIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Error}" Stretch="Uniform" Margin="2 2 4 0" VerticalAlignment="Center"/>
          <TextBlock Foreground="{DynamicResource Error}" TextWrapping="Wrap" Classes="Small">
            <TextBlock.Text>This is a car from Kunos, please, be very careful. In fact, I wouldn’t recommend to use this tool on it at all.</TextBlock.Text>
          </TextBlock>
        </DockPanel>

        <mui:BooleanSwitch Value="{Binding RatingMode}">
          <mui:SpacingStackPanel Spacing="4" MinHeight="120">
            <TextBlock Text="{x:Static g:AppStrings.ContentTools_CarAnalyzer_MoreDetails}" Classes="Label Label.Padding"/>
            <mui:ReferenceSwitch Value="{Binding Ratings}">
              <mui:ReferenceSwitch.Null>
                <ProgressBar IsIndeterminate="True"/>
              </mui:ReferenceSwitch.Null>
            </mui:ReferenceSwitch>
            <mui:BooleanSwitch Value="{Binding RatingLoading}">
              <mui:BooleanSwitch.False>
                <ItemsControl ItemsSource="{Binding Ratings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Height="32" Margin="0 0 8 4">
                        <TextBlock Foreground="Black" DockPanel.Dock="Left" Padding="0 8 0 9" Text="{Binding Rate, Converter={x:Static tools:CarAnalyzer.RatingToTextConverter}}" Background="{Binding Rate, Converter={x:Static tools:CarAnalyzer.RatingToColorConverter}}" Margin="0 0 8 0" Width="32" TextAlignment="Center" Classes="Label">
                          <ToolTip.Tip>
                            <ToolTip Content="{Binding Rate}" IsVisible="{Binding Rate, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>
                          </ToolTip.Tip>
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Content="{x:Static g:AppStrings.ContentTools_CarAnalyzer_More}" Command="{Binding ShowInformationCommand}" Margin="8 0 0 0" IsVisible="{Binding ShowInformationCommand.IsAbleToExecute, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Message}" DockPanel.Dock="Top" Margin="0 -1 0 0"/>
                        <TextBlock Text="{Binding Details}" Margin="0 1 0 0" Classes="Small"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </mui:BooleanSwitch.False>
            </mui:BooleanSwitch>
          </mui:SpacingStackPanel>
        </mui:BooleanSwitch>

        <TextBlock Text="{Binding LeftUnsolved, Converter={StaticResource PluralizingConverter}, ConverterParameter='{}{0} unsolved {issue}:'}" Classes="Label Label.Padding"/>

        <mui:Switch Value="{Binding Aspects.Count}">
          <TextBlock mui:Switch.When="0" Opacity="0.5" Text="{x:Static g:AppStrings.ContentTools_CarAnalyzer_NoIssuesFound}"/>
          <ItemsControl ItemsSource="{Binding Aspects}" IsEnabled="{Binding ReloadCommand.IsAbleToExecute}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type t:ContentRepairSuggestion}">
                <mui:Cell Margin="0 0 0 20" x:Name="__Dt0">
                  <mui:Cell.Styles><Style Selector="mui|Cell#__Dt0"><Style Selector="^ Path#PART_AlertIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding IsCritical, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S2" Value="{Binding IsSolved, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S1)=True]"><Style Selector="^[(pa|T.S2)=True] mui|BbCodeBlock#PART_Category"><Setter Property="Foreground" Value="{DynamicResource Error}"/>
                    </Style><Style Selector="^[(pa|T.S2)=True] Path#PART_AlertIcon"><Setter Property="IsVisible" Value="True"/>
                  </Style></Style></Style></mui:Cell.Styles><DockPanel IsEnabled="{Binding IsSolved, Converter={StaticResource InvertBooleanConverter}}">
                    <!--<Separator DockPanel.Dock="Bottom" Margin="0 0 0 -10" Background="{DynamicResource SeparatorBackground}" />-->
                    <StackPanel DockPanel.Dock="Right" Margin="8 0 5 0" Width="100">
                      <ItemsControl ItemsSource="{Binding Fixes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Content="{Binding FixCaption, TargetNullValue='Fix It'}" Click="OnFixButtonClick" Margin="0 0 0 4"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="{x:Static mui:UiStrings.Toolbar_Hide}" Command="{Binding HideCommand}"/>
                    </StackPanel>
                    <DockPanel Dock="Top" Margin="0 0 0 4">
                      <Path x:Name="PART_AlertIcon" Data="{StaticResource AlertIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Error}" Stretch="Uniform" Margin="0 0 4 0" VerticalAlignment="Center"/>
                      <mui:BbCodeBlock DockPanel.Dock="Right" x:Name="PART_Category" Text="{Binding Category}" Margin="8 2 8 0" Classes="Small"/>
                      <mui:BbCodeBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" FontWeight="Bold"/>
                    </DockPanel>
                    <mui:BbCodeBlock Text="{Binding Description}" Classes="Small"/>
                  </DockPanel>
                  <Border Background="{DynamicResource DarkStripeBackground}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" MaxWidth="320" TextElement.Foreground="{DynamicResource DarkStripeText}" IsVisible="{Binding IsSolved, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                      <Path Data="{StaticResource CheckIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Go}" Stretch="Uniform" Margin="0 0 8 0" VerticalAlignment="Center"/>
                      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Text>Solved.</TextBlock.Text>
                      </TextBlock>
                    </DockPanel>
                  </Border>
                </mui:Cell>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </mui:Switch>

        <WrapPanel Orientation="Horizontal">
          <WrapPanel.Resources>
            <ControlTheme TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" x:Key="{x:Type Button}">
              <Setter Property="Padding" Value="8 3 8 5"/>
              <Setter Property="Margin" Value="0 0 4 4"/>
            </ControlTheme>
          </WrapPanel.Resources>

          <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding ReloadCommand}"/>
          <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding Car.ViewInExplorerCommand}"/>
          <Button Content="{x:Static g:AppStrings.Toolbar_CustomShowroom}" Command="{Binding OpenInCustomShowroomCommand}"/>

          <mui:SpacingStackPanel Orientation="Horizontal" Spacing="-4">
            <Button Content="{x:Static g:AppStrings.Toolbar_Showroom}" Command="{Binding OpenInShowroomCommand}"/>
            <Button Content="…" Command="{Binding OpenInShowroomOptionsCommand}"/>
          </mui:SpacingStackPanel>

          <mui:SpacingStackPanel Orientation="Horizontal" Spacing="-4">
            <Button Content="{x:Static g:AppStrings.Toolbar_Drive}" Command="{Binding DriveCommand}"/>
            <Button Content="…" Command="{Binding DriveOptionsCommand}"/>
          </mui:SpacingStackPanel>

          <Button Content="{x:Static g:AppStrings.Toolbar_ReplaceSound}" Command="{Binding ReplaceSoundCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ReplaceSound_Tooltip}"/>
        </WrapPanel>
      </mui:SpacingStackPanel>
    </ScrollViewer>
  </Grid>
</tools:ContentTool>