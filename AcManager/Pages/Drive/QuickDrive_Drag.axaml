<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:drive="clr-namespace:AcManager.Pages.Drive" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:uc="clr-namespace:AcManager.UserControls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Drive.QuickDrive_Drag" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <Thickness x:Key="ElementMargin">0 0 8 8</Thickness>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="Wrapper">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <UniformGrid MaxHeight="128" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=Wrapper}">
      <StackPanel Margin="{StaticResource ElementMargin}">
        <mui:ValueLabel Value="{Binding MatchesCount}" Content="{x:Static g:AppStrings.QuickDrive_Drag_Total}" Postfix="{Binding MatchesCount, Converter={StaticResource PluralizingConverter}, ConverterParameter={x:Static c:ControlsStrings.Common_RoundPostfix}}"/>
        <Slider Minimum="1" Maximum="20" Value="{Binding MatchesCount}"/>
      </StackPanel>

      <StackPanel Margin="{StaticResource ElementMargin}">
        <TextBlock Text="{x:Static t:ToolsStrings.Drive_GridType}" Margin="0 0 0 4" Classes="Label Label.Padding"/>
        <mui:HierarchicalComboBox Margin="4 0 4 0" ItemsSource="{Binding RaceGridViewModel.Modes}" SelectedItem="{Binding RaceGridViewModel.Mode}" FixedMode="False" PreviewProvider="{Binding}"/>
      </StackPanel>

      <StackPanel Margin="{StaticResource ElementMargin}">
        <CheckBox Margin="8 8 0 0" IsChecked="{Binding Penalties}">
          <Label Content="{x:Static g:AppStrings.Drive_Penalties}"/>
        </CheckBox>
      </StackPanel>

      <StackPanel Margin="{StaticResource ElementMargin}">
        <mui:ValueLabel Value="{Binding RaceGridViewModel.AiLevel}" Postfix="%" Content="{x:Static g:AppStrings.Drive_OpponentsStrength}"/>
        <Slider Minimum="{Binding RaceGridViewModel.AiLevelMinimumLimited}" Maximum="100" Value="{Binding RaceGridViewModel.AiLevel, Converter={StaticResource SliderRoundConverter}, ConverterParameter=1}"/>
      </StackPanel>
    </UniformGrid>

    <uc:RaceGridEditorColumn Grid.Column="1" DataContext="{Binding RaceGridViewModel}"/>
  </Grid>
</UserControl>