<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Drive.TempSurvey">

  <mui:SpacingStackPanel Margin="200 40" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
    <TextBlock Text="Hello there!" Classes="Title"/>
    <mui:BbCodeBlock Text="If you like competitive online racing, maybe you would be interested in taking [url=&quot;https://docs.google.com/forms/d/e/1FAIpQLSdEsZHa9RWyQo65Po3zBjdq-q1NE-yunm6F08WC87NC3icqlg/viewform&quot;]this survey[/url] to help a friend of mine to decide on the next project? Your contribution would be very important to help to design it better. Thank you!"/>
    <Button Content="Hide this page" Click="OnButtonClick"/>
  </mui:SpacingStackPanel>
</UserControl>