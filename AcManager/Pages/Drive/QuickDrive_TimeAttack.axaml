<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:drive="clr-namespace:AcManager.Pages.Drive" xmlns:g="clr-namespace:AcManager" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Drive.QuickDrive_TimeAttack">
    <UserControl.Resources>
        <Thickness x:Key="ElementMargin">0 0 8 16</Thickness>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource ElementMargin}" Grid.Row="0" Grid.Column="0">
            <CheckBox Margin="8 0 0 0" IsChecked="{Binding Penalties}">
                <Label Content="{x:Static g:AppStrings.Drive_Penalties}"/>
            </CheckBox>
        </StackPanel>

        <StackPanel Margin="{StaticResource ElementMargin}" Grid.Row="0" Grid.Column="1">
            <mui:ValueLabel Postfix="{x:Static t:ToolsStrings.Common_KilogramsPostfix}" Margin="0 0 0 4" Content="{x:Static t:ToolsStrings.Common_Ballast}" mui:BetterTextBox.Mode="Integer" Value="{Binding PlayerBallast}"/>
            <Slider Minimum="0" Maximum="200" Value="{Binding PlayerBallast}"/>
        </StackPanel>

        <StackPanel Margin="{StaticResource ElementMargin}" Grid.Row="1" Grid.Column="1">
            <mui:ValueLabel Postfix="%" Margin="0 0 0 4" Content="{x:Static t:ToolsStrings.Common_Restrictor}" mui:BetterTextBox.Mode="Integer" Value="{Binding PlayerRestrictor}"/>
            <Slider Minimum="0" Maximum="100" Value="{Binding PlayerRestrictor}"/>
        </StackPanel>
    </Grid>
</UserControl>