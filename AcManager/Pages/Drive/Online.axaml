<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:dr="clr-namespace:AcManager.Pages.Drive" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Drive.Online" SizeChanged="OnSizeChanged" mui:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/OnlineSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <ContextMenu x:Key="StatusContextMenu">
        <MenuItem Header="{x:Static g:AppStrings.Online_SortByName}" Command="{Binding ChangeSortingCommand}" CommandParameter="name" IsChecked="{Binding SortingMode.Id, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter='name', Mode=OneWay}"/>
        <MenuItem Header="{x:Static g:AppStrings.Online_SortByDrivers}" Command="{Binding ChangeSortingCommand}" CommandParameter="drivers" IsChecked="{Binding SortingMode.Id, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter='drivers', Mode=OneWay}"/>
        <MenuItem Header="{x:Static g:AppStrings.Online_SortByCapacity}" Command="{Binding ChangeSortingCommand}" CommandParameter="capacity" IsChecked="{Binding SortingMode.Id, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter='capacity', Mode=OneWay}"/>
        <MenuItem Header="{x:Static g:AppStrings.Online_SortByCarsNumber}" Command="{Binding ChangeSortingCommand}" CommandParameter="cars" IsChecked="{Binding SortingMode.Id, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter='cars', Mode=OneWay}"/>
        <MenuItem Header="{x:Static g:AppStrings.Online_SortByPing}" Command="{Binding ChangeSortingCommand}" CommandParameter="ping" IsChecked="{Binding SortingMode.Id, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter='ping', Mode=OneWay}"/>
        <Separator/>
        <MenuItem Header="{x:Static g:AppStrings.Online_SetSortingAsDefault}" Command="{Binding SetAsDefaultSortingCommand}"/>
        <MenuItem Header="{x:Static g:AppStrings.Online_SetFiltersAsDefault}" Command="{Binding SetAsDefaultFiltersCommand}"/>
        <Separator/>
        <MenuItem Header="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding RefreshCommand}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
        <MenuItem Header="{x:Static g:AppStrings.Online_AddByIp}" Command="{Binding AddNewServerCommand}" IsVisible="{Binding UserListMode, Converter={StaticResource BooleanToVisibilityConverter}}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
        <Separator/>
        <MenuItem Header="Use caching server for lobby" DataContext="{Binding Source={x:Static t:SettingsHolder.Online}}" IsChecked="{Binding UseCachingServer}" IsEnabled="{Binding CachingServerAvailable}">
          <!-- PORT: removed IsCheckable (not in Avalonia) --><ToolTip.Tip>
            <DockPanel MaxWidth="300">
              <TextBlock Text="Might be faster. Better to use with direct information loading to speed things up even more." TextWrapping="Wrap" DockPanel.Dock="Top"/>
              <mui:BbCodeBlock Text="[b]Please note:[/b] you need to load regular server list at least once for this option to work." Margin="0 4 0 -8" TextWrapping="Wrap" IsVisible="{Binding CachingServerAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='inverse'}"/>
            </DockPanel>
          </ToolTip.Tip>
        </MenuItem>
        <MenuItem Header="{x:Static g:AppStrings.Settings_Online_LoadInformationDirectly}" DataContext="{Binding Source={x:Static t:SettingsHolder.Online}}" IsChecked="{Binding LoadServerInformationDirectly}"><!-- PORT: removed IsCheckable (not in Avalonia) --></MenuItem>
      </ContextMenu>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel>
    <mui:Switch Value="{Binding Pack.Status}" Classes="ContentRoot">
      <!-- Loading -->
      <mui:Cell mui:Switch.When="{x:Static t:OnlineManagerStatus.Loading}" Margin="20">
        <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
          <ItemsControl ItemsSource="{Binding Pack.SourceWrappers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0 0 0 8" Width="200" x:Name="__Dt0">
                  <DockPanel.Styles><Style Selector="DockPanel#__Dt0"><Style Selector="^ ProgressBar#ProgressBar"><!-- PORT: removed setter of IsIndeterminate (not in Avalonia) --></Style><Style Selector="^ TextBlock#Message"><!-- PORT: removed setter of Text (not in Avalonia) --></Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding LoadingProgress.IsReady, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S2" Value="{Binding LoadingProgress.Message, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S3" Value="{Binding Status, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=Error}"/></Style><Style Selector="^[(pa|T.S1)=True] ProgressBar#ProgressBar"><!-- PORT: removed setter of IsIndeterminate (not in Avalonia) -->
                  </Style><Style Selector="^[(pa|T.S2)=True] TextBlock#Message"><Setter Property="IsVisible" Value="False"/>
                  </Style><Style Selector="^[(pa|T.S3)=True] ProgressBar#ProgressBar"><Setter Property="IsVisible" Value="False"/>
                    </Style><Style Selector="^[(pa|T.S3)=True] TextBlock#Message"><Setter Property="IsVisible" Value="True"/>
                    <!-- PORT: removed setter of Text (not in Avalonia) -->
                  </Style></Style></DockPanel.Styles><ProgressBar x:Name="ProgressBar" Maximum="1" Width="200" Height="4" Value="{Binding LoadingProgress.Progress, Mode=OneWay}" DockPanel.Dock="Bottom"/>
                  <TextBlock Text="{Binding DisplayName}" Margin="0 0 8 4" DockPanel.Dock="Left" Classes="Heading2"/>
                  <TextBlock x:Name="Message" Margin="0 0 0 6" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Classes="Small"/>
                </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </mui:Cell>

      <!-- Error -->
      <StackPanel mui:Switch.When="{x:Static t:OnlineManagerStatus.Error}" Margin="40 0 40 40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{x:Static c:ControlsStrings.Common_Error}" Classes="Heading1"/>
        <StackPanel Margin="0 20" DataContext="{Binding Pack.Error}">
          <mui:BbCodeBlock Text="{Binding Message}"/>
          <mui:BbCodeBlock Text="{Binding Commentary}" Margin="0 4 0 0" FontStyle="Italic" IsVisible="{Binding Commentary, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>
        </StackPanel>
        <Button Command="{Binding RefreshCommand}" CommandParameter="True" Margin="0 0 0 8" IsVisible="{Binding Pack.Error.IsFatal, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
          <DockPanel>
            <Path Data="{StaticResource RefreshIconData}" Width="14" Height="14" Margin="0 0 8 0" VerticalAlignment="Center" Stretch="Uniform" Fill="{Binding Path=(TextBlock.Foreground), RelativeSource={RelativeSource Self}}"/>
            <TextBlock Text="{x:Static c:ControlsStrings.Common_TryAgain}"/>
          </DockPanel>
        </Button>
        <Border Margin="0 0 0 8" IsVisible="{Binding Pack.Error.IsFatal, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
          <Button Command="{Binding SwitchToCachingCommand}" IsVisible="{Binding SwitchToCachingCommand.IsAbleToExecute, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=hidden}">
            <ToolTip.Tip>
              <TextBlock MaxWidth="400" TextWrapping="Wrap" Text="Caching server helps to reduce load on main AC lobby server and speed things up, and supply data for some time in case AC lobby server would go under maintenance. And loading data directly from remote servers instead of going through AC lobby server would ensure data is the freshest."/>
            </ToolTip.Tip>
            <DockPanel>
              <Path Data="{StaticResource GitForkIconData}" Width="14" Height="14" Margin="0 0 8 0" VerticalAlignment="Center" Stretch="Uniform" Fill="{Binding Path=(TextBlock.Foreground), RelativeSource={RelativeSource Self}}"/>
              <TextBlock Text="Switch to caching server and direct loading" DockPanel.Dock="Top" Margin="0 0 0 2"/>
              <TextBlock Text="Can be disabled later in Settings/Online" Classes="Small"/>
            </DockPanel>
          </Button>
        </Border>
      </StackPanel>

      <!-- Loaded -->
      <mui:Cell mui:Switch.When="{x:Static t:OnlineManagerStatus.Ready}">
        <mui:BooleanSwitch>
          <mui:BooleanSwitch.Value>
            <MultiBinding Converter="{StaticResource AndConverter}">
              <Binding Path="MainList.Count" Converter="{StaticResource EnumToBooleanConverter}" ConverterParameter="0"/>
              <Binding Path="ServerSelected" Converter="{StaticResource InvertBooleanConverter}"/>
            </MultiBinding>
          </mui:BooleanSwitch.Value>

          <!-- Empty -->
          <mui:BooleanSwitch.True>
            <StackPanel mui:Switch.When="0" Margin="0 0 0 100" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{x:Static g:AppStrings.Online_NothingToDisplay}" TextAlignment="Center" Classes="Heading1"/>
              <StackPanel Orientation="Horizontal" Margin="8 16 0 0">
                <ItemsControl ItemsSource="{Binding Filters}" Margin="0 0 8 0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="8" Height="48"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsEnabled}" MaxWidth="48" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Width="48" Foreground="{DynamicResource ItemText}" ToolTip.Tip="{Binding Description}" x:Name="__Dt4">
                        <ToggleButton.Styles><Style Selector="ToggleButton#__Dt4"><Style Selector="^ Ellipse#PART_Shown"><Setter Property="IsVisible" Value="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/></Style><Style Selector="^ Path#PART_Hidden"><Setter Property="IsVisible" Value="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/></Style><Style Selector="^"><Setter Property="pa:T.S5" Value="{Binding Exclude, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S6" Value="{Binding Exclude, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S5)=True] Ellipse#PART_Shown"><Setter Property="IsVisible" Value="False"/>
                        </Style><Style Selector="^[(pa|T.S6)=True] Path#PART_Hidden"><Setter Property="IsVisible" Value="False"/>
                        </Style></Style></ToggleButton.Styles><mui:Cell>
                          <DockPanel Margin="0">
                            <TextBlock Text="{Binding DisplayName}" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Classes="Label"/>
                            <Border Margin="0 0 0 4">
                              <ContentPresenter Content="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </DockPanel>
                          <Path x:Name="PART_Hidden" Data="F1 M 62,0 L0,62 L2,64 L64,2 Z" Fill="Red" Stretch="Uniform" Margin="0"/>
                          <Ellipse x:Name="PART_Shown" StrokeThickness="2" Stroke="Red" Stretch="Uniform" Margin="0"/>
                        </mui:Cell>
                      </ToggleButton>
                      </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator/>
                <mui:ModernButton IconData="{StaticResource RefreshIconData}" Command="{Binding RefreshCommand}" Content="{x:Static g:AppStrings.Online_Refresh}" Theme="{StaticResource BigButton}"/>
              </StackPanel>
              <Button Margin="0 8 0 0" Command="{Binding AddNewServerCommand}" IsVisible="{Binding UserListMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel IsHitTestVisible="False">
                  <Path Data="{StaticResource AddIconData}" Width="10" Height="10" Stretch="Uniform" DockPanel.Dock="Left" Margin="0 0 4 0" VerticalAlignment="Center" Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"/>
                  <TextBlock Text="{x:Static g:AppStrings.Online_AddNewServer}"/>
                </DockPanel>
              </Button>
            </StackPanel>
          </mui:BooleanSwitch.True>

          <!-- List -->
          <mui:BooleanSwitch.False>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" x:Name="BigButtonsParent">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                  <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <mui:Cell Grid.Row="2" Background="Transparent">
                  <DockPanel Margin="{StaticResource StatusMargin}">
                    <mui:ContextMenuButton VerticalAlignment="Center" DockPanel.Dock="Right" Menu="{StaticResource StatusContextMenu}"/>

                    <mui:BooleanSwitch Value="{Binding CompactUi, Source={x:Static t:SettingsHolder.Online}}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="4 0">
                      <mui:BooleanSwitch.True>
                        <ItemsControl ItemsSource="{Binding Filters}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="6" Height="16"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsEnabled}" Width="16" Height="16" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource ItemText}" ToolTip.Tip="{Binding Description}" x:Name="__Dt7">
                                <ToggleButton.Styles><Style Selector="ToggleButton#__Dt7"><Style Selector="^ Ellipse#PART_Shown"><Setter Property="IsVisible" Value="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/></Style><Style Selector="^ Path#PART_Hidden"><Setter Property="IsVisible" Value="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/></Style><Style Selector="^"><Setter Property="pa:T.S8" Value="{Binding Exclude, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S9" Value="{Binding Exclude, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S8)=True] Ellipse#PART_Shown"><Setter Property="IsVisible" Value="False"/>
                                </Style><Style Selector="^[(pa|T.S9)=True] Path#PART_Hidden"><Setter Property="IsVisible" Value="False"/>
                                </Style></Style></ToggleButton.Styles><mui:Cell>
                                  <ContentPresenter Content="{Binding Icon}" Margin="0"/>
                                  <Path x:Name="PART_Hidden" Data="F1 M 62,0 L0,62 L2,64 L64,2 Z" Fill="Red" Stretch="Uniform"/>
                                  <Ellipse x:Name="PART_Shown" StrokeThickness="2" Stroke="Red" Stretch="Uniform"/>
                                </mui:Cell>
                              </ToggleButton>
                              </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </mui:BooleanSwitch.True>
                      <mui:BooleanSwitch.False>
                        <StackPanel Orientation="Horizontal">
                          <mui:ModernButton EllipseStrokeThickness="0" IconData="{StaticResource AddIconData}" Command="{Binding AddNewServerCommand}" IsVisible="{Binding UserListMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                          <mui:ModernButton Click="OnScrollToSelectedButtonClick" DockPanel.Dock="Right" IconData="{StaticResource CollapsedIconData}" Margin="4 0 0 0" ToolTip.Tip="{x:Static c:ControlsStrings.Common_ScrollToSelected}" Classes="NonTransparent"/>
                          <mui:ModernButton EllipseStrokeThickness="0" IconData="{StaticResource RefreshIconData}" Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                      </mui:BooleanSwitch.False>
                    </mui:BooleanSwitch>

                    <TextBlock Foreground="{DynamicResource WindowTextReadOnly}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding MainList.Count, Mode=OneWay, Converter={StaticResource PluralizingConverter}, ConverterParameter={x:Static g:AppStrings.Online_ServersFormat}}">
                      <ToolTip.Tip>
                        <TextBlock>
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{x:Static g:AppStrings.Online_Pinged}">
                              <Binding Path="Manager.Pinged"/>
                              <Binding Path="Manager.List.Count" Converter="{StaticResource PluralizingConverter}" ConverterParameter="{x:Static g:AppStrings.Online_ServersFormat}"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </ToolTip.Tip>
                    </TextBlock>
                  </DockPanel>

                  <ProgressBar Minimum="0" Maximum="{Binding Manager.List.Count}" Value="{Binding Manager.Pinged}" IsHitTestVisible="False" VerticalAlignment="Bottom" Margin="2" Height="2" IsVisible="{Binding Manager.PingingInProcess, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </mui:Cell>

                <DockPanel Grid.Row="0" Background="Transparent" HorizontalAlignment="Left" IsVisible="{Binding CompactUi, Source={x:Static t:SettingsHolder.Online}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                  <mui:ContextMenuButton DockPanel.Dock="Right" VerticalAlignment="Top" Margin="-28 0 0 0" ZIndex="1">
                    <ContextMenu>
                      <MenuItem Header="{x:Static g:AppStrings.Online_SetSortingAsDefault}" Command="{Binding SetAsDefaultSortingCommand}"/>
                      <MenuItem Header="{x:Static g:AppStrings.Online_SetFiltersAsDefault}" Command="{Binding SetAsDefaultFiltersCommand}"/>
                    </ContextMenu>
                  </mui:ContextMenuButton>

                  <StackPanel x:Name="FilteringComboBox" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8 0 8 16" DockPanel.Dock="Right">
                    <TextBlock Margin="0 0 0 8" Text="{x:Static g:AppStrings.Online_SortByLabel}" Classes="Label"/>
                    <ComboBox Width="150" ItemsSource="{Binding SortingModes}" SelectedItem="{Binding SortingMode}" DisplayMemberBinding="{Binding DisplayName}"/>
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Filters}" Margin="16 0 0 16">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="4" Height="48"/>
                        <!--<WrapPanel Height="48" ClipToBounds="True" />-->
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsEnabled}" MaxWidth="48" Height="48" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource ItemText}" ToolTip.Tip="{Binding Description}" x:Name="__Dt10">
                          <ToggleButton.Styles><Style Selector="ToggleButton#__Dt10"><Style Selector="^ Ellipse#PART_Shown"><Setter Property="IsVisible" Value="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/></Style><Style Selector="^ Path#PART_Hidden"><Setter Property="IsVisible" Value="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/></Style><Style Selector="^"><Setter Property="pa:T.S11" Value="{Binding Exclude, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S12" Value="{Binding Exclude, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S11)=True] Ellipse#PART_Shown"><Setter Property="IsVisible" Value="False"/>
                          </Style><Style Selector="^[(pa|T.S12)=True] Path#PART_Hidden"><Setter Property="IsVisible" Value="False"/>
                          </Style></Style></ToggleButton.Styles><mui:Cell>
                            <DockPanel Margin="4 4 4 2">
                              <TextBlock Text="{Binding DisplayName}" DockPanel.Dock="Bottom" HorizontalAlignment="Center" FontSize="{DynamicResource SmallFontSize}" Classes="Label"/>
                              <ContentPresenter Content="{Binding Icon}" Margin="4 0 4 4"/>
                            </DockPanel>
                            <Path x:Name="PART_Hidden" Data="F1 M 62,0 L0,62 L2,64 L64,2 Z" Fill="Red" Stretch="Uniform"/>
                            <Ellipse x:Name="PART_Shown" StrokeThickness="2" Stroke="Red" Stretch="Uniform"/>
                          </mui:Cell>
                        </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="ServersListBox" ItemsSource="{Binding MainList}" ItemTemplate="{StaticResource SimpleListItem}" mui:SaveScroll.Key="{Binding Key}" SelectionChanged="ServersListBox_OnSelectionChanged" Theme="{StaticResource VirtualizingListBox}"/>
              </Grid>

              <Rectangle Fill="{DynamicResource SeparatorBackground}" Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsVisible="{Binding ServerSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <mui:ModernFrame x:Name="Frame" Grid.Column="2" TransitionName="Normal" Width="450" IsVisible="{Binding ServerSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
          </mui:BooleanSwitch.False>
        </mui:BooleanSwitch>

        <ProgressBar IsIndeterminate="{Binding Pack.BackgroundLoading}" Margin="20" Width="320" Height="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding Pack.BackgroundLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </mui:Cell>
    </mui:Switch>
  </DockPanel>
</UserControl>