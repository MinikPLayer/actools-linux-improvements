<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:dr="clr-namespace:AcManager.Pages.Drive" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:uc="clr-namespace:AcManager.UserControls" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Drive.UserChampionships_SelectedPage" Loaded="OnLoaded" Unloaded="OnUnloaded" mui:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcItemWrapperSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/Converters.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="DataGridCell.DriverName" DataType="{x:Type t:UserChampionshipDriver}">
        <DockPanel x:Name="__Dt0">
          <DockPanel.Styles><Style Selector="DockPanel#__Dt0"><Style Selector="^ TextBlock#NameTextBlock"><!-- PORT: removed setter of Text (not in Avalonia) --></Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding IsPlayer, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S1)=True] TextBlock#NameTextBlock"><!-- PORT: removed setter of Foreground (not in Avalonia) -->
            <!-- PORT: removed setter of FontWeight (not in Avalonia) -->
            <!-- PORT: removed setter of Text (not in Avalonia) -->
          </Style></Style></DockPanel.Styles><Ellipse DockPanel.Dock="Left" Margin="0 0 8 4" Fill="{Binding TakenPlace, Converter={StaticResource PlaceToColorConverter}}" Classes="PlaceMark"/>
          <TextBlock x:Name="NameTextBlock" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        </DataTemplate>

      <DataTemplate x:Key="DataGridCell.Car" DataType="{x:Type t:UserChampionshipDriver}">
        <StackPanel Orientation="Horizontal">
          <ToolTip.Tip>
            <ToolTip>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding CarObject.DisplayName}" Margin="0 0 0 4" Classes="Heading2"/>
                <mui:BetterImage Width="512" Filename="{Binding CarSkinObject.PreviewImage}" Stretch="None"/>
              </StackPanel>
            </ToolTip>
          </ToolTip.Tip>
          <mui:BetterImage Width="16" Height="16" Margin="0 2 8 2" Filename="{Binding CarSkinObject.LiveryImage}" ClearOnChange="True"/>
          <TextBlock Text="{Binding CarObject.DisplayName}"/>
        </StackPanel>
      </DataTemplate>

      <DataTemplate x:Key="ItemTemplate" DataType="{x:Type t:UserChampionshipRoundExtended}">
        <Grid Width="200" Height="100" Background="{DynamicResource ThumbnailBackground}" ClipToBounds="True" x:Name="__Dt2">
          <Grid.Styles><Style Selector="Grid#__Dt2"><Style Selector="^ TextBlock#TakenPlaceText"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding IsAvailable, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S4" Value="{Binding IsPassed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S5" Value="{Binding TakenPlace, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=1}"/><Setter Property="pa:T.S6" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S3)=True] mui|BetterImage#Image"><Setter Property="Effect">
              <Setter.Value>
                <!-- PORT: removed GrayscaleEffect (pixel shader effect) -->
              </Setter.Value>
            </Setter>
          </Style><Style Selector="^[(pa|T.S4)=True] TextBlock#TakenPlaceText"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S4)=True] StackPanel#BottomPanel"><Setter Property="IsVisible" Value="False"/>
          </Style><Style Selector="^[(pa|T.S5)=True] mui|BetterImage#Image"><Setter Property="Effect" Value="{x:Null}"/>
          </Style><!-- PORT: storyboard actions of trigger [(pa|T.S6)=True] not converted --></Style></Grid.Styles><mui:BetterImage x:Name="Image" Filename="{Binding Track.PreviewImage}" Stretch="UniformToFill" StretchDirection="DownOnly" ClearOnChange="True"/>
          <StackPanel VerticalAlignment="Bottom" Background="{StaticResource DarkenPanel}" x:Name="BottomPanel" TextElement.FontSize="{DynamicResource SmallFontSize}" TextElement.Foreground="White">
            <StackPanel.RenderTransform>
              <TranslateTransform/>
            </StackPanel.RenderTransform>
            <TextBlock Margin="4 4 24 4" Text="{Binding Track.LayoutName}"/>
          </StackPanel>
          <TextBlock Text="{Binding TakenPlace, Converter={StaticResource OrdinalizingConverter}}" Padding="8" TextAlignment="Center" VerticalAlignment="Center" x:Name="TakenPlaceText" Background="{StaticResource DarkenPanel}" Foreground="White" Classes="Heading1"/>
          <Ellipse Width="8" Height="8" Margin="8 12" VerticalAlignment="Bottom" HorizontalAlignment="Right" Fill="{Binding TakenPlace, Converter={StaticResource PlaceToColorConverter}}"/>
        </Grid>
        </DataTemplate>

      <mui:ChainConverter x:Key="OrdinalizingLowerConverter">
        <mui:ChainConverter.Converters>
          <mui:OrdinalizingConverter/>
          <mui:ToLowerConverter/>
        </mui:ChainConverter.Converters>
      </mui:ChainConverter>
    </ResourceDictionary>
  </UserControl.Resources>

  <mui:Cell Classes="ContentRootWithPadding">
    <!-- Career errors -->
    <c:AcObjectErrorsSection AcObject="{Binding AcObject}"/>

    <Grid x:Name="ContentGrid" IsVisible="{Binding AcObject.HasErrors, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="124"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="460"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0 -12 0 24">
        <c:UserChampionshipBlock Width="480" Margin="0 9 24 0" DockPanel.Dock="Left" DataContext="{Binding AcObject}">
          <c:UserChampionshipBlock.ButtonPlaceholder>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0 9 0 -9">
                <Button Margin="0 0 4 0" Content="{x:Static c:ControlsStrings.Common_Reset}" PointerReleased="OnResetButtonClick"/>
                <!-- <mui:C ell
                                        Visibility="{Binding NextCareerObject, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='inverse'}">
                                    <mui:Cell.ToolTip>
                                        <ToolTip>
                                            <StackPanel Margin="4">
                                                <TextBlock Text="{Binding NextCareerObject.DisplayName}" />
                                                <StackPanel
                                                        Visibility="{Binding NextCareerObject.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='inverse'}"
                                                        Margin="0 4 0 0" Orientation="Horizontal">
                                                    <TextBlock Text="{x:Static g:AppStrings.KunosCareer_LeftToEarn}" />

                                                    <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static t:KunosCareerObjectType.SingleEvents}}">
                                                        <Ellipse Style="{StaticResource PlaceMark.Inline}" Fill="{StaticResource Gold}" />
                                                        <TextBlock Text="{Binding FirstPlacesNeeded, StringFormat='{}{0}, '}" FontWeight="Bold" />

                                                        <Ellipse Style="{StaticResource PlaceMark.Inline}" Fill="{StaticResource Silver}" />
                                                        <TextBlock Text="{Binding SecondPlacesNeeded, StringFormat='{}{0}, '}" FontWeight="Bold" />

                                                        <Ellipse Style="{StaticResource PlaceMark.Inline}" Fill="{StaticResource Bronze}" />
                                                        <TextBlock Text="{Binding ThirdPlacesNeeded}" FontWeight="Bold" />
                                                    </StackPanel>

                                                    <TextBlock
                                                            Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static t:KunosCareerObjectType.Championship}}">
                                                        <Run Text="{Binding ChampionshipPointsNeeded}" FontWeight="Bold" />
                                                        <Run
                                                                Text="{Binding ChampionshipPointsNeeded, Converter={StaticResource PluralizingConverter}, ConverterParameter={x:Static t:ToolsStrings.KunosCareer_Point}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </ToolTip>
                                    </mui:Cell.ToolTip>
                                    <Button IsEnabled="{Binding NextCareerObject.IsAvailable}" PreviewMouseLeftButtonUp="NextButton_OnMouseLeftButtonUp"
                                            Content="{x:Static g:AppStrings.KunosCareer_Next}" />
                                </mui:Cell>-->
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                <TextBlock Text="{x:Static g:AppStrings.KunosCareer_SeriesGoal}"/>

                <StackPanel Orientation="Horizontal" IsVisible="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static t:KunosCareerObjectType.SingleEvents}}">
                  <Ellipse Fill="{DynamicResource GoldBrush}" Classes="PlaceMark PlaceMark.Inline"/>
                  <TextBlock Text="{Binding FirstPlacesGoal, StringFormat='{}{0}, '}" FontWeight="Bold"/>

                  <Ellipse Fill="{DynamicResource SilverBrush}" Classes="PlaceMark PlaceMark.Inline"/>
                  <TextBlock Text="{Binding SecondPlacesGoal, StringFormat='{}{0}, '}" FontWeight="Bold"/>

                  <Ellipse Fill="{DynamicResource BronzeBrush}" Classes="PlaceMark PlaceMark.Inline"/>
                  <TextBlock Text="{Binding ThirdPlacesGoal}" FontWeight="Bold"/>
                </StackPanel>

                <mui:BbCodeBlock Text="{Binding DisplayChampionshipGoal}" IsVisible="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static t:KunosCareerObjectType.Championship}}"/>
              </StackPanel>
            </DockPanel>
          </c:UserChampionshipBlock.ButtonPlaceholder>
        </c:UserChampionshipBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="TableSection" Margin="0 0 0 -12" PointerWheelChanged="TableSection_OnPreviewMouseWheel">
          <ScrollViewer.Resources>
            <mui:BindingProxy x:Key="TableSectionProxy" Data="{Binding ActualWidth, ElementName=TableSection}"/>
          </ScrollViewer.Resources>

          <DataGrid ItemsSource="{Binding AcObject.ChampionshipDriversView}" IsReadOnly="True" HeadersVisibility="None" Theme="{StaticResource DataGrid.Lite}">
            <DataGrid.Columns>
              <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
              <DataGridTextColumn Width="40" Header="" Binding="{Binding Points}" SortMemberPath="Points"><!-- PORT: removed SortDirection (not in Avalonia) --></DataGridTextColumn>
              <DataGridTemplateColumn Width="1.5*" Header="{x:Static c:ControlsStrings.TableHeader_Name}" SortMemberPath="Name" CellTemplate="{StaticResource DataGridCell.DriverName}"/>
              <DataGridTemplateColumn Width="2*" Header="{x:Static c:ControlsStrings.TableHeader_Car}" SortMemberPath="Car.DisplayName" CellTemplate="{StaticResource DataGridCell.Car}" IsVisible="{Binding Data, Source={StaticResource TableSectionProxy}, Converter={StaticResource MoreToVisibilityConverter}, ConverterParameter='450'}"/>
            </DataGrid.Columns>
          </DataGrid>
        </ScrollViewer>
      </DockPanel>

      <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding AcObject.ExtendedRounds}" SelectedItem="{Binding AcObject.CurrentRound, Mode=TwoWay}" x:Name="ListBox" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ItemTemplate}" Margin="-4 0 -4 12" ScrollViewer.ScrollChanged="ListBox_ScrollChanged" SelectionChanged="ListBox_OnSelectionChanged" DoubleTapped="ListBox_OnPreviewMouseDoubleClick">
        <i:Interaction.Behaviors>
          <mui:HorizontalScrollBehavior/>
        </i:Interaction.Behaviors>
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource FlatListBoxItem}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="4"/>

            <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource ItemTextHover}"/>
              </Style><Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource ItemTextSelected}"/>
                <Setter Property="FontWeight" Value="Normal"/>
              </Style><Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource ItemTextDisabled}"/>
              </Style></ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>

      <Grid Grid.Row="2" Grid.Column="1" IsEnabled="{Binding GoCommand.IsAbleToExecute}">
        <Grid.Styles><Style Selector="DockPanel">
            <Setter Property="Margin" Value="0 0 8 8"/>
          </Style>
          <Style Selector="Label">
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
          </Style>
          <Style Selector="TextBlock.Value">
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    <Setter Property="FontWeight" Value="UltraLight"/>
    <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="20 0 0 0"/>
          </Style>
        </Grid.Styles><Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="1.5*" MinWidth="149"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Event errors -->
        <c:AcObjectErrorsSection AcObject="{Binding}" Grid.ColumnSpan="2"/>

        <!-- Event params -->
        <DockPanel Grid.Column="0" Grid.Row="1">
          <Label Content="{x:Static g:AppStrings.KunosCareer_TimeLabel}"/>
          <TextBlock Text="{Binding CurrentRoundTime, Converter={StaticResource AcTimeDisplayConverter}}" Classes="Heading1 Value"/>
        </DockPanel>
        <DockPanel Grid.Column="1" Grid.Row="1">
          <Label Content="{x:Static g:AppStrings.KunosCareer_WeatherLabel}"/>
          <TextBlock Text="{Binding CurrentRoundWeatherDisplayName}" Classes="Heading1 Value"/>
        </DockPanel>
        <DockPanel Grid.Column="0" Grid.Row="2">
          <Label Content="{x:Static g:AppStrings.KunosCareer_TemperatureLabel}"/>
          <c:TemperatureBlock Text="{Binding CurrentRoundTemperature}" Classes="Heading1 Value"/>
          <ToolTip.Tip>
            <c:TemperatureBlock Prefix="{x:Static g:AppStrings.Common_RoadTemperature}" Rounding="0.1" Text="{Binding CurrentRoundRoadTemperature}"/>
          </ToolTip.Tip>
        </DockPanel>
        <DockPanel Grid.Column="1" Grid.Row="2">
          <Label Content="{x:Static g:AppStrings.KunosCareer_TrackState}"/>
          <TextBlock Text="{Binding AcObject.CurrentRound.TrackProperties.Name}" Classes="Heading1 Value"/>
        </DockPanel>

        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" VerticalAlignment="Top" IsVisible="{Binding ConditionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Canvas Width="20" Height="20" DockPanel.Dock="Left" Margin="0 0 8 0">
            <mui:ModernProgressRing Width="80" Height="80" IsActive="True">
              <mui:ModernProgressRing.RenderTransform>
                <ScaleTransform ScaleX="0.25" ScaleY="0.25"><!-- PORT: removed CenterY (not in Avalonia) --><!-- PORT: removed CenterX (not in Avalonia) --></ScaleTransform>
              </mui:ModernProgressRing.RenderTransform>
            </mui:ModernProgressRing>
          </Canvas>
          <TextBlock Text="{x:Static g:AppStrings.UserChampionships_RealConditions}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Race params -->
        <DockPanel Grid.Column="0" Grid.Row="4">
          <Label Content="{x:Static g:AppStrings.KunosCareer_OpponentsLabel}"/>
          <TextBlock Text="{Binding AcObject.Drivers.Count, Mode=OneWay, Converter={StaticResource SumConverter}, ConverterParameter=-1}" Classes="Heading1 Value"/>
        </DockPanel>

        <DockPanel Grid.Column="0" Grid.Row="3">
          <Label Content="{x:Static g:AppStrings.KunosCareer_LapsLabel}"/>
          <TextBlock Text="{Binding AcObject.CurrentRound.LapsCount}" Classes="Heading1 Value"/>
        </DockPanel>
        <DockPanel Grid.Column="1" Grid.Row="3" Grid.RowSpan="2" DataContext="{Binding AcObject}">
          <Label Content="{x:Static g:AppStrings.KunosCareer_AiLevelLabel}"/>
          <mui:Cell>
            <mui:BooleanSwitch Value="{Binding KunosCareerUserAiLevel, Source={x:Static t:SettingsHolder.Drive}}">
              <mui:BooleanSwitch.False>
                <TextBlock Text="{Binding AiLevelDisplay}" Classes="Heading1 Value"/>
              </mui:BooleanSwitch.False>
              <mui:BooleanSwitch.True>
                <StackPanel>
                  <TextBlock Text="{Binding UserAiLevelDisplay}" Classes="Heading1 Value"/>
                  <Slider Minimum="0.75" Maximum="1.25" Value="{Binding UserAiLevelMultiplier}" TickFrequency="0.0625" IsSnapToTickEnabled="False" TickPlacement="TopLeft"/>
                  <StackPanel.ContextMenu>
                    <ContextMenu>
                      <MenuItem Command="{Binding ResetUserAiLevelCommand}" ToolTip.Tip="{x:Static c:ControlsStrings.Common_ResetToRecommendedValue}">
                        <MenuItem.Header>
                          <TextBlock Text="{Binding AiLevelDisplay, Converter={x:Static t:UserChampionshipObject.AiLevelDisplayTemporaryConverter}, StringFormat={x:Static c:ControlsStrings.Common_RecommendedPercentageFormat}}"/>
                        </MenuItem.Header>
                      </MenuItem>
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                </StackPanel>
              </mui:BooleanSwitch.True>
            </mui:BooleanSwitch>
          </mui:Cell>
        </DockPanel>
      </Grid>

      <!-- Car and track previews -->
      <ScrollViewer Grid.Row="2" Grid.Column="0" Width="240" Margin="0 0 24 0" DataContext="{Binding AcObject}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ActualWidth, ElementName=ContentGrid, Converter={StaticResource MoreToVisibilityConverter}, ConverterParameter=1000}">
        <mui:SpacingStackPanel Spacing="8">
          <mui:Cell c:ContextMenus.Car="{Binding UserCar.Car}" c:ContextMenus.CarSkin="{Binding UserCarSkin}" c:ToolTips.Car="{Binding UserCar.Car}" mui:Draggable.Data="{Binding UserCar.Car}" PointerReleased="OnCarPreviewClick">
            <c:ContextMenus.AdditionalItems>
              <c:ContextMenusItems>
                <MenuItem Header="{x:Static c:ControlsStrings.Common_ChangeSkin}" IsEnabled="{Binding Source={x:Static t:SettingsHolder.Drive}, Path=KunosCareerUserSkin}" PointerReleased="OnChangeSkinMenuItemClick"/>
              </c:ContextMenusItems>
            </c:ContextMenus.AdditionalItems>

            <mui:BetterImage Filename="{Binding UserCarSkin.PreviewImage}" Width="240"/>
            <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom" TextElement.Foreground="{DynamicResource DarkStripeText}">
              <mui:BetterImage Filename="{Binding UserCar.Car.BrandBadge}" Width="16" Height="16" Margin="4 4 0 4" IsVisible="{Binding UserCar.Car, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>
              <mui:ContextMenuButton Padding="2 0 6 0" DockPanel.Dock="Right" LookForParentMenu="True"/>
              <TextBlock Text="{Binding UserCar.Car.DisplayName}" Padding="4"/>
            </DockPanel>
          </mui:Cell>

          <ListBox ItemsSource="{Binding UserCar.Car.EnabledSkinsListView}" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectedItem="{Binding UserCarSkin}" MaxHeight="36" ItemTemplate="{StaticResource CarSkinItemTemplate}">
            <!-- PORT: Visibility property element --><ListBox.IsVisible>
              <MultiBinding Converter="{StaticResource MultiBooleanToVisibilityConverter}">
                <Binding Path="KunosCareerUserSkin" Source="{x:Static t:SettingsHolder.Drive}"/>
                <Binding Path="ActualHeight" ElementName="ContentGrid" Converter="{StaticResource MoreConverter}" ConverterParameter="564"/>
              </MultiBinding>
            </ListBox.IsVisible>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <mui:Cell Width="240" Height="135" HorizontalAlignment="Center" VerticalAlignment="Top" DataContext="{Binding CurrentRound}" c:ContextMenus.Track="{Binding Track}" c:ToolTips.Track="{Binding Track}" mui:Draggable.Data="{Binding Track}">
            <mui:BetterImage Filename="{Binding Track.PreviewImage}" Stretch="UniformToFill" MaxWidth="240"/>
            <mui:BetterImage Filename="{Binding Track.OutlineImage}" Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="240" MaxHeight="135" HorizontalAlignment="Center" VerticalAlignment="Center" ShowBroken="False"/>
            <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom" TextElement.Foreground="{DynamicResource DarkStripeText}">
              <mui:ContextMenuButton Padding="2 0 6 0" DockPanel.Dock="Right" LookForParentMenu="True"/>
              <TextBlock Text="{Binding Track.Name}" Padding="4"/>
            </DockPanel>
          </mui:Cell>
        </mui:SpacingStackPanel>
      </ScrollViewer>

      <Grid Margin="12 0 0 0" Grid.Row="2" Grid.Column="2" IsEnabled="{Binding GoCommand.IsAbleToExecute}" IsVisible="{Binding Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" DataContext="{Binding AcObject.CurrentRound}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Track.Name}" Margin="0 0 0 4" TextTrimming="CharacterEllipsis" Classes="Heading1"/>
            <Ellipse Grid.Column="1" Width="16" Height="16" Margin="8 4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{Binding TakenPlace, Converter={StaticResource PlaceToColorConverter}}"/>
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="0 0 0 24">
          <TextBlock Text="{Binding AcObject.CurrentRound.DisplayDescription}" TextWrapping="Wrap" Margin="0 0 0 12"/>
        </ScrollViewer>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <DockPanel Grid.Column="1" VerticalAlignment="Bottom">
            <c:UserPresetsControl UserPresetable="{Binding Source={x:Static c:AssistsViewModel.Instance}}" ShowSaveButton="False" Margin="0 0 4 0" DockPanel.Dock="Left"/>

            <ToggleButton x:Name="AssistsButton" Content="…" Margin="0 0 4 0" IsHitTestVisible="{Binding ElementName=AssistsPopup, Path=IsOpen, Mode=OneWay, Converter={StaticResource InvertBooleanConverter}}">
              <ToolTip.Tip>
                <c:AssistsDescription DataContext="{Binding Source={x:Static c:AssistsViewModel.Instance}}"/>
              </ToolTip.Tip>
            </ToggleButton>
            <c:ModernPopup x:Name="AssistsPopup" PlacementTarget="{Binding ElementName=AssistsButton}" Placement="Top" IsOpen="{Binding IsChecked, ElementName=AssistsButton, Mode=TwoWay}" Padding="16 12 16 16">
              <uc:AssistsEditor DataContext="{Binding Source={x:Static c:AssistsViewModel.Instance}}"/>
            </c:ModernPopup>

            <Button Command="{Binding GoCommand}" VerticalAlignment="Bottom" IsEnabled="{Binding AcObject.CurrentRound.IsAvailable}" CommandParameter="{Binding Source={x:Static c:AssistsViewModel.Instance}}" Content="{x:Static g:AppStrings.Common_Go}" Theme="{StaticResource Go.Button}"/>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>

    <Border Background="{DynamicResource DarkStripeBackground}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" MaxWidth="320" TextElement.Foreground="{DynamicResource DarkStripeText}" IsVisible="{Binding AcObject.IsFinished, Converter={StaticResource BooleanToVisibilityConverter}}">
      <mui:BooleanSwitch Value="{Binding AcObject.IsCompleted}" VerticalAlignment="Center">
        <mui:BooleanSwitch.True>
          <DockPanel>
            <Path Data="{StaticResource CheckIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Go}" Stretch="Uniform" Margin="0 0 8 0" VerticalAlignment="Center"/>
            <TextBlock TextWrapping="Wrap">
              <TextBlock.Text>
                <Binding Path="AcObject.ChampionshipPlace" Converter="{StaticResource OrdinalizingLowerConverter}" ConverterParameter="place">
                  <Binding.StringFormat>Congratulations! You’ve completed this championship, earned {0} place and won! Press “Reset” if you want to start again.</Binding.StringFormat>
                </Binding>
              </TextBlock.Text>
            </TextBlock>
          </DockPanel>
        </mui:BooleanSwitch.True>
        <mui:BooleanSwitch.False>
          <DockPanel>
            <Path Data="{StaticResource LeaderboardIconData}" Width="12" Height="12" DockPanel.Dock="Left" Fill="{DynamicResource Error}" Stretch="Uniform" Margin="0 0 8 0" VerticalAlignment="Center"/>
            <TextBlock TextWrapping="Wrap">
              <TextBlock.Text>
                <Binding Path="AcObject.ChampionshipPlace" Converter="{StaticResource OrdinalizingLowerConverter}" ConverterParameter="place">
                  <Binding.StringFormat>You’ve completed this championship and earned {0} place. Sadly, it’s not good enough. Please, press “Reset” and try again!</Binding.StringFormat>
                </Binding>
              </TextBlock.Text>
            </TextBlock>
          </DockPanel>
        </mui:BooleanSwitch.False>
      </mui:BooleanSwitch>
    </Border>
  </mui:Cell>
</UserControl>