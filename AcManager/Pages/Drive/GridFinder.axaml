<mui:ReferenceSwitch xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AcManager.Pages.Drive" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Drive.GridFinder" Value="{Binding Value, Source={x:Static t:SteamIdHelper.Instance}}">
  <mui:ReferenceSwitch.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/Plugins.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </mui:ReferenceSwitch.Resources>

  <mui:ReferenceSwitch.Null>
    <DockPanel Margin="40 0 40 100" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="{x:Static c:ControlsStrings.Common_Error}" DockPanel.Dock="Top" Margin="0 0 0 8" Classes="Heading1"/>
      <Path Data="{StaticResource AlertIconData}" Fill="{DynamicResource Error}" Stretch="Uniform" Width="16" Height="16" Margin="0 0 8 0"/>
      <mui:BbCodeBlock Text="{Binding Source={x:Static t:ToolsStrings.Common_SteamIdIsMissing}, StringFormat='{}{0}.'}"/>
    </DockPanel>
  </mui:ReferenceSwitch.Null>

  <mui:ReferenceSwitch.NonNull>
    <mui:BooleanSwitch Value="{Binding IsReady, Source={x:Static local:GridFinder.Requirement}}">
      <mui:BooleanSwitch.True>
        <c:WebBlock x:Name="Browser" UserAgent="AC Content Manager" StartPage="https://www.grid-finder.com/#/leagues?platform=PC&amp;simulator=assetto-corsa" PreferTransparentBackground="True" NewWindowsBehavior="MultiTab" Loaded="OnWebBlockLoaded" Margin="0 4 0 0" SaveKey="GridFinder.CurrentLocation" KeepAliveKey="GridFinder" AlwaysKeepAlive="True"/>
      </mui:BooleanSwitch.True>
      <mui:BooleanSwitch.False>
        <DockPanel Margin="40 0 40 100" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{x:Static c:ControlsStrings.Common_Error}" DockPanel.Dock="Top" Margin="0 0 0 8" Classes="Heading1"/>
          <mui:Switch Value="{Binding ListView.Count}" DataContext="{Binding Source={x:Static local:GridFinder.Requirement}}">
            <DockPanel mui:Switch.When="0">
              <Path Data="{StaticResource AlertIconData}" Fill="{DynamicResource Error}" Stretch="Uniform" Width="16" Height="16" Margin="0 0 8 0"/>
              <TextBlock Text="CefSharp plugin is required for Grid Finder to work." TextWrapping="Wrap"/>
            </DockPanel>
            <mui:SpacingStackPanel Spacing="4">
              <DockPanel mui:Switch.When="0">
                <Path Data="{StaticResource AlertIconData}" Fill="{DynamicResource Error}" Stretch="Uniform" Width="16" Height="16" Margin="0 0 8 0"/>
                <TextBlock Text="Plugin is required for Grid Finder to work:" TextWrapping="Wrap"/>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding ListView}" ItemTemplate="{StaticResource PluginItemTemplate.NoOptions}" Margin="0 8 0 -12"/>
            </mui:SpacingStackPanel>
          </mui:Switch>
        </DockPanel>
      </mui:BooleanSwitch.False>
    </mui:BooleanSwitch>
  </mui:ReferenceSwitch.NonNull>
</mui:ReferenceSwitch>