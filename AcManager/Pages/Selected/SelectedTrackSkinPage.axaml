<sel:SelectedAcJsonObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="clr-namespace:AcManager.Controls;assembly=AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:sel="clr-namespace:AcManager.Pages.Selected" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:acTools="clr-namespace:AcTools;assembly=AcTools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedTrackSkinPage" mui:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSelectedSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- PORT: removed CollectionViewSource -->
    </ResourceDictionary>
  </UserControl.Resources>

  <ac:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="False">
    <ac:AcObjectBase.ToolBars>
      <mui:ToolBar mui:ToolBar.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_SkinTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <Separator/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Drive}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Drive_CarTooltip}" Command="{Binding DriveCommand}" PointerPressed="OnDriveButtonMouseDown" Theme="{StaticResource Go.ToolBarButtonWithComboBox}">
          <mui:ButtonWithComboBox.MenuItems>
            <!-- PORT: removed CollectionContainer -->
            </mui:ButtonWithComboBox.MenuItems>
        </mui:ButtonWithComboBox>
        <Separator/>
        <Button Content="Override textures" Command="{Binding OverrideTexturesCommand}" ToolTip.Tip="Pick textures to override"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Disable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Disable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Enable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Enable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_ChangeId}" Command="{Binding ChangeIdCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ChangeId_SkinTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Save}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Save_JsonTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_SkinTooltip}"/>
        <Separator/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_UpdatePreview}" Command="{Binding UpdatePreviewCommand}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_UpdatePreview_TrackTooltip}">
          <MenuItem Header="{x:Static g:AppStrings.Toolbar_UpdatePreviewWithoutShooting}" Command="{Binding UpdatePreviewDirectCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UpdatePreviewWithoutShooting_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
        </mui:ButtonWithComboBox>
      </mui:ToolBar>
    </ac:AcObjectBase.ToolBars>

    <StackPanel>
      <mui:BetterImage Margin="0 0 0 12" Filename="{Binding SelectedObject.PreviewImage}" c:ImageViewerService.Image="{Binding SelectedObject.PreviewImage}" c:ImageViewerService.MaxWidth="{Binding Source={x:Static acTools:CommonAcConsts.TrackPreviewWidth}}" MaxWidth="{Binding Source={x:Static acTools:CommonAcConsts.TrackPreviewWidth}}" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.56338}"/>

      <TextBlock Text="Tags:" Margin="0 0 0 4" Classes="Label Label.Padding"/>
      <mui:TagsList ItemsSource="{Binding SelectedObject.Tags}" SuggestionsSource="{x:Static t:SuggestionLists.TrackSkinTagsListView}"/>

      <TextBlock Text="Categories:" Margin="0 8 0 4" Classes="Label Label.Padding"/>
      <mui:TagsList ItemsSource="{Binding SelectedObject.Categories}" SuggestionsSource="{x:Static t:SuggestionLists.TrackSkinCategoriesListView}"/>

      <c:PropertiesGrid Columns="2" Margin="0 8 0 8">
        <mui:BetterTextBox c:PropertiesGrid.Label="Priority:" Text="{Binding SelectedObject.Priority, TargetNullValue=''}" Mode="Integer" Placeholder="Normal" Theme="{StaticResource Borderless}"/>

        <mui:Cell mui:ContextMenuAdvancement.PropagateToChildren="True" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_Author_Tooltip}">
          <c:PropertiesGrid.Label>
            <MultiBinding Converter="{x:Static sel:SelectedAcObjectViewModel.VersionInfoLabelConverter}">
              <Binding Path="SelectedObject"/>
              <Binding Path="SelectedObject.VersionInfoDisplay"/>
            </MultiBinding>
          </c:PropertiesGrid.Label>
          <mui:Cell.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByAuthor}" Command="{Binding Path=FilterCommand}" CommandParameter="author"/>
              <MenuItem Header="Filter by origin" Command="{Binding Path=FilterCommand}" CommandParameter="origin"/>
            </ContextMenu>
          </mui:Cell.ContextMenu>
          <mui:BbCodeBlock Text="{Binding SelectedObject.VersionInfoDisplay}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" PointerReleased="OnVersionInfoBlockClick"/>
          <Border Background="Transparent" PointerReleased="OnVersionInfoBlockClick"/>
        </mui:Cell>
      </c:PropertiesGrid>

      <TextBlock Text="Description:" Margin="0 8 0 4" Classes="Label Label.Padding"/>
      <mui:BetterTextBox Text="{Binding SelectedObject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="200" Placeholder="None" Theme="{StaticResource Borderless}"/>
    </StackPanel>
  </ac:AcObjectBase>
</sel:SelectedAcJsonObjectPage>