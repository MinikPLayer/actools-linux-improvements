<selected:SelectedAcJsonObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:selected="clr-namespace:AcManager.Pages.Selected" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedPythonAppPage" mui:InputBindingBehavior.PropagateToWindow="True" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <c:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="True" Icon="{Binding SelectedObject.AppIcon.Value}" IconMouseUp="OnIconClick">
    <c:AcObjectBase.ToolBars>
      <mui:ToolBar mui:ToolBar.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_AppTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <!--<Separator />
        <Button Content="{x:Static g:AppStrings.Toolbar_Share}" Command="{Binding ShareCommand}" ToolTip="Share app (Ctrl+Page Up)" />
        <Button Content="{x:Static g:AppStrings.Toolbar_Test}" Command="{Binding TestCommand}" ToolTip="Test filter in showroom (Ctrl+G)" />-->
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Disable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Disable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Enable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Enable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnToggleClick"/>
        <!--<Button Content="{x:Static g:AppStrings.Toolbar_Rename}" Command="{Binding SelectedObject.SaveCommand}"
                        ToolTip="{x:Static g:AppStrings.Toolbar_Rename_AppTooltip}" />-->
        <Button Content="{x:Static g:AppStrings.Toolbar_Save}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Save_IniTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_AppTooltip}"/>
        <Separator/>
        <Button Content="Edit icons" Command="{Binding ChangeIconCommand}" ToolTip.Tip="Edit windows’ icons"/>
      </mui:ToolBar>
    </c:AcObjectBase.ToolBars>

    <mui:SpacingStackPanel Spacing="8">
      <CheckBox IsChecked="{Binding IsActivated}" IsEnabled="{Binding SelectedObject.Enabled}">
        <Label Content="{x:Static g:AppStrings.AcObject_AppActivated}"/>
      </CheckBox>

      <StackPanel>
        <TextBlock Text="Windows:" Margin="0 8 0 4" Classes="Label Label.Padding"/>
        <mui:Switch Value="{Binding SelectedObject.Windows.Value.Count, FallbackValue=0}" Height="27" ToolTip.Tip="You can add lines like “# app window: Window Name” to your code to help CM figure out their names">
          <mui:BooleanSwitch Value="{Binding SelectedObject.Windows.IsSet}" mui:Switch.When="0">
            <mui:BooleanSwitch.True>
              <mui:PlaceholderTextBlock Placeholder="No windows found"/>
            </mui:BooleanSwitch.True>
            <mui:BooleanSwitch.False>
              <mui:PlaceholderTextBlock Placeholder="Loading…"/>
            </mui:BooleanSwitch.False>
          </mui:BooleanSwitch>
          <ItemsControl ItemsSource="{Binding SelectedObject.Windows.Value}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="1" BorderBrush="{DynamicResource ButtonBorder}" Background="{DynamicResource ButtonBackground}" Margin="0 0 4 4" Padding="4 2">
                  <DockPanel>
                    <mui:BetterImage Filename="{Binding IconOff}" Width="16" Height="16" Margin="0 0 4 0" PointerReleased="OnWindowIconClick"/>
                    <TextBlock Text="{Binding DisplayName}" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonText}"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </mui:Switch>

        <TextBlock Text="Tags:" Margin="0 0 0 4" Classes="Label Label.Padding"/>
        <mui:TagsList ItemsSource="{Binding SelectedObject.Tags}" SuggestionsSource="{x:Static t:SuggestionLists.TrackSkinTagsListView}"/>

        <c:PropertiesGrid Columns="2" Margin="0 8 0 8">
          <mui:BetterTextBox c:PropertiesGrid.Label="ID:" Text="{Binding SelectedObject.Id, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>

          <DockPanel mui:ContextMenuAdvancement.PropagateToChildren="True" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_Author_Tooltip}">
            <c:PropertiesGrid.Label>
              <MultiBinding Converter="{x:Static selected:SelectedAcObjectViewModel.VersionInfoLabelConverter}">
                <Binding Path="SelectedObject"/>
                <Binding Path="SelectedObject.VersionInfoDisplay"/>
              </MultiBinding>
            </c:PropertiesGrid.Label>
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByAuthor}" Command="{Binding Path=FilterCommand}" CommandParameter="author"/>
                <MenuItem Header="Filter by origin" Command="{Binding Path=FilterCommand}" CommandParameter="origin"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <Button DockPanel.Dock="Right" Margin="4 0 0 0" Padding="4 0" c:CupUi.Object="{Binding SelectedObject}" IsVisible="False">
              <Path Data="{StaticResource UpdateIconData}" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource GoButtonText}" StrokeThickness="0" Stretch="Uniform"/>
            </Button>
            <mui:BbCodeBlock Text="{Binding SelectedObject.VersionInfoDisplay}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" PointerReleased="OnVersionInfoBlockClick"/>
            <Border Background="Transparent" PointerReleased="OnVersionInfoBlockClick"/>
          </DockPanel>
        </c:PropertiesGrid>

        <TextBlock Text="Description:" Margin="0 8 0 4" Classes="Label Label.Padding"/>
        <mui:BetterTextBox Text="{Binding SelectedObject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Placeholder="None" Theme="{StaticResource Borderless}"/>
      </StackPanel>
    </mui:SpacingStackPanel>

  </c:AcObjectBase>
</selected:SelectedAcJsonObjectPage>