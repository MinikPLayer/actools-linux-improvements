<selected:SelectedAcObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="clr-namespace:AcManager" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:selected="clr-namespace:AcManager.Pages.Selected" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedFontPage" mui:InputBindingBehavior.PropagateToWindow="True" Loaded="OnLoaded">
  <c:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="True" IconMouseUp="OnIconClick">
    <c:AcObjectBase.IconContent>
      <c:FontIconImage Source="{Binding SelectedObject.IconBitmap}"/>
    </c:AcObjectBase.IconContent>
    <c:AcObjectBase.ToolBars>
      <mui:ToolBar mui:ToolBar.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_FontTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_RescanUsings}" Command="{Binding UsingsRescanCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_RescanUsings_Tooltip}"/>
      </mui:ToolBar>
      <mui:ToolBar Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_CreateNewFont}" Command="{Binding CreateNewFontCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_CreateNewFont_Tooltip}"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Disable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Disable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Enable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Enable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Save}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Save_JsonTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_FontTooltip}"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_DisableUnused}" Command="{Binding DisableUnusedCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_DisableUnused_Tooltip}"/>
      </mui:ToolBar>
    </c:AcObjectBase.ToolBars>

    <StackPanel>
      <StackPanel Margin="8 8 8 20">
        <TextBlock Text="{x:Static g:AppStrings.AcObject_FontTestLabel}" Margin="0 0 0 0" Classes="Label"/>
        <mui:BetterTextBox x:Name="TextBox" Placeholder="?" Margin="0 4 0 0" TextChanged="OnTestTextChanged"/>
        <Grid x:Name="Canvas" Height="120" Background="{DynamicResource ThumbnailBackground}" Margin="0 4 0 0" ClipToBounds="True" c:ImageViewerService.Image="{Binding SelectedObject.FontBitmap}">
          <Grid.Effect>
            <!-- PORT: removed AsTransparencyMask (pixel shader effect) -->
          </Grid.Effect>
        </Grid>
      </StackPanel>

      <DockPanel Margin="8 0 8 8" IsVisible="{Binding Path=SelectedObject.Author, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
        <TextBlock Text="{x:Static c:ControlsStrings.AcObject_AuthorLabel}" Margin="0 0 0 0" Width="80" DockPanel.Dock="Left" Classes="Label"/>
        <mui:BetterTextBox Placeholder="?" Text="{Binding SelectedObject.Author, Mode=OneWay}" IsReadOnly="True" Theme="{StaticResource Borderless}"/>
      </DockPanel>

      <StackPanel Margin="8 0 8 0">
        <TextBlock Text="{x:Static g:AppStrings.AcObject_FontUsedInLabel}" Margin="0 0 0 0" Classes="Label"/>
        <mui:PlaceholderTextBlock Placeholder="?" Margin="0 4 0 0" TextWrapping="Wrap" Text="{Binding SelectedObject.UsingsCarsIds, Converter={x:Static selected:SelectedFontPage.UsingsConverter}}"/>
        <TextBlock TextAlignment="Right" Margin="0 4 0 0" Text="{Binding Manager.LastUsingsRescan, StringFormat={x:Static g:AppStrings.AcObject_FontLastScannedFormat}, TargetNullValue={x:Static g:AppStrings.AcObject_FontLastScannedNever}}" Classes="Small"/>
        <Button Margin="0 4 0 0" Command="{Binding UsingsRescanCommand}" Content="{x:Static g:AppStrings.AcObject_UsingsRescan}"/>
      </StackPanel>
    </StackPanel>
  </c:AcObjectBase>
</selected:SelectedAcObjectPage>