<selected:SelectedAcObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:selected="clr-namespace:AcManager.Pages.Selected" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:services="clr-namespace:AcManager.Controls.Services;assembly=AcManager.Controls" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedReplayPage" mui:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <c:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="False">
    <c:AcObjectBase.ToolBars>
      <mui:ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_ReplayTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <Separator/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Drive}" Command="{Binding QuickDriveButton.DriveCommand}" PointerPressed="OnDriveButtonMouseDown" Theme="{StaticResource Go.ToolBarButtonWithComboBox}">
          <mui:ButtonWithComboBox.Resources>
            <!-- PORT: removed CollectionViewSource -->
          </mui:ButtonWithComboBox.Resources>
          <mui:ButtonWithComboBox.ButtonToolTip>
            <StackPanel>
              <TextBlock Text="{x:Static g:AppStrings.Toolbar_QuickDrive_FirstLine}"/>
              <TextBlock Text="{x:Static g:AppStrings.Toolbar_QuickDrive_SecondLine}"/>
            </StackPanel>
          </mui:ButtonWithComboBox.ButtonToolTip>
          <mui:ButtonWithComboBox.MenuItems>
            <!-- PORT: removed CollectionContainer -->
            </mui:ButtonWithComboBox.MenuItems>
        </mui:ButtonWithComboBox>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_UploadAndShare}" Command="{Binding ShareCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UploadAndShare_ReplayTooltip}" IsVisible="{Binding AlreadyShared, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_UploadAndShare}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_UploadAndShare_ReplayTooltip}" Command="{Binding ShareCommand}" IsVisible="{Binding AlreadyShared, Converter={StaticResource BooleanToVisibilityConverter}}">
          <mui:ButtonWithComboBox.MenuItems>
            <MenuItem Header="Reupload" Command="{Binding ShareCommand}" CommandParameter="True"/>
          </mui:ButtonWithComboBox.MenuItems>
        </mui:ButtonWithComboBox>

        <Button Content="{x:Static g:AppStrings.Toolbar_Play}" Command="{Binding PlayCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Play_Tooltip}" Theme="{StaticResource Go.ToolBarButton}"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Rename}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Rename_ReplayTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_ReplayTooltip}"/>
      </mui:ToolBar>
    </c:AcObjectBase.ToolBars>

    <StackPanel Margin="0 0 0 8">
      <StackPanel Classes="SettingsPanel">
        <DockPanel>
          <Label Content="Category:"/>
          <Button Command="{Binding ClearCategoryCommand}" Content="{x:Static c:ControlsStrings.Common_Clear}"/>
          <Button Command="{Binding ChangeCategoryCommand}" Content="{x:Static c:ControlsStrings.Common_Change}"/>
          <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.EditableCategory, Mode=OneWay}" Theme="{StaticResource Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Rating:"/>
          <c:RatingBar Rating="{Binding SelectedObject.Rating}" HorizontalAlignment="Left"/>
        </DockPanel>
      </StackPanel>

      <Grid Margin="20 0 20 20" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <mui:Cell MaxWidth="355" Background="{DynamicResource ThumbnailBackground}" Margin="0 0 10 0" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5634}" c:ToolTips.Car="{Binding Car}" c:ContextMenus.Car="{Binding Car}" c:ContextMenus.CarSkin="{Binding CarSkin}" mui:Draggable.Data="{Binding Car}" IsVisible="{Binding Car, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnCarPreviewClick">
          <c:ContextMenus.AdditionalItems>
            <c:ContextMenusItems>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByCar}" Command="{Binding FilterCommand}" CommandParameter="car"/>
            </c:ContextMenusItems>
          </c:ContextMenus.AdditionalItems>

          <mui:BetterImage Filename="{Binding CarSkin.PreviewImage}" MaxWidth="355" Stretch="UniformToFill"/>
          <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom" TextElement.Foreground="{DynamicResource DarkStripeText}">
            <mui:BetterImage Filename="{Binding Car.BrandBadge}" Width="16" Height="16" Margin="4 4 0 4" IsVisible="{Binding Car, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>
            <mui:ContextMenuButton Padding="2 0 6 0" DockPanel.Dock="Right" LookForParentMenu="True"/>
            <TextBlock Text="{Binding Car.DisplayName}" Padding="4"/>
          </DockPanel>
        </mui:Cell>

        <mui:Cell Grid.Column="1" MaxWidth="355" Background="{DynamicResource ThumbnailBackground}" services:ImageViewerService.Image="{Binding Track.PreviewImage}" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5634}" Margin="10 0 0 0" c:ToolTips.Track="{Binding Track}" c:ContextMenus.Track="{Binding Track}" mui:Draggable.Data="{Binding Track}" IsVisible="{Binding Track, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
          <c:ContextMenus.AdditionalItems>
            <c:ContextMenusItems>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByTrack}" Command="{Binding FilterCommand}" CommandParameter="track"/>
            </c:ContextMenusItems>
          </c:ContextMenus.AdditionalItems>

          <mui:BetterImage StretchDirection="Both" Filename="{Binding Track.PreviewImage}" Width="355" Height="200" Stretch="UniformToFill"/>
          <mui:BetterImage StretchDirection="Both" Filename="{Binding Track.OutlineImage}" Width="365" Height="192" Stretch="Uniform" Margin="-5 0 -5 8"/>
          <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom" TextElement.Foreground="{DynamicResource DarkStripeText}">
            <mui:ContextMenuButton Padding="2 0 6 0" DockPanel.Dock="Right" LookForParentMenu="True"/>
            <TextBlock Text="{Binding Track.Name}" Padding="4"/>
          </DockPanel>
        </mui:Cell>
      </Grid>

      <c:PropertiesGrid LabelWidth="160">
        <TextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.AcObject_DateLabel}" Text="{Binding SelectedObject.CreationDateTime}">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByAge}" Command="{Binding FilterCommand}" CommandParameter="age"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </TextBlock>

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.AcObject_DriverNameLabel}" Text="{Binding SelectedObject.DriverName}" Placeholder="?">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByDriver}" Command="{Binding FilterCommand}" CommandParameter="driver"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </mui:PlaceholderTextBlock>

        <TextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.AcObject_SizeLabel}" Text="{Binding SelectedObject.Size, Converter={StaticResource FileSizeConverter}}">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_BySize}" Command="{Binding FilterCommand}" CommandParameter="size"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </TextBlock>

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="{x:Static g:AppStrings.AcObject_WeatherLabel}" Text="{Binding Weather.DisplayName}" Placeholder="?">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByWeather}" Command="{Binding FilterCommand}" CommandParameter="weather"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </mui:PlaceholderTextBlock>

        <!--<mui:PlaceholderTextBlock c:PropertiesGrid.Label="Number of frames:" Text="{Binding SelectedObject.NumberOfFrames}" Placeholder="?">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Filter by number of frames" Command="{Binding FilterCommand}" CommandParameter="framesNumber" />
            </ContextMenu>
          </TextBlock.ContextMenu>
        </mui:PlaceholderTextBlock>-->

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Recording quality" Text="{Binding SelectedObject.RecordingQuality, StringFormat='{}{0} Hz', TargetNullValue={x:Null}}" Placeholder="?">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Filter by recording quality" Command="{Binding FilterCommand}" CommandParameter="recordingquality"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </mui:PlaceholderTextBlock>

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Duration:" Text="{Binding SelectedObject.DisplayDuration}" Placeholder="?">
          <!--<TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Filter by duration" Command="{Binding FilterCommand}" CommandParameter="duration" />
            </ContextMenu>if
          </TextBlock.ContextMenu>-->
        </mui:PlaceholderTextBlock>

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Version:" Text="{Binding SelectedObject.Version}" Placeholder="?">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Filter by version" Command="{Binding FilterCommand}" CommandParameter="version"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </mui:PlaceholderTextBlock>

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Number of cars:" Text="{Binding SelectedObject.CarsNumber}" Placeholder="?">
          <TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Filter by number of cars" Command="{Binding FilterCommand}" CommandParameter="cars"/>
            </ContextMenu>
          </TextBlock.ContextMenu>
        </mui:PlaceholderTextBlock>

        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Time:" Text="{Binding SelectedObject.TimeRange}" Placeholder="?">
          <!--<TextBlock.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Filter by time" Command="{Binding FilterCommand}" CommandParameter="time" />
            </ContextMenu>
          </TextBlock.ContextMenu>-->
        </mui:PlaceholderTextBlock>
      </c:PropertiesGrid>

      <!--<Grid Margin="0 0 8 8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static g:AppStrings.AcObject_DateLabel}" Grid.Column="0" Grid.Row="0" Style="{StaticResource Label.Padding}" />
        <TextBlock Text="{x:Static g:AppStrings.AcObject_SizeLabel}" Grid.Column="0" Grid.Row="1" Style="{StaticResource Label.Padding}" />


        <TextBlock Text="{x:Static g:AppStrings.AcObject_DriverNameLabel}" Grid.Column="2" Grid.Row="0" Style="{StaticResource Label.Padding}" />
        <TextBlock Text="{x:Static g:AppStrings.AcObject_WeatherLabel}" Grid.Column="2" Grid.Row="1" Style="{StaticResource Label.Padding}" />
      </Grid>-->

      <mui:BooleanSwitch Value="{Binding SelectedObject.IsAutoSave}">
        <mui:Cell Margin="0 20 0 0">
          <Rectangle Stroke="{DynamicResource Error}" StrokeThickness="1" StrokeDashArray="4,4"/>
          <mui:BooleanSwitch Value="{Binding Autosave, Source={x:Static t:AcSettingsHolder.Replay}}" Margin="8">
            <mui:BooleanSwitch.False>
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Error}" Text="{x:Static t:ToolsStrings.Common_Warning}" Classes="Label"/>
                <TextBlock TextWrapping="Wrap" Margin="0 4 0 0" Text="{x:Static c:ControlsStrings.Replay_CrMessage}"/>
                <TextBlock Margin="0 4 0 0" FontStyle="Italic" TextWrapping="Wrap" Text="{x:Static c:ControlsStrings.Replay_CrMessage_Commentary}" IsVisible="{Binding AutoSaveReplays, Source={x:Static t:SettingsHolder.Drive}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>
              </StackPanel>
            </mui:BooleanSwitch.False>
            <mui:BooleanSwitch.True>
              <StackPanel>
                <TextBlock Foreground="{DynamicResource Error}" Text="{x:Static t:ToolsStrings.Common_Warning}" Classes="Label"/>
                <TextBlock TextWrapping="Wrap" Margin="0 4 0 0" Text="This replay was saved automatically and it will be overwritten soon. Move it from “Autosave” category to keep it."/>
                <Button Command="{Binding KeepReplayCommand}" Content="Keep replay" Margin="0 8 0 0" IsVisible="{Binding KeepReplayCommand, Converter={x:Static pc:VisibilityConverters.ToBool}}"/>
              </StackPanel>
            </mui:BooleanSwitch.True>
          </mui:BooleanSwitch>
        </mui:Cell>
      </mui:BooleanSwitch>

      <c:MessageBlock Margin="0 20 0 0" IsVisible="{Binding SelectedObject.AllowToOverrideTime, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel>
          <TextBlock Text="Set playback time manually" Margin="0 0 0 4" DockPanel.Dock="Top" Classes="Label"/>
          <TextBlock Margin="0 0 0 4" DockPanel.Dock="Top" Text="Because of night mode being in development and all that, if you want to run a replay of a night race saved without extended information, you would need to remind CM and AC what time it took place in."/>
          <mui:ValueLabel Value="{Binding DisplayTime}" mui:BetterTextBox.Mode="Time" Margin="0 0 20 0" Content="{x:Static g:AppStrings.Drive_Time}"/>
          <Slider Value="{Binding TimeSliderMapper.MappedValue}" Margin="0 0 0 4" TickFrequency="3600" TickPlacement="BottomRight" IsSnapToTickEnabled="False" Minimum="0" Maximum="{Binding TimeSliderMapper.Size}" SmallChange="900" LargeChange="1800"/>
        </DockPanel>
      </c:MessageBlock>

    </StackPanel>
  </c:AcObjectBase>
</selected:SelectedAcObjectPage>