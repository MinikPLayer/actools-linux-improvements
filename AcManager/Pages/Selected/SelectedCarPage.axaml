<sel:SelectedAcJsonObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="clr-namespace:AcManager" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:sel="clr-namespace:AcManager.Pages.Selected" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedCarPage" mui:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSelectedSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- PORT: removed CollectionViewSource -->
      <!-- PORT: removed CollectionViewSource -->
      <!-- PORT: removed CollectionViewSource -->

      <mui:BindingProxy x:Key="Model" Data="{Binding}"/>
      <mui:BindingProxy x:Key="Selected" Data="{Binding SelectedObject}"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <c:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="True" IconMouseUp="OnIconClick" Icon="{Binding SelectedObject.BrandBadge}">
    <c:AcObjectBase.ToolBars>
      <mui:ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_CarTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <Separator/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Showroom}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Showroom_Tooltip}" Command="{Binding OpenInShowroomCommand}" PointerPressed="OnShowroomButtonMouseDown">
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding OpenInShowroomOptionsCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Presets}">
            <MenuItem.Items>
              <!-- PORT: removed CollectionContainer -->
              </MenuItem.Items>
          </MenuItem>
        </mui:ButtonWithComboBox>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Selected_CarSkinPage_CMShowroom}" ButtonToolTip="View car in custom CM showroom (Alt+H)" Command="{Binding OpenInCustomShowroomCommand}" MenuItems="{Binding CustomShowroomPresets}" PointerPressed="OnCustomShowroomButtonMouseDown"/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Drive}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Drive_CarTooltip}" Command="{Binding DriveCommand}" PointerPressed="OnQuickDriveButtonMouseDown" Theme="{StaticResource Go.ToolBarButtonWithComboBox}">
          <mui:ButtonWithComboBox.MenuItems>
            <!-- PORT: removed CollectionContainer -->
            </mui:ButtonWithComboBox.MenuItems>
        </mui:ButtonWithComboBox>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Analyze}" IsEnabled="False"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_CarSkins}" Command="{Binding ManageSkinsCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_CarSkins_Tooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_CarSetups}" Command="{Binding ManageSetupsCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_CarSetups_Tooltip}"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Disable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Disable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Enable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Enable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Save}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Save_JsonTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" mui:FancyHintsService.Hint="{Binding Id, Source={x:Static c:FancyHints.AccidentallyRemoved}}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_CarTooltip}"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_FindInformation}" Command="{Binding FindInformationCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_FindInformation_CarTooltip}"/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_UpdatePreviews}" Command="{Binding UpdatePreviewsCommand}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_UpdatePreviews_Tooltip}" PointerPressed="OnUpdatePreviewsButtonMouseDown">
          <MenuItem Header="{x:Static g:AppStrings.Toolbar_UpdatePreviewsManually}" Command="{Binding UpdatePreviewsManuallyCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UpdatePreviewsManually_Tooltip}" IsVisible="{Binding CustomShowroomPreviews, Source={x:Static t:SettingsHolder.CustomShowroom}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding UpdatePreviewsOptionsCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UpdatePreviewsOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <Separator/>
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Presets}">
            <MenuItem.Items>
              <!-- PORT: removed CollectionContainer -->
              </MenuItem.Items>
          </MenuItem>
        </mui:ButtonWithComboBox>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_PackData}" Command="{Binding PackDataCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_PackData_Tooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_UnpackData}" Command="{Binding ReadDataCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UnpackData_Tooltip}" IsVisible="{Binding DeveloperMode, Source={x:Static t:SettingsHolder.Common}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_ReplaceSound}" Command="{Binding ReplaceSoundCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ReplaceSound_Tooltip}"/>
      </mui:ToolBar>
    </c:AcObjectBase.ToolBars>

    <StackPanel>
      <!-- Preview, skins -->
      <Grid Margin="0 0 0 12" MaxHeight="575">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="114"/>
        </Grid.ColumnDefinitions>

        <!-- Preview of selected skin -->
        <mui:Cell>
          <mui:BetterImage x:Name="SelectedSkinPreviewImage" DataContext="{Binding SelectedObject.SelectedSkin}" Filename="{Binding PreviewImage}" MinHeight="160" MaxHeight="575" MaxWidth="1022" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5626223}" PointerReleased="OnPreviewContextMenu"/>
          <mui:BetterImage Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Width="64" Height="64" Filename="{Binding SelectedObject.UpgradeIcon}" PointerPressed="UpgradeIcon_MouseDown" IsVisible="{Binding SelectedObject.IsChild, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </mui:Cell>

        <!-- Skins list -->
        <ListBox ItemsSource="{Binding SelectedObject.EnabledSkinsListView}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Column="1" Width="120" Margin="4 -2 0 -2" VerticalAlignment="Top" HorizontalAlignment="Left" Height="{Binding ActualHeight, Converter={StaticResource SumConverter}, ConverterParameter=4, ElementName=SelectedSkinPreviewImage}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <mui:VirtualizingTilePanel HorizontalAlignment="Left" ItemWidth="36" ItemHeight="36"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type t:CarSkinObject}">
              <mui:BetterImage Filename="{Binding LiveryImage}" Width="32" Height="32" ClearOnChange="True" ToolTip.Tip="{Binding DisplayName}" PointerReleased="OnPreviewContextMenu"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Data section -->
      <StackPanel IsVisible="{Binding SelectedObject.HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
        <!-- Tags -->
        <mui:TagsList ItemsSource="{Binding SelectedObject.Tags}" SuggestionsSource="{x:Static t:SuggestionLists.CarTagsListView}" mui:ContextMenuAdvancement.PropagateToChildren="True" Margin="0 0 0 12" mui:FancyHintsService.Hint="{Binding Id, Source={x:Static c:FancyHints.TagsContextMenu}, Mode=OneTime}" mui:FancyHintsService.HorizontalAlignment="Left" mui:FancyHintsService.VerticalAlignment="Top" mui:FancyHintsService.OffsetX="16" mui:FancyHintsService.OffsetY="8" mui:FancyHintsService.HorizontalContentAlignment="Left" mui:FancyHintsService.VerticalContentAlignment="Bottom">
          <mui:TagsList.ItemContextMenu>
            <mui:InheritingContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByTag}" Command="{Binding Path=FilterTagCommand}" CommandParameter="{Binding}"/>
            </mui:InheritingContextMenu>
          </mui:TagsList.ItemContextMenu>
          <mui:TagsList.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Tags_CleanUp}" Command="{Binding Path=SelectedObject.TagsCleanUpCommand}"/>
              <MenuItem Header="{x:Static g:AppStrings.Tags_Sort}" Command="{Binding Path=SelectedObject.TagsSortCommand}"/>
              <MenuItem Header="{x:Static g:AppStrings.Tags_CleanUpAndSort}" Command="{Binding Path=SelectedObject.TagsCleanUpAndSortCommand}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
            </ContextMenu>
          </mui:TagsList.ContextMenu>
        </mui:TagsList>

        <Grid Classes="ObjectDataGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- First row -->
          <DockPanel Grid.Row="0" Grid.Column="0" mui:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByBrand}" Command="{Binding Path=FilterCommand}" CommandParameter="brand"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarBrandLabel}"/>
            <mui:BetterComboBox ItemsSource="{x:Static t:SuggestionLists.CarBrandsListView}" Text="{Binding SelectedObject.Brand}"/>
          </DockPanel>

          <DockPanel Grid.Row="0" Grid.Column="1" mui:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByCountry}" Command="{Binding Path=FilterCommand}" CommandParameter="country"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_ContryLabel}"/>
            <mui:BetterComboBox ItemsSource="{x:Static t:SuggestionLists.CountriesListView}" Text="{Binding SelectedObject.Country}"/>
          </DockPanel>

          <!-- Second row -->
          <DockPanel Grid.Row="1" Grid.Column="0" mui:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByClass}" Command="{Binding Path=FilterCommand}" CommandParameter="class"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarClassLabel}">
              <ToolTip.Tip>Car class (such as “race” or “street”) in lowercase</ToolTip.Tip>
            </TextBlock>
            <mui:BetterComboBox ItemsSource="{x:Static t:SuggestionLists.CarClassesListView}" Text="{Binding SelectedObject.CarClass}"/>
          </DockPanel>

          <DockPanel Grid.Row="1" Grid.Column="1" mui:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByYear}" Command="{Binding Path=FilterCommand}" CommandParameter="year"/>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByDecade}" Command="{Binding Path=FilterCommand}" CommandParameter="decade"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_YearLabel}" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_YearLabel_CarTooltip}"/>
            <mui:BetterTextBox Text="{Binding SelectedObject.Year, TargetNullValue=''}" Mode="Integer" Minimum="1900" Maximum="2100"/>
          </DockPanel>

          <!-- Third row -->
          <DockPanel Grid.Row="2" Grid.Column="0">
            <ToolTip.Tip>
              <ToolTip IsVisible="{Binding SelectedObject.Parent, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
                <StackPanel Margin="4 8">
                  <TextBlock Text="{Binding SelectedObject.Parent.DisplayName}" Margin="0 0 0 4" Classes="Heading2"/>
                  <c:CarBlock Car="{Binding SelectedObject.Parent}" ShowSkinsAndPreview="False" SelectSkin="False" Width="512" MaxHeight="320"/>
                </StackPanel>
              </ToolTip>
            </ToolTip.Tip>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarParentLabel}" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_CarParentLabel_Tooltip}"/>
            <mui:BbCodeBlock Text="{Binding SelectedObject.ParentDisplayName}" Placeholder="{x:Static t:ToolsStrings.Common_None}" PointerPressed="ParentBlock_OnMouseDown"/>
          </DockPanel>

          <DockPanel Grid.Row="2" Grid.Column="1">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByAuthor}" Command="{Binding Path=FilterCommand}" CommandParameter="author"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_Author_Tooltip}">
              <TextBlock.Text>
                <MultiBinding Converter="{x:Static sel:SelectedAcObjectViewModel.VersionInfoLabelConverter}">
                  <Binding Path="SelectedObject"/>
                  <Binding Path="SelectedObject.VersionInfoDisplay"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <Button DockPanel.Dock="Right" Margin="4 0 0 0" Padding="4 0" c:CupUi.Object="{Binding SelectedObject}" IsVisible="False">
              <Path Data="{StaticResource UpdateIconData}" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource GoButtonText}" StrokeThickness="0" Stretch="Uniform"/>
            </Button>
            <mui:BbCodeBlock Text="{Binding SelectedObject.VersionInfoDisplay}" Placeholder="?" PointerReleased="OnVersionInfoBlockClick"/>
          </DockPanel>

          <!-- Last row -->
          <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByPower}" Command="{Binding Path=FilterCommand}" CommandParameter="power"/>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByTorque}" Command="{Binding Path=FilterCommand}" CommandParameter="torque"/>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByWeight}" Command="{Binding Path=FilterCommand}" CommandParameter="weight"/>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByPwRatio}" Command="{Binding Path=FilterCommand}" CommandParameter="pwratio"/>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByTopSpeed}" Command="{Binding Path=FilterCommand}" CommandParameter="topspeed"/>
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByAcceleration}" Command="{Binding Path=FilterCommand}" CommandParameter="acceleration"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_SpecsLabel}"/>
            <mui:BbCodeBlock Text="{Binding SelectedObject.SpecsInfoDisplay}" Placeholder="?" PointerPressed="SpecsInfoBlock_OnMouseDown"/>
          </DockPanel>
        </Grid>

        <!-- Description -->
        <mui:BetterTextBox Text="{Binding SelectedObject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Placeholder="{x:Static t:ToolsStrings.Common_None}" Theme="{StaticResource Borderless}"/>
      </StackPanel>
    </StackPanel>
  </c:AcObjectBase>
</sel:SelectedAcJsonObjectPage>