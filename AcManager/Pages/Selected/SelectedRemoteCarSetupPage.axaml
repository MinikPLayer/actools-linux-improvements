<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:sel="clr-namespace:AcManager.Pages.Selected" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedRemoteCarSetupPage" mui:InputBindingBehavior.PropagateToWindow="True" x:Name="This">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="EntryDataTemplate" DataType="{x:Type t:CarSetupEntry}">
        <Border Background="Transparent" ToolTip.Tip="{Binding HelpInformation}">
          <mui:ReferenceSwitch Value="{Binding Values}">
            <mui:ReferenceSwitch.NonNull>
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="0 4 0 0" IsVisible="{Binding RatioMaxSpeed, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small">
                  <Run Text="Maximum speed: "/>
                  <Run Text="{Binding RatioMaxSpeed, Mode=OneWay, ConverterParameter={x:Static t:SettingsHolder+CommonSettings.DistanceMultiplier}, StringFormat={x:Static t:SettingsHolder+CommonSettings.SpeedFormat}}"/>
                </TextBlock>
                <TextBlock Text="{Binding DisplayName, StringFormat={x:Static mui:ColonConverter.FormatNoSpaceAfterwards}}" Margin="0 2 0 4" Width="160" DockPanel.Dock="Left" VerticalAlignment="Top" Classes="Label"/>
                <mui:BetterComboBox SelectedItem="{Binding ValuePair}" ItemsSource="{Binding Values}" IsEditable="False" VerticalAlignment="Top" IsHitTestVisible="False" Focusable="False" DisplayMemberBinding="{Binding Key}"/>
              </DockPanel>
            </mui:ReferenceSwitch.NonNull>
            <mui:ReferenceSwitch.Null>
              <DockPanel>
                <mui:ValueLabel Value="{Binding Value}" Postfix="{Binding UnitsPostfix}" Content="{Binding DisplayName}" Margin="0 0 0 4" Width="160" DockPanel.Dock="Left" IsHitTestVisible="False" Focusable="False"/>
                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" TickFrequency="{Binding VisualStep}" TickPlacement="BottomRight" IsSnapToTickEnabled="True" SmallChange="{Binding Step}" LargeChange="{Binding Step}" IsHitTestVisible="False" Focusable="False"><!-- PORT: removed IsMoveToPointEnabled (not in Avalonia) --></Slider>
              </DockPanel>
            </mui:ReferenceSwitch.Null>
          </mui:ReferenceSwitch>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <c:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="True" Icon="{Binding Car.BrandBadge}" IsNameReadOnly="True" Scrollable="False">
    <c:AcObjectBase.ToolBars>
      <mui:ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="View in browser" Command="{Binding SelectedObject.ViewInBrowserCommand}" ToolTip.Tip="View setup’s page in the webbrowser (Ctrl+F)"/>
        <Button Content="Copy URL" Command="{Binding SelectedObject.CopyUrlCommand}" ToolTip.Tip="Copy URL to this setup to the clipboard (Ctrl+Alt+Page Up)"/>
        <Button Content="Share link" Command="{Binding ShareCommand}" ToolTip.Tip="Copy URL to quickly install this setup via Content Manager (Ctrl+Page Up)"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="Install" Command="{Binding SelectedObject.InstallCommand}" ToolTip.Tip="Install setup (Ctrl+S)"/>
        <Button Content="Install as generic" Command="{Binding SelectedObject.InstallCommand}" CommandParameter="{x:Static t:CarSetupObject.GenericDirectory}" ToolTip.Tip="Install setup as generic (Ctrl+Alt+S)"/>
      </mui:ToolBar>
    </c:AcObjectBase.ToolBars>

    <DockPanel>
      <mui:SpacingUniformGrid HorizontalSpacing="20" Columns="2" DockPanel.Dock="Top">
        <StackPanel Classes="SettingsPanel">
          <DockPanel>
            <Label Content="{x:Static g:AppStrings.AcObject_TrackLabel}"/>
            <Grid>
              <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.Track.MainTrackObject.Name, Mode=OneWay}" IsVisible="{Binding SelectedObject.Track, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Theme="{StaticResource Borderless}"/>
              <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.TrackId, Mode=OneWay}" Placeholder="{x:Static c:ControlsStrings.Common_Generic}" IsVisible="{Binding SelectedObject.Track, Converter={StaticResource NullToVisibilityConverter}}" Theme="{StaticResource Borderless}"/>
            </Grid>
          </DockPanel>

          <DockPanel>
            <Label Content="Author:"/>
            <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.Author, Mode=OneWay}" Placeholder="?" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="Date:"/>
            <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.CreationDateTime, Mode=OneWay}" Placeholder="?" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="Your rating (local):"/>
            <c:RatingBar Rating="{Binding SelectedObject.Rating}" HorizontalAlignment="Left"/>
          </DockPanel>

          <DockPanel>
            <Label Content="Version:"/>
            <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.Version, Mode=OneWay}" Placeholder="?" Theme="{StaticResource Borderless}"/>
          </DockPanel>
        </StackPanel>

        <StackPanel Classes="SettingsPanel">
          <DockPanel>
            <Label Content="Downloads:"/>
            <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.Downloads, Mode=OneWay}" Placeholder="?" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="Trim:"/>
            <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.Trim, Mode=OneWay}" Placeholder="?" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="Best time:"/>
            <mui:BetterTextBox IsReadOnly="True" Text="{Binding SelectedObject.BestTime, Converter={StaticResource MillisecondsTimeSpanConverter}, Mode=OneWay}" Placeholder="?" Theme="{StaticResource Borderless}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="Community rating:"/>
            <c:RatingBar Rating="{Binding SelectedObject.CommunityRating, Mode=OneWay}" IsReadOnly="True" HorizontalAlignment="Left"/>
          </DockPanel>
        </StackPanel>
      </mui:SpacingUniformGrid>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding SetupValues.Tabs}" Margin="10 0 0 0" IsVisible="{Binding SetupValues.IsLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Classes="SettingsPanel">
                <TextBlock Text="{Binding DisplayName}" Classes="Heading2 SettingsPanel.Heading2.First"/>

                <StackPanel Margin="20 0 0 12" IsVisible="{Binding Key, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TYRES}">
                  <TextBlock Text="{Binding SetupValues.SelectedTyres.DisplayName}" DataContext="{Binding DataContext, ElementName=This}" Classes="Heading2 SettingsPanel.Heading2.First"/>
                  <ComboBox ItemsSource="{Binding SetupValues.Tyres}" SelectedItem="{Binding SetupValues.SelectedTyres, Mode=OneWay}" DataContext="{Binding DataContext, ElementName=This}" IsHitTestVisible="False" Focusable="False" DisplayMemberBinding="{Binding DisplayName}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Entries}" Margin="20 0 0 0" ItemTemplate="{StaticResource EntryDataTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <mui:SpacingUniformGrid HorizontalSpacing="12" VerticalSpacing="12" Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <mui:SpacingStackPanel Spacing="12"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </c:AcObjectBase>
</UserControl>