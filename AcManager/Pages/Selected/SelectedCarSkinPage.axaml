<sel:SelectedAcJsonObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="clr-namespace:AcManager.Controls;assembly=AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:sel="clr-namespace:AcManager.Pages.Selected" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedCarSkinPage" mui:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSelectedSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- PORT: removed CollectionViewSource -->
      <!-- PORT: removed CollectionViewSource -->
      <!-- PORT: removed CollectionViewSource -->
      <mui:BindingProxy x:Key="Model" Data="{Binding}"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <ac:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="True" IconMouseUp="OnIconClick" Icon="{Binding SelectedObject.LiveryImage}">
    <ac:AcObjectBase.ToolBars>
      <mui:ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_SkinTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Clone}" Command="{Binding CloneCommand}" ToolTip.Tip="Clone skin (Ctrl+Shift+D)"/>
        <Separator/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Showroom}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Showroom_Tooltip}" Command="{Binding OpenInShowroomCommand}" PointerPressed="OnShowroomButtonMouseDown">
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding OpenInShowroomOptionsCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Presets}">
            <MenuItem.Items>
              <!-- PORT: removed CollectionContainer -->
              </MenuItem.Items>
          </MenuItem>
        </mui:ButtonWithComboBox>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Selected_CarSkinPage_CMShowroom}" ButtonToolTip="View car in custom CM showroom (Alt+H)" Command="{Binding OpenInCustomShowroomCommand}" MenuItems="{Binding CustomShowroomPresets}" PointerPressed="OnCustomShowroomButtonMouseDown"/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Drive}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Drive_CarTooltip}" Command="{Binding DriveCommand}" PointerPressed="OnDriveButtonMouseDown" Theme="{StaticResource Go.ToolBarButtonWithComboBox}">
          <mui:ButtonWithComboBox.MenuItems>
            <!-- PORT: removed CollectionContainer -->
            </mui:ButtonWithComboBox.MenuItems>
        </mui:ButtonWithComboBox>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Disable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Disable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Enable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Enable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_ChangeId}" Command="{Binding ChangeIdCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ChangeId_SkinTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Save}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Save_JsonTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_SkinTooltip}"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_DeleteJson}" Command="{Binding DeleteJsonCommand}" ToolTip.Tip="{x:Static ac:ControlsStrings.Toolbar_DeleteJson_Tooltip}" IsVisible="{Binding SelectedObject.HasData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_CreateJson}" Command="{Binding CreateJsonCommand}" ToolTip.Tip="{x:Static ac:ControlsStrings.Toolbar_CreateJson_Tooltip}" IsVisible="{Binding SelectedObject.HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>
        <Separator/>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_UpdatePreview}" Command="{Binding UpdatePreviewCommand}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_UpdatePreview_SkinTooltip}" PointerPressed="OnUpdatePreviewsButtonMouseDown">
          <MenuItem Header="{x:Static g:AppStrings.Toolbar_UpdatePreviewsManually}" Command="{Binding UpdatePreviewManuallyCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UpdatePreviewsManually_Tooltip}" IsVisible="{Binding CustomShowroomPreviews, Source={x:Static t:SettingsHolder.CustomShowroom}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding UpdatePreviewOptionsCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UpdatePreviewsOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <Separator/>
          <MenuItem Header="{x:Static c:ControlsStrings.Common_Presets}">
            <MenuItem.Items>
              <!-- PORT: removed CollectionContainer -->
              </MenuItem.Items>
          </MenuItem>
        </mui:ButtonWithComboBox>
        <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_ChangeLivery}" Command="{Binding ChangeLiveryCommand}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_ChangeLivery_Tooltip}">
          <MenuItem Header="{x:Static g:AppStrings.Toolbar_GenerateLivery}" Command="{Binding GenerateLiveryCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_GenerateLivery_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          <MenuItem Header="{x:Static g:AppStrings.Toolbar_GenerateRandomLivery}" Command="{Binding GenerateRandomLiveryCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_GenerateRandomLivery_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
        </mui:ButtonWithComboBox>
      </mui:ToolBar>
    </ac:AcObjectBase.ToolBars>

    <StackPanel>
      <mui:BetterImage Margin="0 0 0 12" Filename="{Binding SelectedObject.PreviewImage}" c:ImageViewerService.Image="{Binding SelectedObject.PreviewImage}" c:ImageViewerService.MaxWidth="1022" MaxWidth="1022" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5626223}"/>

      <!-- data section -->
      <Grid IsVisible="{Binding SelectedObject.HasData, Converter={StaticResource BooleanToVisibilityConverter}}" Classes="ObjectDataGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- first row -->
        <DockPanel Grid.Row="0" Grid.Column="0" mui:ContextMenuAdvancement.PropagateToChildren="True">
          <DockPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByDriver}" Command="{Binding FilterCommand}" CommandParameter="driver" DataContext="{Binding Data, Source={StaticResource Model}}"/>
            </ContextMenu>
          </DockPanel.ContextMenu>
          <TextBlock Text="{x:Static g:AppStrings.AcObject_DriverLabel}"/>
          <mui:BetterComboBox ItemsSource="{x:Static t:SuggestionLists.CarSkinDriverNamesListView}" Text="{Binding SelectedObject.DriverName}"/>
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="1" mui:ContextMenuAdvancement.PropagateToChildren="True">
          <DockPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByCountry}" Command="{Binding FilterCommand}" CommandParameter="country" DataContext="{Binding Data, Source={StaticResource Model}}"/>
            </ContextMenu>
          </DockPanel.ContextMenu>
          <TextBlock Text="{x:Static ac:ControlsStrings.AcObject_ContryLabel}"/>
          <mui:BetterComboBox ItemsSource="{x:Static t:SuggestionLists.CountriesListView}" Text="{Binding SelectedObject.Country}"/>
        </DockPanel>

        <!-- second row -->
        <DockPanel Grid.Row="1" Grid.Column="0" mui:ContextMenuAdvancement.PropagateToChildren="True">
          <DockPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByTeam}" Command="{Binding FilterCommand}" CommandParameter="team" DataContext="{Binding Data, Source={StaticResource Model}}"/>
            </ContextMenu>
          </DockPanel.ContextMenu>
          <TextBlock Text="{x:Static g:AppStrings.AcObject_TeamLabel}"/>
          <mui:BetterComboBox ItemsSource="{x:Static t:SuggestionLists.CarSkinTeamsListView}" Text="{Binding SelectedObject.Team}"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1">
          <DockPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByPriority}" Command="{Binding FilterCommand}" CommandParameter="priority" DataContext="{Binding Data, Source={StaticResource Model}}"/>
            </ContextMenu>
          </DockPanel.ContextMenu>
          <TextBlock Text="{x:Static g:AppStrings.AcObject_PriorityLabel}"/>
          <mui:BetterTextBox Text="{Binding SelectedObject.Priority, TargetNullValue=''}" Mode="Integer"/>
        </DockPanel>

        <!-- third row -->
        <DockPanel Grid.Row="2" Grid.Column="0">
          <DockPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static g:AppStrings.Filter_ByNumber}" Command="{Binding FilterCommand}" CommandParameter="number" DataContext="{Binding Data, Source={StaticResource Model}}"/>
            </ContextMenu>
          </DockPanel.ContextMenu>
          <TextBlock Text="{x:Static g:AppStrings.AcObject_NumberLabel}"/>
          <mui:BetterTextBox Text="{Binding SelectedObject.SkinNumber}" Mode="Integer"/>
        </DockPanel>
      </Grid>
    </StackPanel>
  </ac:AcObjectBase>
</sel:SelectedAcJsonObjectPage>