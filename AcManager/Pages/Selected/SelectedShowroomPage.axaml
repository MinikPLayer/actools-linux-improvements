<selected:SelectedAcJsonObjectPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:AcManager.Controls;assembly=AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:selected="clr-namespace:AcManager.Pages.Selected" xmlns:services="clr-namespace:AcManager.Controls.Services;assembly=AcManager.Controls" xmlns:attached="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:managers="clr-namespace:AcManager.Tools.Managers;assembly=AcManager.Tools" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Selected.SelectedShowroomPage" attached:InputBindingBehavior.PropagateToWindow="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSelectedSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <mui:BindingProxy x:Key="Model" Data="{Binding}"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <c:AcObjectBase AcObject="{Binding SelectedObject}" ShowIcon="False">
    <c:AcObjectBase.ToolBars>
      <mui:ToolBar ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_Folder}" Command="{Binding SelectedObject.ViewInExplorerCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Folder_ShowroomTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Reload}" Command="{Binding SelectedObject.ReloadCommand}" CommandParameter="full" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Reload_Tooltip}"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Analyze}" IsEnabled="False"/>
      </mui:ToolBar>
      <mui:ToolBar Band="0" BandIndex="0">
        <Button Content="{x:Static g:AppStrings.Toolbar_CreateNewShowroom}" Command="{Binding CreateNewShowroomCommand}" mui:LimitedService.Limited="True" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_CreateNewShowroom_Tooltip}"/>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1">
        <Button Content="{x:Static g:AppStrings.Toolbar_Disable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Disable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Enable}" Command="{Binding SelectedObject.ToggleCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Enable_Tooltip}" IsVisible="{Binding SelectedObject.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" PointerReleased="OnToggleClick"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Save}" Command="{Binding SelectedObject.SaveCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Save_JsonTooltip}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_Delete}" Command="{Binding SelectedObject.DeleteCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_Delete_ShowroomTooltip}"/>
        <Separator/>
        <Button Content="{x:Static g:AppStrings.Toolbar_UpdatePreview}" Command="{Binding UpdatePreviewCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_UpdatePreview_ShowroomTooltip}"/>
        <Separator/>
        <Button Content="Fix lighting for 360° panorama showroom" Command="{Binding FixLightingCommand}">
          <ToolTip.Tip>
            <mui:BbCodeBlock MaxWidth="480" Text="To solve lighting issues (when only half of panorama is lit by sun), CM will redirect normals up, as in Kunos showrooms.[br][br]Original version will be moved to the Recycle Bin."/>
          </ToolTip.Tip>
        </Button>
      </mui:ToolBar>
      <mui:ToolBar Band="1" BandIndex="1" IsVisible="{Binding SelectedObject.HasSound, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Button Content="{x:Static g:AppStrings.Toolbar_TurnOffSound}" Command="{Binding SelectedObject.ToggleSoundCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_TurnOffSound_Tooltip}" IsVisible="{Binding SelectedObject.SoundEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Button Content="{x:Static g:AppStrings.Toolbar_TurnOnSound}" Command="{Binding SelectedObject.ToggleSoundCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_TurnOnSound_Tooltip}" IsVisible="{Binding SelectedObject.SoundEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>
      </mui:ToolBar>
    </c:AcObjectBase.ToolBars>

    <StackPanel>
      <mui:BetterImage Margin="0 0 0 12" Filename="{Binding SelectedObject.PreviewImage}" services:ImageViewerService.Image="{Binding SelectedObject.PreviewImage}" MaxWidth="1022" MaxHeight="575" IsVisible="{Binding SelectedObject.PreviewImage, Converter={StaticResource ExistToVisibilityConverter}}"/>

      <!-- Data section -->
      <StackPanel IsVisible="{Binding SelectedObject.HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
        <!-- Tags -->
        <mui:TagsList ItemsSource="{Binding SelectedObject.Tags}" SuggestionsSource="{x:Static managers:SuggestionLists.ShowroomTagsListView}" PointerPressed="OnTagsListMouseDown"/>

        <Grid Classes="ObjectDataGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- First row -->
          <DockPanel Grid.Row="0" Grid.Column="0" attached:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByCountry}" Command="{Binding Data.FilterCommand, Source={StaticResource Model}}" CommandParameter="country"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_ContryLabel}"/>
            <ComboBox ItemsSource="{x:Static managers:SuggestionLists.CountriesListView}" Text="{Binding SelectedObject.Country}"/>
          </DockPanel>

          <DockPanel Grid.Row="0" Grid.Column="1" attached:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByYear}" Command="{Binding Data.FilterCommand, Source={StaticResource Model}}" CommandParameter="year"/>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByDecade}" Command="{Binding Data.FilterCommand, Source={StaticResource Model}}" CommandParameter="decade"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_YearLabel}"/>
            <mui:BetterTextBox Text="{Binding SelectedObject.Year, TargetNullValue=''}" Mode="Integer" Placeholder="?"/>
          </DockPanel>

          <!-- Last row -->
          <DockPanel Grid.Row="1" Grid.Column="0">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <MenuItem Header="{x:Static g:AppStrings.Filter_ByAuthor}" Command="{Binding Data.FilterCommand, Source={StaticResource Model}}" CommandParameter="author"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <TextBlock Text="{x:Static c:ControlsStrings.AcObject_AuthorLabel}" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_Author_Tooltip}"/>
            <mui:BbCodeBlock Text="{Binding SelectedObject.VersionInfoDisplay}" Placeholder="?" PointerReleased="OnVersionInfoBlockClick"/>
          </DockPanel>
        </Grid>

        <!-- Description -->
        <TextBlock Text="Description:" Margin="0 8 0 4" Classes="Label Label.Padding"/>
        <mui:BetterTextBox Text="{Binding SelectedObject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Placeholder="None" Theme="{StaticResource Borderless}"/>
      </StackPanel>
    </StackPanel>
  </c:AcObjectBase>
</selected:SelectedAcJsonObjectPage>