<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsCustomShowroom">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/TextEditor.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="SettingsCustomShowroom">
    <mui:SpacingUniformGrid x:Name="Grid" Columns="1" HorizontalSpacing="20" VerticalStackMode="True">

      <StackPanel set:Search.Category="{x:Static g:AppStrings.Toolbar_CustomShowroom}" Classes="SettingsPanel">

        <CheckBox IsChecked="{Binding Holder.CustomShowroomInstead}">
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_UseCustomShowroomInstead}">
            <ToolTip.Tip>Such as double-click on car’s skin icon in Content/Cars</ToolTip.Tip>
          </Label>
        </CheckBox>

        <TextBlock Text="{x:Static g:AppStrings.Settings_CustomShowroom_Previews}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Holder.CustomShowroomPreviews}">
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_UseCustomShowroomForPreviews}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.CspPreviews}" IsEnabled="{Binding Holder.CustomShowroomPreviews}" c:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureCarPreviews}">
          <Label Content="Use CSP for final previews render"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.DetailedExifForPreviews}">
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_AddExtendedInformationInEXIFData}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.PreviewsRecycleOld}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_MovePreviousPreviewToTheRecycleBin_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_MovePreviousPreviewToTheRecycleBin}"/>
        </CheckBox>

        <c:MessageBlock CloseKey="fancy-showroom-previews">
          <mui:BbCodeBlock>
            <mui:BbCodeBlock.Text>Custom Showroom works faster and has some additional features, such as reflections (both ground and SSLR aka local reflections), smooth shadows (using PCSS technique) or an option to turn on the lights or steer the wheels.</mui:BbCodeBlock.Text>
          </mui:BbCodeBlock>
        </c:MessageBlock>

        <!--<DockPanel>
        <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_DefaultType}" />
        <ComboBox ItemsSource="{Binding Holder.ShowroomTypes}" SelectedItem="{Binding Holder.ShowroomType}"
            ToolTip="{x:Static g:AppStrings.Settings_CustomShowroom_DefaultType_Tooltip}" />
      </DockPanel>-->

        <!--<TextBlock Style="{StaticResource SettingsPanel.Small}" Margin="0 0 0 20" Text="{x:Static g:AppStrings.Settings_CustomShowroom_TypeComment}"
          TextWrapping="Wrap" />-->

        <TextBlock Text="{x:Static g:AppStrings.Settings_CustomShowroom_Controls}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Holder.SmartCameraPivot}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_AutoAdjustPivot_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_AutoAdjustPivot}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.AlternativeControlScheme}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_InvertMouseButtons_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_InvertMouseButtons}"/>
        </CheckBox>

      </StackPanel>
      <StackPanel set:Search.Category="{x:Static g:AppStrings.Toolbar_CustomShowroom}" Classes="SettingsPanel">

        <!--lite specific-->
        <!--<TextBlock Style="{StaticResource SettingsPanel.Heading2}" Text="{x:Static g:AppStrings.Settings_CustomShowroom_LiteHeader}" />-->
        <TextBlock Text="{x:Static g:AppStrings.AcSettings_Video_QualityHeader}" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <CheckBox IsChecked="{Binding Holder.UseOldLiteShowroom}">
          <ToolTip.Tip>It’s rendering is way less accurate and it doesn’t support skinned meshes, but maybe you still need it for whatever reason?</ToolTip.Tip>
          <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_UseTheOldVersion}"/>
        </CheckBox>

        <StackPanel IsVisible="{Binding Holder.UseOldLiteShowroom, Converter={StaticResource BooleanToVisibilityConverter}}" Classes="SettingsPanel">
          <CheckBox IsChecked="{Binding Holder.LiteUseBloom}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Bloom_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_Bloom}"/>
          </CheckBox>

          <CheckBox IsChecked="{Binding Holder.LiteUseMsaa}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Msaa_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_Msaa}"/>
          </CheckBox>

          <CheckBox IsChecked="{Binding Holder.LiteUseFxaa}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Fxaa_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_Fxaa}"/>
          </CheckBox>
        </StackPanel>

        <StackPanel IsVisible="{Binding Holder.UseOldLiteShowroom, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" Classes="SettingsPanel">
          <DockPanel>
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_ResetHeavyOptions}" Width="200"/>
            <Button Command="{Binding ResetHeavyCommand}" Content="{x:Static c:ControlsStrings.Common_Reset}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Reset_Tooltip}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_ResetAll}" Width="200"/>
            <Button Command="{Binding ResetCommand}" Content="{x:Static c:ControlsStrings.Common_Reset}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Reset_Tooltip}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_ResetHeavyOptionsForPreviews}" Width="200"/>
            <Button Command="{Binding ResetHeavyPreviewsCommand}" Content="{x:Static c:ControlsStrings.Common_Reset}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Reset_Tooltip}"/>
          </DockPanel>

          <DockPanel>
            <Label Content="{x:Static g:AppStrings.Settings_CustomShowroom_ResetAllForPreviews}" Width="200"/>
            <Button Command="{Binding ResetPreviewsCommand}" Content="{x:Static c:ControlsStrings.Common_Reset}" ToolTip.Tip="{x:Static g:AppStrings.Settings_CustomShowroom_Reset_Tooltip}"/>
          </DockPanel>
        </StackPanel>

        <c:MessageBlock CloseKey="bye-bye-fancy-showroom">
          <mui:BbCodeBlock>
            <mui:BbCodeBlock.Text>In the previous version, there was the Fancy showroom, but we’ve got rid of it. Speaking as it is, it wasn’t fancy, and could barely be called “showroom”, especially comparing to the new one. And it was very slow.</mui:BbCodeBlock.Text>
          </mui:BbCodeBlock>
        </c:MessageBlock>

      </StackPanel>

    </mui:SpacingUniformGrid>
  </ScrollViewer>
</UserControl>