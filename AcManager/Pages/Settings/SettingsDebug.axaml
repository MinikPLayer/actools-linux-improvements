<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:settings="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsDebug" x:Name="This">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer x:Name="ScrollViewer" mui:SaveScroll.Key="SettingsDev">
    <StackPanel>
      <StackPanel x:Name="Panel" Classes="SettingsPanel">
        <StackPanel>
          <TextBlock Text="Internal stuff:" Classes="Heading2 SettingsPanel.Heading2"/>
          <DockPanel>
            <Label Content="Magick.NET:"/>
            <Button Command="{Binding MagickNetMemoryLeakingCommand}" Content="{x:Static g:AppStrings.Common_Test}"/>
          </DockPanel>
          <DockPanel>
            <Label Content="Convert outline:"/>
            <Button Command="{Binding ConvertOutlineCommand}" Content="{x:Static g:AppStrings.Common_Test}"/>
          </DockPanel>
          <DockPanel>
            <Label Content="DH:"/>
            <Button Command="{Binding DecryptHelperCommand}" Content="{x:Static g:AppStrings.Common_Test}"/>
          </DockPanel>
          <DockPanel>
            <Label Content="Decompress values:"/>
            <Button Command="{Binding DecompressValuesCommand}" Content="{x:Static g:AppStrings.Common_Test}"/>
          </DockPanel>
          <DockPanel>
            <Label Content="Test:"/>
            <Button Command="{Binding TestCommand}" Content="Test"/>
          </DockPanel>
        </StackPanel>
      </StackPanel>

      <ProgressBar Height="4" Minimum="0" Maximum="1" Value="0" IsIndeterminate="True" Margin="0 0 20 20"/>

      <!--controls test-->
      <mui:BbCodeBlock Classes="Heading1">🐱 This 😛 is 👩‍👩‍👦‍👦 just 😼 a 🤖 text 🌵 with 🐟 a 🍳 bunch 🚔 of 🚘 those 🚦 modern 🙆🏾 smilies 👮🏿 thanks 🚴🏻 to ⁉ Twemoji 🇱🇦🇭🇹🇫🇮 pack 🍷</mui:BbCodeBlock>
      <mui:BbCodeBlock Classes="Heading1">More: 🧚🏿‍♂️🧚🏿‍♀️🧑🏼🧒🏼👨🏼‍🍳👩🏼‍🍳👩‍👩‍👦‍👦💑👆🏾</mui:BbCodeBlock>

      <StackPanel Margin="0 20 20 0">
        <TextBlock Text="Better images" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <DockPanel>
          <Label Content="Crop transparent:" DockPanel.Dock="Left" Width="200"/>
          <mui:BetterImage DockPanel.Dock="Left" HorizontalAlignment="Left" Height="80" Width="80" Background="Gray" Filename="{Binding Default.OutlineImage, Source={x:Static t:TracksManager.Instance}}" CropTransparentAreas="True"/>
        </DockPanel>
      </StackPanel>

      <StackPanel Margin="0 20 20 0">
        <TextBlock Text="Progress rings" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <DockPanel>
          <Label Content="Style:" DockPanel.Dock="Left" Width="200"/>
          <mui:SpacingUniformGrid HorizontalSpacing="8">
            <mui:BetterComboBox x:Name="ProgressRingsComboBox" IsEditable="False" DisplayMemberBinding="{Binding DisplayName}"/>
            <mui:ColorPicker Color="{Binding ProgressRingColor, ElementName=This}"/>
          </mui:SpacingUniformGrid>
        </DockPanel>

        <DockPanel Height="80" Margin="0 8 0 0">
          <Label Content="Control:" Width="200" DockPanel.Dock="Left" VerticalAlignment="Top"/>
          <mui:ModernProgressRing x:Name="ModernProgressRing" IsActive="True" Width="80" Height="80" HorizontalAlignment="Left"/>
        </DockPanel>
      </StackPanel>

      <StackPanel Margin="0 20 20 20" TextElement.Foreground="Cyan">
        <StackPanel.Styles><Style Selector="DockPanel">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
          </Style>
        </StackPanel.Styles><TextBlock Text="Double sliders test" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <!--<DockPanel>
          <Label Content="Sel. range:" Width="200" DockPanel.Dock="Left" />
          <Slider Minimum="0" Maximum="60" AutoToolTipPlacement="TopLeft" IsSelectionRangeEnabled="True" TickPlacement="Outside" Margin="0 0 20 0"
              SelectionStart="20" SelectionEnd="40" />
        </DockPanel>-->

        <DockPanel>
          <Label Content="Simple button:" Width="240" DockPanel.Dock="Left"/>
          <Button Content="Simple button" Command="{Binding AsyncBaseCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button:" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncBaseCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (s):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncBaseCommand}" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (c):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncCancelCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (c+s):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncCancelCommand}" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (p):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (p+s):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressCommand}" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (pc):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressCancelCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (pc+s):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressCancelCommand}" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (pm):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressMsgCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (pm+s):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressMsgCommand}" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (pmc):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressMsgCancelCommand}" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Async button (pmc+s):" Width="240" DockPanel.Dock="Left"/>
          <mui:AsyncButton Content="Async button" Command="{Binding AsyncProgressMsgCancelCommand}" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Button with menu:" Width="240" DockPanel.Dock="Left"/>
          <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Showroom}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Showroom_Tooltip}" Command="{Binding DecryptHelperCommand}" HorizontalAlignment="Left">
            <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding MagickNetMemoryLeakingCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
            <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding MagickNetMemoryLeakingCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          </mui:ButtonWithComboBox>
        </DockPanel>

        <DockPanel>
          <Label Content="Button with menu (GO):" Width="240" DockPanel.Dock="Left"/>
          <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Showroom}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Showroom_Tooltip}" Command="{Binding DecryptHelperCommand}" HorizontalAlignment="Left" Theme="{StaticResource Go.ButtonWithComboBox}">
            <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding MagickNetMemoryLeakingCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
            <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding MagickNetMemoryLeakingCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          </mui:ButtonWithComboBox>
        </DockPanel>

        <DockPanel>
          <Label Content="Button with menu (stretch):" Width="240" DockPanel.Dock="Left"/>
          <mui:ButtonWithComboBox Content="{x:Static g:AppStrings.Toolbar_Showroom}" ButtonToolTip="{x:Static g:AppStrings.Toolbar_Showroom_Tooltip}" Command="{Binding DecryptHelperCommand}">
            <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding MagickNetMemoryLeakingCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
            <MenuItem Header="{x:Static c:ControlsStrings.Common_Options}" Command="{Binding MagickNetMemoryLeakingCommand}" ToolTip.Tip="{x:Static g:AppStrings.Toolbar_ShowroomOptions_Tooltip}"><!-- PORT: removed InputGestureText (not in Avalonia) --></MenuItem>
          </mui:ButtonWithComboBox>
        </DockPanel>

        <DockPanel>
          <Label Content="Double slider (FromTo):" Width="200" DockPanel.Dock="Left"/>
          <mui:DoubleSlider x:Name="DoubleSlider1" BindingMode="FromTo" Maximum="60" Minimum="10" From="30" To="30" Margin="0 0 20 0" LargeChange="5" SmallChange="5"/>
        </DockPanel>

        <mui:SpacingStackPanel Spacing="0" Background="DarkSlateBlue">
          <Slider Minimum="0" Maximum="60" Value="{Binding From, ElementName=DoubleSlider1}" Height="4" ToolTip.Tip="From"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding To, ElementName=DoubleSlider1}" Height="4" ToolTip.Tip="To"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Value, ElementName=DoubleSlider1}" Height="4" ToolTip.Tip="Value"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Range, ElementName=DoubleSlider1}" Height="4" ToolTip.Tip="Range"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
        </mui:SpacingStackPanel>

        <DockPanel>
          <Label Content="Double slider (P.R.):" Width="200" DockPanel.Dock="Left"/>
          <mui:DoubleSlider x:Name="DoubleSlider2" BindingMode="PositionRange" Maximum="60" Minimum="10" Value="30" Range="0" Margin="0 0 20 0" LargeChange="5" SmallChange="5"/>
        </DockPanel>

        <mui:SpacingStackPanel Spacing="0" Background="DarkSlateBlue">
          <Slider Minimum="0" Maximum="60" Value="{Binding From, ElementName=DoubleSlider2}" Height="4" ToolTip.Tip="From"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding To, ElementName=DoubleSlider2}" Height="4" ToolTip.Tip="To"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Value, ElementName=DoubleSlider2}" Height="4" ToolTip.Tip="Value"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Range, ElementName=DoubleSlider2}" Height="4" ToolTip.Tip="Range"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
        </mui:SpacingStackPanel>

        <DockPanel>
          <Label Content="Double slider (FromTo):" Width="200" DockPanel.Dock="Left"/>
          <mui:DoubleSlider x:Name="DoubleSlider3" BindingMode="FromTo" Maximum="60" Minimum="10" From="30" To="30" Margin="0 0 20 0" LargeChange="5" SmallChange="5" mui:DoubleThumb.HighlightRange="True"/>
        </DockPanel>

        <mui:SpacingStackPanel Spacing="0" Background="DarkSlateBlue">
          <Slider Minimum="0" Maximum="60" Value="{Binding From, ElementName=DoubleSlider3}" Height="4" ToolTip.Tip="From"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding To, ElementName=DoubleSlider3}" Height="4" ToolTip.Tip="To"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Value, ElementName=DoubleSlider3}" Height="4" ToolTip.Tip="Value"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Range, ElementName=DoubleSlider3}" Height="4" ToolTip.Tip="Range"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
        </mui:SpacingStackPanel>

        <DockPanel>
          <Label Content="Double slider (P.R.):" Width="200" DockPanel.Dock="Left"/>
          <mui:DoubleSlider x:Name="DoubleSlider4" BindingMode="PositionRange" Maximum="60" Minimum="10" Value="30" Range="0" Margin="0 0 20 0" LargeChange="5" SmallChange="5" mui:DoubleThumb.HighlightRange="True"/>
        </DockPanel>

        <mui:SpacingStackPanel Spacing="0" Background="DarkSlateBlue">
          <Slider Minimum="0" Maximum="60" Value="{Binding From, ElementName=DoubleSlider4}" Height="4" ToolTip.Tip="From"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding To, ElementName=DoubleSlider4}" Height="4" ToolTip.Tip="To"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Value, ElementName=DoubleSlider4}" Height="4" ToolTip.Tip="Value"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
          <Slider Minimum="0" Maximum="60" Value="{Binding Range, ElementName=DoubleSlider4}" Height="4" ToolTip.Tip="Range"><!-- PORT: removed AutoToolTipPlacement (not in Avalonia) --></Slider>
        </mui:SpacingStackPanel>

        <TextBlock Text="Toggle buttons test" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <Label Content="LabeledToggleButton, left:" Width="200" DockPanel.Dock="Left"/>
          <mui:LabeledToggleButton x:Name="ToggleButton" LabelChecked="State: on" LabelUnchecked="State: off" HorizontalAlignment="Left"/>
        </DockPanel>

        <!--<mui:SpacingStackPanel Spacing="4" Height="80" Background="Black">
                    <mui:Switch2 Value="{Binding IsChecked, ElementName=ToggleButton}">
                        <mui:SpacingStackPanel mui:Switch2.When="True">
                            <TextBlock Text="Checked" />
                            <mui:DebugControl x:Name="Checked" />

                            <mui:Switch2 Value="{Binding IsChecked, ElementName=SecondaryButton}">
                                <mui:SpacingStackPanel mui:Switch2.When="True">
                                    <TextBlock Text="Secondary checked" />
                                    <Button Command="{Binding DecryptHelperCommand}" Content="{x:Static g:AppStrings.Common_Test}" />
                                </mui:SpacingStackPanel>
                                <TextBlock mui:Switch2.When="False" Text="Secondary unchecked" />
                            </mui:Switch2>
                        </mui:SpacingStackPanel>
                        <TextBlock mui:Switch2.When="False" Text="Unchecked" />
                    </mui:Switch2>
                </mui:SpacingStackPanel>-->

        <mui:SpacingStackPanel Spacing="4" Height="80" Background="DarkSlateBlue">
          <mui:Switch Value="{Binding IsChecked, ElementName=ToggleButton}">
            <TextBlock mui:Switch.When="True" Text="Checked"/>
            <TextBlock mui:Switch.When="False" Text="Unchecked"/>
          </mui:Switch>
        </mui:SpacingStackPanel>

        <DockPanel>
          <Label Content="LabeledToggleButton, left:" Width="200" DockPanel.Dock="Left"/>
          <mui:LabeledToggleButton x:Name="SecondaryButton" LabelChecked="State: On" LabelUnchecked="State: Off" HorizontalAlignment="Left" HighlightChecked="True"/>
        </DockPanel>

        <DockPanel>
          <Label Content="LabeledToggleButton, left:" Width="200" DockPanel.Dock="Left"/>
          <mui:LabeledToggleButton LabelChecked="State: On" LabelUnchecked="State: Off" HorizontalAlignment="Left" IsChecked="True"/>
        </DockPanel>

        <DockPanel>
          <Label Content="LabeledToggleButton, stretch:" Width="200" DockPanel.Dock="Left"/>
          <mui:LabeledToggleButton LabelChecked="State: On" LabelUnchecked="State: Off" HorizontalAlignment="Stretch"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Previous, placeholder:" Width="200" DockPanel.Dock="Left"/>
          <!-- ReSharper disable once ObsoleteElement -->
          <TextBox mui:WatermarkService.Watermark="Placeholder"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Previous, b., p.:" Width="200" DockPanel.Dock="Left"/>
          <!-- ReSharper disable once ObsoleteElement -->
          <TextBox mui:WatermarkService.Watermark="Placeholder" Classes="TextBoxAsTextBlock"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterTextBox Text="Placeholder"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New, placeholder:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterTextBox Placeholder="Placeholder"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Text:" Width="200" DockPanel.Dock="Left"/>
          <TextBlock Text="Placeholder"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New, borderless:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterTextBox Text="Placeholder" Theme="{StaticResource Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New, b., p.:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterTextBox Placeholder="Placeholder" Theme="{StaticResource Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New CB:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterComboBox IsEditable="True" ItemsSource="{Binding Enabled, Source={x:Static t:WeatherManager.Instance}}" Text="Placeholder"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New CB, placeholder:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterComboBox Placeholder="Placeholder" IsEditable="True" ItemsSource="{Binding Enabled, Source={x:Static t:WeatherManager.Instance}}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New CB, borderless:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterComboBox ItemsSource="{Binding Enabled, Source={x:Static t:WeatherManager.Instance}}" Text="Placeholder" Theme="{StaticResource BetterComboBox.Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="New CB, b., p.:" Width="200" DockPanel.Dock="Left"/>
          <mui:BetterComboBox Placeholder="Placeholder" ItemsSource="{Binding Enabled, Source={x:Static t:WeatherManager.Instance}}" Theme="{StaticResource BetterComboBox.Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="Colorpicker:" Width="200" DockPanel.Dock="Left"/>
          <mui:ColorPicker/>
        </DockPanel>

        <DockPanel>
          <Label Content="Colorpicker, borderless:" Width="200" DockPanel.Dock="Left"/>
          <mui:ColorPicker Theme="{StaticResource ColorPicker.Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="PasswordBox:" Width="200" DockPanel.Dock="Left"/>
          <mui:ProperPasswordBox Placeholder="Placeholder"/>
        </DockPanel>

        <DockPanel>
          <Label Content="PasswordBox:" Width="200" DockPanel.Dock="Left"/>
          <mui:ProperPasswordBox Placeholder="Placeholder" VisiblePassword="True"/>
        </DockPanel>

        <DockPanel>
          <Label Content="PasswordBox, borderless:" Width="200" DockPanel.Dock="Left"/>
          <mui:ProperPasswordBox Placeholder="Placeholder" Theme="{StaticResource ProperPasswordBox.Borderless}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="PasswordBox, borderless:" Width="200" DockPanel.Dock="Left"/>
          <mui:ProperPasswordBox Placeholder="Placeholder" VisiblePassword="True" Theme="{StaticResource ProperPasswordBox.Borderless}"/>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>