<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:networkInformation="clr-namespace:System.Net.NetworkInformation;assembly=System" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsOnline">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="SettingsOnline">
    <mui:SpacingUniformGrid x:Name="Grid" Columns="1" HorizontalSpacing="20" VerticalStackMode="True" set:Search.Keywords="online;servers">

      <StackPanel set:Search.Category="{x:Static g:AppStrings.Main_Online}" Classes="SettingsPanel">
        <DockPanel ToolTip.Tip="{x:Static g:AppStrings.Settings_Drive_OnlineName_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Drive_OnlineNameLabel}"/>
          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Drive.DifferentPlayerNameOnline}" VerticalAlignment="Center"/>
          <mui:BetterTextBox Text="{Binding Drive.PlayerNameOnline}" Placeholder="?" IsEnabled="{Binding Drive.DifferentPlayerNameOnline}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Online_AutoRefreshSelected}"/>
          <ComboBox ItemsSource="{Binding Online.RefreshPeriods}" SelectedItem="{Binding Online.RefreshPeriod}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <!--<CheckBox IsChecked="{Binding Online.IntegrateMinorating}">
          <Label Content="Integrate Minorating" />
        </CheckBox>-->

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Online_FixNames}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_FixNames_Tooltip}"/>
          <ComboBox ItemsSource="{Binding Online.FixNamesModes}" SelectedItem="{Binding Online.FixNamesMode}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <mui:SpacingUniformGrid HorizontalSpacing="4" Rows="1">
          <Button Content="{x:Static g:AppStrings.Settings_Online_ManageLists}" Command="{Binding ManageListsCommand}"/>
          <Button Content="{x:Static g:AppStrings.Settings_Online_ManageDriversTags}" Command="{Binding ManageDriversTagsCommand}"/>
        </mui:SpacingUniformGrid>

        <!-- Display -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_Display}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Online.CompactUi}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_CompactUi}" set:Search.Keywords="appearance;ui"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.ShowBrandBadges}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_ShowBrandBadges}" set:Search.Keywords="appearance;ui"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.LoadDescriptionImages}" set:Search.Keywords="appearance;ui">
          <Label Content="Load images in server descriptions"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.UseCommunityRating}" set:Search.Keywords="appearance;ui" ToolTip.Tip="Experimental addition allowing users to rate servers. Subject to change. Restart the app after changing. In the future, if the concept works at all, more features (like sorting or hiding based on community score) will be added.">
          <Label Content="Participate in community server rating"/>
        </CheckBox>

        <!-- Passwords -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_Passwords}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Online.RememberPasswords}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_RememberPasswords}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.AlwaysAllowToUsePassword}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_AlwaysAllowToUsePassword}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_AlwaysAllowToUsePassword_Tooltip}"/>
        </CheckBox>

        <!-- Connection -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_ConnectionHeader}" Classes="Heading2 SettingsPanel.Heading2"/>
        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Online_ServerLabel}"/>
          <ComboBox ItemsSource="{Binding Online.OnlineServers}" SelectedItem="{Binding Online.OnlineServer}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Online.UseCachingServer}" IsEnabled="{Binding Online.CachingServerAvailable}">
          <ToolTip.Tip>
            <DockPanel MaxWidth="300">
              <TextBlock Text="Might be faster. Better to use with direct information loading to speed things up even more." TextWrapping="Wrap" DockPanel.Dock="Top"/>
              <mui:BbCodeBlock Text="[b]Please note:[/b] you need to load regular server list at least once for this option to work." Margin="0 4 0 -8" TextWrapping="Wrap" IsVisible="{Binding Online.CachingServerAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='inverse'}"/>
            </DockPanel>
          </ToolTip.Tip>
          <Label Content="Use caching proxy server for lobby"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.LoadServerInformationDirectly}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_LoadInformationDirectly_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_LoadInformationDirectly}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.PausePingingInRace}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_PausePingingDuringTheRace}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.PingOnlyOnce}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_PingServersOnce_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_PingServersOnce}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Online.LoadServersWithMissingContent}">
          <ToolTip.Tip>If you’re sure you won’t need any information about servers with missing content, disable this option to reduce pinging time (reload lists after changing)</ToolTip.Tip>
          <Label Content="{x:Static g:AppStrings.Settings_Online_ShowExtendedInformationIfContentIsMissing}"/>
        </CheckBox>

        <DockPanel>
          <Label Content="Search for missing content" ToolTip.Tip="Uses CUPv2 database"/>
          <ComboBox ItemsSource="{Binding Online.SearchContentModes}" SelectedItem="{Binding Online.SearchContentMode}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <c:MessageBlock CloseKey="search-hint" Margin="0 0 0 20">
          <mui:BbCodeBlock Text="CM uses [url=&quot;https://cup.acstuff.club/&quot;]CUPv2 database[/url] to look for missing content. Please feel free to request an invite if you would like to register your content there as well."/>
        </c:MessageBlock>

        <TextBlock Text="Lobby servers:" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel IsVisible="{Binding LobbiesBuiltIn.Count, Converter={StaticResource MoreToVisibilityConverter}}">
          <Label Content="Extra built-in lobbies:"/>
          <ItemsControl ItemsSource="{Binding LobbiesBuiltIn}" DockPanel.Dock="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type t:ThirdPartyOnlineSource}">
                <CheckBox Margin="20 4" IsChecked="{Binding IsEnabled}">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"/>
                    <mui:BbCodeBlock Text="{Binding Description}" Classes="Small"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <DockPanel>
          <Label Content="User lobbies:"/>
          <ListBox SelectedItem="{Binding SelectedUserLobby}" ItemsSource="{Binding LobbiesUser}" DockPanel.Dock="Top" ItemContainerTheme="{StaticResource RibbonListBoxItem.Left}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type t:ThirdPartyOnlineSource}">
                <StackPanel Margin="20 4">
                  <mui:BetterTextBox Placeholder="Name" Text="{Binding DisplayName}" TextChanged="OnUserLinkTextChanged" Theme="{StaticResource Borderless.Small}"/>
                  <mui:BetterTextBox Placeholder="Description" Text="{Binding Description}" TextChanged="OnUserLinkTextChanged" Theme="{StaticResource Borderless}"/>
                  <mui:BetterTextBox Text="{Binding Url, Mode=OneWay}" Theme="{StaticResource TextBoxAsTextBlock.ReadOnly}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <mui:SpacingUniformGrid Rows="1" Columns="3" HorizontalSpacing="0" Margin="0 8 0 0">
            <Button Content="Add lobby" Command="{Binding AddUserLobbyCommand}"/>
            <Button Content="Delete lobby" Command="{Binding DeleteSelectedUserLobbyCommand}" IsEnabled="{Binding SelectedUserLobby, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=inverse}"/>
            <Button Content="Share lobby" Command="{Binding ShareSelectedUserLobbyCommand}" IsEnabled="{Binding SelectedUserLobby, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=inverse}"/>
          </mui:SpacingUniformGrid>
        </DockPanel>

      </StackPanel>
      <StackPanel set:Search.Category="{x:Static g:AppStrings.Main_Online}" set:Search.Keywords="online;servers" Classes="SettingsPanel">

        <!-- Pinging -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_PingingHeader}" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <CheckBox IsChecked="{Binding Online.PingingSingleSocket}" ToolTip.Tip="Might work faster, pings 25 servers at once">
          <Label Content="Ping with a single socket"/>
        </CheckBox>

        <StackPanel IsVisible="{Binding Online.PingingSingleSocket, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
          <CheckBox IsChecked="{Binding Online.ThreadsPing}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_PingWithThreads_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_Online_PingWithThreads}"/>
          </CheckBox>

          <DockPanel IsEnabled="{Binding Online.ThreadsPing, Converter={StaticResource InvertBooleanConverter}}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_PingConcurrency_Tooltip}">
            <mui:ValueLabel Value="{Binding Online.PingConcurrency}" mui:BetterTextBox.Minimum="1" Content="{x:Static g:AppStrings.Settings_Online_PingConcurrency}"/>
            <Slider Minimum="5" Maximum="50" Value="{Binding Online.PingConcurrency}" TickFrequency="5" TickPlacement="BottomRight"/>
          </DockPanel>
        </StackPanel>
        
        <DockPanel IsVisible="{Binding Online.PingingSingleSocket, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_PingConcurrency_Tooltip}">
          <mui:ValueLabel Value="{Binding Online.PingConcurrency2}" mui:BetterTextBox.Minimum="1" Content="{x:Static g:AppStrings.Settings_Online_PingConcurrency}"/>
          <Slider Minimum="10" Maximum="100" Value="{Binding Online.PingConcurrency2}" TickFrequency="10" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Online.PingTimeout}" mui:BetterTextBox.Minimum="1" Postfix="{x:Static c:ControlsStrings.Common_MillisecondsPostfix}" Content="{x:Static g:AppStrings.Settings_Online_PingTimeout}"/>
          <Slider Minimum="200" Maximum="5000" Value="{Binding Online.PingTimeout}" TickFrequency="480" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Online.PingAttempts}" mui:BetterTextBox.Minimum="1" mui:BetterTextBox.Maximum="1000" mui:BetterTextBox.Mode="Integer" Content="{x:Static g:AppStrings.Settings_Online_PingAttempts}"/>
          <Slider Minimum="1" Maximum="12" Value="{Binding Online.PingAttempts}" TickFrequency="1" TickPlacement="BottomRight"/>
        </DockPanel>

        <!-- Adding by IP -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_AddingByIpHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_PortsByIp_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_PortsLabel}"/>
          <mui:BetterTextBox Text="{Binding Online.PortsEnumeration}" Placeholder="?"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Online.ScanPingTimeout}" mui:BetterTextBox.Minimum="1" Postfix="{x:Static c:ControlsStrings.Common_MillisecondsPostfix}" Content="{x:Static g:AppStrings.Settings_Online_AddingByIpScanTimeout}"/>
          <Slider Minimum="200" Maximum="5000" Value="{Binding Online.ScanPingTimeout}" TickFrequency="480" TickPlacement="BottomRight"/>
        </DockPanel>

        <!-- LAN -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_LanHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel ToolTip.Tip="{x:Static g:AppStrings.Settings_Online_PortsLan_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Online_PortsLabel}"/>
          <mui:BetterTextBox Text="{Binding Online.LanPortsEnumeration}" Placeholder="?"/>
        </DockPanel>

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Online_LanScanConnectionLabel}"/>
          <ListBox x:Name="IgnoredInterfacesListBox" ItemsSource="{Binding NetworkInterfaces}" mui:ListBoxHelper.ProperMultiSelectionMode="True" SelectionChanged="IgnoredInterfacesListBox_OnSelectionChanged" ItemContainerTheme="{StaticResource CheckBoxListBoxItem}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="networkInformation:NetworkInterface">
                <StackPanel>
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Text="{Binding Description}" Classes="Small"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Server manager -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Online_ServerPresetsManagerHeader}" Classes="Heading2 SettingsPanel.Heading2"/>
        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Online_PresetsFolder}"/>
          <Button Command="{Binding ChangeServerPresetsDirectoryCommand}" Content="{x:Static c:ControlsStrings.Common_Change}"/>
          <Button Command="{Binding OpenServerPresetsDirectoryCommand}" Content="{x:Static g:AppStrings.Settings_General_Open}"/>
          <mui:PathTrimmingTextBlock Text="{Binding Online.ServerPresetsDirectory, Mode=OneTime}"/>
        </DockPanel>
        <CheckBox IsChecked="{Binding Online.ServerLogsSave}" mui:LimitedService.Limited="True">
          <Label Content="Write server logs in files"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Online.ServerCopyConfigsToCfgFolder}" mui:LimitedService.Limited="True" ToolTip.Tip="Might help with some plugins that could expect server configuration to be copied there">
          <Label Content="Copy server configuration to “cfg” folder before starting"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Online.ServerLogsCmFormat}" IsEnabled="{Binding Online.ServerLogsSave}" mui:LimitedService.Limited="True" ToolTip.Tip="CM format means each line would also get a prefix with time and message type">
          <Label Content="Use CM format for logs"/>
        </CheckBox>
        <DockPanel IsEnabled="{Binding Online.ServerLogsSave}">
          <Label Content="Logs folder"/>
          <Button Command="{Binding ChangeServerLogsDirectoryCommand}" Content="{x:Static c:ControlsStrings.Common_Change}"/>
          <Button Command="{Binding OpenServerLogsDirectoryCommand}" Content="{x:Static g:AppStrings.Settings_General_Open}"/>
          <mui:PathTrimmingTextBlock Text="{Binding Online.ServerLogsDirectory, Mode=OneTime}"/>
        </DockPanel>
        <DockPanel IsEnabled="{Binding Online.ServerLogsSave}">
          <Label Content="Keep old logs for"/>
          <mui:BetterComboBox ItemsSource="{Binding Online.ServerKeepLogsDurations}" SelectedItem="{Binding Online.ServerKeepLogsDuration}" IsEditable="False" mui:LimitedService.Limited="True" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>
        <CheckBox IsChecked="{Binding Online.ServerPresetsUpdateDataAutomatically}" mui:LimitedService.Limited="True">
          <Label Content="Update server’s data automatically before starting server"/>
        </CheckBox>
        <!--<CheckBox IsChecked="{Binding Online.ServerPresetsFitInFewerTabs}" mui:LimitedService.Limited="True"
            ToolTip="You might want to enable this option if you run Content Manager fullscreen. Also, just in case, shortcuts Alt+F1…Alt+F5 allow you to switch between those tabs quickly.">
          <Label Content="Combine together main, assists, conditions and sessions tabs" />
        </CheckBox>-->
      </StackPanel>

    </mui:SpacingUniformGrid>
  </ScrollViewer>
</UserControl>