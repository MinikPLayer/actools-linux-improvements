<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsReplays">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer mui:SaveScroll.Key="SettingsReplays">
    <StackPanel set:Search.Category="{x:Static g:AppStrings.Main_Replays}" x:Name="Panel" Classes="SettingsPanel">
      <CheckBox IsChecked="{Binding Drive.TryToLoadReplays}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Replays_LoadInformation_Tooltip}">
        <Label Content="{x:Static g:AppStrings.Settings_Replays_LoadInformation}"/>
      </CheckBox>

      <!-- Extension -->
      <DockPanel>
        <Button Command="{Binding AddReplaysExtensionsCommand}" Content="{x:Static g:AppStrings.Settings_Replays_AddExtensionToExisting}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Replays_AddExtensionToExisting_Tooltip}"/>
        <CheckBox IsChecked="{Binding Drive.AutoAddReplaysExtension}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Replays_AddExtension_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Replays_AddExtension}"/>
        </CheckBox>
      </DockPanel>

      <c:MessageBlock>
        <mui:BbCodeBlock Text="With file extension, you can quickly start a replay by double clicking in it Windows Explorer (and opening it with Content Manager)."/>
      </c:MessageBlock>

      <!--<TextBlock Style="{StaticResource SettingsPanel.Heading2}" ToolTip="{x:Static g:AppStrings.Settings_Replays_ExtensionHeader_Tooltip}"
          Text="{x:Static g:AppStrings.Settings_Replays_ExtensionHeader}" />-->

      <!-- AC settings -->
      <TextBlock Text="{x:Static g:AppStrings.Settings_AcSettingsHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

      <DockPanel>
        <Label Content="{x:Static g:AppStrings.AcSettings_Replays_QualityLabel}"/>
        <ComboBox ItemsSource="{Binding Replay.Qualities}" SelectedItem="{Binding Replay.Quality}" DisplayMemberBinding="{Binding DisplayName}"/>
      </DockPanel>

      <DockPanel>
        <ToolTip.Tip>
          <ToolTip>
            <TextBlock Text="{Binding Replay.RecommendedSize, StringFormat={x:Static g:AppStrings.AcSettings_Replays_RecommendedMaximumSizeFormat}, TargetNullValue='?', FallbackValue='?'}"/>
          </ToolTip>
        </ToolTip.Tip>
        <mui:ValueLabel Value="{Binding Replay.MaxSize}" mui:BetterTextBox.Minimum="1" Postfix=" MB" Content="{x:Static g:AppStrings.AcSettings_Replays_MaximumSize}"/>
        <Slider Minimum="10" Maximum="{Binding Replay.MaxSizeMaximum}" Value="{Binding Replay.MaxSize}" TickFrequency="99" TickPlacement="BottomRight"/>
      </DockPanel>

      <c:MessageBlock>
        <mui:BbCodeBlock>
          <mui:BbCodeBlock.Text>
            <MultiBinding StringFormat="{}Maximum duration: ≈{0} ±10% (estimated for {1} cars). Thanks to @Stereo for data and [url=&quot;http://assettocorsamods.net/threads/ac-replay-size-estimator.837/&quot;]@luchian[/url] for the idea.">
              <Binding Path="Replay.EstimatedDuration" Converter="{StaticResource ReadableTimeSpanConverter}"/>
              <Binding Source="{x:Static t:ReplaySettings.CarsToEstimate}"/>
            </MultiBinding>
          </mui:BbCodeBlock.Text>
        </mui:BbCodeBlock>
      </c:MessageBlock>

      <!-- Replays autosave -->
      <TextBlock Text="{x:Static g:AppStrings.AcSettings_General_ReplaysAutosave}" Classes="Heading2 SettingsPanel.Heading2"/>

      <CheckBox IsChecked="{Binding Replay.Autosave}" ToolTip.Tip="Autosave replays using new AC mechanism added in 1.14 update">
        <Label Content="{x:Static g:AppStrings.Settings_Replays_AutosaveReplays}"/>
      </CheckBox>

      <StackPanel Margin="0" IsVisible="{Binding Replay.Autosave, Converter={StaticResource BooleanToVisibilityConverter}}" Classes="SettingsPanel">
        <DockPanel>
          <mui:ValueLabel Value="{Binding Replay.MinTimeSecond}" mui:BetterTextBox.Minimum="0" Postfix=" sec" Content="{x:Static g:AppStrings.AcSettings_General_MinimumTime}"/>
          <Slider Minimum="0" Maximum="120" Value="{Binding Replay.MinTimeSecond}" TickFrequency="12" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Replay.RacesLimit}" mui:BetterTextBox.Minimum="0" Content="{x:Static g:AppStrings.AcSettings_General_LimitForRaces}"/>
          <Slider Minimum="0" Maximum="20" Value="{Binding Replay.RacesLimit}" TickFrequency="2" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Replay.QualifyLimit}" mui:BetterTextBox.Minimum="0" Content="{x:Static g:AppStrings.AcSettings_General_LimitForQualifications}"/>
          <Slider Minimum="0" Maximum="20" Value="{Binding Replay.QualifyLimit}" TickFrequency="2" TickPlacement="BottomRight"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Replay.OthersLimit}" mui:BetterTextBox.Minimum="0" Content="{x:Static g:AppStrings.AcSettings_General_LimitForOtherSessions}"/>
          <Slider Minimum="0" Maximum="20" Value="{Binding Replay.OthersLimit}" TickFrequency="2" TickPlacement="BottomRight"/>
        </DockPanel>
      </StackPanel>

      <!-- Old autosave system -->
      <StackPanel Margin="0" IsVisible="{Binding Replay.Autosave, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" Classes="SettingsPanel">
        <TextBlock Text="Autosave replays (old approach):" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Drive.AutoSaveReplays}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Replays_AutosaveReplays_Tooltip}">
          <Label Content="Autosave replays (with approach used before 1.14 update)"/>
        </CheckBox>

        <DockPanel>
          <ToolTip.Tip>
            <ToolTip>
              <StackPanel Margin="4">
                <mui:BbCodeBlock TextWrapping="WrapWithOverflow" Text="{x:Static g:AppStrings.Settings_Replays_NameFormat_Tooltip}"/>
              </StackPanel>
            </ToolTip>
          </ToolTip.Tip>
          <Label Content="{x:Static g:AppStrings.Settings_Replays_NameFormat}"/>
          <mui:BetterTextBox Text="{Binding Drive.ReplaysNameFormat}" Placeholder="{Binding Drive.DefaultReplaysNameFormat}"/>
        </DockPanel>
      </StackPanel>

      <!-- Replay-related events -->
      <TextBlock Text="{x:Static g:AppStrings.AcSettings_Replays_EventsHeader}" Classes="Heading2 SettingsPanel.Heading2"/>
      <DockPanel>
        <ToolTip.Tip>
          <ToolTip>
            <StackPanel Margin="4">
              <mui:BbCodeBlock TextWrapping="WrapWithOverflow" Text="{x:Static g:AppStrings.Settings_Drive_PreCommand_Tooltip}"/>
            </StackPanel>
          </ToolTip>
        </ToolTip.Tip>
        <Label Content="{x:Static g:AppStrings.AcSettings_Replays_EventPreLabel}"/>
        <mui:BetterTextBox Text="{Binding Drive.PreReplayCommand}" Placeholder="{x:Static t:ToolsStrings.Common_None}"/>
      </DockPanel>

      <DockPanel>
        <ToolTip.Tip>
          <ToolTip>
            <StackPanel Margin="4">
              <mui:BbCodeBlock TextWrapping="WrapWithOverflow" Text="{x:Static g:AppStrings.Settings_Drive_PostCommand_Tooltip}"/>
            </StackPanel>
          </ToolTip>
        </ToolTip.Tip>
        <Label Content="{x:Static g:AppStrings.AcSettings_Replays_EventPostLabel}"/>
        <mui:BetterTextBox Text="{Binding Drive.PostReplayCommand}" Placeholder="{x:Static t:ToolsStrings.Common_None}"/>
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>