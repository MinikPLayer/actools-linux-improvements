<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsGenericMods">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer mui:SaveScroll.Key="SettingsGenericMods">
    <StackPanel set:Search.Category="Generic mods" set:Search.Limited="True" x:Name="Panel" Classes="SettingsPanel">
      <CheckBox IsChecked="{Binding GenericMods.UseHardLinks}" ToolTip.Tip="The only possible issue here is that in some cases, if you change file from mod folder or placed modded file, the other one will change as well">
        <Label Content="Use hard links to save disk space (recommended)"/>
      </CheckBox>

      <CheckBox IsChecked="{Binding GenericMods.DetectWhileInstalling}" ToolTip.Tip="Allow to install content as a new mod">
        <Label Content="Extend content installation"/>
      </CheckBox>

      <DockPanel>
        <Label Content="Mods directory:"/>
        <Button Command="{Binding ChangeModsDirectoryCommand}" Content="{x:Static c:ControlsStrings.Common_Change}"/>
        <Button Command="{Binding OpenModsDirectoryCommand}" Content="Open"/>
        <mui:PathTrimmingTextBlock Text="{Binding ModsDirectory}"/>
      </DockPanel>

      <c:MessageBlock IsVisible="{Binding ModsDirectoryWrong, Converter={StaticResource BooleanToVisibilityConverter}}">
        <mui:BbCodeBlock Text="Selected directory is located on a different drive! Hard links won’t work, which will cause whole process of enabling and disabling mods marginally slower and will lead to wasting space."/>
      </c:MessageBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>