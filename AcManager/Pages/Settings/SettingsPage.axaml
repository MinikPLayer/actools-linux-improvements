<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:in="clr-namespace:AcManager.Internal;assembly=AcManager.Internal" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsPage">
  <mui:ModernTab x:Name="Tab" Layout="List" SelectedSource="/Pages/Settings/SettingsGeneral.xaml" SaveKey="__SettingsPage.SelectedPage" Classes="ContentRoot">
    <mui:ModernTab.Links>
      <mui:Link DisplayName="{x:Static g:AppStrings.Settings_General}" Source="/Pages/Settings/SettingsGeneral.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Settings_Appearance}" Source="/Pages/Settings/SettingsAppearance.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Main_Content}" Source="/Pages/Settings/SettingsContent.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Toolbar_CustomShowroom}" Source="/Pages/Settings/SettingsCustomShowroom.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Main_Drive}" Source="/Pages/Settings/SettingsDrive.xaml"/>
      <mui:Link DisplayName="Generic mods" Source="/Pages/Settings/SettingsGenericMods.xaml" IsEnabled="{x:Static in:InternalUtils.IsAllRight}"/>
      <mui:Link DisplayName="Integrated" Source="/Pages/Settings/SettingsIntegrated.xaml"/>
      <mui:Link DisplayName="Lap times" Source="/Pages/Settings/SettingsLapTimes.xaml"/>
      <!--<mui:Link DisplayName="{x:Static g:AppStrings.Main_Live}" Source="/Pages/Settings/SettingsLive.xaml" />-->
      <mui:Link DisplayName="{x:Static g:AppStrings.Main_Language}" Source="/Pages/Settings/SettingsLocale.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Main_Online}" Source="/Pages/Settings/SettingsOnline.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Settings_Plugins}" Source="/Pages/Settings/SettingsPlugins.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Settings_QuickSwitches}" Source="/Pages/Settings/SettingsQuickSwitches.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Main_Replays}" Source="/Pages/Settings/SettingsReplays.xaml"/>
      <mui:Link DisplayName="{x:Static g:AppStrings.Settings_Sharing}" Source="/Pages/Settings/SettingsSharing.xaml"/>
      <mui:Link DisplayName="Web" Source="/Pages/Settings/SettingsWebBlocks.xaml"/>
    </mui:ModernTab.Links>
  </mui:ModernTab>
</UserControl>