<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsContent">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="SettingsContent">
    <mui:SpacingUniformGrid x:Name="Grid" Columns="1" HorizontalSpacing="20" VerticalStackMode="True">

      <StackPanel set:Search.Category="{x:Static g:AppStrings.Main_Content}" set:Search.Keywords="content" Classes="SettingsPanel">
        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Content_MarkAsNewLabel}"/>
          <mui:BetterComboBox ItemsSource="{Binding Holder.NewContentPeriods}" SelectedItem="{Binding Holder.NewContentPeriod}" IsEditable="False" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Content_LoadingConcurrencyLabel}"/>
          <mui:BetterTextBox Text="{Binding Holder.LoadingConcurrency}" Placeholder="?" Mode="Positive" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_LoadingConcurrency_Tooltip}"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Holder.DeleteConfirmation}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_ConfirmBeforeRemoval_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_ConfirmBeforeRemoval}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.ScrollAutomatically}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_ScrollAutomatically_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_ScrollAutomatically}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.MentionCmInPackedContent}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_MentionCMInPacked}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="display;ui" IsChecked="{Binding Holder.ShowNotesIconInLists}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_MarkObjectsWithNotesWithIcon}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.CompressFilesInBackground}" ToolTip.Tip="Only when Assetto Corsa is not running">
          <Label Content="Compress files in background"/>
        </CheckBox>

        <!-- Power and torque curves -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_PowerAndTorqueCurves}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Holder.CurversInDrive}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_ShowCurvesInDriveSection}"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Holder.SmoothCurves}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_SmoothCurves}"/>
        </CheckBox>

        <!-- Find information specific -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_InformationSearchHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel set:Search.Keywords="missing;missing content">
          <Label Content="{x:Static g:AppStrings.Settings_Content_SearchEngine}"/>
          <mui:BetterComboBox IsEditable="False" ItemsSource="{Binding Holder.SearchEngines}" SelectedItem="{Binding Holder.SearchEngine}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Holder.SearchWithWikipedia}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_LookAtWikipedia_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_LookAtWikipedia}"/>
        </CheckBox>

        <!-- Origin icons -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_OriginIcons}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox set:Search.Keywords="display;ui" IsChecked="{Binding Holder.MarkKunosContent}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_ShowOriginIconsInLists}"/>
        </CheckBox>

        <c:MessageBlock set:Search.Include="False">
          <mui:BbCodeBlock>
            <mui:BbCodeBlock.Text>If you’re making mods and want your icon to be shown there as well, please, [url="https://acstuff.club/app/#contacts"]contact us[/url] or send a pull request [url="https://github.com/gro-ove/actools-data/tree/master/Origin%20Icons"]here[/url].</mui:BbCodeBlock.Text>
          </mui:BbCodeBlock>
        </c:MessageBlock>

        <!-- Missing content -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_DownloadingContent}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel set:Search.Keywords="missing;missing content;installation;download;install">
          <Label Content="{x:Static g:AppStrings.Settings_Content_TemporaryFilesLocation}"/>
          <Button Command="{Binding ChangeTemporaryFilesLocationCommand}" Content="{x:Static c:ControlsStrings.Common_Change}"/>
          <mui:BetterTextBox Text="{Binding Holder.TemporaryFilesLocation}" Placeholder="{Binding DefaultTemporaryFilesLocation}"/>
        </DockPanel>

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Content_SearchMissingContentVia}"/>
          <mui:BetterComboBox IsEditable="False" ItemsSource="{Binding Holder.MissingContentSearchEntries}" SelectedItem="{Binding Holder.MissingContentSearch}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <!-- Mega credentials -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_MegaNzCredentials}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_MegaNzCredentials_Tooltip}" Classes="Heading2 SettingsPanel.Heading2"/>

        <mui:BooleanSwitch Value="{Binding MegaReady}">
          <mui:BooleanSwitch.True>
            <DockPanel>
              <mui:AsyncButton Content="{x:Static g:AppStrings.Settings_Content_LogOut}" DockPanel.Dock="Right" Margin="8 0 0 0" Command="{Binding MegaLogOutCommand}"/>
              <TextBlock Text="{x:Static g:AppStrings.Settings_Content_SignedAs}"/>
              <mui:BetterTextBox Text="{Binding MegaUserEmail}" IsReadOnly="True" VerticalAlignment="Center" Theme="{StaticResource Borderless}"/>
            </DockPanel>
          </mui:BooleanSwitch.True>
          <mui:BooleanSwitch.False>
            <DockPanel>
              <mui:AsyncButton Content="{x:Static g:AppStrings.Settings_Content_LogIn}" DockPanel.Dock="Bottom" Margin="0 8 0 0" Command="{Binding MegaLogInCommand}"/>
              <mui:SpacingUniformGrid Rows="1" HorizontalSpacing="8">
                <mui:BetterTextBox Text="{Binding MegaUserEmail}" Placeholder="{x:Static g:AppStrings.Settings_Content_EMail}"/>
                <mui:ProperPasswordBox Password="{Binding MegaUserPassword}" Placeholder="{x:Static g:AppStrings.Online_FilterPassword_Short}"/>
              </mui:SpacingUniformGrid>
            </DockPanel>
          </mui:BooleanSwitch.False>
        </mui:BooleanSwitch>

      </StackPanel>
      <StackPanel set:Search.Category="{x:Static g:AppStrings.Main_Content}" set:Search.Keywords="content" Classes="SettingsPanel">

        <!-- Cars specific -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_CarsHeader}" Classes="Heading2 SettingsPanel.Heading2.First"/>

        <CheckBox set:Search.Keywords="cars" IsChecked="{Binding Holder.ChangeBrandIconAutomatically}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_ChangeBrandIcon}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="cars;display;ui" IsChecked="{Binding Holder.CarsYearPostfix}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_AddYearPostfix}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="cars;display;ui" IsChecked="{Binding Holder.CarsYearPostfixAlt}" IsEnabled="{Binding Holder.CarsYearPostfix}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_FourDigitForYearPostfix}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="cars;display;ui" IsChecked="{Binding Holder.CarsDisplayNameCleanUp}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_HideSymbolsLikeFromCarNames}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="display;ui;cars" IsChecked="{Binding Holder.ShowCarPreviewInToolTips}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_ShowCarPreviewsInTooltips}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="ui;display;cars" IsChecked="{Binding Holder.CarsFixSpecs}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_FixMissingSpacesInSpecsInDrive}"/>
        </CheckBox>

        <DockPanel set:Search.Keywords="cars">
          <Label Content="{x:Static g:AppStrings.Settings_Content_TyresReplacementFilter}"/>
          <mui:HistoricalTextBox Text="{Binding Holder.CarReplaceTyresDonorFilter}" Placeholder="*" SaveKey="__CarReplaceTyresDonorFilters" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_TyresReplacementFilter_Tooltip}"/>
        </DockPanel>

        <DockPanel set:Search.Keywords="cars;specs">
          <Label Content="{x:Static g:AppStrings.Settings_Content_PWRatioFormat}"/>
          <mui:BetterComboBox ItemsSource="{Binding Holder.CarsDisplayPwRatioFormat}" SelectedItem="{Binding Holder.CarsDisplayPwRatioFormat.SelectedItem}" IsEditable="False" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <CheckBox set:Search.Keywords="cars;specs;display;ui" IsChecked="{Binding Holder.DisplaySteerLock}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_DisplaySteerLock}"/>
        </CheckBox>

        <DockPanel set:Search.Keywords="cars;model">
          <Label Content="LOD generation tool"/>
          <mui:BetterComboBox ItemsSource="{Binding Holder.CarsLODGeneratorTool}" SelectedItem="{Binding Holder.CarsLODGeneratorTool.SelectedItem}" IsEditable="False">
            <mui:BetterComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel x:Name="__Dt0">
                  <StackPanel.Styles><Style Selector="StackPanel#__Dt0"><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S1)=True] TextBlock#PART_Details"><Setter Property="IsVisible" Value="False"/>
                  </Style></Style></StackPanel.Styles><TextBlock Text="{Binding DisplayName}"/>
                  <TextBlock x:Name="PART_Details" Text="{Binding Tag}" TextWrapping="Wrap" MaxWidth="400" Classes="Small"/>
                </StackPanel>
                </DataTemplate>
            </mui:BetterComboBox.ItemTemplate>
          </mui:BetterComboBox>
        </DockPanel>

        <!-- Car skins specific -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_CarSkins}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox set:Search.Keywords="cars;skins" IsChecked="{Binding Holder.CarSkinsDisplayId}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_DisplaySkinIDsInsteadOfNames}"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="cars;skins" IsChecked="{Binding Holder.SkinsSkipPriority}">
          <Label>
            <Label.Content>Remove skin’s priority field on saving</Label.Content>
          </Label>
        </CheckBox>

        <CheckBox set:Search.Keywords="display;cars;skins" IsChecked="{Binding Holder.CarSkinsUsePngPreview}">
          <Label Content="Use “preview.png” instead of “preview.jpg” if exists"/>
        </CheckBox>

        <CheckBox set:Search.Keywords="cars;skins" IsChecked="{Binding Holder.SkinsCacheNames}">
          <ToolTip.Tip>With caching CM wouldn’t need to load skin JSON files later when it would only need a name, speeding things up. Might have side effects if you edit skins outside of CM.</ToolTip.Tip>
          <Label>
            <Label.Content>Cache skin names</Label.Content>
          </Label>
        </CheckBox>

        <DockPanel set:Search.Keywords="cars;skins">
          <Label Content="{x:Static g:AppStrings.Online_SortByLabel}"/>
          <mui:BetterComboBox ItemsSource="{Binding Holder.CarSkinsSorting}" SelectedItem="{Binding Holder.CarSkinsSorting.SelectedItem}" IsEditable="False" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <!-- Showrooms specific -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_ShowroomsHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Holder.DownloadShowroomPreviews}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_DownloadPreviews_Tooltip}">
          <Label Content="{x:Static g:AppStrings.Settings_Content_DownloadPreviews}"/>
        </CheckBox>

        <!-- Fonts specific -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_FontsHeader}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <Label Content="{x:Static g:AppStrings.Settings_Content_FontIconSymbol}"/>
          <mui:BetterTextBox Text="{Binding Holder.FontIconCharacter}" Placeholder="?" ToolTip.Tip="{x:Static g:AppStrings.Settings_Content_FontIconSymbol_Tooltip}"/>
        </DockPanel>

        <!-- CUP -->
        <TextBlock Text="{x:Static g:AppStrings.Settings_Content_ModsAutoUpdate}" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <Label Content="Registries:"/>
          <mui:BetterTextBox Text="{Binding Holder.CupRegistries}" Placeholder="?" mui:ContextMenuAdvancement.PropagateToChildren="True" Height="80" AcceptsReturn="True" TextWrapping="Wrap">
            <ToolTip.Tip>
              <ToolTip>
                <ToolTip.Content>
                  <TextBlock MaxWidth="400" TextWrapping="Wrap" Text="Registries are websites providing information about new versions. If you want to create your own, please let me know, and I’ll describe it in detail."/>
                </ToolTip.Content>
              </ToolTip>
            </ToolTip.Tip>
            <mui:BetterTextBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Reset to default" Command="{Binding ResetCupRegistriesCommand}"/>
              </ContextMenu>
            </mui:BetterTextBox.ContextMenu>
          </mui:BetterTextBox>
        </DockPanel>
      </StackPanel>

    </mui:SpacingUniformGrid>
  </ScrollViewer>
</UserControl>