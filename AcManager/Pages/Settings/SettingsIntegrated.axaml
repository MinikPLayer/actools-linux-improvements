<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:set="clr-namespace:AcManager.Pages.Settings" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:c="http://acstuff.club/app/controls" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Pages.Settings.SettingsIntegrated">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer mui:SaveScroll.Key="SettingsIntegrated">
    <mui:SpacingUniformGrid x:Name="Grid" Columns="1" HorizontalSpacing="20" VerticalStackMode="True">

      <StackPanel set:Search.Category="Integrated" Classes="SettingsPanel">

        <!-- Steam -->
        <TextBlock Text="Steam:" Classes="Heading2 SettingsPanel.Heading2.First"/>
        <DockPanel IsVisible="{Binding IsSteamFullyIntegrated, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
          <Button Command="{Binding RestartCommand}" Content="{x:Static g:AppStrings.Common_Restart}" Margin="0 -2" IsVisible="{Binding SteamRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <Button Command="{Binding FullIntegrationCommand}" Content="Full integration" Margin="0 -2" IsVisible="{Binding SteamRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" ToolTip.Tip="With full integration, Steam will open Content Manager when you’re starting Assetto Corsa, or when you get an invite to a race and Content Manager is closed"/>
          <CheckBox IsChecked="{Binding Integrated.SteamIntegration}" Margin="0" ToolTip.Tip="Use Steam overlay in Content Manager, count is as Assetto Corsa running, send and accept invites for online races">
            <Label Content="Connect to Steam API at launch (restart required)"/>
          </CheckBox>
        </DockPanel>
        <DockPanel IsVisible="{Binding IsSteamFullyIntegrated, Converter={StaticResource BooleanToVisibilityConverter}}">
          <CheckBox IsChecked="True" IsEnabled="False" Margin="0" ToolTip.Tip="To disable full integration, move Content Manager somewhere else and rename “AssettoCorsa_original.exe” back to “AssettoCorsa.exe”">
            <Label Content="Connect to Steam API at launch (restart required)"/>
          </CheckBox>
        </DockPanel>

        <!-- Discord -->
        <TextBlock Text="Discord:" Classes="Heading2 SettingsPanel.Heading2"/>
        <DockPanel>
          <Button Command="{Binding RestartCommand}" Content="{x:Static g:AppStrings.Common_Restart}" Margin="0 -2 0 -3" IsVisible="{Binding DiscordRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <CheckBox IsChecked="{Binding Integrated.DiscordIntegration}" Margin="0">
            <Label Content="Discord Rich Presence (restart required)"/>
          </CheckBox>
        </DockPanel>

        <TextBlock Text="RSR:" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Integrated.RsrLimitTemperature}" ToolTip.Tip="There is a rumour you might get banned on RSR for setting the temperature lower than 10 °C; with this option enabled, if you have RSR app enabled, CM will automatically raise temperature if needed up to 10 °C to avoid getting banned">
          <Label Content="Limit lower temperature by 10 °C to avoid being banned on RSR"/>
        </CheckBox>

        <CheckBox IsChecked="{Binding Live.RsrEnabled}">
          <Label Content="{x:Static g:AppStrings.Settings_Live_EnableRsr}"/>
        </CheckBox>

        <StackPanel IsEnabled="{Binding Live.RsrEnabled}">
          <CheckBox IsChecked="{Binding Live.RsrCustomStyle}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Live_RsrCustomStyle_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_Live_CustomStyle}"/>
          </CheckBox>

          <DockPanel>
            <Label Content="{x:Static g:AppStrings.Settings_Live_RsrNameLabel}"/>
            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Live.RsrDifferentPlayerName}" VerticalAlignment="Center" ToolTip.Tip="{x:Static g:AppStrings.Settings_Live_RsrName_Tooltip}"/>
            <mui:BetterTextBox Text="{Binding Live.RsrPlayerName}" Placeholder="?" IsEnabled="{Binding Live.RsrDifferentPlayerName}"/>
          </DockPanel>

          <CheckBox IsChecked="{Binding Live.RsrDisableAppAutomatically}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Live_RsrAutoToggleApp_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_Live_RsrAutoToggleApp}"/>
          </CheckBox>
        </StackPanel>

        <TextBlock Text="SRS:" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Live.SrsEnabled}">
          <Label Content="{x:Static g:AppStrings.Settings_Live_EnableSrs}"/>
        </CheckBox>

        <StackPanel IsEnabled="{Binding Live.SrsEnabled}">
          <CheckBox IsChecked="{Binding Live.SrsCustomStyle}" ToolTip.Tip="{x:Static g:AppStrings.Settings_Live_SrsCustomStyle_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_Live_CustomStyle}"/>
          </CheckBox>

          <CheckBox IsChecked="{Binding Live.SrsCollectCombinations}">
            <Label Content="Collect race combinations for quick testing and training"/>
          </CheckBox>

          <!--<CheckBox IsChecked="{Binding Live.SrsAutoMode}" ToolTip="{x:Static g:AppStrings.Settings_Live_SrsJoinFromOnline_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_Live_SrsJoinFromOnline}" />
          </CheckBox>

          <DockPanel ToolTip="{x:Static g:AppStrings.Settings_Live_SrsOnlineMask_Tooltip}">
            <Label Content="{x:Static g:AppStrings.Settings_Live_SrsOnlineMaskLabel}" />
            <mui:BetterTextBox Text="{Binding Live.SrsAutoMask}" Placeholder="?" />
          </DockPanel>-->
        </StackPanel>

        <TextBlock Text="Track Titan:" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Live.TrackTitanEnabled}">
          <Label Content="Enable Track Titan"/>
        </CheckBox>

        <TextBlock Text="United Racing Data:" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Live.UnitedRacingDataEnabled}">
          <Label Content="Enable United Racing Data"/>
        </CheckBox>

        <TextBlock Text="World Sim Series:" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Live.WorldSimSeriesEnabled}">
          <Label Content="Enable World Sim Series"/>
        </CheckBox>

        <TextBlock Text="RaceU:" Classes="Heading2 SettingsPanel.Heading2"/>

        <CheckBox IsChecked="{Binding Live.RaceUEnabled}">
          <Label Content="Enable RaceU"/>
        </CheckBox>

        <!-- Custom services -->
        <TextBlock Text="Extra Live Services:" Classes="Heading2 SettingsPanel.Heading2"/>

        <DockPanel>
          <Label Content="Services:"/>
          <ListBox SelectedItem="{Binding LiveModel.SelectedLiveService}" ItemsSource="{Binding Live.UserEntries}" DockPanel.Dock="Top" ItemContainerTheme="{StaticResource RibbonListBoxItem.Left}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="20 4">
                  <mui:BetterTextBox Text="{Binding DisplayName}" TextChanged="OnUserLinkTextChanged" Theme="{StaticResource Borderless}"/>
                  <mui:BetterTextBox Text="{Binding Url}" TextChanged="OnUserLinkTextChanged" Theme="{StaticResource Borderless.Small}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <mui:SpacingUniformGrid Rows="1" Columns="3" HorizontalSpacing="0" Margin="0 8 0 0">
            <Button Content="Add service" Command="{Binding LiveModel.AddLiveServiceCommand}"/>
            <Button Content="Delete service" Command="{Binding LiveModel.DeleteSelectedServiceCommand}" IsEnabled="{Binding LiveModel.SelectedLiveService, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=inverse}"/>
            <Button Content="Share service" Command="{Binding LiveModel.ShareSelectedServiceCommand}" IsEnabled="{Binding LiveModel.SelectedLiveService, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=inverse}"/>
          </mui:SpacingUniformGrid>
        </DockPanel>

      </StackPanel>
      <StackPanel set:Search.Category="Integrated" Classes="SettingsPanel">

        <!-- Camber Extravaganza -->
        <TextBlock Text="Camber Extravaganza:" Classes="Heading2 SettingsPanel.Heading2.First"/>
        <CheckBox IsChecked="{Binding Drive.CamberExtravaganzaIntegration}">
          <Label Content="Add missing tyres information"/>
        </CheckBox>

        <!-- Sidekick -->
        <TextBlock Text="Sidekick:" Classes="Heading2 SettingsPanel.Heading2"/>
        <CheckBox IsChecked="{Binding Drive.SidekickIntegration}">
          <Label Content="Extend Sidekick’s tyres information if needed"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Drive.SidekickUpdateExistingKunos}">
          <Label Content="Update entries for Kunos cars if different"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Drive.SidekickUpdateExistingMods}">
          <Label Content="Update entries for mods if different"/>
        </CheckBox>
        <DockPanel>
          <Button Content="Import all distances now" Margin="8 -4 0 -4" Command="{Binding ImportSidekickOdometerCommand}" ToolTip.Tip="By default, CM will only update values for selected car before the race"/>
          <CheckBox IsChecked="{Binding Drive.SidekickOdometerImportValues}">
            <Label Content="Import driven distance from Sidekick app if bigger"/>
          </CheckBox>
        </DockPanel>
        <CheckBox IsChecked="{Binding Drive.SidekickOdometerExportValues}">
          <Label Content="Export driven distance to Sidekick app if bigger"/>
        </CheckBox>

        <!-- Race Essentials -->
        <TextBlock Text="Race Essentials:" Classes="Heading2 SettingsPanel.Heading2"/>
        <CheckBox IsChecked="{Binding Drive.RaceEssentialsIntegration}">
          <Label Content="Extend RaceEssentials’s tyres information if needed"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Drive.RaceEssentialsUpdateExistingKunos}">
          <Label Content="Update entries for Kunos cars if different"/>
        </CheckBox>
        <CheckBox IsChecked="{Binding Drive.RaceEssentialsUpdateExistingMods}">
          <Label Content="Update entries for mods if different"/>
        </CheckBox>

        <!-- Odometer by Stereo -->
        <TextBlock Text="Odometer by Stereo:" Classes="Heading2 SettingsPanel.Heading2"/>
        <DockPanel>
          <Button Content="Import all distances now" Margin="8 -4 0 -4" Command="{Binding ImportStereoOdometerCommand}" ToolTip.Tip="By default, CM will only update values for selected car before the race"/>
          <CheckBox IsChecked="{Binding Drive.StereoOdometerImportValues}">
            <Label Content="Import driven distance from Odometer app if bigger"/>
          </CheckBox>
        </DockPanel>
        <CheckBox IsChecked="{Binding Drive.StereoOdometerExportValues}">
          <Label Content="Export driven distance to Odometer app if bigger"/>
        </CheckBox>
        <c:MessageBlock>
          <mui:BbCodeBlock Text="Please, keep in mind that Odometer calculates distance made by wheels, while CM stores the distance car moved in space. If you want to remove imported values, simply uncheck “Import driven distance …” checkbox and use “Recalculate” button in stats section."/>
        </c:MessageBlock>

        <!-- Real Head Motion -->
        <DockPanel set:Search.SubCategory="Real Head Motion:" Margin="0 20 0 8" set:Search.Keywords="real head motion;rhm">
          <TextBlock Text="Real Head Motion:" Classes="Heading2"/>
          <Button CommandParameter="http://www.assettocorsa.net/forum/index.php?threads/real-head-motion-1-0-2.4755/" Theme="{StaticResource MoreDetailsSuperscript}"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Drive.RhmIntegration}" set:Search.Keywords="real head motion;rhm">
          <Label Content="RHM integration"/>
        </CheckBox>

        <DockPanel IsEnabled="{Binding Drive.RhmIntegration}" set:Search.Keywords="real head motion;rhm">
          <Label Content="RHM location:"/>
          <Button Content="Browse" Command="{Binding Drive.SelectRhmLocationCommand}"/>
          <mui:BetterTextBox Text="{Binding Drive.RhmLocation}" Placeholder="{x:Static t:ToolsStrings.Common_None}"/>
        </DockPanel>

        <DockPanel IsEnabled="{Binding Drive.RhmIntegration}" set:Search.Keywords="real head motion;rhm">
          <Label Content="RHM settings location:"/>
          <Button Content="Browse" Command="{Binding Drive.SelectRhmSettingsCommand}"/>
          <mui:BetterTextBox Text="{Binding Drive.RhmSettingsLocation}" Placeholder="{x:Static t:ToolsStrings.Common_None}"/>
        </DockPanel>

        <DockPanel set:Search.Keywords="real head motion;rhm" ToolTip.Tip="How long RHM will be running after the race (to avoid restarting it over and over)">
          <Label Content="Keep alive for:"/>
          <mui:BetterComboBox IsEditable="False" ItemsSource="{Binding Drive.RhmKeepAlivePeriods}" SelectedItem="{Binding Drive.RhmKeepAlivePeriod}" DisplayMemberBinding="{Binding DisplayName}"/>
        </DockPanel>

        <!-- D-BOX -->
        <DockPanel set:Search.SubCategory="D-BOX:" Margin="0 20 0 8">
          <TextBlock Text="D-BOX:" Classes="Heading2"/>
          <Button CommandParameter="http://www.d-box.com/training-and-simulation/racing-simulation/" Theme="{StaticResource MoreDetailsSuperscript}"/>
        </DockPanel>

        <CheckBox IsChecked="{Binding Integrated.DBoxIntegration}" set:Search.Keywords="dbox">
          <Label Content="D-BOX integration"/>
        </CheckBox>

        <mui:SpacingUniformGrid IsEnabled="{Binding Integrated.DBoxIntegration}" Rows="1" HorizontalSpacing="8" Margin="0 0 0 8" set:Search.Keywords="dbox">
          <Button Command="{Binding Integrated.SwitchDBoxModeCommand}" CommandParameter="{x:Static t:SettingsHolder+IntegratedSettings+DBoxMode.CmCompatible}">
            <TextBlock Text="Switch D-BOX to CM‑compatible mode" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button Command="{Binding Integrated.SwitchDBoxModeCommand}" CommandParameter="{x:Static t:SettingsHolder+IntegratedSettings+DBoxMode.Stock}">
            <TextBlock Text="Restore original D‑BOX settings" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
        </mui:SpacingUniformGrid>

        <DockPanel IsEnabled="{Binding Integrated.DBoxIntegration}" set:Search.Keywords="dbox">
          <Label Content="D-BOX location:"/>
          <Button Content="Browse" Command="{Binding Integrated.SelectDBoxLocationCommand}"/>
          <mui:BetterTextBox Text="{Binding Integrated.DBoxLocation}" Placeholder="{x:Static t:ToolsStrings.Common_None}"/>
        </DockPanel>

        <DockPanel>
          <mui:ValueLabel Value="{Binding Integrated.DBoxDelay}" mui:BetterTextBox.Minimum="1" Postfix=" s" Content="D-BOX delay"/>
          <Slider Minimum="0" Maximum="60" Value="{Binding Integrated.DBoxDelay}" TickFrequency="6" TickPlacement="BottomRight"/>
        </DockPanel>

        <c:MessageBlock Margin="0 0 0 8" c:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureSharedMemoryReduceGForcesWhenSlow}">
          <mui:BbCodeBlock Text="You can use Custom Shaders Patch to reduce G-forces for cars going slower than 6 km/h. There is an option for it in General settings."/>
        </c:MessageBlock>

      </StackPanel>

    </mui:SpacingUniformGrid>
  </ScrollViewer>
</UserControl>