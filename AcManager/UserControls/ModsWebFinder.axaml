<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AcManager.UserControls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.UserControls.ModsWebFinder">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel Margin="0 0 0 -8" Classes="SettingsPanel">
    <DockPanel>
      <Label>
        <DockPanel>
          <TextBlock Text="Rule to start download:"/>
          <Button CommandParameter="/Pages/About/ImportantTipsPage.xaml?Key=autoClickdownloadButtons" Theme="{StaticResource MoreDetailsSuperscript}"/>
        </DockPanel>
      </Label>
      <mui:BetterComboBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Placeholder="?" ItemsSource="{Binding Source.RuleSuggestions.Value}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" FontSize="{DynamicResource SmallFontSize}"/>
    </DockPanel>
  </StackPanel>
</UserControl>