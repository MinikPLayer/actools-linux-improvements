<Grid xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:c="http://acstuff.club/app/controls" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.UserControls.AssistsEditor" x:Name="This">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/Converters.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Thickness x:Key="EntryMargin">0 0 8 8</Thickness>
    </ResourceDictionary>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="240"/>
    <ColumnDefinition Width="240"/>
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
    <RowDefinition Height="40"/>
    <RowDefinition Height="40"/>
    <RowDefinition Height="60"/>
    <RowDefinition Height="60"/>
    <RowDefinition Height="60"/>
    <RowDefinition Height="60"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- first row -->
  <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding AutoShifter}" Margin="{StaticResource EntryMargin}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_AutoShifting_Tooltip}">
    <Label Content="{x:Static t:ToolsStrings.Assists_AutoShifting}"/>
  </CheckBox>

  <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding AutoClutch}" Margin="{StaticResource EntryMargin}" IsEnabled="{Binding AutoClutchEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_AutoClutch_Tooltip}">
    <Label Content="{x:Static t:ToolsStrings.Assists_AutoClutch}"/>
  </CheckBox>

  <!-- second row -->
  <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding AutoBlip}" Margin="{StaticResource EntryMargin}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_AutoBlip_Tooltip}">
    <Label Content="{x:Static t:ToolsStrings.Assists_AutoBlip}"/>
  </CheckBox>

  <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IdealLine}" Margin="{StaticResource EntryMargin}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_IdealLine_Tooltip}">
    <Label Content="{x:Static t:ToolsStrings.Assists_IdealLine}"/>
  </CheckBox>

  <!-- third row -->
  <StackPanel Margin="{StaticResource EntryMargin}" Grid.Row="2" Grid.Column="0" IsEnabled="{Binding TractionControlEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_TractionControlLabel_Tooltip}">
    <TextBlock Text="{x:Static t:ToolsStrings.Assists_TractionControlLabel}" Margin="0 0 0 4" Classes="Label Label.Padding"/>
    <ComboBox Margin="4 0 4 0" SelectedItem="{Binding TractionControl}" ItemsSource="{Binding AssistStates}" mui:ComboBoxAdvancement.DisplayConverter="{x:Static c:AssistsViewModel.AssistStateToStringConverter}"/>
  </StackPanel>

  <StackPanel Margin="{StaticResource EntryMargin}" Grid.Row="2" Grid.Column="1" IsEnabled="{Binding AbsEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_AbsLabel_Tooltip}">
    <TextBlock Text="{x:Static t:ToolsStrings.Assists_AbsLabel}" Margin="0 0 0 4" Classes="Label Label.Padding"/>
    <ComboBox Margin="4 0 4 0" SelectedItem="{Binding Abs}" ItemsSource="{Binding AssistStates}" mui:ComboBoxAdvancement.DisplayConverter="{x:Static c:AssistsViewModel.AssistStateToStringConverter}"/>
  </StackPanel>

  <!-- forth row -->
  <StackPanel Grid.Row="3" Grid.Column="0" Margin="{StaticResource EntryMargin}" IsEnabled="{Binding StabilityControlEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_StabilityControl_Tooltip}">
    <mui:ValueLabel Content="{x:Static t:ToolsStrings.Assists_StabilityControl}" Value="{Binding StabilityControl}" Postfix="%"/>
    <Slider Minimum="0" Maximum="100" Value="{Binding StabilityControl}" Margin="0 0 0 4" TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="False"/>
  </StackPanel>

  <!--<CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding FuelConsumption}" Margin="{StaticResource EntryMargin}">
        <Label Content="{x:Static t:ToolsStrings.Assists_FuelConsumption}" />
    </CheckBox>-->

  <StackPanel Grid.Row="3" Grid.Column="1" Margin="{StaticResource EntryMargin}" IsEnabled="{Binding FuelConsumptionEditable}">
    <mui:ValueLabel Content="{x:Static t:ToolsStrings.Assists_FuelConsumption}" Value="{Binding FuelConsumption}" Postfix="×"/>
    <Slider Minimum="0" Maximum="5" Value="{Binding FuelConsumption}" Margin="0 0 0 4" TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="False"/>
  </StackPanel>

  <!-- fifth row -->
  <StackPanel Grid.Row="4" Grid.Column="0" Margin="{StaticResource EntryMargin}" IsEnabled="{Binding DamageEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_MechanicalDamage_Tooltip}">
    <mui:ValueLabel Content="{x:Static t:ToolsStrings.Assists_MechanicalDamage}" Value="{Binding Damage}" Postfix="%"/>
    <Slider Minimum="0" Maximum="100" Value="{Binding Damage}" Margin="0 0 0 4" TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="True"/>
  </StackPanel>

  <StackPanel Grid.Row="4" Grid.Column="1" Margin="{StaticResource EntryMargin}" IsEnabled="{Binding TyreWearMultiplierEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_TyreWear_Tooltip}">
    <mui:ValueLabel Content="{x:Static t:ToolsStrings.Assists_TyreWear}" Value="{Binding TyreWearMultiplier}" Postfix="×"/>
    <Slider Minimum="0" Maximum="5" Value="{Binding TyreWearMultiplier}" Margin="0 0 0 4" TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="False"/>
  </StackPanel>

  <!-- sixth row -->
  <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding TyreBlankets}" Margin="{StaticResource EntryMargin}" IsEnabled="{Binding TyreBlanketsEditable}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_TyreBlankets_Tooltip}">
    <Label Content="{x:Static t:ToolsStrings.Assists_TyreBlankets}"/>
  </CheckBox>

  <StackPanel Grid.Row="5" Grid.Column="1" Margin="{StaticResource EntryMargin}" ToolTip.Tip="{x:Static t:ToolsStrings.Assists_SlipstreamEffect_Tooltip}">
    <mui:ValueLabel Content="{x:Static t:ToolsStrings.Assists_SlipstreamEffect}" Value="{Binding SlipsteamMultiplier}" Postfix="×"/>
    <Slider Minimum="0" Maximum="10" Value="{Binding SlipsteamMultiplier}" Margin="0 0 0 4" TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"/>
  </StackPanel>

  <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
    <TextBlock Text="Some assists are defined by server" TextWrapping="Wrap" MaxWidth="120" HorizontalAlignment="Left" DockPanel.Dock="Left" IsVisible="{Binding ServerAssists, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Small"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
      <c:UserPresetsControl UserPresetable="{Binding}" Margin="0 0 4 0"/>
      <Button Command="{Binding ShareCommand, ElementName=This}" Content="{x:Static g:AppStrings.Common_Share}" ToolTip.Tip="{x:Static g:AppStrings.Common_Share_SettingsTooltip}"/>
    </StackPanel>
  </DockPanel>
</Grid>