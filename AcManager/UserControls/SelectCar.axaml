<mui:ModernTab xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:g="clr-namespace:AcManager" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.UserControls.SelectCar" Layout="TabWithTitle" mui:ModernFrame.TopSource="/Pages/SelectionLists/CarBrands.xaml" FrameNavigated="OnFrameNavigated" mui:ModernFrame.KeepContentAlive="True" SaveKey=".selectCarUc" SavePolicy="Flexible" LinksHorizontalAlignment="Stretch">
  <mui:ModernTab.LinksListBoxTemplate>
    <ControlTemplate>
      <DockPanel>
        <!--<mui:ContextMenuButton DockPanel.Dock="Right" VerticalAlignment="Center" />-->
        <ItemsPresenter HorizontalAlignment="Left"/>
      </DockPanel>
    </ControlTemplate>
  </mui:ModernTab.LinksListBoxTemplate>
  <mui:ModernTab.Links>
    <mui:Link DisplayName="{x:Static g:AppStrings.Select_Brands}" Source="/Pages/SelectionLists/CarBrands.xaml"/>
    <mui:Link DisplayName="{x:Static g:AppStrings.Select_Countries}" Source="/Pages/SelectionLists/CarCountries.xaml"/>
    <mui:Link DisplayName="{x:Static g:AppStrings.Select_Categories}" Source="/Pages/SelectionLists/CarCategories.xaml"/>
    <mui:Link DisplayName="DLCs" Source="/Pages/SelectionLists/CarDlcs.xaml"/>
    <mui:Link DisplayName="Tags" Source="/Pages/SelectionLists/CarTags.xaml"/>
    <mui:Link DisplayName="Ratings &amp; Favourites" Source="/Pages/SelectionLists/CarRatings.xaml"/>
    <!-- ReSharper disable once Xaml.PathError -->
    <mui:Link DisplayName="{x:Static g:AppStrings.Select_All}" Source="/Pages/Miscellaneous/AcObjectSelectList.xaml?Type=car&amp;Filter=enabled+"/>
  </mui:ModernTab.Links>
</mui:ModernTab>