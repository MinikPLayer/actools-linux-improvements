<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:customShowroom="clr-namespace:AcManager.CustomShowroom" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.CustomShowroom.TrackMapRendererTools" LocationAndSizeKey="TrackMapRenderer.LS" Topmost="True" Width="250" SizeToContent="Height">
  <mui:ModernDialog.Title>Track’s Map</mui:ModernDialog.Title>
  <mui:ModernDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
        <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
        <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBox.axaml"/>
        <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/ListBox.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </mui:ModernDialog.Resources>

  <StackPanel Margin="-4 -8 -4 -20">
    <StackPanel.Styles><Style Selector="DockPanel.DockPanel">
          <Setter Property="Margin" Value="0 4 0 0"/>

          <Style Selector="^ Label">
                <Setter Property="Width" Value="80"/>
                <Setter Property="DockPanel.Dock" Value="Left"/>
              </Style>
              <Style Selector="^ StackPanel">
                <Setter Property="Margin" Value="0 0 0 4"/>
                <Setter Property="DockPanel.Dock" Value="Top"/>
              </Style>
            </Style>

        <Style Selector="DockPanel"/>
      </StackPanel.Styles><mui:Switch Value="{Binding SurfaceMode}">
      <StackPanel mui:Switch.When="True">
        <TextBlock Text="Surface mode" Classes="Heading2"/>

        <Label Content="Filter road surface by:" Margin="0 0 0 0"/>
        <!--<mui:HistoricalTextBox Text="{Binding Filter, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 8"
                SaveKey="TrackMapFilter" />-->
        <mui:BetterTextBox Margin="0 4 0 0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>

        <CheckBox Margin="0 4 0 0" IsChecked="{Binding FilterIgnoreCase}">
          <Label Content="Ignore case"/>
        </CheckBox>

        <Label Content="Surfaces:" Margin="0 8 0 0"/>
        <ListBox x:Name="SurfacesListBox" ItemsSource="{Binding Surfaces}" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0 4 0 0" ItemContainerTheme="{StaticResource CheckBoxListBoxItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock Text="{Binding Key}" Margin="0 0 0 4" DockPanel.Dock="Top"/>
                <TextBlock Text="{Binding Description}" Classes="Small"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <StackPanel mui:Switch.When="False">
        <TextBlock Text="Surface mode" Classes="Heading2"/>

        <CheckBox Margin="0 4 0 0" IsChecked="{Binding AiLaneActualWidth}">
          <Label Content="Actual width"/>
        </CheckBox>

        <DockPanel Margin="20 4 0 0" IsVisible="{Binding AiLaneActualWidth, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
          <mui:ValueLabel Value="{Binding AiLaneWidth}" Postfix=" m" mui:BetterTextBox.Mode="Integer" DockPanel.Dock="Top" Content="Width"/>
          <Slider Minimum="1" Maximum="50" TickFrequency="4.9" TickPlacement="BottomRight" IsSnapToTickEnabled="False" Value="{Binding AiLaneWidth, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.1}"/>
        </DockPanel>

        <CheckBox Margin="0 4 0 0" IsChecked="{Binding ShowPitlane}">
          <Label Content="Show pitlane"/>
        </CheckBox>

        <DockPanel Margin="20 4 0 0" IsVisible="{Binding ShowPitlane, Converter={StaticResource BooleanToVisibilityConverter}}">
          <mui:ValueLabel Value="{Binding AiPitLaneWidth}" Postfix=" m" mui:BetterTextBox.Mode="Integer" DockPanel.Dock="Top" Content="Pitlane width"/>
          <Slider Minimum="1" Maximum="{Binding AiLaneWidth}" TickFrequency="{Binding AiLaneWidth, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.1}" TickPlacement="BottomRight" IsSnapToTickEnabled="False" Value="{Binding AiPitLaneWidth, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.1}"/>
        </DockPanel>

        <DockPanel Margin="20 4 0 0" IsVisible="{Binding ShowPitlane, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Label Content="Pitlane color:" Margin="8 0 0 0" VerticalAlignment="Center"/>
          <mui:ColorPicker Color="{Binding AiPitLaneColor}"/>
        </DockPanel>

        <CheckBox Margin="0 4 0 0" IsChecked="{Binding ShowSpecialMarks}">
          <Label Content="Show special marks"/>
        </CheckBox>

        <CheckBox Margin="20 4 0 0" IsChecked="{Binding ShowAiPitLaneMarks}" IsVisible="{Binding ShowSpecialMarks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Label Content="Show pitlane marks"/>
        </CheckBox>

        <DockPanel Margin="20 4 0 0" IsVisible="{Binding ShowSpecialMarks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <mui:ValueLabel Value="{Binding SpecialMarksWidth}" Postfix=" m" mui:BetterTextBox.Mode="Integer" DockPanel.Dock="Top" Content="Marks width"/>
          <Slider Minimum="1" Maximum="40" TickFrequency="3.9" TickPlacement="BottomRight" IsSnapToTickEnabled="False" Value="{Binding SpecialMarksWidth, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.1}"/>
        </DockPanel>

        <DockPanel Margin="20 4 0 0" IsVisible="{Binding ShowSpecialMarks, Converter={StaticResource BooleanToVisibilityConverter}}">
          <mui:ValueLabel Value="{Binding SpecialMarksThickness}" Postfix=" m" mui:BetterTextBox.Mode="Integer" DockPanel.Dock="Top" Content="Marks thickness"/>
          <Slider Minimum="1" Maximum="40" TickFrequency="3.9" TickPlacement="BottomRight" IsSnapToTickEnabled="False" Value="{Binding SpecialMarksThickness, Converter={StaticResource SliderRoundConverter}, ConverterParameter=0.1}"/>
        </DockPanel>
      </StackPanel>
    </mui:Switch>

    <TextBlock Text="View" Margin="0 12 0 0" Classes="Heading2"/>

    <UniformGrid Columns="2" Margin="0 4 0 0">
      <Button Content="Go to start" Command="{Binding CameraToStartCommand}" Margin="0 0 2 0"/>
      <Button Content="Show all" Command="{Binding ResetCameraCommand}" Margin="2 0 0 0"/>
    </UniformGrid>

    <TextBlock Text="Image parameters" Margin="0 12 0 0" Classes="Heading2"/>

    <CheckBox Margin="0 4 0 0" IsChecked="{Binding UseFxaa}">
      <Label Content="FXAA"/>
    </CheckBox>

    <DockPanel>
      <mui:ValueLabel Value="{Binding Margin, StringFormat='\{0:F0\}'}" Postfix="px" mui:BetterTextBox.Mode="Number" DockPanel.Dock="Top" Content="Margin"/>
      <Slider Minimum="0" Maximum="20" Value="{Binding Margin}" TickFrequency="5" TickPlacement="BottomRight" IsSnapToTickEnabled="False"/>
    </DockPanel>

    <DockPanel>
      <mui:ValueLabel Value="{Binding Scale, Converter={StaticResource PercentageConverter}, StringFormat='\{0:F0\}'}" Postfix="%" mui:BetterTextBox.Mode="Number" DockPanel.Dock="Top" Content="Scale"/>
      <Slider Minimum="20" Maximum="320" Value="{Binding Scale, Converter={StaticResource PercentageConverter}, ConverterParameter=0.1}" TickFrequency="100" TickPlacement="BottomRight" IsSnapToTickEnabled="False"/>
    </DockPanel>

    <Button Margin="0 8 0 0" Content="Save map" Command="{Binding SaveCommand}" ToolTip.Tip="Save new map.png and map.ini (original files will be moved to the Recycle Bin)"/>
  </StackPanel>
</mui:ModernDialog>