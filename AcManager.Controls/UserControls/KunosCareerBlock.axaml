<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:objects="clr-namespace:AcManager.Tools.Objects;assembly=AcManager.Tools" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:effects="clr-namespace:FirstFloor.ModernUI.Effects;assembly=FirstFloor.ModernUI" xmlns:c="clr-namespace:AcManager.Controls" xmlns:t="http://acstuff.club/app/tools" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Controls.UserControls.KunosCareerBlock" DataContextChanged="KunosCareerBlock_OnDataContextChanged">
  <UserControl.Styles><Style Selector="TextBlock.CodeStyle">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="UltraLight"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

      </UserControl.Styles><UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/SettingsSpecific.axaml"/>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <mui:ChainConverter x:Key="LowerCaseOrdinalizing">
        <mui:OrdinalizingConverter/>
        <mui:ToLowerConverter/>
      </mui:ChainConverter>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Height="100" IsVisible="{Binding Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='inverse, hidden'}">
    <!-- previed image -->
    <Grid DockPanel.Dock="Left" Background="{DynamicResource ThumbnailBackground}" Margin="0 0 24 0" Width="100" Height="100">
      <mui:BetterImage Filename="{Binding PreviewImage}" Stretch="UniformToFill" StretchDirection="DownOnly" Width="100" ToolTip.Tip="{Binding DisplayName}">
        <mui:BetterImage.Style>
          <Style Selector="mui|BetterImage">
            <Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding IsAvailable, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^:is(Control)[(pa|T.S0)=True]"><Setter Property="Effect">
                  <Setter.Value>
                    <effects:GrayscaleEffect x:Name="GrayscaleEffect" SaturationFactor="0"/>
                  </Setter.Value>
                </Setter>
              </Style></Style>
        </mui:BetterImage.Style>
      </mui:BetterImage>

      <Grid Opacity="0" Background="Transparent" Cursor="Hand" PointerReleased="OnClick" IsVisible="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid Background="#33000000">
          <Grid.Effect>
            <DropShadowEffect Opacity="1" BlurRadius="4" OffsetX="0" OffsetY="0"/>
          </Grid.Effect>

          <Ellipse StrokeThickness="2" Stroke="White" Fill="Transparent" Width="64" Height="64"/>
          <Path Data="{StaticResource InformationIconData}" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" Width="32" Stretch="Uniform" x:Name="InformationIcon"/>
        </Grid>
        <Grid.Triggers>
          <!-- PORT: removed EventTrigger -->
          <!-- PORT: removed EventTrigger -->
        </Grid.Triggers>
      </Grid>
    </Grid>

    <ContentPresenter x:Name="ButtonPresenter" DockPanel.Dock="Bottom" MinWidth="320"/>

    <!-- code -->
    <Grid DockPanel.Dock="Left" Margin="0 0 8 0">
      <mui:TextBlockAutoShrink Text="{Binding Code}" TextAlignment="Center" Width="64" VerticalAlignment="Center" IsVisible="{Binding Code, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="CodeStyle"/>
      <Border Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4 8" ToolTip.Tip="{Binding Type, Converter={StaticResource EnumToDescriptionConverter}}">
        <Path Data="{Binding Type, Converter={StaticResource KunosCareerTypeToIconConverter}}" Fill="{DynamicResource WindowText}" Stretch="Uniform">
          <Path.Effect>
            <DropShadowEffect Opacity="1" BlurRadius="3" OffsetX="0" OffsetY="0"/>
          </Path.Effect>
        </Path>
      </Border>
    </Grid>

    <StackPanel VerticalAlignment="Bottom">
      <!--name-->
      <TextBlock Text="{Binding DisplayName}" Margin="0 0 0 4" TextTrimming="CharacterEllipsis" Theme="{StaticResource Heading2}"/>

      <!--without errors-->
      <StackPanel Margin="0 0 0 4" IsVisible="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
        <!--not available-->
        <DockPanel Background="Transparent" IsVisible="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}" ToolTip.Tip="{x:Static c:ControlsStrings.KunosCareer_RequiredSeriesAreNotFinishedYet}">
          <Path Data="{StaticResource LockIconData}" Fill="{DynamicResource WindowText}" MaxHeight="10" Stretch="Uniform" DockPanel.Dock="Left"/>
          <TextBlock Text="{Binding DisplayRequired, StringFormat={x:Static c:ControlsStrings.KunosCareer_RequiredSeries}}" x:Name="LockTextBlock" Margin="4 0 0 0"/>
        </DockPanel>

        <!--available-->
        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" IsVisible="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel.Styles><Style Selector="DockPanel">
              <Setter Property="Margin" Value="0"/>
            </Style>
            <Style Selector="Ellipse">
              <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="4 0"/>
  <Setter Property="DockPanel.Dock" Value="Left"/>
            </Style>
          </StackPanel.Styles><!--completed events: 0/0-->
          <TextBlock Text="{x:Static c:ControlsStrings.KunosCareer_CompletedLabel}"/>
          <TextBlock FontWeight="Bold" Classes="inline1">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0}/{1}">
                <Binding Path="CompletedEvents"/>
                <Binding Path="EventsWrappers.Count"/>
              </MultiBinding>
            </TextBlock.Text>
            <TextBlock.Styles>
              <Style Selector="TextBlock.inline1">
                <Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding IsCompleted, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^:is(Control)[(pa|T.S1)=True]"><Setter Property="Foreground" Value="{DynamicResource Go}"/>
                  </Style></Style>
            </TextBlock.Styles>
          </TextBlock>

          <StackPanel Orientation="Horizontal" IsVisible="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static objects:KunosCareerObjectType.SingleEvents}}">
            <TextBlock Text=", "/>

            <DockPanel>
              <Ellipse Fill="{DynamicResource GoldBrush}"/>
              <TextBlock Text="{Binding FirstPlaces, StringFormat='{}{0}, '}" FontWeight="Bold"/>
            </DockPanel>

            <DockPanel>
              <Ellipse Fill="{DynamicResource SilverBrush}"/>
              <TextBlock Text="{Binding SecondPlaces, StringFormat='{}{0}, '}" FontWeight="Bold"/>
            </DockPanel>

            <DockPanel>
              <Ellipse Fill="{DynamicResource BronzeBrush}"/>
              <TextBlock Text="{Binding ThirdPlaces}" FontWeight="Bold"/>
            </DockPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static objects:KunosCareerObjectType.Championship}}">
            <TextBlock IsVisible="{Binding IsStarted, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Run Text=","/>
              <Run Text="{Binding ChampionshipPlace, Converter={StaticResource LowerCaseOrdinalizing}, Mode=OneWay}" FontWeight="Bold" Classes="inline2">
                <Run.Styles>
                  <Style Selector="Run.inline2">
                    <Style Selector="^"><Setter Property="pa:T.S2" Value="{Binding ChampionshipPlace, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=1}"/></Style><Style Selector="^:is(Control)[(pa|T.S2)=True]"><Setter Property="Foreground" Value="{DynamicResource Go}"/>
                      </Style></Style>
                </Run.Styles>
              </Run><Run Text=","/>
              <Run Text="{Binding ChampionshipPoints, Mode=OneWay}" FontWeight="Bold"/>
              <Run Text="{Binding ChampionshipPoints, Mode=OneWay, Converter={StaticResource PluralizingConverter}, ConverterParameter={x:Static t:ToolsStrings.KunosCareer_Point}}"/>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!--errors-->
      <DockPanel Margin="0 0 0 4" Background="Transparent" IsVisible="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ToolTip.Tip>
          <ToolTip>
            <ItemsControl ItemsSource="{Binding Errors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Message, StringFormat='{}• {0}'}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ToolTip>
        </ToolTip.Tip>
        <Path Data="{StaticResource AlertIconData}" MaxHeight="10" Stretch="Uniform" Fill="{DynamicResource Error}" DockPanel.Dock="Left"/>
        <TextBlock Margin="4 0 0 0" Text="{Binding Errors.Count, Converter={StaticResource PluralizingConverter}, ConverterParameter={x:Static c:ControlsStrings.KunosCareer_Error}}"/>
      </DockPanel>
    </StackPanel>
  </DockPanel>
</UserControl>