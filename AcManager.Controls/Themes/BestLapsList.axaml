<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="clr-namespace:AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Themes/ModernButton.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/LapTimesSpecific.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/AcItemWrapperSpecific.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="ac:BestLapsList" x:Key="{x:Type ac:BestLapsList}">
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ac:BestLapsList">
          <StackPanel Background="Transparent">
            <TextBlock Text="{x:Static t:ToolsStrings.BestLapsControl_BestLaps}" Margin="0 0 0 4" IsVisible="{TemplateBinding ShowTitle, Converter={StaticResource BooleanToVisibilityConverter}}" Theme="{StaticResource Label}"/>
            <mui:Switch x:Name="PART_Switch" Margin="{TemplateBinding EntryPadding}">
              <ProgressBar mui:Switch.When="-1" Height="2" IsIndeterminate="True" Margin="0 4 0 0"/>
              <TextBlock mui:Switch.When="0" FontStyle="Italic" Opacity="0.5" Text="{x:Static t:ToolsStrings.Common_None}">
              </TextBlock>
              <ItemsControl x:Name="PART_List" ItemsSource="{Binding Entries, RelativeSource={RelativeSource TemplatedParent}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Height="20" ContextMenu="{StaticResource BestLapWrappedContextMenu}">
                      <TextBlock DockPanel.Dock="Right" Width="80" Margin="4 0 0 0" TextAlignment="Right" Text="{Binding Entry.LapTime, Converter={StaticResource MillisecondsTimeSpanConverter}}"/>
                      <mui:PlaceholderTextBlock Text="{Binding Track.LayoutName}" Placeholder="{Binding Entry.TrackId}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </mui:Switch>
          </StackPanel>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^ /template/ mui|Switch#PART_Switch"><Setter Property="Value" Value="{Binding Entries.Count, RelativeSource={RelativeSource TemplatedParent}}"/></Style><Style Selector="^[SingleEntryMode=True]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (1 triggers) --><ControlTemplate TargetType="ac:BestLapsList">
              <DockPanel Background="Transparent">
                <mui:Switch x:Name="PART_Switch" Value="{Binding Entries.Count, RelativeSource={RelativeSource TemplatedParent}}" DockPanel.Dock="Right" Width="80" Margin="8 0 0 0">
                  <ProgressBar mui:Switch.When="-1" Height="2" IsIndeterminate="True" VerticalAlignment="Center"/>
                  <TextBlock mui:Switch.When="0" FontStyle="Italic" Opacity="0.5" TextAlignment="Right" Text="{x:Static t:ToolsStrings.Common_None}">
                  </TextBlock>
                  <mui:Cell DataContext="{Binding Entries[0], RelativeSource={RelativeSource TemplatedParent}}" ContextMenu="{StaticResource BestLapWrappedContextMenu}">
                    <TextBlock Text="{Binding Entry.LapTime, Converter={StaticResource MillisecondsTimeSpanConverter}}" TextAlignment="Right"/>
                  </mui:Cell>
                </mui:Switch>
                <TextBlock Text="{x:Static t:ToolsStrings.BestLapsControl_BestLap}" IsVisible="{TemplateBinding ShowTitle, Converter={StaticResource BooleanToVisibilityConverter}}" Theme="{StaticResource Label}"/>
              </DockPanel>
              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[Loading=True] /template/ mui|Switch#PART_Switch"><Setter Property="Value" Value="-1"/>
            </Style><Style Selector="^[CarId=null] /template/ ItemsControl#PART_List"><Setter Property="ItemTemplate">
                <Setter.Value>
                  <DataTemplate DataType="t:LapTimeWrapped">
                    <DockPanel Height="20" ContextMenu="{StaticResource BestLapWrappedContextMenu}" Background="Transparent" ac:ToolTips.Car="{Binding Car}" ac:ContextMenus.Car="{Binding Car}" mui:Draggable.Data="{Binding Car}">
                      <TextBlock DockPanel.Dock="Right" Width="80" Margin="4 0 0 0" TextAlignment="Right" Text="{Binding Entry.LapTime, Converter={StaticResource MillisecondsTimeSpanConverter}}"/>
                      <mui:BetterImage DockPanel.Dock="Left" Filename="{Binding Car.BrandBadge}" Width="16" Height="16" Margin="0 0 8 0" ClearOnChange="True"/>
                      <mui:PlaceholderTextBlock Text="{Binding Car.DisplayName}" Placeholder="{Binding Entry.CarId}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style></ControlTheme>
</ResourceDictionary>