<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="clr-namespace:AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/Converters.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="ac:StatEntry" x:Key="{x:Type ac:StatEntry}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ac:StatEntry">
          <Border Background="{DynamicResource CardBackground}" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Padding="8" Width="181" Height="181" Margin="0 0 0 10">
            <mui:Cell>

              <!--<mui:ReferenceSwitch Value="{TemplateBinding TrackId}">
                <mui:ReferenceSwitch.NonNull>
                  <mui:Cell DataContext="{TemplateBinding TrackId, Converter={StaticResource TrackIdToTrackWrapperConverter}}">
                    <Border Opacity="0.2" ClipToBounds="True" Background="{DynamicResource WindowBackground}" Margin="-8">
                      <Border.Effect>
                        <BlurEffect Radius="20" RenderingBias="Performance" KernelType="Gaussian" />
                      </Border.Effect>
                      <mui:BetterImage Margin="-20" Stretch="UniformToFill" Filename="{Binding Value.PreviewImage}" ClearOnChange="True" />
                    </Border>
                  </mui:Cell>
                </mui:ReferenceSwitch.NonNull>
              </mui:ReferenceSwitch>-->

              <DockPanel>
                <mui:ReferenceSwitch Value="{TemplateBinding CarId}" DockPanel.Dock="Top" Height="80">
                  <mui:ReferenceSwitch.NonNull>
                    <Border DataContext="{TemplateBinding CarId, Converter={StaticResource CarIdToCarWrapperConverter}}">
                      <mui:Cell DataContext="{Binding Value}" Background="Transparent" ac:ToolTips.Car="{Binding}" ac:ContextMenus.Car="{Binding}" mui:Draggable.Data="{Binding}">
                        <mui:BetterImage Filename="{Binding SelectedSkinLazy.Value.PreviewImage}" HideIfNull="True" Margin="0 8 0 0"/>
                        <TextBlock Padding="4" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="{DynamicResource CardHeaderBackground}" Text="{Binding DisplayName}" Foreground="{DynamicResource CardHeaderText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Classes="Small"/>
                      </mui:Cell>
                    </Border>
                  </mui:ReferenceSwitch.NonNull>
                  <mui:ReferenceSwitch.Null>
                    <mui:ReferenceSwitch Value="{TemplateBinding TrackId}">
                      <mui:ReferenceSwitch.NonNull>
                        <Border DataContext="{TemplateBinding TrackId, Converter={StaticResource TrackIdToTrackWrapperConverter}}">
                          <mui:Cell DataContext="{Binding Value}" Background="Transparent" ac:ToolTips.Track="{Binding}" ac:ContextMenus.Track="{Binding}" mui:Draggable.Data="{Binding}">
                            <mui:BetterImage Filename="{Binding OutlineImage}" Margin="0 20 0 0" Effect="{DynamicResource TrackOutlineAloneEffect}"/>
                            <TextBlock Padding="4" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="{DynamicResource CardHeaderBackground}" Text="{Binding Name}" Foreground="{DynamicResource CardHeaderText}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Classes="Small"/>
                          </mui:Cell>
                        </Border>
                      </mui:ReferenceSwitch.NonNull>
                      <mui:ReferenceSwitch.Null>
                        <Path Data="{TemplateBinding Icon}" Fill="{DynamicResource WindowText}" Height="64" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 8 0 0"/>
                      </mui:ReferenceSwitch.Null>
                    </mui:ReferenceSwitch>
                  </mui:ReferenceSwitch.Null>
                </mui:ReferenceSwitch>

                <Viewbox Margin="0 8 0 0" DockPanel.Dock="Top" Height="40" StretchDirection="DownOnly">
                  <mui:ReferenceSwitch Value="{TemplateBinding ValueUnits}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mui:ReferenceSwitch.NonNull>
                      <DockPanel HorizontalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Value}" DockPanel.Dock="Left" VerticalAlignment="Center" Classes="Heading1"/>
                        <TextBlock Text="{TemplateBinding ValueUnits}" FontSize="18" Margin="6 0 0 4" VerticalAlignment="Bottom" Classes="Heading1"/>
                      </DockPanel>
                    </mui:ReferenceSwitch.NonNull>
                    <mui:ReferenceSwitch.Null>
                      <TextBlock Text="{TemplateBinding Value}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200" Classes="Heading1"/>
                    </mui:ReferenceSwitch.Null>
                  </mui:ReferenceSwitch>
                </Viewbox>

                <TextBlock Text="{TemplateBinding Title, Converter={StaticResource ToTitleConverter}}" Foreground="{DynamicResource Accent}" Margin="0 8 0 0" TextAlignment="Center" DockPanel.Dock="Top" Classes="Heading2"/>
              </DockPanel>

            </mui:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>