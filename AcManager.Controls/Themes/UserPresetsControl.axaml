<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="clr-namespace:AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/ButtonWithComboBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="ac:UserPresetsControl" x:Key="{x:Type ac:UserPresetsControl}">
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
    <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinWidth" Value="100"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ac:UserPresetsControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <mui:HierarchicalComboBox x:Name="PART_ComboBox" ItemsSource="{TemplateBinding SavedPresetsGrouped}" FixedMode="False">
              <mui:HierarchicalComboBox.SelectedContent>
                <DataTemplate>
                  <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Normal" Text="{Binding CurrentUserPreset.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ac:UserPresetsControl}}}"/>
                </DataTemplate>
              </mui:HierarchicalComboBox.SelectedContent>
            </mui:HierarchicalComboBox>
            <Button Command="{Binding SaveCommand, RelativeSource={RelativeSource TemplatedParent}, Mode=OneTime}" Grid.Column="1" Margin="4 0 0 0" Content="{x:Static ac:ControlsStrings.Presets_Save}" IsVisible="{TemplateBinding ShowSaveButton, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip.Tip="{x:Static ac:ControlsStrings.Presets_Save_Tooltip}"/>
          </Grid>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[ShowSaveButton=True]"><Setter Property="MinWidth" Value="250"/>
      </Style><Style Selector="^[Changed=True] /template/ mui|HierarchicalComboBox#PART_ComboBox"><Setter Property="SelectedContent">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Italic" Text="{Binding CurrentUserPreset.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ac:UserPresetsControl}}}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style><Style Selector="^[CurrentUserPreset=null] /template/ mui|HierarchicalComboBox#PART_ComboBox"><Setter Property="SelectedContent">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Italic" Text="{x:Static ac:ControlsStrings.Presets_Unsaved}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style></ControlTheme>
</ResourceDictionary>