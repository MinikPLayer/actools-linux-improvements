<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
    <!-- PORT: removed include of SelectableBbCodeBlock -->
    <ResourceInclude Source="avares://AcManager.Controls/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/AcItemWrapperSpecific.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Themes/GraphDataViewer.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!--<RichTextBox x:Key="CarBlock.Description" Margin="0 8 0 0" Style="{StaticResource RichTextBox.Small}" />-->

  <ControlTheme TargetType="c:CarBlock" x:Key="{x:Type c:CarBlock}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:CarBlock">
          <!-- Data section -->
          <ScrollViewer DataContext="{Binding Car, RelativeSource={RelativeSource TemplatedParent}}" Margin="0 8 -8 0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" mui:FancyScroll.Outside="True" Padding="0 0 8 0" Background="{TemplateBinding Background}" IsVisible="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
              <!-- Tags -->
              <mui:TagsList x:Name="PART_TagsList" ItemsSource="{Binding Tags}" IsReadOnly="True" DockPanel.Dock="Top" Margin="0 0 0 8"/>

              <StackPanel DockPanel.Dock="Right" Margin="20 0 0 0" Width="240" IsVisible="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type DockPanel}}, Converter={StaticResource MoreToVisibilityConverter}, ConverterParameter=640}">
                <c:PropertiesGrid Columns="1" LabelPadding="0 1 0 0" LabelWidth="100" VerticalSpacing="4">
                  <c:RatingBar c:PropertiesGrid.Label="Rating:" Rating="{Binding Rating}" HorizontalAlignment="Left"/>
                  <c:NotesBlock c:PropertiesGrid.Label="Notes:" AcObject="{Binding}"/>
                  <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Total driven:" Placeholder="…" Text="{Binding TotalDrivenDistanceKm, Converter={StaticResource MultiplyConverter}, ConverterParameter={x:Static t:SettingsHolder+CommonSettings.DistanceMultiplier}, StringFormat={x:Static t:SettingsHolder+CommonSettings.DistanceFormat}}"/>
                  <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Speed achieved:" Placeholder="…" Text="{Binding MaxSpeedAchieved, Converter={StaticResource MultiplyConverter}, ConverterParameter={x:Static t:SettingsHolder+CommonSettings.DistanceMultiplier}, StringFormat={x:Static t:SettingsHolder+CommonSettings.SpeedFormat}}" IsVisible="{Binding MaxSpeedAchieved, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='≠0'}"/>
                  <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Steer lock:" Placeholder="…" Text="{Binding SteerLock, StringFormat='{}{0:F0}°'}" IsVisible="{Binding DisplaySteerLock, Converter={StaticResource BooleanToVisibilityConverter}, Source={x:Static t:SettingsHolder.Content}}"/>
                </c:PropertiesGrid>
                <c:BestLapsList CarId="{Binding Id}" Margin="0 7 0 0" Limit="10"/>
              </StackPanel>

              <StackPanel>
                <Grid Margin="0 0 8 0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- First row -->
                  <DockPanel x:Name="PART_BrandArea" Background="Transparent" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
                    <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarBrandLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                    <mui:PlaceholderTextBlock Text="{Binding Brand}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>

                  <DockPanel x:Name="PART_CountryArea" Background="Transparent" Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Static c:ControlsStrings.AcObject_ContryLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                    <c:CountryIcon Country="{Binding Country}" HorizontalAlignment="Right" Width="24" Height="16" DockPanel.Dock="Right" Margin="4 -6 0 0" VerticalAlignment="Bottom" RenderOptions.BitmapInterpolationMode="LowQuality"/>
                    <mui:PlaceholderTextBlock Text="{Binding Country}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>

                  <!-- Second row -->
                  <DockPanel x:Name="PART_ClassArea" Background="Transparent" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarClassLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                    <mui:PlaceholderTextBlock Text="{Binding CarClass}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>

                  <DockPanel x:Name="PART_YearArea" Background="Transparent" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock Text="{x:Static c:ControlsStrings.AcObject_YearLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                    <mui:PlaceholderTextBlock Text="{Binding Year, TargetNullValue=''}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>

                  <!-- Third row -->
                  <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarParentLabel}" Grid.Column="0" Grid.Row="2" Classes="Label Label.Padding"/>
                  <TextBlock Grid.Column="2" Grid.Row="2" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_Author_Tooltip}" Classes="Label Label.Padding">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource AuthorVersionUrlToLabelConverter}">
                        <Binding Path="Author"/>
                        <Binding Path="Version"/>
                        <Binding Path="Url"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>

                  <mui:PlaceholderTextBlock Text="{Binding ParentDisplayName}" Placeholder="{x:Static t:ToolsStrings.Common_None}" Grid.Column="1" Grid.Row="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  <mui:BbCodeBlock Text="{Binding VersionInfoDisplay}" Placeholder="?" Grid.Column="3" Grid.Row="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                  <!-- Last row -->
                  <TextBlock Text="{x:Static c:ControlsStrings.AcObject_SpecsLabel}" Grid.Column="0" Grid.Row="3" Classes="Label Label.Padding"/>
                  <mui:PlaceholderTextBlock Text="{Binding SpecsInfoDisplay}" Placeholder="?" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border x:Name="PART_Footer"/>
              </StackPanel>
            </DockPanel>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[ShowSkinsAndPreview=True]"><Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="c:CarBlock">
              <DockPanel Background="{TemplateBinding Background}">
                <mui:Cell DockPanel.Dock="Top" MaxWidth="1022">
                  <mui:BetterImage x:Name="PART_PreviewImage" Filename="{Binding SelectedSkin.PreviewImage, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.5626223}" MaxWidth="1022" c:ContextMenus.Car="{Binding Car, RelativeSource={RelativeSource TemplatedParent}}"/>
                  <ListBox ItemsSource="{Binding Car.EnabledSkinsListView, RelativeSource={RelativeSource TemplatedParent}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="4" SelectedItem="{Binding SelectedSkin, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Top" MaxHeight="76" BorderThickness="0" ItemTemplate="{StaticResource CarSkinItemTemplate}" IsVisible="{Binding SelectSkin, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <mui:VirtualizingTilePanel ItemWidth="36" ItemHeight="36" Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
                  <ContentPresenter Content="{TemplateBinding PreviewContent}"/>
                  <mui:ModernButton x:Name="PART_ShowroomButton" IconData="{StaticResource CarShowroomIconData}" EllipseDiameter="52" EllipseStrokeThickness="2" IconWidth="32" IconHeight="32" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </mui:Cell>

                <!-- Data section -->
                <ScrollViewer DataContext="{Binding Car, RelativeSource={RelativeSource TemplatedParent}}" Margin="0 8 -8 0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" mui:FancyScroll.Outside="True" Padding="0 0 8 0" IsVisible="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <DockPanel>
                    <!-- Tags -->
                    <mui:TagsList x:Name="PART_TagsList" ItemsSource="{Binding Tags}" IsReadOnly="True" DockPanel.Dock="Top" Margin="0 0 0 8"/>

                    <StackPanel DockPanel.Dock="Right" Margin="20 0 0 0" Width="240" IsVisible="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type DockPanel}}, Converter={StaticResource MoreToVisibilityConverter}, ConverterParameter=640}">
                      <c:PropertiesGrid Columns="1" LabelPadding="0 1 0 0" LabelWidth="100" VerticalSpacing="4">
                        <c:RatingBar c:PropertiesGrid.Label="Rating:" Rating="{Binding Rating}" HorizontalAlignment="Left"/>
                        <c:NotesBlock AcObject="{Binding}" c:PropertiesGrid.Label="Notes:"/>
                        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Total driven:" Placeholder="…" Text="{Binding TotalDrivenDistanceKm, Converter={StaticResource MultiplyConverter}, ConverterParameter={x:Static t:SettingsHolder+CommonSettings.DistanceMultiplier}, StringFormat={x:Static t:SettingsHolder+CommonSettings.DistanceFormat}}"/>
                        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Speed achieved:" Placeholder="…" Text="{Binding MaxSpeedAchieved, Converter={StaticResource MultiplyConverter}, ConverterParameter={x:Static t:SettingsHolder+CommonSettings.DistanceMultiplier}, StringFormat={x:Static t:SettingsHolder+CommonSettings.SpeedFormat}}" IsVisible="{Binding MaxSpeedAchieved, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='≠0'}"/>
                        <mui:PlaceholderTextBlock c:PropertiesGrid.Label="Steer lock:" Placeholder="…" Text="{Binding SteerLock, StringFormat='{}{0:F0}°'}" IsVisible="{Binding DisplaySteerLock, Converter={StaticResource BooleanToVisibilityConverter}, Source={x:Static t:SettingsHolder.Content}}"/>
                      </c:PropertiesGrid>
                      <c:BestLapsList CarId="{Binding Id}" Margin="0 7 0 0" Limit="10"/>
                    </StackPanel>

                    <StackPanel>
                      <Grid Margin="0 0 8 0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- First row -->
                        <DockPanel x:Name="PART_BrandArea" Background="Transparent" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
                          <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarBrandLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                          <mui:PlaceholderTextBlock Text="{Binding Brand}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <DockPanel x:Name="PART_CountryArea" Background="Transparent" Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                          <TextBlock Text="{x:Static c:ControlsStrings.AcObject_ContryLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                          <c:CountryIcon Country="{Binding Country}" HorizontalAlignment="Right" Width="24" Height="16" DockPanel.Dock="Right" Margin="4 -6 0 0" VerticalAlignment="Bottom" RenderOptions.BitmapInterpolationMode="LowQuality"/>
                          <mui:PlaceholderTextBlock Text="{Binding Country}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!-- Second row -->
                        <DockPanel x:Name="PART_ClassArea" Background="Transparent" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
                          <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarClassLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                          <mui:PlaceholderTextBlock Text="{Binding CarClass}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <DockPanel x:Name="PART_YearArea" Background="Transparent" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2">
                          <TextBlock Text="{x:Static c:ControlsStrings.AcObject_YearLabel}" Width="80" DockPanel.Dock="Left" Classes="Label Label.Padding"/>
                          <mui:PlaceholderTextBlock Text="{Binding Year, TargetNullValue=''}" Placeholder="?" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!-- Third row -->
                        <TextBlock Text="{x:Static c:ControlsStrings.AcObject_CarParentLabel}" Grid.Column="0" Grid.Row="2" Classes="Label Label.Padding"/>
                        <TextBlock Grid.Column="2" Grid.Row="2" ToolTip.Tip="{x:Static c:ControlsStrings.AcObject_Author_Tooltip}" Classes="Label Label.Padding">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource AuthorVersionUrlToLabelConverter}">
                              <Binding Path="Author"/>
                              <Binding Path="Version"/>
                              <Binding Path="Url"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>

                        <mui:PlaceholderTextBlock Text="{Binding ParentDisplayName}" Placeholder="{x:Static t:ToolsStrings.Common_None}" Grid.Column="1" Grid.Row="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <mui:BbCodeBlock Text="{Binding VersionInfoDisplay}" Placeholder="?" Grid.Column="3" Grid.Row="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                        <!-- Last row -->
                        <TextBlock Text="{x:Static c:ControlsStrings.AcObject_SpecsLabel}" Grid.Column="0" Grid.Row="3" Classes="Label Label.Padding"/>
                        <mui:PlaceholderTextBlock Text="{Binding SpecsInfoDisplay}" Placeholder="?" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </Grid>

                      <Border x:Name="PART_Footer"/>
                    </StackPanel>
                  </DockPanel>
                </ScrollViewer>
              </DockPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style></ControlTheme>
</ResourceDictionary>