<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ac="clr-namespace:AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/ButtonWithComboBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/BetterTextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/Converters.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="ac:TemperatureValueLabel" x:Key="{x:Type ac:TemperatureValueLabel}">
    <Setter Property="Margin" Value="0 0 0 4"/>
    <Setter Property="Padding" Value="8 0 0 0"/>
    <Setter Property="mui:BetterTextBox.Mode" Value="Number"/>
    <Setter Property="Postfix" Value="{x:Static ac:ControlsStrings.Common_CelsiusPostfix}"/>
    <Setter Property="FahrenheitPostfix" Value="{x:Static ac:ControlsStrings.Common_FahrenheitPostfix}"/>
    <Setter Property="Mode" Value="{Binding TemperatureUnitMode, Source={x:Static t:SettingsHolder.Common}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ac:TemperatureValueLabel">
          <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
            <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
            <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
            <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
            <TextBlock x:Name="PART_Postfix" Text="{TemplateBinding Postfix}" Classes="Label"/>
          </StackPanel>

          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[Mode=Fahrenheit]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (4 triggers) --><ControlTemplate TargetType="ac:TemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding Value, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{TemplateBinding FahrenheitPostfix}" Classes="Label"/>
              </StackPanel>

              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[Mode=Both]"><Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ac:TemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{Binding Postfix, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}, '}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox_F" Text="{Binding Value, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix_F" Text="{TemplateBinding FahrenheitPostfix}" Classes="Label"/>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding Prefix, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S1" Value="{Binding Postfix, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S0)=True] /template/ TextBlock#PART_Prefix"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S1)=True] /template/ TextBlock#PART_Postfix"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[ShowPostfix=False] /template/ TextBlock#PART_Postfix"><Setter Property="IsVisible" Value="False"/>
            </Style><!-- PORT: DataTrigger with element binding not converted --></ControlTheme>

  <ControlTheme TargetType="ac:DoubleTemperatureValueLabel" x:Key="{x:Type ac:DoubleTemperatureValueLabel}">
    <Setter Property="Margin" Value="0 0 0 4"/>
    <Setter Property="Padding" Value="8 0 0 0"/>
    <Setter Property="mui:BetterTextBox.Mode" Value="Number"/>
    <Setter Property="Postfix" Value="{x:Static ac:ControlsStrings.Common_CelsiusPostfix}"/>
    <Setter Property="FahrenheitPostfix" Value="{x:Static ac:ControlsStrings.Common_FahrenheitPostfix}"/>
    <Setter Property="Mode" Value="{Binding TemperatureUnitMode, Source={x:Static t:SettingsHolder.Common}}"/>
    <Setter Property="Separator" Value="–"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ac:DoubleTemperatureValueLabel">
          <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
            <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
            <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
            <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding Value, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
            <TextBlock x:Name="PART_Separator" Text="{TemplateBinding Separator}" Classes="Label"/>
            <mui:BetterTextBox x:Name="PART_TextBox2" Text="{Binding SecondValue, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
            <TextBlock x:Name="PART_Postfix" Text="{TemplateBinding Postfix}" Classes="Label"/>
          </StackPanel>

          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[Mode=Fahrenheit]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (5 triggers) --><ControlTemplate TargetType="ac:DoubleTemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding Value, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator" Text="{TemplateBinding Separator}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2" Text="{Binding SecondValue, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{TemplateBinding FahrenheitPostfix}" Classes="Label"/>
              </StackPanel>

              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[Mode=Both]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (1 triggers) --><ControlTemplate TargetType="ac:DoubleTemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>

                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding Value, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator" Text="{TemplateBinding Separator}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2" Text="{Binding SecondValue, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{Binding Postfix, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}, '}" Classes="Label"/>

                <mui:BetterTextBox x:Name="PART_TextBox_F" Text="{Binding Value, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator_F" Text="{TemplateBinding Separator}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2_F" Text="{Binding SecondValue, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix_F" Text="{TemplateBinding FahrenheitPostfix}" Classes="Label"/>
              </StackPanel>

              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[RelativeRange=True]"><Style Selector="^[Mode=Celsius]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (5 triggers) --><ControlTemplate TargetType="ac:DoubleTemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding RelativeRangeBase, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator" Text="±" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2" Text="{Binding RelativeRangeHalf, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{TemplateBinding Postfix}" Classes="Label"/>
              </StackPanel>

              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[Mode=Fahrenheit]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (5 triggers) --><ControlTemplate TargetType="ac:DoubleTemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding RelativeRangeBase, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator" Text="±" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2" Text="{Binding RelativeRangeHalf, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, ConverterParameter=relative, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{TemplateBinding FahrenheitPostfix}" Classes="Label"/>
              </StackPanel>

              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[Mode=Both]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (1 triggers) --><ControlTemplate TargetType="ac:DoubleTemperatureValueLabel">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, StringFormat={x:Static mui:UiStrings.ValueLabel_Format}}" IsVisible="{TemplateBinding Content, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}" Classes="Label"/>
                <TextBlock x:Name="PART_Prefix" Text="{TemplateBinding Prefix}" Classes="Label"/>

                <mui:BetterTextBox x:Name="PART_TextBox" Text="{Binding RelativeRangeBase, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator" Text="±" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2" Text="{Binding RelativeRangeHalf, StringFormat='{}{0:F1}', RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix" Text="{Binding Postfix, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}, '}" Classes="Label"/>

                <mui:BetterTextBox x:Name="PART_TextBox_F" Text="{Binding RelativeRangeBase, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Separator_F" Text="±" Classes="Label"/>
                <mui:BetterTextBox x:Name="PART_TextBox2_F" Text="{Binding RelativeRangeHalf, StringFormat='{}{0:F1}', Converter={StaticResource TemperatureToFahrenheitConverter}, ConverterParameter=relative, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Theme="{StaticResource Borderless.Label}"/>
                <TextBlock x:Name="PART_Postfix_F" Text="{TemplateBinding FahrenheitPostfix}" Classes="Label"/>
              </StackPanel>

              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style></Style><Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding Prefix, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S4" Value="{Binding Postfix, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S3)=True] /template/ TextBlock#PART_Prefix"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S4)=True] /template/ TextBlock#PART_Postfix"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[ShowPostfix=False] /template/ TextBlock#PART_Postfix"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[JoinIfEqual=True]"><Style Selector="^[ValuesEqual=True] /template/ TextBlock#PART_Separator"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[ValuesEqual=True] /template/ mui|BetterTextBox#PART_TextBox2"><Setter Property="IsVisible" Value="False"/>
            </Style></Style><!-- PORT: DataTrigger with element binding not converted --></ControlTheme>
</ResourceDictionary>