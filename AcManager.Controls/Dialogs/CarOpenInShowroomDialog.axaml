<mui:ModernDialog xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:c="clr-namespace:AcManager.Controls" xmlns:di="clr-namespace:AcManager.Controls.Dialogs" xmlns:helpers="clr-namespace:AcManager.Controls.Helpers" xmlns:t="http://acstuff.club/app/tools" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI" x:Class="AcManager.Controls.Dialogs.CarOpenInShowroomDialog" Title="{x:Static c:ControlsStrings.Showroom_DialogHeader}" Closing="OnClosing" x:Name="This">
  <mui:ModernDialog.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AcManager.Controls/Assets/AcItemWrapperSpecific.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </mui:ModernDialog.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*"/>
      <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
      <RowDefinition/>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0 0 8 8" Grid.Row="0" Grid.Column="0">
      <TextBlock Text="{x:Static c:ControlsStrings.Showroom_ShowroomLabel}" Margin="0 0 0 4" Classes="Label Label.Padding"/>
      <ComboBox Margin="4 0 4 0" ItemsSource="{Binding Showrooms}" SelectedItem="{Binding SelectedShowroom}">
        <ComboBox.Styles>
          <Style Selector="ComboBoxItem">
            <Setter Property="ToolTip.Tip" Value="{StaticResource ShowroomPreviewToolTip}"/>
          </Style>
        </ComboBox.Styles>
      </ComboBox>
    </StackPanel>

    <StackPanel Margin="0 0 8 8" Grid.Row="1" Grid.Column="0">
      <TextBlock Text="{x:Static c:ControlsStrings.Common_FilterLabel}" Margin="0 0 0 4" Classes="Label Label.Padding"/>
      <ComboBox Margin="4 0 4 0" SelectedItem="{Binding SelectedFilter}" ItemsSource="{Binding Filters}"/>
    </StackPanel>

    <StackPanel Margin="0 0 8 8" Grid.Row="2" Grid.Column="0">
      <TextBlock Text="Video settings:" Margin="0 0 0 4" Classes="Label Label.Padding"/>
      <mui:HierarchicalComboBox ItemsSource="{Binding VideoPresets}" SelectedItem="{Binding SelectedVideoPreset}" FixedMode="False" Margin="4 0 4 0">
        <mui:HierarchicalComboBox.SelectedContent>
          <DataTemplate>
            <TextBlock x:Name="TextBlock"><TextBlock.Styles><Style Selector="TextBlock#TextBlock"><Style Selector="^ TextBlock#TextBlock"><Setter Property="Text" Value="{Binding DataContext.DisplayVideoPreset, ElementName=This}"/></Style><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding DataContext.VideoPresetFilename, ElementName=This, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S0)=True] TextBlock#TextBlock"><Setter Property="Text" Value="Default"/>
                <Setter Property="FontStyle" Value="Italic"/>
              </Style></Style></TextBlock.Styles></TextBlock>
            </DataTemplate>
        </mui:HierarchicalComboBox.SelectedContent>
      </mui:HierarchicalComboBox>
    </StackPanel>

    <StackPanel Margin="0 0 8 8" Grid.Row="0" Grid.Column="1">
      <TextBlock Text="{x:Static c:ControlsStrings.Showroom_FovLabel}" Margin="0 0 0 4" Classes="Label Label.Padding"/>
      <mui:BetterTextBox Margin="4 0 4 0" Text="{Binding CameraFov}" Mode="Number"/>
    </StackPanel>

    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DisableWatermark}" Margin="8 0 0 0" ToolTip.Tip="{x:Static c:ControlsStrings.Showroom_HideWatermark_Tooltip}">
      <Label Content="{x:Static c:ControlsStrings.Showroom_HideWatermark}"/>
    </CheckBox>

    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding DisableSweetFx}" Margin="8 0 0 0" ToolTip.Tip="{x:Static c:ControlsStrings.Showroom_DisableSweetFx_Tooltip}">
      <Label Content="{x:Static c:ControlsStrings.Showroom_DisableSweetFx}"/>
    </CheckBox>

    <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding UseCspShowroom}" Margin="8 0 0 0" helpers:FeatureIsAvailable.Feature="{x:Static t:PatchHelper.FeatureHasShowroomMode}" ToolTip.Tip="Requires CSP v0.1.78 or newer">
      <Label Content="Use CSP showroom"/>
    </CheckBox>
  </Grid>

  <mui:ModernDialog.ButtonsRowContent>
    <c:UserPresetsControl UserPresetable="{Binding}"/>
  </mui:ModernDialog.ButtonsRowContent>
</mui:ModernDialog>