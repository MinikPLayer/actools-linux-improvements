<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Controls of the app, on top of Avalonia. Uses glob patterns for sources (see FirstFloor.ModernUI.csproj);
    sources which are not ported yet are listed in Deferred.props.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AcManager.Controls</RootNamespace>
    <AssemblyName>AcManager.Controls</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>4</WarningLevel>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\Output\$(Platform)\Debug\</OutputPath>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\$(Platform)\Release\</OutputPath>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <Import Project="..\Build\AvaloniaCompat.props" />
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.3.0.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="OxyPlot.Avalonia" Version="2.1.0-Avalonia11" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <ProjectReference Include="..\AcManager.Internal.Stub\AcManager.Internal.Stub.csproj" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\Libraries\Newtonsoft.Json\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>..\packages\MoonSharp.2.0.0.0\lib\net40-client\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AcManager.LargeFilesSharing\AcManager.LargeFilesSharing.csproj" />
    <ProjectReference Include="..\AcManager.Tools\AcManager.Tools.csproj" />
    <ProjectReference Include="..\AcManager.Workshop\AcManager.Workshop.csproj" />
    <ProjectReference Include="..\AcTools.LapTimes\AcTools.LapTimes.csproj" />
    <ProjectReference Include="..\AcTools.Render\AcTools.Render.csproj" />
    <ProjectReference Include="..\AcTools\AcTools.csproj" />
    <ProjectReference Include="..\FirstFloor.ModernUI\FirstFloor.ModernUI.csproj" />
    <ProjectReference Include="..\LicensePlates\LicensePlates.csproj" />
    <ProjectReference Include="..\StringBasedFilter\StringBasedFilter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <EmbeddedResource Include="**\*.resx" Exclude="obj\**;bin\**" />
    <AvaloniaXaml Include="**\*.axaml" Exclude="obj\**;bin\**" />
    <AvaloniaResource Include="Assets\Background.jpg" />
  </ItemGroup>
  <Import Project="Deferred.props" />
</Project>
