<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:AcManager.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://AcManager.Controls/Themes/UserPresetsControl.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="UserPresetsControl.Compact.Share" TargetType="c:UserPresetsControl">
    <Setter Property="Width" Value="210"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:UserPresetsControl">
          <DockPanel>
            <mui:SpacingUniformGrid HorizontalSpacing="4" Rows="1" DockPanel.Dock="Bottom" Margin="0 4 0 0" Height="24">
              <Button Command="{Binding SaveCommand, RelativeSource={RelativeSource TemplatedParent}, Mode=OneTime}" Content="{x:Static c:ControlsStrings.Presets_Save}" Padding="4 2 4 3" IsVisible="{TemplateBinding ShowSaveButton, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip.Tip="{x:Static c:ControlsStrings.Presets_Save_Tooltip}"/>
              <Button Command="{TemplateBinding Tag}" Content="Share link" Padding="4 2 4 3"/>
            </mui:SpacingUniformGrid>
            <mui:HierarchicalComboBox x:Name="PART_ComboBox" ItemsSource="{TemplateBinding SavedPresetsGrouped}" FixedMode="False" Height="24">
              <mui:HierarchicalComboBox.SelectedContent>
                <DataTemplate>
                  <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Normal" Text="{Binding CurrentUserPreset.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type c:UserPresetsControl}}}"/>
                </DataTemplate>
              </mui:HierarchicalComboBox.SelectedContent>
            </mui:HierarchicalComboBox>
          </DockPanel>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[ShowSaveButton=True]"><Setter Property="MinWidth" Value="100"/>
      </Style><Style Selector="^[Changed=True] /template/ mui|HierarchicalComboBox#PART_ComboBox"><Setter Property="SelectedContent">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Italic" Text="{Binding CurrentUserPreset.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type c:UserPresetsControl}}}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding CurrentUserPreset, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S0)=True] /template/ mui|HierarchicalComboBox#PART_ComboBox"><Setter Property="SelectedContent">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Italic" Text="{x:Static c:ControlsStrings.Presets_Unsaved}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style></ControlTheme>

  <ControlTheme x:Key="UserPresetsControl.Compact" TargetType="c:UserPresetsControl">
    <Setter Property="Width" Value="200"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:UserPresetsControl">
          <DockPanel>
            <mui:SpacingUniformGrid HorizontalSpacing="4" Rows="1" DockPanel.Dock="Bottom" Margin="0 4 0 0" Height="24">
              <Button Command="{Binding SaveCommand, RelativeSource={RelativeSource TemplatedParent}, Mode=OneTime}" Content="{x:Static c:ControlsStrings.Presets_Save}" Padding="4 2 4 3" IsVisible="{TemplateBinding ShowSaveButton, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip.Tip="{x:Static c:ControlsStrings.Presets_Save_Tooltip}"/>
              <!--<Button Command="{Binding Settings.ShareCommand}" Content="Share link" Padding="4 2 4 3" />-->
            </mui:SpacingUniformGrid>
            <mui:HierarchicalComboBox x:Name="PART_ComboBox" ItemsSource="{TemplateBinding SavedPresetsGrouped}" FixedMode="False" Height="24">
              <mui:HierarchicalComboBox.SelectedContent>
                <DataTemplate>
                  <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Normal" Text="{Binding CurrentUserPreset.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type c:UserPresetsControl}}}"/>
                </DataTemplate>
              </mui:HierarchicalComboBox.SelectedContent>
            </mui:HierarchicalComboBox>
          </DockPanel>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[ShowSaveButton=True]"><Setter Property="MinWidth" Value="100"/>
      </Style><Style Selector="^[Changed=True] /template/ mui|HierarchicalComboBox#PART_ComboBox"><Setter Property="SelectedContent">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Italic" Text="{Binding CurrentUserPreset.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type c:UserPresetsControl}}}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding CurrentUserPreset, RelativeSource={RelativeSource Self}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S1)=True] /template/ mui|HierarchicalComboBox#PART_ComboBox"><Setter Property="SelectedContent">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontStyle="Italic" Text="{x:Static c:ControlsStrings.Presets_Unsaved}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style></ControlTheme>
</ResourceDictionary>