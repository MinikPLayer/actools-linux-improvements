<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:controls="clr-namespace:AcManager.Controls" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ResourceDictionary x:Key="SettingsStyle">

    <Style Selector="DockPanel">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="0 0 0 8"/>

      <Style Selector="^ Label">
          <Setter Property="Margin" Value="0 4 8 0"/>
          <Setter Property="Width" Value="148"/>
          <Setter Property="VerticalAlignment" Value="Top"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ mui|ValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ mui|DoubleValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ controls|TemperatureValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ controls|DoubleTemperatureValueLabel">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0 0 16 0"/>
          <Setter Property="Width" Value="140"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>

        <Style Selector="^ Button">
          <Setter Property="Margin" Value="8 0 0 0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>

        <Style Selector="^ mui|AsyncButton">
          <Setter Property="Margin" Value="8 0 0 0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>

        <Style Selector="^ mui|LabeledToggleButton">
          <Setter Property="Margin" Value="8 0 0 0"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>

        <Style Selector="^ TextBlock">
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="^ CheckBox"><Setter Property="VerticalAlignment" Value="Center"/>

    </Style>
      </Style>

    <Style Selector="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>

    <Setter Property="Margin" Value="0 0 0 8"/>
    </Style>

    <Style Selector="controls|MessageBlock">
      <Setter Property="Margin" Value="0 0 0 8"/>
    </Style>
  </ResourceDictionary>

  </ResourceDictionary>