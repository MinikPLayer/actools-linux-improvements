<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:attached="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/../Assets/AcSelectedSpecific.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="Grid.ObjectDataGrid">
    <Setter Property="Margin" Value="0 8 8 8"/>

    <Style.Resources>
      <ResourceDictionary><Style Selector="DockPanel" __plain="1">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="0 0 0 2"/>
        <Style.Resources>
          <ResourceDictionary><Style Selector="TextBlock" __plain="1">
            <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Padding" Value="8 0 0 0"/>
  <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0 2 0 1"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
          </Style>

          <Style Selector="mui|BbCodeBlock" __plain="1">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          </Style>

          <Style Selector="ComboBox" __plain="1">
            <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="-1"/>
    <Setter Property="IsEditable" Value="True"/>
            <Setter Property="attached:FocusAdvancement.AdvancesByEnterKey" Value="True"/>
            <Setter Property="attached:WatermarkService.Watermark" Value="?"/>
          <Style Selector="^:editable"><Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="-3 -1 -3 -1"/>
      </Style></Style>

          <Style Selector="TextBox" __plain="1">
            <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="-3 -1 -3 -1"/>
    <Setter Property="Foreground" Value="{DynamicResource WindowText}"/>
  <Setter Property="attached:FocusAdvancement.AdvancesByEnterKey" Value="True"/>
            <Setter Property="attached:WatermarkService.Watermark" Value="?"/>
          </Style>

          <ControlTheme TargetType="mui:BetterComboBox" BasedOn="{StaticResource BetterComboBox.Borderless}" x:Key="{x:Type mui:BetterComboBox}">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Placeholder" Value="?"/>
          </ControlTheme>

          <ControlTheme TargetType="mui:BetterTextBox" BasedOn="{StaticResource Borderless}" x:Key="{x:Type mui:BetterTextBox}">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Placeholder" Value="?"/>
          </ControlTheme>
        </ResourceDictionary></Style.Resources>
      </Style>
    </ResourceDictionary></Style.Resources>
  </Style>

  <Style Selector="TextBlock.TextBlockValue"/>
</Styles>