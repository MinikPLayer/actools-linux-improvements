<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:attached="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://AcManager.Controls/Assets/AcSelectedSpecific.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="Grid.ObjectDataGrid">
    <Setter Property="Margin" Value="0 8 8 8"/>

    <Style Selector="^ DockPanel">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="0 0 0 2"/>
        <Style Selector="^ TextBlock">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0 2 0 1"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
          </Style>

          <Style Selector="^ mui|BbCodeBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          </Style>

          <Style Selector="^ ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="attached:FocusAdvancement.AdvancesByEnterKey" Value="True"/>
            <Setter Property="attached:WatermarkService.Watermark" Value="?"/>
          </Style>

          <Style Selector="^ TextBox">
            <Setter Property="attached:FocusAdvancement.AdvancesByEnterKey" Value="True"/>
            <Setter Property="attached:WatermarkService.Watermark" Value="?"/>
          </Style>

          <Style Selector="^ mui|BetterComboBox">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Placeholder" Value="?"/>
          </Style>

          <Style Selector="^ mui|BetterTextBox">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Placeholder" Value="?"/>
          </Style>
        </Style>
    </Style>

  <Style Selector="TextBlock.TextBlockValue"/>
</Styles>