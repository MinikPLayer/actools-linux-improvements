  <DataTemplate x:Key="AcItemWrapperSpecific.ListItemTemplate.Thumbnail" DataType="{x:Type t:AcItemWrapper}">
    <ContentControl DataContext="{Binding Value}" Content="{Binding}">
      <ContentControl.Resources>
        <!-- Placeholder -->
        <DataTemplate DataType="{x:Type t:AcPlaceholderNew}">
          <mui:BbCodeBlock Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 2 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText"><BbCodeBlock.Styles><Style Selector="#PART_DisplayNameText"><Style Selector="^"><Setter Property="pa:T.S62" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S62)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style></Style></BbCodeBlock.Styles></mui:BbCodeBlock>
          </DataTemplate>

        <!-- AcObjectNew -->
        <DataTemplate DataType="{x:Type t:AcObjectNew}">
          <DockPanel x:Name="PART_Panel" HorizontalAlignment="Stretch" mui:Draggable.Enabled="True" Background="Transparent">
            <DockPanel.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S63" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S64" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S65" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S66" Value="{Binding Rating, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S67" Value="{Binding ActualWidth, ElementName=PART_Panel, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S68" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S63)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S64)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S65)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S66)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S67)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S68)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style></Style></DockPanel.Styles><Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
            <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource FavouriteBrush}" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>

            <mui:BbCodeBlock Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 4 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText"/>
          </DockPanel>
          </DataTemplate>

        <!-- AcCommonObject -->
        <DataTemplate DataType="{x:Type t:AcCommonObject}">
          <mui:Cell x:Name="PART_Panel" mui:Draggable.Enabled="True" Background="{DynamicResource ThumbnailBackground}" ClipToBounds="True">
            <Cell.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource DarkStripeText}"/></Style><Style Selector="^ #PART_ErrorIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S69" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S70" Value="{Binding HasErrors, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S71" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S72" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S73" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S74" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S75" Value="{Binding Changed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S69)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S70)=True] #PART_ErrorIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S71)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S72)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S73)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S74)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S75)=True] #PART_DisplayNameText"><Setter Property="FontStyle" Value="Italic"/>
            </Style></Style></Cell.Styles><Border Background="{DynamicResource CardBackground}" VerticalAlignment="Stretch">
              <TextBlock Text="No preview" Foreground="{DynamicResource CardHeaderTextDisabled}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 20" Classes="Heading1"/>
            </Border>
            <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom">
              <mui:BbCodeBlock x:Name="PART_DisplayNameText" Padding="0 2 8 2" Text="{Binding DisplayName}" Mode="WithoutBbCodes" TextTrimming="CharacterEllipsis" FontWeight="Normal" Classes="Small"/>
            </DockPanel>
            <DockPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0">
              <Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Fill="{DynamicResource Error}" Stretch="Uniform" x:Name="PART_ErrorIcon"/>
              <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
              <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource FavouriteBrush}" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
              <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
              <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>
            </DockPanel>
          </mui:Cell>
          </DataTemplate>

        <!-- TrackObject -->
        <DataTemplate DataType="{x:Type t:TrackObject}">
          <mui:Cell x:Name="PART_Panel" mui:Draggable.Enabled="True" Background="{DynamicResource ThumbnailBackground}" ClipToBounds="True" c:ToolTips.GenericObject="{Binding}" c:ContextMenus.GenericObject="{Binding}">
            <Cell.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource DarkStripeText}"/></Style><Style Selector="^ #PART_ErrorIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S76" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S77" Value="{Binding HasErrors, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S78" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S79" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S80" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S81" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S82" Value="{Binding Changed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S76)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S77)=True] #PART_ErrorIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S78)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S79)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S80)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S81)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S82)=True] #PART_DisplayNameText"><Setter Property="FontStyle" Value="Italic"/>
            </Style></Style></Cell.Styles><mui:Cell>
              <mui:BetterImage Filename="{Binding PreviewImage}" MaxWidth="320" Stretch="UniformToFill" Margin="-8 -10 -8 0" ClearOnChange="True"/>
              <mui:BetterImage Filename="{Binding OutlineImage}" Margin="0 0 0 10" ClearOnChange="True"/>
            </mui:Cell>
            <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom">
              <c:CountryIcon Country="{Binding Country}" Width="18" Height="12" DockPanel.Dock="Left" Margin="2 0 4 0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <mui:BbCodeBlock x:Name="PART_DisplayNameText" Margin="0 1 0 3" Text="{Binding DisplayName}" Mode="WithoutBbCodes" TextTrimming="CharacterEllipsis" FontWeight="Normal" Classes="Small"/>
            </DockPanel>
            <c:OriginIcon Author="{Binding Author}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" TextElement.Foreground="{DynamicResource DarkStripeText}"/>
            <DockPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0">
              <Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Fill="{DynamicResource Error}" Stretch="Uniform" x:Name="PART_ErrorIcon" Margin="0 0 4 0"/>
              <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
              <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource FavouriteBrush}" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
              <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
              <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>
            </DockPanel>
          </mui:Cell>
          </DataTemplate>

        <!-- CarObject -->
        <DataTemplate DataType="{x:Type t:CarObject}">
          <mui:Cell x:Name="PART_Panel" mui:Draggable.Enabled="True" Background="{DynamicResource ThumbnailBackground}" ClipToBounds="True" c:ToolTips.GenericObject="{Binding}" c:ContextMenus.GenericObject="{Binding}">
            <Cell.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource DarkStripeText}"/></Style><Style Selector="^ #PART_ErrorIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S83" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S84" Value="{Binding HasErrors, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S85" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S86" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S87" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S88" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S89" Value="{Binding Changed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S83)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S84)=True] #PART_ErrorIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S85)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S86)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S87)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S88)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S89)=True] #PART_DisplayNameText"><Setter Property="FontStyle" Value="Italic"/>
            </Style></Style></Cell.Styles><mui:BetterImage Filename="{Binding SelectedSkinLazy.Value.PreviewImage}" AsyncDecode="True" ClearOnChange="True" DecodeWidth="320" Stretch="UniformToFill" Margin="-8 -10 -8 0" CollapseIfNull="True"/>
            <DockPanel Background="{DynamicResource DarkStripeBackground}" VerticalAlignment="Bottom">
              <c:CarIcon Width="12" Height="12" DockPanel.Dock="Left" Margin="2 0 4 0" VerticalAlignment="Center" Car="{Binding}" ClearOnChange="True"/>
              <mui:BbCodeBlock x:Name="PART_DisplayNameText" Margin="0 1 0 3" Text="{Binding ShortName}" TextAlignment="Left" Mode="WithoutBbCodes" TextTrimming="CharacterEllipsis" FontWeight="Normal" TextWrapping="NoWrap" Classes="Small"/>
            </DockPanel>
            <c:OriginIcon Author="{Binding Author}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" TextElement.Foreground="{DynamicResource DarkStripeText}"/>
            <DockPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0">
              <Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Fill="{DynamicResource Error}" Stretch="Uniform" x:Name="PART_ErrorIcon" Margin="0 0 4 0"/>
              <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
              <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource FavouriteBrush}" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
              <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
              <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>
            </DockPanel>
          </mui:Cell>
          </DataTemplate>

      </ContentControl.Resources>
    </ContentControl>
  </DataTemplate>

  <DataTemplate x:Key="CarSkinItemTemplate" DataType="{x:Type t:CarSkinObject}">
    <mui:Cell>
      <mui:BetterImage c:ToolTips.CarSkin="{Binding}" Width="32" Height="32" Filename="{Binding LiveryImage}" ClearOnChange="True" c:ContextMenus.CarSkin="{Binding}"/>
      <Ellipse Width="4" Height="4" VerticalAlignment="Top" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 -1 -1 0" IsHitTestVisible="False" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </mui:Cell>
  </DataTemplate>

  <DataTemplate x:Key="AcItemWrapperSpecific.CarSkinItemTemplate" DataType="{x:Type t:AcItemWrapper}">
    <ContentControl Content="{Binding Value}" Width="32" Height="32" Background="Transparent">
      <ContentControl.Resources>
        <!-- Placeholder -->
        <DataTemplate DataType="{x:Type t:AcPlaceholderNew}">
          <TextBlock Text="{Binding Id}" Classes="Label"/>
        </DataTemplate>

        <!-- AccommonObject -->
        <DataTemplate DataType="{x:Type t:CarSkinObject}">
          <mui:Cell>
            <mui:BetterImage Filename="{Binding LiveryImage}" Width="32" Height="32" ClearOnChange="True" ToolTip.Tip="{Binding DisplayName}"/>
            <Ellipse Width="4" Height="4" VerticalAlignment="Top" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 -1 -1 0" IsHitTestVisible="False" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </mui:Cell>
        </DataTemplate>
      </ContentControl.Resources>
    </ContentControl>
  </DataTemplate>

  <ToolTip x:Key="ShowroomPreviewToolTip">
    <mui:BetterImage Width="256" Height="144" Margin="4" Filename="{Binding PreviewImage}"/>
  </ToolTip>

  <ToolTip x:Key="WeatherPreviewToolTip" IsVisible="{Binding PreviewImage, Converter={StaticResource ExistToVisibilityConverter}}">
    <mui:BetterImage Width="256" Height="144" Margin="4" Filename="{Binding PreviewImage}" HideBroken="True"/>
  </ToolTip>

  </ResourceDictionary>