<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI" xmlns:t="http://acstuff.club/app/tools" xmlns:c="clr-namespace:AcManager.Controls" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/IconData.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Assets/FavouritesSpecific.axaml"/>
    <ResourceInclude Source="avares://AcManager.Controls/Themes/FavouriteButton.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate x:Key="AcItemWrapperSpecific.ComboBoxItemTemplate" DataType="{x:Type t:AcItemWrapper}">
    <TextBlock Text="{Binding Value.DisplayName}"/>
  </DataTemplate>

  <ControlTheme x:Key="CompactRatingBar.ReadOnly" TargetType="c:RatingBar">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource RatingCompactBackground}"/>
    <Setter Property="Data" Value="{StaticResource CompactRatingGeometry}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RatingBar">
          <Border Background="{TemplateBinding Background}">
            <Path Data="{TemplateBinding Data}" Stretch="Uniform" Margin="{TemplateBinding Padding}">
              <Path.Fill>
                <VisualBrush Stretch="Fill">
                  <VisualBrush.Visual>
                    <ProgressBar Minimum="0" Maximum="5" Value="{Binding Rating, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Height="4" Width="28" Foreground="{Binding ActiveBrush, RelativeSource={RelativeSource TemplatedParent}}" Background="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                  </VisualBrush.Visual>
                </VisualBrush>
              </Path.Fill>
            </Path>
            <!--<Slider x:Name="Slider" Minimum="0" Maximum="5" TickFrequency="0.5" TickPlacement="None" IsSnapToTickEnabled="True" IsTabStop="True"
                Focusable="True" Value="{Binding Rating, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0" IsHitTestVisible="False"
                TabIndex="0" />-->
          </Border>

          <!--<ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource ButtonBackgroundHover}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Slider" Property="IsEnabled" Value="False" />
              <Setter TargetName="Slider" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>-->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>

  <DataTemplate x:Key="AcItemWrapperSpecific.ListItemTemplate" DataType="{x:Type t:AcItemWrapper}">
    <ContentControl DataContext="{Binding Value}" Content="{Binding}">
      <ContentControl.Resources>
        <!-- Placeholder -->
        <DataTemplate DataType="{x:Type t:AcPlaceholderNew}">
          <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 2 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText"><BbCodeBlock.Styles><Style Selector="#PART_DisplayNameText"><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S0)=True] #PART_DisplayNameText"><Setter Property="mui:HyperlinkHelper.IsHighlighted" Value="True"/>
              <Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style></Style></BbCodeBlock.Styles></mui:BbCodeBlock>
          </DataTemplate>

        <!-- AcObjectNew -->
        <DataTemplate DataType="{x:Type t:AcObjectNew}">
          <DockPanel x:Name="PART_Panel" HorizontalAlignment="Stretch" mui:Draggable.Enabled="True" Background="Transparent">
            <DockPanel.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource FavouriteBrush}"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Go}"/></Style><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S2" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S3" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S4" Value="{Binding Rating, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S5" Value="{Binding ActualWidth, ElementName=PART_Panel, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S6" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S7" Value="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S1)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S2)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S3)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S4)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S5)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S6)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S7)=True] #PART_DisplayNameText"><Setter Property="mui:HyperlinkHelper.IsHighlighted" Value="True"/>
              </Style><Style Selector="^[(pa|T.S7)=True] #PART_FavouriteIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S7)=True] #PART_NewIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S7)=True] #PART_RatingIcon"><Setter Property="ActiveBrush" Value="{DynamicResource ItemTextSelected}"/>
            </Style></Style></DockPanel.Styles><!--<Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Fill="{DynamicResource Error}" Stretch="Uniform"
                Visibility="Collapsed" x:Name="PART_ErrorIcon" />-->

            <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
            <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>

            <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 4 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText"/>
          </DockPanel>
          </DataTemplate>

        <!-- AcCommonObject -->
        <DataTemplate DataType="{x:Type t:AcCommonObject}">
          <DockPanel x:Name="PART_Panel" HorizontalAlignment="Stretch" mui:Draggable.Enabled="True" Background="Transparent" c:ToolTips.GenericObject="{Binding}" c:ContextMenus.GenericObject="{Binding}">
            <DockPanel.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_ErrorIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Error}"/></Style><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource FavouriteBrush}"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Go}"/></Style><Style Selector="^"><Setter Property="pa:T.S8" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S9" Value="{Binding HasErrors, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S10" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S11" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S12" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S13" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S14" Value="{Binding Changed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S15" Value="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S8)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S9)=True] #PART_DisplayNameText"><Setter Property="FontWeight" Value="Bold"/>
              </Style><Style Selector="^[(pa|T.S9)=True] #PART_ErrorIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S10)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S11)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S12)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S13)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S14)=True] #PART_DisplayNameText"><Setter Property="FontStyle" Value="Italic"/>
            </Style><Style Selector="^[(pa|T.S15)=True] #PART_DisplayNameText"><Setter Property="mui:HyperlinkHelper.IsHighlighted" Value="True"/>
              <Setter Property="Foreground" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S15)=True] #PART_FavouriteIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S15)=True] #PART_ErrorIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S15)=True] #PART_NewIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S15)=True] #PART_RatingIcon"><Setter Property="ActiveBrush" Value="{DynamicResource ItemTextSelected}"/>
            </Style></Style></DockPanel.Styles><Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_ErrorIcon"/>

            <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
            <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>

            <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 4 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText"/>
          </DockPanel>
          </DataTemplate>

        <!-- AcJsonObjectNew -->
        <DataTemplate DataType="{x:Type t:AcJsonObjectNew}">
          <DockPanel x:Name="PART_Panel" HorizontalAlignment="Stretch" mui:Draggable.Enabled="True" Background="Transparent" c:ToolTips.GenericObject="{Binding}" c:ContextMenus.GenericObject="{Binding}">
            <DockPanel.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_ErrorIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Error}"/></Style><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource FavouriteBrush}"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Go}"/></Style><Style Selector="^"><Setter Property="pa:T.S16" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S17" Value="{Binding NeedsMargin, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S18" Value="{Binding HasErrors, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S19" Value="{Binding ExtraListMargin, Source={x:Static mui:AppearanceManager.Instance}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S20" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S21" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S22" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S23" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S24" Value="{Binding Changed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S25" Value="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S16)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S17)=True] #PART_DisplayNameText"><Setter Property="Padding" Value="20 0 0 0"/>
            </Style><Style Selector="^[(c|AcListPage.UsePaddingForChildObjects)=False] #PART_DisplayNameText"><Setter Property="Padding" Value="0 0 0 0"/>
            </Style><Style Selector="^[(pa|T.S18)=True] #PART_DisplayNameText"><Setter Property="FontWeight" Value="Bold"/>
              </Style><Style Selector="^[(pa|T.S18)=True] #PART_OriginIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(pa|T.S18)=True] #PART_ErrorIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S19)=True] #PART_OriginIcon"><Setter Property="Margin" Value="0 0 8 0"/>
            </Style><Style Selector="^[(pa|T.S20)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S21)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S22)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S23)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S24)=True] #PART_DisplayNameText"><Setter Property="FontStyle" Value="Italic"/>
            </Style><Style Selector="^[(pa|T.S25)=True] #PART_DisplayNameText"><Setter Property="mui:HyperlinkHelper.IsHighlighted" Value="True"/>
              <Setter Property="Foreground" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S25)=True] #PART_FavouriteIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S25)=True] #PART_ErrorIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S25)=True] #PART_NewIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S25)=True] #PART_RatingIcon"><Setter Property="ActiveBrush" Value="{DynamicResource ItemTextSelected}"/>
            </Style></Style></DockPanel.Styles><Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_ErrorIcon"/>
            <c:OriginIcon Author="{Binding Author}" DockPanel.Dock="Right" x:Name="PART_OriginIcon"/>

            <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
            <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>

            <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 4 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText"/>
          </DockPanel>
          </DataTemplate>

        <!-- ServerPreset -->
        <DataTemplate DataType="{x:Type t:ServerPresetObject}">
          <DockPanel x:Name="PART_Panel" HorizontalAlignment="Stretch" mui:Draggable.Enabled="True" Background="Transparent">
            <DockPanel.Styles><Style Selector="#PART_Panel"><Style Selector="^ #PART_ErrorIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Error}"/></Style><Style Selector="^ #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource FavouriteBrush}"/></Style><Style Selector="^ #PART_NewIcon"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource Go}"/></Style><Style Selector="^ #RunningIcon"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^"><Setter Property="pa:T.S26" Value="{Binding Enabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S27" Value="{Binding HasErrors, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S28" Value="{Binding IsFavourite, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S29" Value="{Binding ShowNotesIcon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S30" Value="{Binding Rating, TargetNullValue=0, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=0}"/><Setter Property="pa:T.S31" Value="{Binding IsNew, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S32" Value="{Binding IsRunning, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S33" Value="{Binding Changed, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S34" Value="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S26)=True] #PART_DisplayNameText"><Setter Property="Foreground" Value="{DynamicResource WindowTextReadOnly}"/>
            </Style><Style Selector="^[(pa|T.S27)=True] #PART_DisplayNameText"><Setter Property="FontWeight" Value="Bold"/>
              </Style><Style Selector="^[(pa|T.S27)=True] #PART_ErrorIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S28)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S29)=True] #PART_NotesIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S30)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_FavouriteIcon"><Setter Property="IsVisible" Value="False"/>
              </Style><Style Selector="^[(c|AcListPage.NarrowList)=True] #PART_RatingIcon"><Setter Property="IsVisible" Value="False"/>
            </Style><Style Selector="^[(pa|T.S31)=True] #PART_NewIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S32)=True] #RunningIcon"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[(pa|T.S33)=True] #PART_DisplayNameText"><Setter Property="FontStyle" Value="Italic"/>
            </Style><Style Selector="^[(pa|T.S34)=True] #PART_DisplayNameText"><Setter Property="mui:HyperlinkHelper.IsHighlighted" Value="True"/>
              </Style><Style Selector="^[(pa|T.S34)=True] #PART_FavouriteIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S34)=True] #PART_ErrorIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S34)=True] #PART_NewIcon"><Setter Property="Fill" Value="{DynamicResource ItemTextSelected}"/>
              </Style><Style Selector="^[(pa|T.S34)=True] #PART_RatingIcon"><Setter Property="ActiveBrush" Value="{DynamicResource ItemTextSelected}"/>
            </Style></Style></DockPanel.Styles><Path Data="{StaticResource AlertIconData}" Width="16" Height="16" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_ErrorIcon"/>
            <Path Data="{StaticResource PlayIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource Go}" Stretch="Uniform" x:Name="RunningIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>

            <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" IsHitTestVisible="False" x:Name="PART_NewIcon" DockPanel.Dock="Right"/>
            <Path Data="{StaticResource BookmarkIconData}" Width="12" Height="12" DockPanel.Dock="Right" Stretch="Uniform" x:Name="PART_FavouriteIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <Path Data="{StaticResource NotesIconData}" Width="12" Height="12" DockPanel.Dock="Right" Fill="{DynamicResource WindowText}" Stretch="Uniform" x:Name="PART_NotesIcon" VerticalAlignment="Center" Margin="0 0 4 0"/>
            <c:RatingBar DockPanel.Dock="Right" Rating="{Binding Rating}" x:Name="PART_RatingIcon" VerticalAlignment="Center" Margin="0 0 4 0" Theme="{StaticResource CompactRatingBar.ReadOnly}"/>

            <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding DisplayName}" Mode="WithoutBbCodes" Margin="10 2 4 2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="PART_DisplayNameText" DockPanel.Dock="Top" ToolTip.Tip="{Binding DisplayName}"/>
            <mui:BbCodeBlock TextWrapping="NoWrap" Text="{Binding ManagerDescription}" Mode="WithoutBbCodes" Margin="10 2 4 2" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" FontWeight="Normal" ToolTip.Tip="{Binding ManagerDescription}"/>
          </DockPanel>
          </DataTemplate>

        <!-- CarSkinObject -->
        <DataTemplate DataType="{x:Type t:CarSkinObject}">
          <DockPanel x:Name="PART_Panel" HorizontalAlignment="Stretch" mui:Draggable.Enabled="True" Background="Transparent">
