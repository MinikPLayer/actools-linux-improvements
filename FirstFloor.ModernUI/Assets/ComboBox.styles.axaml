<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://__ASM__/ComboBox.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="ComboBox.ComboBox.CommonBase">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Padding" Value="7 3 18 3"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ComboBox.DataGridEditingComboBoxStyle">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="1,1"/>
  </Style>

  <Style Selector="ComboBox.ComboBoxAsTextBlock">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="-1"/>
    <Style Selector="^:editable"><Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="-3 -1 -3 -1"/>
      </Style></Style>

</Styles>