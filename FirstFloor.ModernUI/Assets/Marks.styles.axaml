<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="clr-namespace:FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://__ASM__/Marks.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="TextBlock.LimitedMarkStyle">
    <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Text" Value="{x:Static mui:UiStrings.MarkLimited}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Margin" Value="0 4 0 0"/>
    <Setter Property="Background" Value="#666666"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="2"/>
  </Style>

  <Style Selector="TextBlock.NewMarkStyle">
    <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Text" Value="{x:Static mui:UiStrings.MarkNew}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Margin" Value="0 0 3 3"/>
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentOverlay}"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
</Styles>