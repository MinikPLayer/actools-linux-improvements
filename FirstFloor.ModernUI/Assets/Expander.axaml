<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Easing.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TreeView.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="Expander" TargetType="Expander">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WindowText}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <DockPanel x:Name="PART_Header">
              <ToggleButton DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Theme="{StaticResource ExpandCollapseToggleStyle}"/>
              <ContentPresenter RecognizesAccessKey="False"/>
            </DockPanel>
            <ContentPresenter x:Name="PART_ExpandSite" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </StackPanel>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ ContentPresenter#PART_ExpandSite"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^:expanded /template/ ContentPresenter#PART_ExpandSite"><Setter Property="IsVisible" Value="True"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="Expander.Animated" TargetType="Expander" BasedOn="{StaticResource Expander}">
    
          <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <DockPanel x:Name="PART_Header" DockPanel.Dock="Top">
              <ToggleButton DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Theme="{StaticResource ExpandCollapseToggleStyle}"/>
              <ContentPresenter RecognizesAccessKey="False"/>
            </DockPanel>
            <Border x:Name="PART_ExpandSite" Margin="{TemplateBinding Padding}" ClipToBounds="True" IsVisible="False">
              <!-- PORT: removed Border.LayoutTransform -->
              <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" RenderTransform="{Binding Path=(FrameworkElement.LayoutTransform).Inverse, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"/>
            </Border>
          </DockPanel>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <!-- PORT: storyboard actions of trigger :expanded not converted --></ControlTheme>
</ResourceDictionary>