<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:sys="using:System" xmlns:p="clr-namespace:FirstFloor.ModernUI.Presentation" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Easing.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="DataGridRow" x:Key="{x:Type DataGridRow}">
    <Setter Property="Background" Value="Transparent"/>
    <!-- PORT: removed setter of ValidationErrorTemplate (not in Avalonia) -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <SelectiveScrollingGrid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <!-- auto? -->
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <DataGridCellsPresenter Grid.Column="1"><!-- PORT: removed ItemsPanel (not in Avalonia) --></DataGridCellsPresenter>
              <DataGridDetailsPresenter SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=AreRowDetailsFrozen, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}}" Grid.Column="1" Grid.Row="1" IsVisible="{TemplateBinding DetailsVisibility, Converter={x:Static pc:VisibilityConverters.ToBool}}"/>
              <DataGridRowHeader SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Row}}"/>
            </SelectiveScrollingGrid>
          </Border>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource DataGridCellBackgroundHover}"/>
            </Style><Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource DataGridCellBackgroundSelected}"/>
              <Setter Property="Foreground" Value="{DynamicResource DataGridCellForegroundSelected}"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="DataGridRow.RibbonLeft" TargetType="DataGridRow">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <c:Cell x:Name="DGR_Border">
            <Rectangle x:Name="Bg" HorizontalAlignment="Left" Width="4"/>
            <Rectangle x:Name="BgHighlight" Fill="{DynamicResource ItemBackgroundSelectedSubtle}"/>
            <SelectiveScrollingGrid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DataGridCellsPresenter Grid.Column="1"><!-- PORT: removed ItemsPanel (not in Avalonia) --></DataGridCellsPresenter>
              <DataGridRowHeader SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Row}}"/>
            </SelectiveScrollingGrid>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ Rectangle#Bg"><!-- PORT: removed setter of Fill (not in Avalonia) --></Style><Style Selector="^ /template/ Rectangle#BgHighlight"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^:selected /template/ Rectangle#Bg"><!-- PORT: removed setter of Fill (not in Avalonia) -->
              </Style><Style Selector="^:selected /template/ Rectangle#BgHighlight"><Setter Property="IsVisible" Value="True"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="DataGridRow.DetailsAlways.RibbonLeft" TargetType="DataGridRow">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <c:Cell x:Name="DGR_Border">
            <Rectangle x:Name="Bg" HorizontalAlignment="Left" Width="4"/>
            <Rectangle x:Name="BgHighlight" Fill="{DynamicResource ItemBackgroundSelectedSubtle}"/>
            <SelectiveScrollingGrid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DataGridCellsPresenter Grid.Column="1"><!-- PORT: removed ItemsPanel (not in Avalonia) --></DataGridCellsPresenter>
              <DataGridDetailsPresenter x:Name="PART_Content" Grid.Column="1" Grid.Row="1" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=AreRowDetailsFrozen, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}}"/>
              <DataGridRowHeader SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Row}}"/>
            </SelectiveScrollingGrid>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ Rectangle#Bg"><!-- PORT: removed setter of Fill (not in Avalonia) --></Style><Style Selector="^ /template/ Rectangle#BgHighlight"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^:selected /template/ Rectangle#Bg"><!-- PORT: removed setter of Fill (not in Avalonia) -->
              </Style><Style Selector="^:selected /template/ Rectangle#BgHighlight"><Setter Property="IsVisible" Value="True"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="DataGridRow.DetailsAnimated.RibbonLeft" TargetType="DataGridRow">
    <ControlTheme.Resources>
            <ResourceDictionary><ResourceDictionary>
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
            </ResourceDictionary>
          </ResourceDictionary></ControlTheme.Resources>
          <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <c:Cell x:Name="DGR_Border">
            <Rectangle x:Name="Bg" HorizontalAlignment="Left" Width="4"/>
            <Rectangle x:Name="BgHighlight" Fill="{DynamicResource ItemBackgroundSelectedSubtle}"/>
            <SelectiveScrollingGrid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DataGridCellsPresenter Grid.Column="1"><!-- PORT: removed ItemsPanel (not in Avalonia) --></DataGridCellsPresenter>
              <c:BooleanSwitch x:Name="PART_ExpandSwitch" Grid.Column="1" Grid.Row="1">
                <Border ClipToBounds="True">
                  <!-- PORT: removed Border.LayoutTransform -->
                  <DataGridDetailsPresenter x:Name="PART_Content" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=AreRowDetailsFrozen, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}}" RenderTransform="{Binding Path=(FrameworkElement.LayoutTransform).Inverse, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"/>
                </Border>
              </c:BooleanSwitch>
              <DataGridRowHeader SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Row}}"/>
            </SelectiveScrollingGrid>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ Rectangle#Bg"><!-- PORT: removed setter of Fill (not in Avalonia) --></Style><Style Selector="^ /template/ Rectangle#BgHighlight"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^:selected /template/ Rectangle#Bg"><!-- PORT: removed setter of Fill (not in Avalonia) -->
              </Style><Style Selector="^:selected /template/ Rectangle#BgHighlight"><Setter Property="IsVisible" Value="True"/>
            </Style><!-- PORT: storyboard actions of trigger [DetailsVisibility=Visible] not converted --></ControlTheme>

</ResourceDictionary>