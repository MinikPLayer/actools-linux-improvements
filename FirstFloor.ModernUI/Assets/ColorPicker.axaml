<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/BetterTextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Themes/ColorPicker.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="ColorPicker.Borderless" TargetType="c:ColorPicker" BasedOn="{StaticResource {x:Type c:ColorPicker}}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
  </ControlTheme>
</ResourceDictionary>
