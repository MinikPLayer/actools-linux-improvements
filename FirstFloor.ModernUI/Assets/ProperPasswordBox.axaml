<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:mui="clr-namespace:FirstFloor.ModernUI" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/BetterTextBox.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- PORT: ControlTemplate with triggers outside of a style (7 triggers) --><ControlTemplate x:Key="ProperPasswordBoxControlTemplate.Basic" TargetType="c:ProperPasswordBox">
    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
      <c:Cell>
        <c:BooleanSwitch Value="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}">
          <c:BooleanSwitch.False>
            <TextBox x:Name="PART_PasswordBox" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" Margin="2 1" Padding="0" CaretBrush="{TemplateBinding CaretBrush}" SelectionBrush="{TemplateBinding SelectionBrush}" PasswordChar="●">
              <PasswordBox.ContextMenu>
                <c:InheritingContextMenu>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Cut}"/>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Copy}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Paste}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Delete}"/>
                  <Separator/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.SelectAll}"/>
                  <Separator/>
                  <MenuItem Header="{x:Static mui:UiStrings.ShowPassword}" Command="{Binding TogglePasswordVisibilityCommand, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                </c:InheritingContextMenu>
              </PasswordBox.ContextMenu>
            </TextBox>
          </c:BooleanSwitch.False>
          <c:BooleanSwitch.True>
            <c:BetterTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0" Margin="4 1 3 1" Padding="0" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" CaretBrush="{TemplateBinding CaretBrush}" SelectionBrush="{TemplateBinding SelectionBrush}" Theme="{StaticResource BetterComboBoxEditableTextBox}">
              <c:BetterTextBox.ContextMenu>
                <c:InheritingContextMenu>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Cut}"/>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Copy}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Paste}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Delete}"/>
                  <Separator/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.SelectAll}"/>
                  <Separator/>
                  <MenuItem Header="{x:Static mui:UiStrings.ShowPassword}" Command="{Binding TogglePasswordVisibilityCommand, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                </c:InheritingContextMenu>
              </c:BetterTextBox.ContextMenu>
            </c:BetterTextBox>
          </c:BooleanSwitch.True>
        </c:BooleanSwitch>
        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Margin="2 0" Padding="{TemplateBinding Padding}" Opacity="0.5" IsHitTestVisible="False" IsVisible="False"/>
      </c:Cell>
    </Border>
    </ControlTemplate>

  <ControlTheme x:Key="ProperPasswordBoxControlTemplate.TextBoxStyle" TargetType="c:BetterTextBox">
    <Setter Property="ContextMenu" Value="{StaticResource TextBoxContextMenu}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InputText}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2 1 1 1"/>
    <Setter Property="DragDrop.AllowDrop" Value="True"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <!-- PORT: Template setter without inline ControlTemplate --><Setter Property="Template" Value="{StaticResource BetterTextBoxControlTemplate.Simple}"/>
  <Style Selector="^:readonly"><Setter Property="ContextMenu" Value="{StaticResource TextBoxReadOnlyContextMenu}"/>
      </Style></ControlTheme>

  <!-- PORT: ControlTemplate with triggers outside of a style (6 triggers) --><ControlTemplate x:Key="ProperPasswordBoxControlTemplate.Borderless" TargetType="c:ProperPasswordBox">
    <c:AdornedControl x:Name="Outline" IsAdornerVisible="False">
      <c:AdornedControl.AdornerContent>
        <Border Margin="{StaticResource BorderlessOutline}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False"/>
      </c:AdornedControl.AdornerContent>
      <c:Cell>
        <c:BooleanSwitch Value="{TemplateBinding VisiblePassword}">
          <c:BooleanSwitch.False>
            <TextBox x:Name="PART_PasswordBox" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" Margin="-2 0" Padding="0" CaretBrush="{TemplateBinding CaretBrush}" SelectionBrush="{TemplateBinding SelectionBrush}" PasswordChar="●">
              <PasswordBox.ContextMenu>
                <c:InheritingContextMenu>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Cut}"/>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Copy}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Paste}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Delete}"/>
                  <Separator/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.SelectAll}"/>
                  <Separator/>
                  <MenuItem Header="{x:Static mui:UiStrings.ShowPassword}" Command="{Binding TogglePasswordVisibilityCommand, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                </c:InheritingContextMenu>
              </PasswordBox.ContextMenu>
            </TextBox>
          </c:BooleanSwitch.False>
          <c:BooleanSwitch.True>
            <c:BetterTextBox x:Name="PART_TextBox" Background="Transparent" BorderThickness="0" Padding="0" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" CaretBrush="{TemplateBinding CaretBrush}" SelectionBrush="{TemplateBinding SelectionBrush}" Theme="{StaticResource ProperPasswordBoxControlTemplate.TextBoxStyle}">
              <c:BetterTextBox.ContextMenu>
                <c:InheritingContextMenu>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Cut}"/>
                  <MenuItem IsEnabled="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}}" Command="{x:Static swi:ApplicationCommands.Copy}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Paste}"/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.Delete}"/>
                  <Separator/>
                  <MenuItem Command="{x:Static swi:ApplicationCommands.SelectAll}"/>
                  <Separator/>
                  <MenuItem Header="{x:Static mui:UiStrings.ShowPassword}" Command="{Binding TogglePasswordVisibilityCommand, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding VisiblePassword, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                </c:InheritingContextMenu>
              </c:BetterTextBox.ContextMenu>
            </c:BetterTextBox>
          </c:BooleanSwitch.True>
        </c:BooleanSwitch>
        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Opacity="0.5" IsHitTestVisible="False" IsVisible="False"/>
      </c:Cell>
    </c:AdornedControl>
    </ControlTemplate>

  <ControlTheme x:Key="ProperPasswordBoxBase" TargetType="c:ProperPasswordBox">
    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>

    <Setter Property="CaretBrush" Value="{DynamicResource InputText}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2 1 1 1"/>
    <Setter Property="DragDrop.AllowDrop" Value="True"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>

    <!-- PORT: Template setter without inline ControlTemplate --><Setter Property="Template" Value="{StaticResource ProperPasswordBoxControlTemplate.Basic}"/>
  </ControlTheme>

  <ControlTheme TargetType="c:ProperPasswordBox" BasedOn="{StaticResource ProperPasswordBoxBase}" x:Key="{x:Type c:ProperPasswordBox}">
    <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
    </ControlTheme>

  <ControlTheme x:Key="ProperPasswordBox.Borderless" TargetType="c:ProperPasswordBox" BasedOn="{StaticResource ProperPasswordBoxBase}">
    <Setter Property="Padding" Value="0"/>
    <!-- PORT: Template setter without inline ControlTemplate --><Setter Property="Template" Value="{StaticResource ProperPasswordBoxControlTemplate.Borderless}"/>
    </ControlTheme>
</ResourceDictionary>