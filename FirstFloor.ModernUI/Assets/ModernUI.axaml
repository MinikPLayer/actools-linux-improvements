<ResourceDictionary xmlns:cdb="clr-namespace:FirstFloor.ModernUI.Presentation;assembly=FirstFloor.ModernUI" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="using:System" xmlns:presentation="clr-namespace:FirstFloor.ModernUI.Presentation" xmlns:controls="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:attached="clr-namespace:FirstFloor.ModernUI.Windows.Attached" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="AsyncButton.axaml"/>
    <ResourceInclude Source="Button.axaml"/>
    <ResourceInclude Source="ButtonWithComboBox.axaml"/>
    <!-- PORT: removed include of Calendar -->
    <ResourceInclude Source="CheckBox.axaml"/>
    <ResourceInclude Source="ColorPicker.axaml"/>
    <ResourceInclude Source="ComboBox.axaml"/>
    <ResourceInclude Source="ContextMenu.axaml"/>

    <!-- PORT: removed include of DataGrid.Base -->
    <!-- PORT: removed include of DataGrid.Cells -->
    <!-- PORT: removed include of DataGrid.Headers -->
    <!-- PORT: removed include of DataGrid.Rows -->
    <!-- PORT: removed include of DataGrid -->

    <!-- PORT: removed include of DatePicker -->
    <ResourceInclude Source="Easing.axaml"/>
    <!-- PORT: removed include of ExceptionDetails -->
    <ResourceInclude Source="Expander.axaml"/>
    <ResourceInclude Source="Fonts.axaml"/>
    <ResourceInclude Source="GridSplitter.axaml"/>
    <ResourceInclude Source="Hyperlink.axaml"/>
    <ResourceInclude Source="Label.axaml"/>
    <ResourceInclude Source="Layout.axaml"/>
    <ResourceInclude Source="ListBox.axaml"/>
    <!-- PORT: removed include of ListView -->
    <ResourceInclude Source="ModernProgressRing.Special.axaml"/>
    <!-- PORT: removed include of MenuItem -->
    <!-- PORT: removed include of PasswordBox -->
    <ResourceInclude Source="ProgressBar.axaml"/>
    <ResourceInclude Source="RadioButton.axaml"/>
    <ResourceInclude Source="ScrollBar.axaml"/>
    <!-- PORT: removed include of SelectableBbCodeBlock -->
    <ResourceInclude Source="Slider.axaml"/>
    <ResourceInclude Source="TextBlock.axaml"/>
    <ResourceInclude Source="TextBox.axaml"/>
    <!-- PORT: removed include of ToolBar -->
    <ResourceInclude Source="ToolTip.axaml"/>
    <ResourceInclude Source="TreeView.axaml"/>

    <!-- PORT: FancyHint deferred (needs custom ScrollViewer/attached controls port) -->
    <!-- PORT: FancyScroll deferred (needs custom ScrollViewer/attached controls port) -->
    <ResourceInclude Source="Marks.axaml"/>
    <!-- PORT: removed include of ProperPasswordBox -->
    <ResourceInclude Source="Watermark.axaml"/>

    <ResourceInclude Source="BetterTextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Themes/Generic.axaml"/>
    <!--<ResourceDictionary Source="{x:Static presentation:AppearanceManager.DefaultValuesSource}" />-->
  </ResourceDictionary.MergedDictionaries>

  <!-- ToolTips fix -->
  <!-- PORT: removed PopupAnimation -->

  <!-- Basic color brushes -->
  <SolidColorBrush x:Key="Accent" cdb:DynamicColorBrush.ColorKey="AccentColor"/>
  <SolidColorBrush x:Key="AccentOverlay" cdb:DynamicColorBrush.ColorKey="AccentOverlayColor"/>
  <SolidColorBrush x:Key="Go" cdb:DynamicColorBrush.ColorKey="GoColor"/>
  <SolidColorBrush x:Key="Error" cdb:DynamicColorBrush.ColorKey="ErrorColor"/>
  <SolidColorBrush x:Key="ThumbnailBackground" cdb:DynamicColorBrush.ColorKey="ThumbnailBackgroundColor"/>

  <!-- Font settings -->
  <sys:Double x:Key="DefaultFontSize">13</sys:Double>
  <sys:Double x:Key="FixedFontSize">13.333</sys:Double>
  <sys:Double x:Key="SmallFontSize">11</sys:Double>
  <sys:Double x:Key="ModernSubMenuFontSize">11</sys:Double>

  <!-- Title links -->
  <DataTemplate x:Key="DefaultTitleLinksTemplate" DataType="presentation:TitleLink">
    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsEnabled}" x:Name="__Dt0">
      <StackPanel.Styles><Style Selector="StackPanel#__Dt0"><Style Selector="^"><Setter Property="pa:T.S1" Value="{Binding RelativeSource={RelativeSource}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S2" Value="{Binding IsEnabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S3" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S4" Value="{Binding IsActive, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S5" Value="{Binding IsAccented, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S1)=True] Line#PART_Separator"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^[(pa|T.S2)=True]"><Setter Property="attached:LimitedService.Limited" Value="True"/>
      </Style><Style Selector="^[(pa|T.S3)=True]"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^[(pa|T.S4)=True] Button#PART_Button"><Setter Property="Foreground" Value="{DynamicResource MenuTextSelected}"/>
      </Style><Style Selector="^[(pa|T.S5)=True] Button#PART_Button"><Setter Property="Foreground" Value="{DynamicResource Error}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Style></Style></StackPanel.Styles><Line x:Name="PART_Separator" Margin="5,0" VerticalAlignment="Center" Stroke="{DynamicResource SeparatorBackground}" StartPoint=".5,3" EndPoint=".5,12"/>
      <controls:Cell>
        <Button Content="{Binding Content}" Command="{x:Static controls:ModernWindow.NavigateTitleLink}" CommandParameter="{Binding}" x:Name="PART_Button" Theme="{StaticResource SystemButtonLink}"/>
        <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 -6 -1 0" IsHitTestVisible="False" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </controls:Cell>
    </StackPanel>
    </DataTemplate>

  <DataTemplate x:Key="LargerTitleLinksTemplate" DataType="presentation:TitleLink">
    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsEnabled}" x:Name="__Dt6">
      <StackPanel.Styles><Style Selector="StackPanel#__Dt6"><Style Selector="^"><Setter Property="pa:T.S7" Value="{Binding RelativeSource={RelativeSource}, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/><Setter Property="pa:T.S8" Value="{Binding IsEnabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S9" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/><Setter Property="pa:T.S10" Value="{Binding IsActive, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/><Setter Property="pa:T.S11" Value="{Binding IsAccented, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=True}"/></Style><Style Selector="^[(pa|T.S7)=True] Line#PART_Separator"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^[(pa|T.S8)=True]"><Setter Property="attached:LimitedService.Limited" Value="True"/>
      </Style><Style Selector="^[(pa|T.S9)=True]"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^[(pa|T.S10)=True] Button#PART_Button"><Setter Property="Foreground" Value="{DynamicResource MenuTextSelected}"/>
      </Style><Style Selector="^[(pa|T.S11)=True] Button#PART_Button"><Setter Property="Foreground" Value="{DynamicResource Error}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Style></Style></StackPanel.Styles><Line x:Name="PART_Separator" Margin="5,0" VerticalAlignment="Center" Stroke="{DynamicResource SeparatorBackground}" StartPoint=".5,3" EndPoint=".5,14"/>
      <controls:Cell>
        <Button Content="{Binding Content}" Command="{x:Static controls:ModernWindow.NavigateTitleLink}" FontSize="13" CommandParameter="{Binding}" x:Name="PART_Button" Theme="{StaticResource SystemButtonLink}"/>
        <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 -6 -1 0" IsHitTestVisible="False" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </controls:Cell>
    </StackPanel>
    </DataTemplate>
</ResourceDictionary>