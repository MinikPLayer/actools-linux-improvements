<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:mui="clr-namespace:FirstFloor.ModernUI.Presentation" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="Fonts.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="ContextMenu" x:Key="{x:Type ContextMenu}">
    <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
    <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource ItemText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderActive}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- PORT: removed setter of VerticalContentAlignment (not in Avalonia) -->
    <Setter Property="Padding" Value="0 6 0 6"/>
    <Setter Property="MinWidth" Value="150"/>
    <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
    <Setter Property="TextElement.FontWeight" Value="Normal"/>
    <Setter Property="TextElement.FontStyle" Value="Normal"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <c:Cell>
            <!-- PORT: removed Cell.LayoutTransform -->
            <Border x:Name="ContextMenuBorder" Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource WindowBorderActive}" BorderThickness="1">
              <ScrollViewer x:Name="ContextMenuScrollViewer">
                <c:Cell>
                  <Canvas Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Rectangle x:Name="OpaqueRect" Height="{Binding ElementName=ContextMenuBorder, Path=ActualHeight}" Width="{Binding ElementName=ContextMenuBorder, Path=ActualWidth}" Fill="{Binding ElementName=ContextMenuBorder, Path=Background}"/>
                  </Canvas>
                  <ItemsPresenter x:Name="ItemsPresenter"/>
                </c:Cell>
              </ScrollViewer>
            </Border>
          </c:Cell>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>

  <c:InheritingContextMenu x:Key="TextBoxContextMenu">
    <MenuItem Command="{x:Static swi:ApplicationCommands.Cut}"/>
    <MenuItem Command="{x:Static swi:ApplicationCommands.Copy}"/>
    <MenuItem Command="{x:Static swi:ApplicationCommands.Paste}"/>
    <MenuItem Command="{x:Static swi:ApplicationCommands.Delete}"/>
    <Separator/>
    <MenuItem Command="{x:Static swi:ApplicationCommands.SelectAll}"/>
  </c:InheritingContextMenu>

  <c:InheritingContextMenu x:Key="TextBoxReadOnlyContextMenu">
    <MenuItem Command="{x:Static swi:ApplicationCommands.Copy}"/>
    <MenuItem Command="{x:Static swi:ApplicationCommands.SelectAll}"/>
  </c:InheritingContextMenu>
</ResourceDictionary>