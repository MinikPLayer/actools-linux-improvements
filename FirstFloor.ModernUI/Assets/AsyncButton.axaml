<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:s="using:System" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Button.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <s:Double x:Key="AsyncButton.ProgressBarOpacity">0.08</s:Double>
  <ControlTheme TargetType="c:AsyncButton" BasedOn="{StaticResource BaseButtonStyle}" x:Key="{x:Type c:AsyncButton}">
    <ControlTheme.Resources>
            <ResourceDictionary><ResourceDictionary>
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
              <!-- PORT: removed Storyboard -->
            </ResourceDictionary>
          </ResourceDictionary></ControlTheme.Resources>
          <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:AsyncButton">
          <c:Cell>
            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"/>
            <ProgressBar x:Name="PART_ProgressBar" Minimum="0" Maximum="1" Value="{Binding Progress.Progress, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent">
              <ProgressBar.Foreground>
                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="{DynamicResource AsyncButton.ProgressBarOpacity}"/>
              </ProgressBar.Foreground>
            </ProgressBar>
            <Border x:Name="Chrome" Background="Transparent" BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
              <c:AdornedControl x:Name="PART_Adorned">
                <c:AdornedControl.AdornerContent>
                  <Border ClipToBounds="True" Margin="-1">
                    <Border HorizontalAlignment="Right">
                      <Border.RenderTransform>
                        <TranslateTransform x:Name="PART_CancelTranslate" X="23"/>
                      </Border.RenderTransform>
                      <Button x:Name="PART_CancelButton" Content="×" Padding="6 1 5 2" BorderThickness="0" ToolTip.Tip="Cancel">
                        <Button.Resources>
                          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                        </Button.Resources>
                      </Button>
                    </Border>
                  </Border>
                </c:AdornedControl.AdornerContent>
                <DockPanel x:Name="PART_PaddingPanel" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                  <DockPanel.RenderTransform>
                    <TranslateTransform x:Name="PART_PaddingTranslate" X="0"/>
                  </DockPanel.RenderTransform>
                  <Border VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Border.RenderTransform>
                      <TranslateTransform X="{Binding Padding.Left, Converter={StaticResource SubstractConverter}, ConverterParameter=4, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Border.RenderTransform>
                    <Border Width="12" Height="12" Margin="0 -3 0 -4" DockPanel.Dock="Left" VerticalAlignment="Center" ClipToBounds="True">
                      <!-- PORT: removed Border.LayoutTransform -->
                      <c:BooleanSwitch x:Name="PART_ProgressRing" RenderTransform="{Binding Path=(FrameworkElement.LayoutTransform).Inverse, RelativeSource={RelativeSource AncestorType={x:Type Border}}}">
                        <Canvas>
                          <c:ModernProgressRing Width="80" Height="80" IsActive="True" Theme="{StaticResource CompactProgressRingStyle}">
                            <c:ModernProgressRing.RenderTransform>
                              <ScaleTransform ScaleX="0.15" ScaleY="0.15" CenterX="0" CenterY="0"/>
                            </c:ModernProgressRing.RenderTransform>
                          </c:ModernProgressRing>
                        </Canvas>
                      </c:BooleanSwitch>
                    </Border>
                  </Border>
                  <c:Cell>
                    <c:Cell.RenderTransform>
                      <TranslateTransform x:Name="PART_ContentTranslate" Y="0"/>
                    </c:Cell.RenderTransform>
                    <Border Margin="0 -20 0 20">
                      <TextBlock Text="{Binding Progress.Message, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource ButtonText}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <ContentPresenter x:Name="Presenter" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                  </c:Cell>
                </DockPanel>
              </c:AdornedControl>
            </Border>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ Border#Chrome"><Setter Property="BorderBrush" Value="Transparent"/></Style><!-- PORT: storyboard actions of trigger [IsProcessing=True] not converted --><Style Selector="^[Cancellable=True] /template/ c|AdornedControl#PART_Adorned"><Setter Property="IsAdornerVisible" Value="True"/>
            </Style><!-- PORT: storyboard actions of trigger [Padding=16 1 16 2] not converted --><!-- PORT: storyboard actions of trigger [PercentageProgress=True] not converted --><!-- PORT: storyboard actions of trigger [MessageProgress=True] not converted --><Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Style><Style Selector="^:pressed /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Style><Style Selector="^:focus /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Style></ControlTheme>

  </ResourceDictionary>