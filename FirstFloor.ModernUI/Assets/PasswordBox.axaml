<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ContextMenu.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme TargetType="PasswordBox" x:Key="{x:Type PasswordBox}">
        <Setter Property="ContextMenu" Value="{StaticResource TextBoxContextMenu}"/>

        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2 0 1 2"/>
        <Setter Property="DragDrop.AllowDrop" Value="True"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    </ControlTemplate>
            </Setter.Value>
        </Setter>
    <Style Selector="^ /template/ Border#Bd"><Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/></Style><Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource InputTextDisabled}"/>
                        </Style><Style Selector="^:focus /template/ Border#Bd"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
                        </Style><Style Selector="^:not(:disabled)"><Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource InputBackgroundHover}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InputTextHover}"/>
                        </Style></Style></ControlTheme>
</ResourceDictionary>