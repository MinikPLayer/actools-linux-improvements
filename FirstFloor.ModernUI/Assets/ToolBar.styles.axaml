<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/ToolBar.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="Separator.{x:Static_ToolBar.SeparatorStyleKey}">
    <Setter Property="Background" Value="{DynamicResource SeparatorBackground}"/>
  </Style>

  <Style Selector="TextBox.{x:Static_ToolBar.TextBoxStyleKey}">
    <Setter Property="DragDrop.AllowDrop" Value="True"/>
  </Style>

  <Style Selector="ToolBarTray">
    <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
  </Style>

  </Styles>