<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- PORT: hand-written; the WPF template relied on RelativeAnimatingContentControl and VisualStateManager -->
  <ControlTheme TargetType="ProgressBar" x:Key="{x:Type ProgressBar}">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="{DynamicResource ProgressBackground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <Border Name="PART_Track" ClipToBounds="True" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Track">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
