<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Layout.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="Control.BottomRow">
    <Setter Property="Margin" Value="0 20 0 0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Control.ContentRoot">
    <Setter Property="Margin" Value="{StaticResource ContentMargin}"/>
  </Style>

  <Style Selector="Control.ContentRootWithPadding">
    <Setter Property="Margin" Value="{StaticResource ContentMarginWithPadding}"/>
  </Style>

  <Style Selector="Control.InnerContentRoot">
    <Setter Property="Margin" Value="{StaticResource InnerContentMargin}"/>
  </Style>
</Styles>