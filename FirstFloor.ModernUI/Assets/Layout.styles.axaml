<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://__ASM__/Layout.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="Control.BottomRow">
    <Setter Property="Margin" Value="0 20 0 0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style Selector="Control.ContentRoot">
    <Setter Property="Margin" Value="{StaticResource ContentMargin}"/>
  </Style>

  <Style Selector="Control.ContentRootWithPadding">
    <Setter Property="Margin" Value="{StaticResource ContentMarginWithPadding}"/>
  </Style>

  <Style Selector="Control.InnerContentRoot">
    <Setter Property="Margin" Value="{StaticResource InnerContentMargin}"/>
  </Style>
</Styles>