<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mui="http://firstfloorsoftware.com/ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://__ASM__/Watermark.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="TextBlock.Watermark">
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="1 0 1 0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    <Style Selector="TextBlock.Watermark.TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="7 3 8 3"/>
    </Style>

    <Style Selector="TextBlock.Watermark.ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="7 3 8 3"/>
    </Style>

    <Style Selector="TextBlock.Watermark.TextBoxAsTextBlock"><Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="1 0 1 0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    <Style Selector="TextBlock.Watermark.ComboBoxAsTextBlock"><Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="1 0 1 0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
</Styles>