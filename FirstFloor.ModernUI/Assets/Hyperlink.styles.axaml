<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:a="clr-namespace:FirstFloor.ModernUI.Windows.Attached" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Hyperlink.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Hyperlink}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
    <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource HyperlinkHover}"/>
      </Style><Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource HyperlinkDisabled}"/>
      </Style><Style Selector="^:not(:disabled)"><Setter Property="Cursor" Value="Hand"/>
      </Style><Style Selector="^[(a|HyperlinkHelper.IsHighlighted)=True]"><Setter Property="Foreground" Value="{Binding Path=(TextBlock.Foreground), RelativeSource={RelativeSource AncestorType={x:Type DependencyObject}}}"/>
      </Style></Style>
</Styles>