<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ControlTheme TargetType="RadioButton" x:Key="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource WindowText}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <DockPanel x:Name="LayoutRoot">
            <Border x:Name="CheckBorder" Width="16" Height="16" Margin="0 1 4 0" BorderThickness="1" CornerRadius="8">
              <Ellipse x:Name="CheckMark" Width="8" Height="8" Margin="2"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            <!--<TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" />-->
          </DockPanel>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ Ellipse#CheckMark"><Setter Property="IsVisible" Value="False"/><!-- PORT: removed setter of Fill (not in Avalonia) --></Style><Style Selector="^ /template/ Border#CheckBorder"><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/></Style><Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource ButtonTextDisabled}"/>
            </Style><Style Selector="^:checked /template/ Ellipse#CheckMark"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^:pointerover /template/ Border#CheckBorder"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundHover}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderHover}"/>
              </Style><Style Selector="^:pointerover /template/ Ellipse#CheckMark"><!-- PORT: removed setter of Fill (not in Avalonia) -->
            </Style><Style Selector="^:pressed /template/ Border#CheckBorder"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderPressed}"/>
              </Style><Style Selector="^:pressed /template/ Ellipse#CheckMark"><!-- PORT: removed setter of Fill (not in Avalonia) -->
            </Style><Style Selector="^:focus /template/ Border#CheckBorder"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
            </Style></ControlTheme>
</ResourceDictionary>