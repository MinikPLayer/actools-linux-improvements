<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:attached="clr-namespace:FirstFloor.ModernUI.Windows.Attached" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Button.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/FancyScroll.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Fonts.axaml"/>
    <!-- PORT: removed include of DataGrid.Base -->
    <!-- PORT: removed include of DataGrid.Cells -->
    <!-- PORT: removed include of DataGrid.Rows -->
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="DataGrid" x:Key="{x:Type DataGrid}">
    <Setter Property="Background" Value="{DynamicResource DataGridBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource DataGridForeground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowDetailsVisibilityMode" Value="VisibleWhenSelected"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridGridLines}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGridGridLines}"/>
    <!-- PORT: removed setter of DragIndicatorStyle (not in Avalonia) -->
    <!-- PORT: removed setter of DropLocationIndicatorStyle (not in Avalonia) -->
    <Setter Property="GridLinesVisibility" Value="None"/>
    <!-- PORT: removed setter of AlternationCount (not in Avalonia) -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGrid">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ScrollViewer Focusable="False" x:Name="DG_ScrollViewer">
              <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{x:Static DataGrid.SelectAllCommand}" Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=CellsPanelHorizontalOffset}" Focusable="False" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.All}}" Theme="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type DataGrid}, ResourceId=DataGridSelectAllButtonStyle}}"/>

                    <DataGridColumnHeadersPresenter Grid.Row="0" Grid.Column="1" x:Name="PART_ColumnHeadersPresenter" IsVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=HeadersVisibility, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Column}}"/>

                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0"/>

                    <c:BetterScrollBar Grid.Row="1" Grid.Column="1" x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" IsVisible="{TemplateBinding ComputedVerticalScrollBarVisibility, Converter={x:Static pc:VisibilityConverters.ToBool}}" Theme="{StaticResource FancyScrollBarVertical}"/>

                    <Grid Grid.Row="2" Grid.Column="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=NonFrozenColumnsViewportHorizontalOffset}"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <ScrollBar Grid.Column="1" x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsVisible="{TemplateBinding ComputedHorizontalScrollBarVisibility, Converter={x:Static pc:VisibilityConverters.ToBool}}"/>

                    </Grid>
                  </Grid>
                </ControlTemplate>
              </ScrollViewer.Template>
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    </ControlTheme>

  <ControlTheme x:Key="DataGrid.Lite" TargetType="DataGrid">
    <!-- PORT: removed setter of VerticalContentAlignment (not in Avalonia) -->
    <!-- PORT: removed setter of SelectionUnit (not in Avalonia) -->
    <Setter Property="SelectionMode" Value="Single"/>
    <!-- PORT: removed setter of MinRowHeight (not in Avalonia) -->
    <Setter Property="IsReadOnly" Value="False"/>
    <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>

    <!-- PORT: removed setter of EnableRowVirtualization (not in Avalonia) -->
    <!-- PORT: removed setter of EnableColumnVirtualization (not in Avalonia) -->
    <Setter Property="VirtualizingStackPanel.IsVirtualizingWhenGrouping" Value="True"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="False"/>
    <!-- PORT: removed setter of CanUserResizeRows (not in Avalonia) -->
    <Setter Property="CanUserReorderColumns" Value="False"/>
    <!-- PORT: removed setter of CanUserAddRows (not in Avalonia) -->
    <!-- PORT: removed setter of CanUserDeleteRows (not in Avalonia) -->

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGrid">
          <ScrollViewer Focusable="False" x:Name="DG_ScrollViewer" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ScrollViewer.Template>
              <!-- PORT: ControlTemplate with triggers outside of a style (2 triggers) --><ControlTemplate TargetType="ScrollViewer">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <DataGridColumnHeadersPresenter Grid.Row="0" x:Name="PART_ColumnHeadersPresenter" IsVisible="{Binding HeadersVisibility, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, ConverterParameter={x:Static DataGridHeadersVisibility.Column}}"/>
                  <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"/>
                  <c:BetterScrollBar Grid.Row="1" x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" IsVisible="{TemplateBinding ComputedVerticalScrollBarVisibility, Converter={x:Static pc:VisibilityConverters.ToBool}}" Theme="{StaticResource FancyScrollBarVertical}"/>
                </Grid>
                </ControlTemplate>
            </ScrollViewer.Template>
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <!-- PORT: removed setter of RowStyle (not in Avalonia) -->

    <!-- Virtualization -->
    <!-- Scrolling -->
    <!-- Simplifying -->
    <!-- Styles -->
    <Style Selector="^[RowDetailsVisibilityMode=Visible]"><!-- PORT: removed setter of RowStyle (not in Avalonia) -->
      </Style><Style Selector="^[RowDetailsVisibilityMode=VisibleWhenSelected]"><!-- PORT: removed setter of RowStyle (not in Avalonia) -->
      </Style></ControlTheme>

</ResourceDictionary>