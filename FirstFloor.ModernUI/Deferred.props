    <Compile Remove="Presentation\AutoCompleteBehavior.cs;Windows\Controls\TextBoxEnterKeyUpdateBehavior.cs" />
    <Compile Remove="Windows\Converters\IconPathToImageConverter.cs" />
    <!-- XAML not ported yet -->
