    <Compile Remove="Windows\Controls\DataGrid*Column.cs;Windows\Controls\DataGridCheckBoxColumn.cs" />
    <Compile Remove="Dialogs\ScreenColorPickerDialog.xaml.cs" />
    <AvaloniaXaml Remove="Dialogs\ScreenColorPickerDialog.axaml" />

    <Compile Remove="Windows\Controls\RelativeAnimatingContentControl.cs" />
    <Compile Remove="Windows\Controls\OutlinedTextBlock.cs;Windows\Controls\SplitButton.cs" />
