    <AvaloniaXaml Remove="Themes\SplitButton.styles.axaml" />
    <!-- XAML which is replaced by Avalonia defaults for now -->
    <AvaloniaXaml Remove="Assets\DataGrid.Base.axaml" />
    <AvaloniaXaml Remove="Assets\DataGrid.Cells.axaml" />
    <AvaloniaXaml Remove="Assets\DataGrid.Cells.styles.axaml" />
    <AvaloniaXaml Remove="Assets\DataGrid.Headers.axaml" />
