    <AvaloniaXaml Remove="Assets\DataGrid.Rows.axaml" />
    <AvaloniaXaml Remove="Assets\DataGrid.axaml" />
    <AvaloniaXaml Remove="Assets\DatePicker.axaml" />
    <AvaloniaXaml Remove="Assets\Calendar.axaml" />
    <AvaloniaXaml Remove="Assets\ListView.axaml" />
