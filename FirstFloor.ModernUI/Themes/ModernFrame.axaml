<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="using:System" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="c:ModernFrame" x:Key="{x:Type c:ModernFrame}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="{x:Null}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernFrame">
          <ControlTemplate.Resources>
            <!-- render a nicely formatted error page when content is an exception -->
            <DataTemplate DataType="{x:Type sys:Exception}">
              <c:ExceptionDetails Exception="{Binding}"/>
            </DataTemplate>
          </ControlTemplate.Resources>

          <Border HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <c:Cell HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" c:ModernFrame.KeepContentAlive="False">
              <c:TransitioningContentControl Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" Transition="{TemplateBinding TransitionName}"/>

              <!-- display progress bar while content is being loaded -->
              <ProgressBar IsIndeterminate="{TemplateBinding IsLoadingContent}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="4" Margin="20 0 20 0" IsVisible="{Binding IsLoadingContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </c:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>

</ResourceDictionary>