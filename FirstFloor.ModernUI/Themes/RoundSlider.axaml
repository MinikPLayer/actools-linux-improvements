<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Fonts.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="c:RoundSlider" x:Key="{x:Type c:RoundSlider}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="80"/>
    <Setter Property="Height" Value="80"/>
    <Setter Property="ContentWidth" Value="40"/>
    <Setter Property="ContentHeight" Value="40"/>
    <Setter Property="IsSnapToTickEnabled" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="TickFrequency" Value="5"/>
    <Setter Property="TickThickness" Value="1"/>
    <Setter Property="TickLength" Value="6"/>
    <Setter Property="TickOffset" Value="10"/>
    <Setter Property="TickBrush" Value="{DynamicResource SliderTick}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RoundSlider">
          <Border x:Name="PART_Border" Background="Transparent" BorderThickness="0">
            <c:Cell Margin="{TemplateBinding Padding}">
              <Viewbox x:Name="PART_Wrapper">
                <Canvas Width="80" Height="80" Background="Transparent">
                  <Border x:Name="PART_Temporary" IsHitTestVisible="False" Width="0" Height="0">
                    <Border.RenderTransform>
                      <RotateTransform x:Name="RotateTransform" CenterX="4" CenterY="4">
                        <RotateTransform.Angle>
                          <MultiBinding Converter="{x:Static c:RoundSlider.Converter}">
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                          </MultiBinding>
                        </RotateTransform.Angle>
                      </RotateTransform>
                    </Border.RenderTransform>
                  </Border>

                  <Thumb x:Name="PART_Thumb" Width="20" Height="20" BorderThickness="0" Classes="inline1">
                    <Thumb.Template>
                      <ControlTemplate>
                        <Ellipse Margin="6" Width="8" Height="8" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" RenderTransform="{Binding RenderTransform.Inverse, ElementName=PART_Temporary}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                    <Thumb.Styles>
                      <Style Selector="Thumb.inline1">
                        <Setter Property="Background" Value="{DynamicResource SliderThumbBackground}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorder}"/>
                        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundHover}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderHover}"/>
                          </Style><Style Selector="^:pressed"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDragging}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderDragging}"/>
                          </Style><Style Selector="^:disabled"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDisabled}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderDisabled}"/>
                          </Style></Style>
                    </Thumb.Styles>
                    <Thumb.RenderTransform>
                      <TransformGroup>
                        <TranslateTransform X="30" Y="60"/>
                        <RotateTransform x:Name="RotateTransform" CenterX="40" CenterY="40">
                          <RotateTransform.Angle>
                            <MultiBinding Converter="{x:Static c:RoundSlider.Converter}">
                              <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                              <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                              <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                            </MultiBinding>
                          </RotateTransform.Angle>
                        </RotateTransform>
                      </TransformGroup>
                    </Thumb.RenderTransform>
                  </Thumb>
                </Canvas>
              </Viewbox>

              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Width="{TemplateBinding ContentWidth}" Height="{TemplateBinding ContentHeight}" RecognizesAccessKey="False" Content="{TemplateBinding Content}"/>
            </c:Cell>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>