<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:a="clr-namespace:FirstFloor.ModernUI.Windows.Attached" xmlns:pr="clr-namespace:FirstFloor.ModernUI.Presentation" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Button.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/ListBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Fonts.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="ModernTabLinkItem" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
    <Setter Property="Margin" Value="0 0 0 0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter x:Name="Presenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource MenuTextHover}"/>
            </Style><Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource MenuTextSelected}"/>
            </Style><Style Selector="^"><Setter Property="pa:T.S0" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S0)=True]"><Setter Property="IsVisible" Value="False"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="ModernTabListLinkItem" TargetType="ListBoxItem" BasedOn="{StaticResource FlatListBoxItem}">
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Bd"><Setter Property="Background" Value="{DynamicResource ItemBackgroundHover}"/></Style>
    <Style Selector="^:selected /template/ Border#Bd"><Setter Property="Background" Value="{DynamicResource ItemBackgroundSelected}"/></Style>
    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource MenuTextDisabled}"/></Style>
  </ControlTheme>

  <ItemsPanelTemplate x:Key="ModernTabLinkItemPanelTemplate">
    <WrapPanel Orientation="Horizontal"/>
  </ItemsPanelTemplate>

  <DataTemplate x:Key="ModernTabLinkItemPanelDataTemplate" DataType="pr:Link">
    <TextBlock Text="{Binding DisplayName, Converter={StaticResource ToUpperConverter}}" Margin="0 0 12 0"/>
  </DataTemplate>

  <DataTemplate x:Key="ListOfLinksDataTemplateDataTemplate" DataType="{x:Type pr:ListOfLinks}">
    <c:ModernTabLinksComboBox ItemsSource="{Binding Children}" IsEditable="False" BorderThickness="0" Theme="{StaticResource BetterComboBox.Borderless}">
      <c:ModernTabLinksComboBox.ItemTemplate>
        <DataTemplate DataType="pr:Link">
          <TextBlock Text="{Binding DisplayName}" FontWeight="Normal" ToolTip.Tip="{Binding ToolTip}"/>
        </DataTemplate>
      </c:ModernTabLinksComboBox.ItemTemplate>
      <c:ModernTabLinksComboBox.Template>
        <!-- PORT: ControlTemplate with triggers outside of a style (6 triggers) --><ControlTemplate TargetType="c:ModernTabLinksComboBox">
          <c:Cell x:Name="MainGrid">
            <Popup x:Name="PART_Popup" Placement="Bottom" Margin="1" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <c:Cell Margin="0" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ElementName=MainGrid, Path=ActualWidth}">
                <Border x:Name="DropDownBorder" Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource WindowBorderActive}" BorderThickness="1" TextElement.Foreground="{DynamicResource WindowText}">
                  <ScrollViewer x:Name="DropDownScrollViewer">
                    <ItemsPresenter x:Name="ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                  </ScrollViewer>
                </Border>
              </c:Cell>
            </Popup>
            <ToggleButton Background="Transparent" BorderThickness="0" Padding="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <DockPanel>
              <Path x:Name="Icon" Margin="0 1 5 0" Fill="{TemplateBinding Foreground}" Data="F1 M 21,30.0001L 55.9999,30.0001L 55.9999,50L 21,50L 21,30.0001 Z M 52,28L 37,28C 38,25 39.4999,24.0001 39.4999,24.0001L 50.75,24C 51.3023,24 52,24.6977 52,25.25L 52,28 Z" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" DockPanel.Dock="Left" Stretch="Uniform" Width="12" Height="12"/>
              <Path x:Name="Arrow" Margin="5 1 8 0" Fill="{TemplateBinding Foreground}" Data="{DynamicResource DownArrowGeometry}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" DockPanel.Dock="Right"/>
              <Border IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <TextBlock Text="MORE"/>
              </Border>
            </DockPanel>
          </c:Cell>
          </ControlTemplate>
      </c:ModernTabLinksComboBox.Template>
    </c:ModernTabLinksComboBox>
  </DataTemplate>

  <DataTemplate x:Key="ModernTabLinksItemPanelDataTemplate" DataType="{x:Type pr:LinkWithList}">
    <c:ModernTabLinksComboBox ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedLink}" IsEditable="False" BorderThickness="0" Theme="{StaticResource BetterComboBox.Borderless}">
      <c:ModernTabLinksComboBox.ItemTemplate>
        <DataTemplate DataType="pr:Link">
          <TextBlock Text="{Binding DisplayName}" FontWeight="Normal" ToolTip.Tip="{Binding ToolTip}"/>
        </DataTemplate>
      </c:ModernTabLinksComboBox.ItemTemplate>
      <c:ModernTabLinksComboBox.Template>
        <!-- PORT: ControlTemplate with triggers outside of a style (6 triggers) --><ControlTemplate TargetType="c:ModernTabLinksComboBox">
          <c:Cell x:Name="MainGrid">
            <Popup x:Name="PART_Popup" Placement="Bottom" Margin="1" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <c:Cell Margin="0" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ElementName=MainGrid, Path=ActualWidth}">
                <Border x:Name="DropDownBorder" Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource WindowBorderActive}" BorderThickness="1" TextElement.Foreground="{DynamicResource WindowText}">
                  <ScrollViewer x:Name="DropDownScrollViewer">
                    <ItemsPresenter x:Name="ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                  </ScrollViewer>
                </Border>
              </c:Cell>
            </Popup>
            <ToggleButton Background="Transparent" BorderThickness="0" Padding="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <DockPanel>
              <Path x:Name="Arrow" Margin="5 1 8 0" Fill="{TemplateBinding Foreground}" Data="{DynamicResource DownArrowGeometry}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" DockPanel.Dock="Right"/>
              <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <ContentPresenter.ContentTemplate>
                  <DataTemplate DataType="pr:Link">
                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource ToUpperConverter}}"/>
                  </DataTemplate>
                </ContentPresenter.ContentTemplate>
              </ContentPresenter>
            </DockPanel>
          </c:Cell>
          </ControlTemplate>
      </c:ModernTabLinksComboBox.Template>
    </c:ModernTabLinksComboBox>
  </DataTemplate>

  <PathGeometry x:Key="PinIcon">F1 M 56.1355,32.5475L 43.4466,19.8526C 42.7886,20.4988 42.298,21.2123 41.9749,21.9932C 41.6519,22.7741 41.4903,23.5729 41.4903,24.3895C 41.4903,25.1942 41.6529,25.987 41.9779,26.7679L 34.0577,34.6821C 33.3918,34.3372 32.6991,34.0776 31.9796,33.9032C 31.2601,33.7288 30.5298,33.6415 29.7885,33.6415C 28.623,33.6415 27.4953,33.8526 26.4052,34.2748C 25.315,34.697 24.3419,35.3342 23.4856,36.1865L 30.2344,42.9174L 25.9027,47.9032L 22.6532,51.8425L 20.5988,54.5836C 20.1212,55.2892 19.8823,55.753 19.8823,55.975L 19.8645,56.0701L 19.9002,56.088L 19.9002,56.1474L 19.9358,56.1058L 20.0131,56.1236C 20.2351,56.1236 20.6989,55.8888 21.4045,55.419L 24.1457,53.3765L 28.0849,50.1151L 33.0945,45.7775L 39.8016,52.5025C 40.6579,51.6462 41.2961,50.6731 41.7163,49.5829C 42.1365,48.4928 42.3466,47.367 42.3466,46.2056C 42.3466,45.4603 42.2603,44.729 42.0879,44.0115C 41.9155,43.294 41.6548,42.6003 41.3069,41.9304L 49.2202,34.0161C 50.0011,34.3372 50.7939,34.4978 51.5986,34.4978C 52.4192,34.4978 53.2189,34.3362 53.9979,34.0132C 54.7768,33.6901 55.4894,33.2015 56.1355,32.5475 Z</PathGeometry>
  <PathGeometry x:Key="UnpinIcon">F1 M 26.9166,22.1667L 37.9999,33.25L 49.0832,22.1668L 53.8332,26.9168L 42.7499,38L 53.8332,49.0834L 49.0833,53.8334L 37.9999,42.75L 26.9166,53.8334L 22.1666,49.0833L 33.25,38L 22.1667,26.9167L 26.9166,22.1667 Z</PathGeometry>

  <ControlTheme x:Key="PinTabButton.Pin" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Margin" Value="0 -14 16 0"/>
    <Setter Property="ToolTip.Tip" Value="Pin tab"/>
    <Setter Property="Path.Data" Value="{StaticResource PinIcon}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Width="16" Height="16" CornerRadius="8 8 0 0">
            <Path x:Name="PART_Icon" Fill="{TemplateBinding Foreground}" Stretch="Fill" Data="{TemplateBinding Path.Data}" Margin="0 1 0 -1"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="PinTabButton.Unpin" TargetType="Button" BasedOn="{StaticResource PinTabButton.Pin}">
    <Setter Property="ToolTip.Tip" Value="Unpin tab"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Path.Data" Value="{StaticResource UnpinIcon}"/>
  </ControlTheme>

  <DataTemplate x:Key="ModernTabPinnedLinkItemPanelDataTemplate" DataType="pr:Link">
    <c:AdornedControl ShowAdornerOnHover="True">
      <c:AdornedControl.AdornerContent>
        <Button Command="{Binding UnpinCommand}" Theme="{StaticResource PinTabButton.Unpin}"/>
      </c:AdornedControl.AdornerContent>
      <TextBlock Text="{Binding DisplayName, Converter={StaticResource ToUpperConverter}}" Margin="0 0 12 0"/>
    </c:AdornedControl>
  </DataTemplate>

  <c:ModernTabDataTemplateSelector x:Key="ModernTabDataTemplateSelector" LinkDataTemplate="{StaticResource ModernTabLinkItemPanelDataTemplate}" PinnedLinkDataTemplate="{StaticResource ModernTabPinnedLinkItemPanelDataTemplate}" ListOfLinksDataTemplate="{StaticResource ListOfLinksDataTemplateDataTemplate}" LinkWithListDataTemplate="{StaticResource ModernTabLinksItemPanelDataTemplate}">
    <c:ModernTabDataTemplateSelector.TitleDataTemplate>
      <DataTemplate DataType="c:ModernTab+TitleItem">
        <TextBlock Text="{Binding Title, Converter={StaticResource ToUpperConverter}}" FontFamily="{StaticResource DefaultFont}" FontSize="15" HorizontalAlignment="Left" FontWeight="Bold" Margin="0 0 12 0" Foreground="{DynamicResource MenuTextSelected}"/>
      </DataTemplate>
    </c:ModernTabDataTemplateSelector.TitleDataTemplate>
  </c:ModernTabDataTemplateSelector>

  <ControlTheme TargetType="c:ModernTab" x:Key="{x:Type c:ModernTab}">
    <Setter Property="LinksHorizontalAlignment" Value="Right"/>
    <Setter Property="LinksMargin" Value="0 0 0 4"/>
    <Setter Property="FrameMargin" Value="0"/>
    <Setter Property="c:ModernFrame.TopSource" Value="{x:Null}"/>

    <Setter Property="LinksListBoxTemplate">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernTab">
          <DockPanel>
            <ListBox x:Name="PART_LinkList" VerticalAlignment="Top" ItemsSource="{TemplateBinding Links}" ItemsPanel="{StaticResource ModernTabLinkItemPanelTemplate}" ItemTemplate="{StaticResource ModernTabLinkItemPanelDataTemplate}" HorizontalAlignment="{TemplateBinding LinksHorizontalAlignment}" Margin="{TemplateBinding LinksMargin}" Template="{TemplateBinding LinksListBoxTemplate}" DockPanel.Dock="Top" ItemContainerTheme="{StaticResource ModernTabLinkItem}"/>
            <c:ModernFrame x:Name="PART_Frame" Source="{Binding SelectedSource, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ContentLoader="{TemplateBinding ContentLoader}" Margin="{TemplateBinding FrameMargin}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <!-- PORT: pin/unpin buttons (adorners) of the title layout are not ported yet -->
    <Style Selector="^[Layout=TabWithTitle]">
      <Setter Property="Template">
        <ControlTemplate TargetType="c:ModernTab">
          <DockPanel>
            <ListBox x:Name="PART_LinkList" ItemContainerTheme="{StaticResource ModernTabLinkItem}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemTemplate="{StaticResource ModernTabDataTemplateSelector}" ItemsPanel="{StaticResource ModernTabLinkItemPanelTemplate}" ItemsSource="{TemplateBinding LinksWithTitle}" HorizontalAlignment="{TemplateBinding LinksHorizontalAlignment}" Margin="{TemplateBinding LinksMargin}" DockPanel.Dock="Top" Template="{TemplateBinding LinksListBoxTemplate}"/>
            <c:ModernFrame x:Name="PART_Frame" Source="{Binding SelectedSource, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ContentLoader="{TemplateBinding ContentLoader}" Margin="{TemplateBinding FrameMargin}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^[Layout=List]">
      <Setter Property="Template">
        <ControlTemplate TargetType="c:ModernTab">
          <Grid ColumnDefinitions="Auto,9,*">
            <ListBox x:Name="PART_LinkList" ItemsSource="{TemplateBinding Links}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}" Template="{TemplateBinding LinksListBoxTemplate}" MinWidth="50" MaxWidth="400" ItemContainerTheme="{StaticResource ModernTabListLinkItem}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="pr:Link">
                  <TextBlock Text="{Binding DisplayName, Converter={StaticResource ToUpperConverter}}" Margin="10 2 2 2" FontSize="{DynamicResource SmallFontSize}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <c:ModernTabSplitter Grid.Column="1"/>
            <c:ModernFrame Grid.Column="2" x:Name="PART_Frame" Source="{Binding SelectedSource, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ContentLoader="{TemplateBinding ContentLoader}" Margin="32 0 0 0"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    </ControlTheme>
</ResourceDictionary>