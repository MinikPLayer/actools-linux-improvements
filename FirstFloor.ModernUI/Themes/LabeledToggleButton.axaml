<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:a="clr-namespace:FirstFloor.ModernUI.Windows.Attached" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Slider.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme TargetType="c:SelectableBbCodeBlock" x:Key="{x:Type c:SelectableBbCodeBlock}">
    <Setter Property="ContextMenu" Value="{StaticResource TextBoxReadOnlyContextMenu}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource InputText}"/>
    <Setter Property="DragDrop.AllowDrop" Value="True"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost"/>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource InputTextDisabled}"/>
            </Style></ControlTheme>

  <ControlTheme TargetType="c:LabeledToggleButton" x:Key="{x:Type c:LabeledToggleButton}">
    <Setter Property="Background" Value="{DynamicResource SliderTrackBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SliderTrackBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="16 1 16 2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:LabeledToggleButton">
          <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <c:Cell ClipToBounds="True">
              <Border x:Name="PART_Helper" Margin="0 0 11 0"/>
              <Border x:Name="PART_OnLabel" Padding="{TemplateBinding Padding}" a:RelativeTranslateTransform.RelativeTo="{Binding ElementName=PART_Helper}" a:RelativeTranslateTransform.X="-1">
                <TextBlock Text="{TemplateBinding LabelChecked}" Margin="0 0 11 0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <Border x:Name="PART_OffLabel" Margin="{TemplateBinding Padding}" a:RelativeTranslateTransform.RelativeTo="{Binding ElementName=PART_Helper}" a:RelativeTranslateTransform.X="0">
                <TextBlock Text="{TemplateBinding LabelUnchecked}" Margin="11 0 0 0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <Thumb x:Name="PART_Thumb" Width="11" HorizontalAlignment="Left" a:RelativeTranslateTransform.RelativeTo="{Binding ElementName=PART_Helper}" a:RelativeTranslateTransform.X="0" Margin="0" Theme="{StaticResource BaseSliderThumbStyle}"/>
            </c:Cell>
          </Border>

          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource ButtonTextDisabled}"/>
      </Style><Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextHover}"/>
      </Style><Style Selector="^:pressed"><Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderPressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextPressed}"/>
      </Style><Style Selector="^:focus"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
      </Style><Style Selector="^[HighlightChecked=True] /template/ Border#PART_OnLabel"><Setter Property="Background" Value="{DynamicResource Accent}"/>
              <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonTextPressed}"/>
            </Style><Style Selector="^[HighlightUnchecked=True] /template/ Border#PART_OffLabel"><Setter Property="Background" Value="{DynamicResource Accent}"/>
              <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonTextPressed}"/>
            </Style></ControlTheme>
</ResourceDictionary>