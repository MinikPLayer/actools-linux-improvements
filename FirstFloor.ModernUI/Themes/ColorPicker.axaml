<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:mui="clr-namespace:FirstFloor.ModernUI"
    xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/BetterTextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBox.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- PORT: the palette is Avalonia’s ColorView (WPF version used pixel shaders) -->
  <ControlTheme x:Key="ColorPickerToggleButton" TargetType="ToggleButton">
    <Setter Property="Width" Value="23"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource ModernButtonText}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Rectangle Fill="{TemplateBinding Background}" Width="23" HorizontalAlignment="Right"/>
          <Path Name="Arrow" Margin="8 1 8 0" Fill="{TemplateBinding Foreground}" Data="{DynamicResource DownArrowGeometry}"
              HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource ModernButtonTextHover}"/></Style>
    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource ModernButtonTextDisabled}"/></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ColorPicker}" TargetType="c:ColorPicker">
    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4 3"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <c:BetterTextBox Name="PART_TextBox" Text="{Binding DisplayColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
              Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" Placeholder="Select color"/>
          <ToggleButton Name="PART_Button" HorizontalAlignment="Right" Margin="3 2 5 0" Theme="{StaticResource ColorPickerToggleButton}"
              Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:ColorPicker.ColorToBrushConverter}}"
              IsHitTestVisible="{Binding !#PART_Popup.IsOpen}"/>
          <Popup Name="PART_Popup" PlacementTarget="{Binding #PART_TextBox}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
              IsOpen="{Binding IsChecked, ElementName=PART_Button, Mode=TwoWay}">
            <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="1">
              <ColorView Color="{Binding Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsAlphaVisible="False"
                  IsColorPaletteVisible="False" IsColorModelVisible="False" IsAccentColorsVisible="False"/>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
