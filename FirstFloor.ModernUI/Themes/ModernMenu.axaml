<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:pr="clr-namespace:FirstFloor.ModernUI.Presentation" xmlns:a="clr-namespace:FirstFloor.ModernUI.Windows.Attached" xmlns:pa="clr-namespace:FirstFloor.ModernUI.Windows.Attached;assembly=FirstFloor.ModernUI" xmlns:pc="clr-namespace:FirstFloor.ModernUI.Windows.Converters;assembly=FirstFloor.ModernUI" xmlns:sw="clr-namespace:System.Windows;assembly=FirstFloor.ModernUI" xmlns:swi="clr-namespace:System.Windows.Input;assembly=FirstFloor.ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/ListBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBlock.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="ModernSubMenuItemLink" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource SubMenuText}"/>
    <Setter Property="FontSize" Value="{DynamicResource ModernSubMenuFontSize}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <DockPanel MinWidth="20" Margin="0 0 12 0">
            <ContentPresenter Width="10" Height="10" Margin="0 0 4 0" Content="{Binding Icon}"/>
            <c:Cell>
              <TextBlock x:Name="NameTextBox" Text="{Binding DisplayName, Converter={StaticResource ToUpperSpecialConverter}}" TextAlignment="Center" Margin="2"/>
              <TextBlock Text="{Binding DisplayName, Converter={StaticResource ToUpperConverter}}" FontWeight="Bold" Margin="2" IsVisible="False"/>
              <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 -6 -1 0" IsHitTestVisible="False" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </c:Cell>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^"><Setter Property="pa:T.S2" Value="{Binding Icon, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter={x:Null}}"/></Style><Style Selector="^[(pa|T.S2)=True]"><Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <c:Cell MinWidth="20" Margin="0 0 12 0" ToolTip.Tip="{Binding ToolTip}">
                <TextBlock x:Name="NameTextBox" Text="{Binding DisplayName, Converter={StaticResource ToUpperSpecialConverter}}" TextAlignment="Center" Margin="2"/>
                <TextBlock Text="{Binding DisplayName, Converter={StaticResource ToUpperConverter}}" FontWeight="Bold" Margin="2" IsVisible="False"/>
                <Ellipse Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right" Fill="{DynamicResource Go}" Margin="0 -6 -1 0" IsHitTestVisible="False" IsVisible="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              </c:Cell>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextHover}"/>
      </Style><Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextSelected}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Style><Style Selector="^"><Setter Property="pa:T.S3" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S3)=True]"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^"><Setter Property="pa:T.S4" Value="{Binding IsEnabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S4)=True]"><Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextDisabled}"/>
        <Setter Property="a:LimitedService.Limited" Value="True"/>
      </Style></ControlTheme>

  <ControlTheme x:Key="ModernSubMenuItemLinkInputEmpty" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource SubMenuText}"/>
    <Setter Property="FontSize" Value="{DynamicResource ModernSubMenuFontSize}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <c:Cell MinWidth="20" Margin="0 0 12 0">
            <c:BetterTextBox x:Name="NameTextBox" Text="{Binding DisplayName}" TextAlignment="Center" Margin="2" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Tag="{Binding SelectedLinkGroupFilterable.FilterHint, RelativeSource={RelativeSource AncestorType={x:Type c:ModernMenu}}}" Theme="{StaticResource Borderless}">
              <ToolTip.Tip>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <ToolTip DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" IsVisible="{Binding Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
                  <c:BbCodeBlock Text="{Binding Value}" TextAlignment="Left" Classes="Small"/>
                </ToolTip>
              </ToolTip.Tip>
            </c:BetterTextBox>
            <Path x:Name="Icon" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 42.5,22C 49.4036,22 55,27.5964 55,34.5C 55,41.4036 49.4036,47 42.5,47C 40.1356,47 37.9245,46.3435 36,45.2426L 26.9749,54.2678C 25.8033,55.4393 23.9038,55.4393 22.7322,54.2678C 21.5607,53.0962 21.5607,51.1967 22.7322,50.0251L 31.7971,40.961C 30.6565,39.0755 30,36.8644 30,34.5C 30,27.5964 35.5964,22 42.5,22 Z M 42.5,26C 37.8056,26 34,29.8056 34,34.5C 34,39.1944 37.8056,43 42.5,43C 47.1944,43 51,39.1944 51,34.5C 51,29.8056 47.1944,26 42.5,26 Z" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextHover}"/>
      </Style><Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextSelected}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Style><Style Selector="^"><Setter Property="pa:T.S5" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S5)=True]"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^"><Setter Property="pa:T.S6" Value="{Binding IsEnabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S6)=True]"><Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextDisabled}"/>
        <Setter Property="a:LimitedService.Limited" Value="True"/>
      </Style><Style Selector="^:focus /template/ Path#Icon"><Setter Property="IsVisible" Value="False"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="ModernSubMenuItemLinkInput" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource SubMenuText}"/>
    <Setter Property="FontSize" Value="{DynamicResource ModernSubMenuFontSize}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="a:Draggable.Data" Value="{Binding}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <DockPanel MinWidth="20" Background="Transparent" Margin="0 0 12 0" a:ContextMenuAdvancement.PropagateToChildren="True">
            <DockPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Close tab (middle button)" Command="{Binding CloseCommand}"/>
                <MenuItem Header="Close all" Command="{Binding CloseAllCommand}"/>
                <MenuItem Header="Close others" Command="{Binding CloseOthersCommand}"/>
                <MenuItem Header="Close to the right" Command="{Binding CloseToRightCommand}"/>
              </ContextMenu>
            </DockPanel.ContextMenu>
            <!-- PORT: removed DockPanel.InputBindings -->

            <Path VerticalAlignment="Center" DockPanel.Dock="Left" Height="8" Width="6" Margin="0 -1 2 1" Stretch="Uniform" Fill="{Binding (TextBlock.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M 28.5,23L 36.5,23L 36.5,31L 28.5,31L 28.5,23 Z M 28.5,34L 36.5,34L 36.5,42L 28.5,42L 28.5,34 Z M 39.5,23L 47.5,23L 47.5,31L 39.5,31L 39.5,23 Z M 28.5,45L 36.5,45L 36.5,53L 28.5,53L 28.5,45 Z M 39.5,34L 47.5,34L 47.5,42L 39.5,42L 39.5,34 Z M 39.5,45L 47.5,45L 47.5,53L 39.5,53L 39.5,45 Z" IsVisible="{DynamicResource ModernSubMenuDraggablePoints}"/>

            <Button Focusable="False" x:Name="CloseButton" DockPanel.Dock="Right" Margin="0 0 -4 0" Command="{Binding CloseCommand}">
              <Border Background="Transparent">
                <Path Data="M0,0 L5,5 M5,0 L0,5 Z" Width="6" Height="6" Margin="4 0" VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/>
              </Border>
              <Button.Theme>
                <ControlTheme TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource SubMenuText}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextHover}"/>
                    </Style><Style Selector="^:pressed"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextSelected}"/>
                    </Style></ControlTheme>
              </Button.Theme>
            </Button>

            <c:Cell Tag="{Binding SelectedLinkGroupFilterable.FilterHint, RelativeSource={RelativeSource AncestorType={x:Type c:ModernMenu}}}">
              <ToolTip.Tip>
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <ToolTip x:Name="ToolTip" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                  <c:BbCodeBlock Text="{Binding Value}" Classes="Small"/>
                </ToolTip>
              </ToolTip.Tip>
              <c:BetterTextBox x:Name="NameTextBox" Text="{Binding DisplayName}" HorizontalAlignment="Center" Margin="2" Foreground="{TemplateBinding Foreground}" Theme="{StaticResource Borderless}"/>
              <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="2" IsVisible="False"/>
            </c:Cell>
          </DockPanel>

          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ c|BetterTextBox#NameTextBox"><Setter Property="IsEnabled" Value="False"/></Style><Style Selector="^ /template/ ToolTip#ToolTip"><Setter Property="IsVisible" Value="{Binding Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/></Style><Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextHover}"/>
      </Style><Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource SubMenuTextSelected}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </Style><Style Selector="^"><Setter Property="pa:T.S7" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S7)=True]"><Setter Property="IsVisible" Value="False"/>
      </Style><Style Selector="^"><Setter Property="pa:T.S8" Value="{Binding IsEnabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S8)=True]"><Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuTextDisabled}"/>
        <Setter Property="a:LimitedService.Limited" Value="True"/>
      </Style><Style Selector="^:selected /template/ c|BetterTextBox#NameTextBox"><Setter Property="IsEnabled" Value="True"/>
            </Style><Style Selector="^:not(:selected) /template/ ToolTip#ToolTip"><Setter Property="IsVisible" Value="False"/>
            </Style></ControlTheme>

  <c:ModernSubMenuItemContainerStyleSelector x:Key="ModernSubMenuItemContainerStyleSelector" LinkStyle="{StaticResource ModernSubMenuItemLink}" LinkInputStyle="{StaticResource ModernSubMenuItemLinkInput}" LinkInputEmptyStyle="{StaticResource ModernSubMenuItemLinkInputEmpty}"/>

  <ControlTheme TargetType="c:ModernMenu" x:Key="{x:Type c:ModernMenu}">
    <Setter Property="a:InputBindingBehavior.PropagateToWindow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ModernMenu">
          <StackPanel>
            <ListBox ItemsSource="{TemplateBinding VisibleLinkGroups}" SelectedItem="{Binding SelectedLinkGroup, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Height="40" IsVisible="{TemplateBinding TopRowVisibility, Converter={x:Static pc:VisibilityConverters.ToBool}}">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
                  <Setter Property="HorizontalContentAlignment" Value="Center"/>
                  <Setter Property="VerticalContentAlignment" Value="Center"/>
                  <Setter Property="Margin" Value="0 0 12 0"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <TextBlock DataContext="{TemplateBinding Content}" Text="{Binding DisplayName, Converter={StaticResource ToLowerConverter}}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" ToolTip.Tip="{Binding ToolTip}" Classes="Title"/>
                        </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource MenuTextHover}"/>
                          </Style><Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource MenuTextSelected}"/>
                          </Style><Style Selector="^"><Setter Property="pa:T.S9" Value="{Binding IsEnabled, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S9)=True]"><Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Foreground" Value="{DynamicResource MenuTextDisabled}"/>
                            <Setter Property="a:LimitedService.Limited" Value="True"/>
                          </Style><Style Selector="^"><Setter Property="pa:T.S10" Value="{Binding IsShown, Converter={x:Static pc:StateConverter.Instance}, ConverterParameter=False}"/></Style><Style Selector="^[(pa|T.S10)=True]"><Setter Property="IsVisible" Value="False"/>
                          </Style></ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
            <ListBox MinHeight="20" x:Name="PART_SubMenu" ItemsSource="{Binding SelectedLinkGroup.Links, RelativeSource={RelativeSource TemplatedParent}}" SelectedItem="{Binding SelectedLink, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" VerticalAlignment="Top" HorizontalAlignment="Stretch" a:Draggable.KeepSelection="True" DragDrop.AllowDrop="True" ItemContainerTheme="{x:Null}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ItemsPresenter/>
                </ControlTemplate>
              </ListBox.Template>
            </ListBox>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>