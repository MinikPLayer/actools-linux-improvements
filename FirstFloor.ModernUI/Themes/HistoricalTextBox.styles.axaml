<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:mui="http://firstfloorsoftware.com/ModernUI">
  <Styles.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://__ASM__/HistoricalTextBox.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Styles.Resources><Style Selector="c:HistoricalTextBox">
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <DockPanel x:Name="Panel" Background="Transparent">
            <DockPanel.InputBindings>
              <MouseBinding Gesture="MiddleClick" CommandParameter="{Binding}" Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type c:HistoricalTextBox}}}"/>
            </DockPanel.InputBindings>
            <Button DockPanel.Dock="Right" Width="13" Height="13" Margin="4 0 0 0" VerticalAlignment="Center" Padding="2" CommandParameter="{Binding}" Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type c:HistoricalTextBox}}}" Classes="inline1">
              <Button.Styles>
                <Style Selector="Button.inline1">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>
              </Button.Styles>
              <Path Data="M0,0 L7,7 M7,0 L0,7 Z" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Center" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            </Button>
            <TextBlock Text="{Binding}"/>
          </DockPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</Styles>