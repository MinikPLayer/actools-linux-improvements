<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls" xmlns:converters="clr-namespace:FirstFloor.ModernUI.Windows.Converters" xmlns:mui="http://firstfloorsoftware.com/ModernUI">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/TextBox.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Fonts.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Slider.axaml"/>
    <ResourceInclude Source="avares://FirstFloor.ModernUI/Assets/Converters.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="BaseSliderThumbStyle.Double.InnerSlider" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource SliderThumbBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <c:Cell Background="Transparent">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" Width="4"/>
            <Border x:Name="VerticalLine" Background="{TemplateBinding BorderBrush}" Width="1"/>
            <Border Background="{TemplateBinding BorderBrush}" VerticalAlignment="Top" Height="1"/>
            <Border Background="{TemplateBinding BorderBrush}" VerticalAlignment="Bottom" Height="1"/>
            <Border x:Name="Highlight" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" VerticalAlignment="Center" Height="4"/>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^ /template/ #VerticalLine"><Setter Property="HorizontalAlignment" Value="Right"/></Style><Style Selector="^ /template/ #Bg"><Setter Property="HorizontalAlignment" Value="Right"/></Style><Style Selector="^ /template/ #Highlight"><Setter Property="Margin" Value="-2000 0 0 0"/></Style><Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundHover}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderHover}"/>
            </Style><Style Selector="^[IsDragging=True]"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDragging}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderDragging}"/>
            </Style><Style Selector="^:disabled"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDisabled}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderDisabled}"/>
            </Style><Style Selector="^[(c|DoubleThumb.IsLeftSubThumb)=True] /template/ #VerticalLine"><Setter Property="HorizontalAlignment" Value="Left"/>
              </Style><Style Selector="^[(c|DoubleThumb.IsLeftSubThumb)=True] /template/ #Bg"><Setter Property="HorizontalAlignment" Value="Left"/>
              </Style><Style Selector="^[(c|DoubleThumb.IsLeftSubThumb)=True] /template/ #Highlight"><Setter Property="Margin" Value="0 0 -2000 0"/>
            </Style><Style Selector="^[(c|DoubleThumb.HighlightRange)=False] /template/ #Highlight"><Setter Property="IsVisible" Value="False"/>
            </Style></ControlTheme>

  <ControlTheme x:Key="Slider.Double.InnerSlider" TargetType="Slider">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <c:ThumbExt x:Name="Thumb" Height="22" Width="{Binding ThumbSubSize, RelativeSource={RelativeSource AncestorType={x:Type c:DoubleSlider}}}" Theme="{StaticResource BaseSliderThumbStyle.Double.InnerSlider}"/>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^[Orientation=Vertical]"><Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <c:ThumbExt x:Name="Thumb" Width="22" Height="{Binding (c:DoubleSlider.ThumbSubSize), RelativeSource={RelativeSource Self}}" Theme="{StaticResource BaseSliderThumbStyle.Double.InnerSlider}"/>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style></ControlTheme>

  <ControlTheme x:Key="BaseSliderThumbStyle.Double" TargetType="c:DoubleThumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource SliderThumbBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:DoubleThumb">
          <c:Cell>
            <Border x:Name="PART_RangeRight" Width="{TemplateBinding RangeRightWidth}" HorizontalAlignment="Left" ClipToBounds="True">
              <Border.Margin>
                <MultiBinding>
                  <MultiBinding.Converter>
                    <converters:ToThicknessConverter Top="0" Bottom="0"/>
                  </MultiBinding.Converter>
                  <Binding Path="(c:DoubleSlider.ThumbSizeDelta)" RelativeSource="{RelativeSource TemplatedParent}"/>
                  <Binding Path="RangeRightWidth" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource MultiplyConverter}" ConverterParameter="-1"/>
                </MultiBinding>
              </Border.Margin>
              <Slider Minimum="0" Maximum="{TemplateBinding RangeRightLimit}" Value="{Binding RangeRight, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" LargeChange="{TemplateBinding Change}" SmallChange="{TemplateBinding Change}" Theme="{StaticResource Slider.Double.InnerSlider}"/>
            </Border>
            <Border x:Name="PART_RangeLeft" Width="{TemplateBinding RangeLeftWidth}" HorizontalAlignment="Right" ClipToBounds="True">
              <Border.Margin>
                <MultiBinding>
                  <MultiBinding.Converter>
                    <converters:ToThicknessConverter Top="0" Bottom="0"/>
                  </MultiBinding.Converter>
                  <Binding Path="RangeLeftWidth" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource MultiplyConverter}" ConverterParameter="-1"/>
                  <Binding Path="(c:DoubleSlider.ThumbSizeDelta)" RelativeSource="{RelativeSource TemplatedParent}"/>
                </MultiBinding>
              </Border.Margin>
              <Slider Minimum="{TemplateBinding RangeLeftLimit}" Maximum="0" Value="{Binding RangeLeft, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" LargeChange="{TemplateBinding Change}" SmallChange="{TemplateBinding Change}" c:DoubleThumb.IsLeftSubThumb="True" Theme="{StaticResource Slider.Double.InnerSlider}"/>
            </Border>
            <Border Background="{TemplateBinding Background}" Margin="3 0"/>
            <Border Background="{TemplateBinding BorderBrush}" VerticalAlignment="Top" Height="1"/>
            <Border Background="{TemplateBinding BorderBrush}" VerticalAlignment="Bottom" Height="1"/>
          </c:Cell>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundHover}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderHover}"/>
            </Style><Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SliderThumbBackground}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorder}"/>
            </Style><Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SliderThumbBackground}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorder}"/>
            </Style><Style Selector="^[IsDragging=True]"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDragging}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderDragging}"/>
            </Style><Style Selector="^:disabled"><Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDisabled}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderDisabled}"/>
            </Style></ControlTheme>

  <ControlTheme TargetType="c:DoubleSlider" x:Key="{x:Type c:DoubleSlider}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="ThumbSize" Value="11"/>
    <Setter Property="ThumbSubSize" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:DoubleSlider">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding Slider.MinHeight}"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TickBar x:Name="TopTick" Grid.Row="0" Placement="Top" Height="4"/>
              <TickBar x:Name="BottomTick" Grid.Row="2" Placement="Bottom" Height="4"/>
              <Border x:Name="TrackBackground" Grid.Row="1" VerticalAlignment="center" BorderBrush="{DynamicResource SliderTrackBorder}" BorderThickness="1" Background="{DynamicResource SliderTrackBackground}" Height="4.0">
                <Canvas Margin="-6,-1">
                  <Rectangle x:Name="PART_SelectionRange" Fill="{DynamicResource SliderSelectionBackground}" Height="4.0" StrokeThickness="1.0" Stroke="{DynamicResource SliderSelectionBorder}"/>
                </Canvas>
              </Border>
              <Track Grid.Row="1" x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <c:DoubleThumb x:Name="Thumb" RangeLeft="{Binding RangeLeft, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" RangeRight="{Binding RangeRight, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" RangeLeftLimit="{TemplateBinding RangeLeftLimit}" RangeRightLimit="{TemplateBinding RangeRightLimit}" RangeLeftWidth="{TemplateBinding RangeLeftWidth}" RangeRightWidth="{TemplateBinding RangeRightWidth}" Change="{TemplateBinding SmallChange}" Width="{TemplateBinding ThumbSize}" Height="22" Theme="{StaticResource BaseSliderThumbStyle.Double}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </Border>
          </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^ /template/ #TopTick"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource SliderTick}"/></Style><Style Selector="^ /template/ #TrackBackground"><Setter Property="Margin" Value="5,0"/></Style><Style Selector="^ /template/ #BottomTick"><Setter Property="IsVisible" Value="False"/><Setter Property="Fill" Value="{DynamicResource SliderTick}"/></Style><Style Selector="^ /template/ #PART_SelectionRange"><Setter Property="IsVisible" Value="False"/></Style><Style Selector="^[Orientation=Vertical]"><Setter Property="Template">
          <Setter.Value>
            <!-- PORT: ControlTemplate with triggers outside of a style (5 triggers) --><ControlTemplate TargetType="Slider">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="{TemplateBinding Slider.MinWidth}"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TickBar x:Name="TopTick" Grid.Column="0" Placement="Left" Fill="{DynamicResource SliderTick}" Width="4" IsVisible="False"/>
                  <TickBar x:Name="BottomTick" Grid.Column="2" Placement="Right" Fill="{DynamicResource SliderTick}" Width="4" IsVisible="False"/>
                  <Border x:Name="TrackBackground" Grid.Column="1" Margin="0,5" HorizontalAlignment="center" BorderBrush="{DynamicResource SliderTrackBorder}" BorderThickness="1" Background="{DynamicResource SliderTrackBackground}" Width="4.0">

                    <Canvas Margin="-1,-6">
                      <Rectangle x:Name="PART_SelectionRange" Fill="{DynamicResource SliderSelectionBackground}" Width="4.0" StrokeThickness="1.0" Stroke="{DynamicResource SliderSelectionBorder}" IsVisible="False"/>
                    </Canvas>
                  </Border>

                  <Track Grid.Column="1" x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Theme="{StaticResource SliderRepeatButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <c:ThumbExt x:Name="Thumb" Theme="{StaticResource VerticalSliderThumbStyle}"/>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </Border>
              </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style><Style Selector="^[TickPlacement=TopLeft] /template/ #TopTick"><Setter Property="IsVisible" Value="True"/>
              </Style><Style Selector="^[TickPlacement=TopLeft] /template/ #TrackBackground"><Setter Property="Margin" Value="5 2 5 0"/>
            </Style><Style Selector="^[TickPlacement=BottomRight] /template/ #BottomTick"><Setter Property="IsVisible" Value="True"/>
              </Style><Style Selector="^[TickPlacement=BottomRight] /template/ #TrackBackground"><Setter Property="Margin" Value="5 0 5 2"/>
            </Style><Style Selector="^[TickPlacement=Both] /template/ #TopTick"><Setter Property="IsVisible" Value="True"/>
              </Style><Style Selector="^[TickPlacement=Both] /template/ #BottomTick"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^[IsSelectionRangeEnabled=True] /template/ #PART_SelectionRange"><Setter Property="IsVisible" Value="True"/>
            </Style><Style Selector="^:disabled /template/ #TopTick"><Setter Property="Fill" Value="{DynamicResource SliderTickDisabled}"/>
              </Style><Style Selector="^:disabled /template/ #BottomTick"><Setter Property="Fill" Value="{DynamicResource SliderTickDisabled}"/>
            </Style></ControlTheme>
</ResourceDictionary>