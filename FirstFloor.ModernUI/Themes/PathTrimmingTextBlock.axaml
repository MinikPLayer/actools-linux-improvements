<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:FirstFloor.ModernUI.Windows.Controls">
  <ControlTheme x:Key="{x:Type c:PathTrimmingTextBlock}" TargetType="c:PathTrimmingTextBlock">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <SelectableTextBlock Text="{TemplateBinding DisplayText}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
            FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
            Padding="{TemplateBinding Padding}" TextWrapping="NoWrap"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsPlaceholder=True] /template/ SelectableTextBlock">
      <Setter Property="Opacity" Value="0.37"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
